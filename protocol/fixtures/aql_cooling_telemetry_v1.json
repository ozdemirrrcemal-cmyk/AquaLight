{
  "schema": "aql.cooling.v1",
  "schemaVersion": 1,
  "event": "cooling.telemetry.changed",
  "commandCount": 50,
  "requiredRootFields": [
    "schema",
    "schemaVersion",
    "catalogSha256",
    "configRevision",
    "programRevision",
    "uptimeMs",
    "decisionSequence",
    "evaluatedAtMs",
    "inputSampleSequence",
    "timeGeneration",
    "controlMode",
    "operatingState",
    "controlReason",
    "manualActive",
    "manualTargetPercent",
    "clockReady",
    "currentMinuteOfDay",
    "activeProgramSlotIndex",
    "sensors",
    "fan",
    "power",
    "alarms",
    "healthSummary"
  ],
  "alarmFields": ["code", "severity", "active", "latched", "affectedKey", "reason"],
  "healthSummaryFields": ["fanHealth", "sensorHealth", "activeAlarmCount", "highestAlarmSeverity"],
  "sensorKeys": ["water", "ambient"],
  "fanKeys": ["fan1"],
