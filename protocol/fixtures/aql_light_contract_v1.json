{
  "schema": "aqualight.light.v1",
  "storageVersion": 1,
  "productKey": "LIGHT_WRGB_PRO_ELITE",
  "channelCount": 4,
  "channels": ["redPercent", "greenPercent", "bluePercent", "whitePercent"],
  "channelDescriptors": [
    {"key": "red", "percentField": "redPercent", "displayName": "Red", "displayColorRgb": 16711680, "order": 0},
    {"key": "green", "percentField": "greenPercent", "displayName": "Green", "displayColorRgb": 65280, "order": 1},
    {"key": "blue", "percentField": "bluePercent", "displayName": "Blue", "displayColorRgb": 255, "order": 2},
    {"key": "white", "percentField": "whitePercent", "displayName": "White", "displayColorRgb": 16777215, "order": 3}
  ],
  "lightFeatures": {
    "acclimation": true,
    "fanControl": true,
    "temperatureSensor": true,
    "thermal": true,
    "estimatedPower": true,
    "estimatedColor": true
  },
  "modes": ["MANUAL", "AUTO", "CUSTOM"],
  "commands": [
    "light.status.get",
    "light.control.set",
    "light.manual.set",
    "light.manual.off",
    "light.auto.programs.get",
    "light.auto.program.create",
    "light.auto.program.update",
    "light.auto.program.enabled.set",
    "light.auto.program.delete",
    "light.custom.get",
    "light.custom.install",
    "light.acclimation.status.get",
    "light.acclimation.start",
    "light.acclimation.stop",
    "light.graph.get",
    "light.preview.set",
    "light.preview.clear"
  ],
  "forbidden": {
    "modes": ["OFF"],
    "commands": [
      "light.manual.on",
      "light.auto.set",
      "light.auto.clear",
      "light.custom.set",
      "light.custom.clear",
      "light.channel.regime.set",
      "light.program.apply",
      "light.program.delete",
      "light.auto.program.duplicate"
    ],
    "fields": [
      "masterPower",
      "manualEnabled",
      "intensityPercent",
      "programIndex",
      "name",
      "title",
      "role",
      "profileId",
      "moonlight"
    ],
    "outputReasons": ["MASTER_OFF"]
  },
  "manual": {
    "completeSceneReplacement": true,
    "offWritesZeroScene": true,
    "previewPersistent": false
  },
  "auto": {
    "capacity": 16,
    "initialRevision": 0,
    "programIdPattern": "^ap-[0-9a-f]{8}$",
    "programIdSequenceMinimum": 1,
    "programIdReuse": false,
    "timeStepMs": 60000,
    "weekdays": {
      "MONDAY": 64,
      "TUESDAY": 32,
      "WEDNESDAY": 16,
      "THURSDAY": 8,
      "FRIDAY": 4,
      "SATURDAY": 2,
      "SUNDAY": 1,
      "EVERY_DAY": 127
    },
    "rampDurationsMs": [0, 1800000, 3600000, 5400000, 7200000, 9000000],
    "programFields": [
      "programId",
      "enabled",
      "weekdaysMask",
      "startTimeMs",
      "endTimeMs",
      "rampDurationMs",
      "scene"
    ],
    "overlap": {
      "enabledOnly": true,
      "halfOpen": true,
      "overnight": true,
      "weeklyBoundary": true,
      "structuredReason": "AUTO_PROGRAM_OVERLAP"
    }
  },
  "custom": {
    "installedDocumentCount": 1,
    "initialRevision": 0,
    "pointCapacity": 96,
    "pointTuple": [
      "timeMs",
      "redPercent",
      "greenPercent",
      "bluePercent",
      "whitePercent"
    ],
    "sharedWeekdaysMask": true,
    "strictlyIncreasingTimes": true,
    "midnightWrapInterpolation": "LINEAR",
    "clearCommand": null
  },
  "acclimation": {
    "supported": true,
    "states": ["DISABLED", "ACTIVE", "COMPLETED"],
    "startPercent": {"minimum": 20, "maximum": 90, "step": 5, "default": 50},
    "durationDays": {"minimum": 7, "maximum": 90, "step": 1, "default": 30},
    "targetPercent": 100,
    "clock": "AqlTimeService",
    "continuousElapsedTime": true,
    "manualBypass": true,
    "naturalCompletionDurable": true,
    "persistentEpochFields": [
      "startedAtEpochSeconds",
      "endsAtEpochSeconds"
    ]
  },
  "status": {
    "autoIsSummaryOnly": true,
    "rootFields": [
      "schema",
      "storageVersion",
      "productKey",
      "channelScale",
      "channels",
      "features",
      "mode",
      "outputActive",
      "outputReason",
      "requested",
