rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticatedOwner(ownerUid) {
      return request.auth != null && request.auth.uid == ownerUid;
    }

    function textFeedbackIsValid() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'category',
          'email',
          'message',
          'platform',
          'appVersion',
          'locale',
          'status',
          'userId',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'category',
          'email',
          'message',
          'platform',
          'appVersion',
          'locale',
          'status',
          'userId',
          'createdAt'
        ])
        && isAuthenticatedOwner(data.userId)
        && data.status == 'new'
        && data.platform == 'android'
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 80
        && data.message is string
        && data.message.size() >= 10
        && data.message.size() <= 500
        && (
          data.email == null
          || (
            data.email is string
            && data.email.size() > 0
            && data.email.size() <= 254
            && data.email.split('@').size() == 2
            && data.email.split('@')[0].size() <= 64
            && data.email.matches("^[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(\\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*@[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$")
          )
        )
        && data.appVersion is string
        && data.appVersion.size() > 0
        && data.appVersion.size() <= 64
        && data.locale is string
        && data.locale.size() > 0
        && data.locale.size() <= 35
        && data.createdAt == request.time;
    }

    match /feedback_items/{feedbackId} {
      allow create: if textFeedbackIsValid();
      allow get, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow list: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update: if false;
    }
  }
}
