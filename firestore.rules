rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isSignedIn()
        && ownerUid is string
        && ownerUid.size() > 0
        && ownerUid.size() <= 128
        && request.auth.uid == ownerUid;
    }

    function isNonEmptyString(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function optionalEmailIsValid(value) {
      return value == null
        || (
          value is string
          && value.size() > 0
          && value.size() <= 320
        );
    }

    function commonFeedbackFieldsAreValid(data) {
      return isOwner(data.userId)
        && data.mediaTransactionState == 'committed'
        && data.status == 'new'
        && data.platform == 'android'
        && isNonEmptyString(data.category, 80)
        && data.message is string
        && data.message.size() >= 10
        && data.message.size() <= 4000
        && optionalEmailIsValid(data.email)
        && isNonEmptyString(data.appVersion, 64)
        && isNonEmptyString(data.locale, 35)
        && data.createdAt == request.time;
    }

    function markerFieldsAreValid(feedbackId, state, status) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'userId',
          'mediaTransactionState',
          'status',
          'screenshotPath',
          'createdAt',
          'mediaTransactionExpiresAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'mediaTransactionState',
          'status',
          'screenshotPath',
          'createdAt',
          'mediaTransactionExpiresAt'
        ])
        && isOwner(data.userId)
        && data.mediaTransactionState == state
        && data.status == status
        && data.screenshotPath is string
        && data.screenshotPath ==
          'feedback_screenshots/' + data.userId + '/' + feedbackId + '.jpg'
        && data.createdAt is timestamp
        && data.mediaTransactionExpiresAt is timestamp
        && data.mediaTransactionExpiresAt > request.time
        && data.mediaTransactionExpiresAt <= request.time + duration.value(8, 'd');
    }

    function existingPendingMarkerIsValid(feedbackId) {
      let data = resource.data;
      return data.keys().hasAll([
          'userId',
          'mediaTransactionState',
          'status',
          'screenshotPath',
          'createdAt',
          'mediaTransactionExpiresAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'mediaTransactionState',
          'status',
          'screenshotPath',
          'createdAt',
          'mediaTransactionExpiresAt'
        ])
        && isOwner(data.userId)
        && data.mediaTransactionState == 'pending'
        && data.status == 'media_pending'
        && data.screenshotPath is string
        && data.screenshotPath ==
          'feedback_screenshots/' + data.userId + '/' + feedbackId + '.jpg'
        && data.createdAt is timestamp
        && data.mediaTransactionExpiresAt is timestamp;
    }

    function textFeedbackIsValid() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'category',
          'email',
          'message',
          'platform',
          'appVersion',
          'locale',
          'status',
          'userId',
          'createdAt',
          'mediaTransactionState'
        ])
        && data.keys().hasOnly([
          'category',
          'email',
          'message',
          'platform',
          'appVersion',
          'locale',
          'status',
          'userId',
          'createdAt',
          'mediaTransactionState'
        ])
        && commonFeedbackFieldsAreValid(data);
    }

    function committedMediaFeedbackIsValid(feedbackId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'category',
          'email',
          'message',
          'platform',
          'appVersion',
          'locale',
          'status',
          'userId',
          'createdAt',
          'screenshotUrl',
          'screenshotPath',
          'mediaTransactionState'
        ])
        && data.keys().hasOnly([
          'category',
          'email',
          'message',
          'platform',
          'appVersion',
          'locale',
          'status',
          'userId',
          'createdAt',
          'screenshotUrl',
          'screenshotPath',
          'mediaTransactionState'
        ])
        && commonFeedbackFieldsAreValid(data)
        && data.screenshotPath is string
        && data.screenshotPath ==
          'feedback_screenshots/' + data.userId + '/' + feedbackId + '.jpg'
        && data.screenshotUrl is string
        && data.screenshotUrl.size() > 0
        && data.screenshotUrl.size() <= 2048;
    }

    match /feedback_items/{feedbackId} {
      // A media transaction probes its generated document ID before reserving it.
      // Existing documents remain readable only by their immutable owner.
      allow get: if isSignedIn()
        && (
          !exists(/databases/$(database)/documents/feedback_items/$(feedbackId))
          || resource.data.userId == request.auth.uid
        );

      // Feedback is submitted as individual documents. Client-side listing, deletion and
      // arbitrary management are intentionally denied; trusted retention/account-deletion
      // operations must run outside the mobile client.
      allow list, delete: if false;

      allow create: if textFeedbackIsValid()
        || (
          markerFieldsAreValid(feedbackId, 'pending', 'media_pending')
          && request.resource.data.createdAt == request.time
        )
        || (
          markerFieldsAreValid(feedbackId, 'aborted', 'media_aborted')
          && request.resource.data.createdAt == request.time
        );

      allow update: if existingPendingMarkerIsValid(feedbackId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.screenshotPath == resource.data.screenshotPath
        && (
          committedMediaFeedbackIsValid(feedbackId)
          || (
            markerFieldsAreValid(feedbackId, 'aborted', 'media_aborted')
            && request.resource.data.createdAt == resource.data.createdAt
          )
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
