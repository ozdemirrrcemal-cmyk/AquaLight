rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function submitterIsValid(userId) {
      return (request.auth != null && request.auth.uid == userId)
        || (request.auth == null && userId == 'anonymous');
    }

    function textFeedbackIsValid() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'category',
          'email',
          'message',
          'platform',
          'appVersion',
          'locale',
          'status',
          'userId',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'category',
          'email',
          'message',
          'platform',
          'appVersion',
          'locale',
          'status',
          'userId',
          'createdAt'
        ])
        && data.userId is string
        && submitterIsValid(data.userId)
        && data.status == 'new'
        && data.platform == 'android'
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 80
        && data.message is string
        && data.message.size() >= 10
        && data.message.size() <= 4000
        && (data.email == null || (data.email is string && data.email.size() <= 320))
        && data.appVersion is string
        && data.appVersion.size() > 0
        && data.appVersion.size() <= 64
        && data.locale is string
        && data.locale.size() > 0
        && data.locale.size() <= 35
        && data.createdAt == request.time;
    }

    match /feedback_items/{feedbackId} {
      allow create: if textFeedbackIsValid();

      // Account cleanup queries by userId and may delete only the authenticated owner's records.
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow update: if false;
    }
  }
}
