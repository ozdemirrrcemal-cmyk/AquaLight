rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAuthenticatedOwner(ownerUid) {
      return isAuthenticated() && request.auth.uid == ownerUid;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admin_access/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_access/$(request.auth.uid)).data.role == 'feedback-admin';
    }

    function validSubmissionId(submissionId) {
      return submissionId is string
        && submissionId.size() == 36
        && submissionId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$');
    }

    function textFeedbackIsValid(ownerUid, submissionId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'submissionId',
          'category',
          'email',
          'message',
          'platform',
          'appVersion',
          'locale',
          'status',
          'userId',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'submissionId',
          'category',
          'email',
          'message',
          'platform',
          'appVersion',
          'locale',
          'status',
          'userId',
          'createdAt'
        ])
        && isAuthenticatedOwner(ownerUid)
        && validSubmissionId(submissionId)
        && data.submissionId == submissionId
        && data.userId == ownerUid
        && data.status == 'new'
        && data.platform == 'android'
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 80
        && data.message is string
        && data.message.size() >= 10
        && data.message.size() <= 500
        && (
          data.email == null
          || (
            data.email is string
            && data.email.size() > 0
            && data.email.size() <= 254
            && data.email.split('@').size() == 2
            && data.email.split('@')[0].size() <= 64
            && data.email.matches("^[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(\\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*@[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$")
          )
        )
        && data.appVersion is string
        && data.appVersion.size() > 0
        && data.appVersion.size() <= 64
        && data.locale is string
        && data.locale.size() > 0
        && data.locale.size() <= 35
        && data.createdAt == request.time;
    }

    function retentionAuditIsValid() {
      let data = request.resource.data;
      return isAdmin()
        && data.keys().hasAll([
          'actorUid',
          'createdAt',
          'cutoff',
          'deletedCount',
          'mode',
          'version'
        ])
        && data.keys().hasOnly([
          'actorUid',
          'createdAt',
          'cutoff',
          'deletedCount',
          'mode',
          'version'
        ])
        && data.actorUid == request.auth.uid
        && data.createdAt == request.time
        && data.cutoff is timestamp
        && data.cutoff < request.time
        && data.deletedCount is int
        && data.deletedCount > 0
        && data.deletedCount <= 100
        && data.mode == 'manual-admin-panel'
        && data.version == 1;
    }

    match /admin_access/{adminUid} {
      allow get: if isAuthenticatedOwner(adminUid);
      allow list, create, update, delete: if false;
    }

    match /feedback_items/{ownerUid} {
      allow read, write: if false;

      match /submissions/{submissionId} {
        allow create: if textFeedbackIsValid(ownerUid, submissionId);
        allow get, list, delete: if isAuthenticatedOwner(ownerUid);
        allow update: if false;
      }
    }

    // Firestore collection-group queries require a version-2 recursive match.
    // The admin UI separately fail-closes unless every returned path is exactly
    // feedback_items/{uid}/submissions/{submissionId} and its owner fields agree.
    match /{path=**}/submissions/{submissionId} {
      allow get, list, delete: if isAdmin();
    }

    match /retention_audits/{auditId} {
      allow get, list: if isAdmin();
      allow create: if retentionAuditIsValid();
      allow update, delete: if false;
    }
  }
}
