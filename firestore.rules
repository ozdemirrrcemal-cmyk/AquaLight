rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(ownerUid) {
      return request.auth != null && request.auth.uid == ownerUid;
    }

    function textFeedbackIsValid() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'category',
          'email',
          'message',
          'platform',
          'appVersion',
          'locale',
          'status',
          'userId',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'category',
          'email',
          'message',
          'platform',
          'appVersion',
          'locale',
          'status',
          'userId',
          'createdAt'
        ])
        && (
          isOwner(data.userId)
          || (request.auth == null && data.userId == 'anonymous')
        )
        && data.status == 'new'
        && data.platform == 'android'
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 80
        && data.message is string
        && data.message.size() >= 10
        && data.message.size() <= 4000
        && (data.email == null || (data.email is string && data.email.size() <= 320))
        && data.appVersion is string
        && data.appVersion.size() <= 64
        && data.locale is string
        && data.locale.size() <= 35
        && data.createdAt == request.time;
    }

    match /feedback_items/{feedbackId} {
      allow get: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow list, update, delete: if false;
      allow create: if textFeedbackIsValid();
    }
  }
}
