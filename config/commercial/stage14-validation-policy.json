{
  "schemaVersion": 1,
  "policyId": "aqualight-stage14-commercial-release",
  "release": {
    "baseBranch": "main",
    "tagPattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
    "applicationId": "com.aqua.aqualight",
    "candidateVariant": "release",
    "smokeVariant": "releaseSmoke",
    "minifiedCandidateRequired": true,
    "signedAabRequired": true,
    "apkMode": "optional-on-request"
  },
  "android": {
    "minSdk": 27,
    "targetSdk": 36,
    "emulatorApiLevels": [
      27,
      36
    ],
    "visualProfiles": [
      "light",
      "dark",
      "large-font-light",
      "large-font-dark",
      "rtl-light",
      "rtl-dark"
    ],
    "largeFontScale": 2.0
  },
  "blockerThresholds": {
    "androidLint": {
      "fatal": 0,
      "error": 0
    },
    "codeql": {
      "critical": 0,
      "high": 0
    },
    "knownDefects": {
      "critical": 0,
      "high": 0
    }
  },
