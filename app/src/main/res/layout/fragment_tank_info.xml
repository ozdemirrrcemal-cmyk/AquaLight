<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/aqua_space_value_20"
        android:paddingEnd="@dimen/aqua_space_value_20"
        android:paddingTop="@dimen/aqua_space_value_8"
        android:paddingBottom="@dimen/aqua_space_value_24">

        <TextView
            android:id="@+id/tvStepDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_space_value_8"
            android:text="@string/aquarium_text_set_the_final_aquarium_details_these_values_help_organize_an"
            android:textColor="@color/aqua_card_text_secondary"
            android:textSize="@dimen/aqua_text_size_body"
            android:lineSpacingExtra="@dimen/aqua_space_value_3" />

        <!-- Setup Date -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card"
            android:id="@+id/rowSetupDate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_value_82"
            android:layout_marginTop="@dimen/aqua_space_value_22"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/aqua_space_value_18"
                android:paddingEnd="@dimen/aqua_space_value_14">

                <TextView
                    android:id="@+id/tvSetupDateLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/aquarium_setup_date_title"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_caption"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/icSetupDateArrow"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tvSetupDateValue"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tvSetupDateValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_space_value_6"
                    android:text="@string/aquarium_common_not_selected"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_body_large"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/icSetupDateArrow"
                    app:layout_constraintTop_toBottomOf="@id/tvSetupDateLabel"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/icSetupDateArrow"
                    android:layout_width="@dimen/aqua_size_value_24"
                    android:layout_height="@dimen/aqua_size_value_24"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/aqua_palette_7f91aa"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Size -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card"
            android:id="@+id/rowSize"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_value_82"
            android:layout_marginTop="@dimen/aqua_space_value_12"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/aqua_space_value_18"
                android:paddingEnd="@dimen/aqua_space_value_14">

                <TextView
                    android:id="@+id/tvSizeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/aquarium_text_size_cm"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_caption"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/icSizeArrow"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tvSizeValue"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tvSizeValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_space_value_6"
                    android:text="@string/aquarium_text_10_w_x_10_l_x_10_h"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body_large"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/icSizeArrow"
                    app:layout_constraintTop_toBottomOf="@id/tvSizeLabel"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/icSizeArrow"
                    android:layout_width="@dimen/aqua_size_value_24"
                    android:layout_height="@dimen/aqua_size_value_24"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/aqua_palette_7f91aa"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Volume -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card"
            android:id="@+id/rowVolume"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_value_82"
            android:layout_marginTop="@dimen/aqua_space_value_12"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/aqua_space_value_18"
                android:paddingEnd="@dimen/aqua_space_value_14">

                <TextView
                    android:id="@+id/tvVolumeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/aquarium_volume_title"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_caption"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/icVolumeArrow"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tvVolumeValue"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tvVolumeValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_space_value_6"
                    android:text="@string/aquarium_text_1_l"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body_large"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/icVolumeArrow"
                    app:layout_constraintTop_toBottomOf="@id/tvVolumeLabel"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/icVolumeArrow"
                    android:layout_width="@dimen/aqua_size_value_24"
                    android:layout_height="@dimen/aqua_size_value_24"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/aqua_palette_7f91aa"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Tank Type -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card"
            android:id="@+id/rowTankType"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_value_82"
            android:layout_marginTop="@dimen/aqua_space_value_12"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/aqua_space_value_18"
                android:paddingEnd="@dimen/aqua_space_value_14">

                <TextView
                    android:id="@+id/tvTankTypeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/aquarium_tank_type_title"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_caption"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/icTankTypeArrow"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tvTankTypeValue"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tvTankTypeValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_space_value_6"
                    android:text="@string/aquarium_tank_type_fish"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body_large"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/icTankTypeArrow"
                    app:layout_constraintTop_toBottomOf="@id/tvTankTypeLabel"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/icTankTypeArrow"
                    android:layout_width="@dimen/aqua_size_value_24"
                    android:layout_height="@dimen/aqua_size_value_24"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/aqua_palette_7f91aa"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Style -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card"
            android:id="@+id/rowStyle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_value_82"
            android:layout_marginTop="@dimen/aqua_space_value_12"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/aqua_space_value_18"
                android:paddingEnd="@dimen/aqua_space_value_14">

                <TextView
                    android:id="@+id/tvStyleLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/aquarium_style_title"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_caption"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/icStyleArrow"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tvStyleValue"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tvStyleValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_space_value_6"
                    android:text="@string/aquarium_common_not_selected"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_body_large"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/icStyleArrow"
                    app:layout_constraintTop_toBottomOf="@id/tvStyleLabel"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/icStyleArrow"
                    android:layout_width="@dimen/aqua_size_value_24"
                    android:layout_height="@dimen/aqua_size_value_24"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/aqua_palette_7f91aa"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>