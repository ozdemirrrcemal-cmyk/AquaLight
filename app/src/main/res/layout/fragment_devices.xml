<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".ui.tabs.devices.DevicesFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSelectedDevices"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:layout_marginStart="@dimen/aqua_size_16"
        android:layout_marginTop="@dimen/aqua_size_8"
        android:layout_marginEnd="@dimen/aqua_size_16"
        android:layout_marginBottom="@dimen/aqua_size_16"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/cardMenuDiagnostics"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMenuDiagnostics"
        style="@style/Widget.Aqua.Card"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/aqua_size_16"
        android:layout_marginTop="@dimen/aqua_size_8"
        android:layout_marginEnd="@dimen/aqua_size_16"
        android:visibility="gone"
        app:cardBackgroundColor="@color/aqua_surface_deep"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:strokeColor="@color/aqua_content_warning"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvMenuDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="@dimen/aqua_size_12"
            android:textColor="@color/aqua_content_primary_soft"
            android:textIsSelectable="true"
            android:textSize="@dimen/aqua_text_size_micro_plus"
            tools:text="MENU OPEN DIAGNOSTIC&#10;stage=COOLING_COMMAND&#10;outcome=TIMEOUT" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
    style="@style/Widget.Aqua.Card.Inline"
        android:id="@+id/tvEmptyState"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/aqua_size_28"
        android:layout_marginEnd="@dimen/aqua_size_28"
        android:visibility="gone"
        app:cardBackgroundColor="@color/aqua_color_transparent"
        app:cardCornerRadius="@dimen/aqua_size_24"
        app:cardElevation="@dimen/aqua_size_0"
        app:strokeWidth="@dimen/aqua_size_0"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.48"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_aqua_state_container"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_18"
            android:paddingTop="@dimen/aqua_size_22"
            android:paddingEnd="@dimen/aqua_size_18"
            android:paddingBottom="@dimen/aqua_size_20">

            <FrameLayout
                android:layout_width="@dimen/aqua_size_72"
                android:layout_height="@dimen/aqua_size_72"
                android:background="@drawable/bg_devices_empty_orb">

                <ImageView
                    android:layout_width="@dimen/aqua_size_32"
                    android:layout_height="@dimen/aqua_size_32"
                    android:layout_gravity="center"
                    android:contentDescription="@string/devices_empty_icon_desc"
                    android:src="@drawable/ic_devices"
                    app:tint="@color/aqua_state_icon_tint" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/devices_empty_title"
                android:textColor="@color/aqua_state_text_primary"
                android:textSize="@dimen/aqua_text_size_title_medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_8"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/aqua_size_2"
                android:text="@string/devices_empty_message"
                android:textColor="@color/aqua_state_text_secondary"
                android:textSize="@dimen/aqua_text_size_body_small" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Aqua.Button.Primary"
                android:id="@+id/btnEmptyAddDevice"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_button_height"
                android:layout_marginTop="@dimen/aqua_size_22"
                android:text="@string/devices_empty_add_button"
                android:textStyle="bold"
                app:icon="@drawable/ic_add_24"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/aqua_size_8" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_13"
                android:gravity="center"
                android:text="@string/devices_empty_setup_hint"
                android:textColor="@color/aqua_state_text_tertiary"
                android:textSize="@dimen/aqua_text_size_micro_plus" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
