<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/countryPickerSheetRoot"
    style="@style/Widget.Aqua.BottomSheet.Root">

    <View
        style="@style/Widget.Aqua.BottomSheet.Handle"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvBottomTitle"
        style="@style/TextAppearance.Aqua.BottomSheet.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingBottom="12dp"
        android:text="@string/address_info_country_label" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Aqua.BottomSheet.SelectionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/aqua_bottom_sheet_text_secondary"
                android:contentDescription="@string/address_info_country_search_hint" />

            <EditText
                android:id="@+id/etSearchCountry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="@string/address_info_country_search_hint"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:textColor="@color/aqua_bottom_sheet_text_primary"
                android:textColorHint="@color/aqua_bottom_sheet_text_secondary"
                android:background="@null"
                android:padding="0dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCountries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
