<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottomsheet_rounded"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- Küçük handle bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bottomsheet_handle"
        android:layout_marginBottom="12dp" />

    <!-- Sadece başlık, ortada -->
    <TextView
        android:id="@+id/tvBottomTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/address_info_country_label"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        android:paddingBottom="8dp" />

    <!-- Arama kutusu -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/Widget.Aqua.CardStyles">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/ivSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/settings_text_secondary"
                android:contentDescription="@string/address_info_country_search_hint" />

            <EditText
                android:id="@+id/etSearchCountry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:hint="@string/address_info_country_search_hint"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:textColor="@android:color/white"
                android:textColorHint="@color/settings_text_secondary"
                android:background="@null"
                android:padding="0dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

   <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/recyclerCountries"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:paddingBottom="4dp" />

</LinearLayout>