<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/previewDaySheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_light_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_light_sheet_handle" />

    <TextView
        android:id="@+id/tvSheetTitle"
        style="@style/TextAppearance.Aqua.Light.SheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Preview Day" />

    <TextView
        style="@style/TextAppearance.Aqua.Light.SheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Simulate the full program on device." />

    <TextView
        style="@style/TextAppearance.Aqua.Light.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="SPEED" />

    <LinearLayout
        android:id="@+id/previewSpeedSelector"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_light_filter_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/speedOneMinute"
            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_light_filter_selected"
            android:gravity="center"
            android:text="1 min" />

        <TextView
            android:id="@+id/speedThreeMinutes"
            style="@style/TextAppearance.Aqua.Light.Filter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="3 min" />

        <TextView
            android:id="@+id/speedFiveMinutes"
            style="@style/TextAppearance.Aqua.Light.Filter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="5 min" />

    </LinearLayout>

    <TextView
        style="@style/TextAppearance.Aqua.Light.SheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="During preview, live program will be temporarily overridden." />

    <ProgressBar
        android:id="@+id/previewProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="22dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_light_preview_progress"
        tools:progress="42" />

    <TextView
        android:id="@+id/tvPreviewProgress"
        style="@style/TextAppearance.Aqua.Light.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:text="0%" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartPreview"
        style="@style/Widget.Aqua.Light.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:text="Start Preview" />

</LinearLayout>