<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/previewDayRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_light_bottom_sheet_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/light_stroke" />

    <TextView
        android:id="@+id/tvPreviewDayTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:text="@string/light_preview_day_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvPreviewDaySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/light_preview_day_subtitle"
        android:textColor="@color/settings_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvPreviewDayTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:text=""
        android:textColor="@color/light_accent"
        android:textSize="34sp"
        tools:text="00:00" />

    <TextView
        android:id="@+id/tvPreviewDayMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/settings_text_secondary"
        android:textSize="13sp"
        tools:text="Simple preview · Linear · Every day" />

    <ProgressBar
        android:id="@+id/progressPreviewDay"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="20dp"
        android:max="1000"
        android:progress="0"
        android:progressTint="@color/light_accent"
        android:progressBackgroundTint="@color/light_stroke" />

    <LinearLayout
        android:id="@+id/previewValuesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPreviewMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            tools:text="Main 0%" />

        <TextView
            android:id="@+id/tvPreviewRed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="@color/light_red"
            android:textSize="15sp"
            tools:text="Red 0%" />

        <TextView
            android:id="@+id/tvPreviewGreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="@color/light_green"
            android:textSize="15sp"
            tools:text="Green 0%" />

        <TextView
            android:id="@+id/tvPreviewBlue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="@color/light_blue"
            android:textSize="15sp"
            tools:text="Blue 0%" />

        <TextView
            android:id="@+id/tvPreviewWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="@color/light_white"
            android:textSize="15sp"
            tools:text="White 0%" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnPreviewDayClose"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_light_primary_action"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/common_close"
        android:textColor="@color/background_color"
        android:textSize="15sp" />

</LinearLayout>