<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <EditText
    android:id="@+id/inputStyle"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:background="@drawable/bg_settings_sheet_input"
    android:gravity="center_vertical"
    android:hint="Write custom style"
    android:includeFontPadding="false"
    android:inputType="textCapWords"
    android:maxLines="1"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:selectAllOnFocus="false"
    android:singleLine="true"
    android:textColor="@android:color/white"
    android:textColorHint="#8FA4BE"
    android:textSize="15sp" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:includeFontPadding="false"
    android:lineSpacingExtra="2dp"
    android:text="Choose a style or write your own aquarium concept."
    android:textColor="#8FA4BE"
    android:textSize="13sp" />

  <LinearLayout
    android:id="@+id/styleOptionsContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="28dp"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:baselineAligned="false"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/optionNatureAquarium"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:background="@drawable/bg_settings_sheet_grid_option"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:maxLines="2"
        android:text="Nature&#10;Aquarium"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

      <TextView
        android:id="@+id/optionIwagumi"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_settings_sheet_grid_option"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:maxLines="2"
        android:text="Iwagumi"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

      <TextView
        android:id="@+id/optionDutch"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_settings_sheet_grid_option"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:maxLines="2"
        android:text="Dutch"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:baselineAligned="false"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/optionJungle"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:background="@drawable/bg_settings_sheet_grid_option"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:maxLines="2"
        android:text="Jungle"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

      <TextView
        android:id="@+id/optionBiotope"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_settings_sheet_grid_option"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:maxLines="2"
        android:text="Biotope"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

      <TextView
        android:id="@+id/optionBlackwater"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_settings_sheet_grid_option"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:maxLines="2"
        android:text="Blackwater"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:baselineAligned="false"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/optionForest"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:background="@drawable/bg_settings_sheet_grid_option"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:maxLines="2"
        android:text="Forest"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

      <TextView
        android:id="@+id/optionMountain"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_settings_sheet_grid_option"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:maxLines="2"
        android:text="Mountain"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

      <TextView
        android:id="@+id/optionIsland"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_settings_sheet_grid_option"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:maxLines="2"
        android:text="Island"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    </LinearLayout>

  </LinearLayout>

  <com.google.android.material.button.MaterialButton
    android:id="@+id/btnSave"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layout_marginTop="26dp"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:minWidth="0dp"
    android:minHeight="0dp"
    android:text="Save"
    android:textAllCaps="false"
    android:textColor="@android:color/white"
    android:textSize="14sp"
    android:textStyle="bold"
    app:backgroundTint="#2196F3"
    app:cornerRadius="16dp" />

  <TextView
    android:id="@+id/btnCancel"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layout_marginTop="10dp"
    android:gravity="center"
    android:includeFontPadding="false"
    android:text="Cancel"
    android:textColor="#8FA4BE"
    android:textSize="14sp" />

</LinearLayout>