<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".ui.tabs.devices.detail.light.DeviceLightRootFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="@dimen/aqua_size_16"
        android:paddingTop="@dimen/aqua_size_12"
        android:paddingEnd="@dimen/aqua_size_16"
        android:paddingBottom="@dimen/aqua_size_24"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_18">

                    <TextView
                        android:id="@+id/tvProductName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_large"
                        android:textStyle="bold"
                        tools:text="WRGB Pro Elite" />

                    <TextView
                        android:id="@+id/tvDeviceUid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:textColor="@color/aqua_palette_hex_8fa4be"
                        android:textSize="@dimen/aqua_text_size_caption"
                        tools:text="AQL-LIGHT-123456" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_16"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/device_detail_connection_section_title"
                                android:textColor="@color/aqua_palette_hex_8fa4be"
                                android:textSize="@dimen/aqua_text_size_caption" />

                            <TextView
                                android:id="@+id/tvConnectionStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/aqua_size_4"
                                android:textColor="@color/white"
                                android:textSize="@dimen/aqua_text_size_body_large"
                                android:textStyle="bold"
                                tools:text="Online" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_14">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_18">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_detail_information_section_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_14"
                        android:textColor="@color/aqua_palette_hex_dce7f3"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="IP: 192.168.1.40" />

                    <TextView
                        android:id="@+id/tvFirmware"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_10"
                        android:textColor="@color/aqua_palette_hex_dce7f3"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="Firmware: 1.0.0 / build 20260624" />

                    <TextView
                        android:id="@+id/tvModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_10"
                        android:textColor="@color/aqua_palette_hex_dce7f3"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="Model: wrgb-pro-elite" />

                    <TextView
                        android:id="@+id/tvChannelCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_10"
                        android:textColor="@color/aqua_palette_hex_dce7f3"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="Light channels: 4" />

                    <TextView
                        android:id="@+id/tvFeatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_10"
                        android:textColor="@color/aqua_palette_hex_dce7f3"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="Features: Manual light, Program, Presets, OTA" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device.Highlight"
                android:id="@+id/otaTestPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_14"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_18">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_ota_test_panel_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:text="@string/device_ota_test_panel_description"
                        android:textColor="@color/aqua_palette_hex_8fa4be"
                        android:textSize="@dimen/aqua_text_size_body_small" />

                    <TextView
                        android:id="@+id/tvOtaTestStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_12"
                        android:fontFamily="monospace"
                        android:textColor="@color/aqua_palette_hex_dce7f3"
                        android:textSize="@dimen/aqua_text_size_caption"
                        tools:text="Hidden OTA test panel. Long press Firmware to unlock." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_14"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Aqua.Button.Secondary.Compact"
                            android:id="@+id/btnOtaTestCheck"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="@dimen/aqua_button_height"
                            android:layout_marginEnd="@dimen/aqua_size_6"
                            android:layout_weight="1"
                            android:text="@string/device_ota_test_check_beta_action" />

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Aqua.Button.Neutral.Compact"
                            android:id="@+id/btnOtaTestStatus"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="@dimen/aqua_button_height"
                            android:layout_marginStart="@dimen/aqua_size_6"
                            android:layout_weight="1"
                            android:text="@string/device_ota_test_status_action" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Aqua.Button.Primary.Compact"
                            android:id="@+id/btnOtaTestStart"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="@dimen/aqua_button_height"
                            android:layout_marginEnd="@dimen/aqua_size_6"
                            android:layout_weight="1"
                            android:text="@string/device_ota_test_start_action" />

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Aqua.Button.Danger.Compact"
                            android:id="@+id/btnOtaTestClear"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="@dimen/aqua_button_height"
                            android:layout_marginStart="@dimen/aqua_size_6"
                            android:layout_weight="1"
                            android:text="@string/device_ota_test_clear_action" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_14">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_18">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_menu_manual_control_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvManualPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:text="@string/device_menu_manual_preparing"
                        android:textColor="@color/aqua_palette_hex_8fa4be"
                        android:textSize="@dimen/aqua_text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_14">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_18">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_menu_programs_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProgramsPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:text="@string/device_menu_programs_preparing"
                        android:textColor="@color/aqua_palette_hex_8fa4be"
                        android:textSize="@dimen/aqua_text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
