<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">

        <!-- DEVICE SUMMARY -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDosingSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#111A35"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#315B7A"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="38dp"
                    android:background="#38BDF8" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDosingTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="DosePro 4"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDosingSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="4 channel smart dosing pump"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#17384D"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tvConnectionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="64dp"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:text="Ready"
                        android:textColor="#A7E8FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- DOSING PUMP VISUAL -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pumpVisualContainer"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="18dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/ivDosingPump"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:adjustViewBounds="false"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/img_dosing_pump_4ch"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- TOUCH AREA Y -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePumpTouchTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.185" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePumpTouchBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.735" />

            <!-- INDICATOR Y CENTER -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePumpIndicatorY"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.486" />

            <!-- TOUCH AREAS X -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump1Start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.075" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump1End"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.265" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump2Start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.295" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump2End"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.485" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump3Start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.515" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump3End"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.705" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump4Start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.735" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump4End"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.925" />

            <!-- INDICATOR X CENTERS -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump1Center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.153" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump2Center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.386" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump3Center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.614" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump4Center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.846" />

            <!-- RUNNING INDICATORS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/indicatorPump1"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:visibility="gone"
                app:cardBackgroundColor="#22C55E"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:strokeColor="#86EFAC"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="@id/guidePumpIndicatorY"
                app:layout_constraintEnd_toEndOf="@id/guidePump1Center"
                app:layout_constraintStart_toStartOf="@id/guidePump1Center"
                app:layout_constraintTop_toTopOf="@id/guidePumpIndicatorY">

                <TextView
                    android:id="@+id/tvPumpIndicator1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@android:color/black"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/indicatorPump2"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:visibility="gone"
                app:cardBackgroundColor="#22C55E"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:strokeColor="#86EFAC"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="@id/guidePumpIndicatorY"
                app:layout_constraintEnd_toEndOf="@id/guidePump2Center"
                app:layout_constraintStart_toStartOf="@id/guidePump2Center"
                app:layout_constraintTop_toTopOf="@id/guidePumpIndicatorY">

                <TextView
                    android:id="@+id/tvPumpIndicator2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@android:color/black"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/indicatorPump3"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:visibility="gone"
                app:cardBackgroundColor="#22C55E"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:strokeColor="#86EFAC"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="@id/guidePumpIndicatorY"
                app:layout_constraintEnd_toEndOf="@id/guidePump3Center"
                app:layout_constraintStart_toStartOf="@id/guidePump3Center"
                app:layout_constraintTop_toTopOf="@id/guidePumpIndicatorY">

                <TextView
                    android:id="@+id/tvPumpIndicator3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@android:color/black"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/indicatorPump4"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:visibility="gone"
                app:cardBackgroundColor="#22C55E"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:strokeColor="#86EFAC"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="@id/guidePumpIndicatorY"
                app:layout_constraintEnd_toEndOf="@id/guidePump4Center"
                app:layout_constraintStart_toStartOf="@id/guidePump4Center"
                app:layout_constraintTop_toTopOf="@id/guidePumpIndicatorY">

                <TextView
                    android:id="@+id/tvPumpIndicator4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@android:color/black"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <!-- TOUCH HOTSPOTS -->
            <View
                android:id="@+id/hotspotPump1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="@id/guidePumpTouchBottom"
                app:layout_constraintEnd_toEndOf="@id/guidePump1End"
                app:layout_constraintStart_toStartOf="@id/guidePump1Start"
                app:layout_constraintTop_toTopOf="@id/guidePumpTouchTop" />

            <View
                android:id="@+id/hotspotPump2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="@id/guidePumpTouchBottom"
                app:layout_constraintEnd_toEndOf="@id/guidePump2End"
                app:layout_constraintStart_toStartOf="@id/guidePump2Start"
                app:layout_constraintTop_toTopOf="@id/guidePumpTouchTop" />

            <View
                android:id="@+id/hotspotPump3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="@id/guidePumpTouchBottom"
                app:layout_constraintEnd_toEndOf="@id/guidePump3End"
                app:layout_constraintStart_toStartOf="@id/guidePump3Start"
                app:layout_constraintTop_toTopOf="@id/guidePumpTouchTop" />

            <View
                android:id="@+id/hotspotPump4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="@id/guidePumpTouchBottom"
                app:layout_constraintEnd_toEndOf="@id/guidePump4End"
                app:layout_constraintStart_toStartOf="@id/guidePump4Start"
                app:layout_constraintTop_toTopOf="@id/guidePumpTouchTop" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- CHANNEL CARDS -->
        <include
            android:id="@+id/channelCard1"
            layout="@layout/item_dosing_channel_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <include
            android:id="@+id/channelCard2"
            layout="@layout/item_dosing_channel_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <include
            android:id="@+id/channelCard3"
            layout="@layout/item_dosing_channel_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <include
            android:id="@+id/channelCard4"
            layout="@layout/item_dosing_channel_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <!-- TEMP TEST ACTIONS -->
        <LinearLayout
            android:id="@+id/actionRow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualRun"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Run"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:backgroundTint="#1D4E6B"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalibration"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Calibrate"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:backgroundTint="#2563EB"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSchedule"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Schedule"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:backgroundTint="#315B7A"
                app:cornerRadius="18dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>