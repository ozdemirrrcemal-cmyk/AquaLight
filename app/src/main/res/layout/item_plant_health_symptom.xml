<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Aqua.Card"
    android:layout_width="@dimen/aqua_size_0"
    android:layout_height="@dimen/aqua_size_96"
    android:clickable="true"
    android:focusable="true"
    app:checkable="true"
    app:checkedIcon="@drawable/ic_check_24"
    app:checkedIconTint="@color/aqua_status_success"
    app:checkedIconSize="@dimen/aqua_size_18"
    app:checkedIconMargin="@dimen/aqua_size_6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/aqua_size_8">

        <ImageView
            android:id="@+id/ivSymptom"
            android:layout_width="@dimen/aqua_size_32"
            android:layout_height="@dimen/aqua_size_32"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_health_plant_24"
            app:tint="@color/aqua_status_success" />

        <TextView
            android:id="@+id/tvSymptom"
            android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_6"
            android:gravity="center"
            android:maxLines="2"
            tools:text="Leaf yellowing" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
