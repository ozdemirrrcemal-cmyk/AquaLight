<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:padding="20dp"
    android:fitsSystemWindows="false">

    <!-- 🔹 Başlık Alanı -->
    <include
    android:id="@+id/appHeader"
    layout="@layout/layout_aqua_header"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <!-- 🧍‍♂️ Profil Fotoğrafı + Kamera İkonu -->
    <FrameLayout
    android:id="@+id/photoContainer"
    android:layout_width="180dp"
    android:layout_height="180dp"
    android:layout_marginTop="24dp"
    android:background="@drawable/profile_background"
    android:padding="0dp"
    app:layout_constraintTop_toBottomOf="@id/appHeader"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <!-- İçteki gerçek profil fotosu -->
    <ImageView
        android:id="@+id/ivEditProfilePhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"  
        android:background="@drawable/profile_clip_circle"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_profile_placeholder"
        android:clipToOutline="true"
    />

    <!-- Kamera ikonu -->
    <ImageView
        android:id="@+id/ivCameraIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/profile_background_small"
        android:src="@drawable/ic_camera"
        android:padding="8dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="15dp"
        android:contentDescription="@string/edit_profile_camera_icon_desc"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>

    <!-- 💾 Kaydet Butonu -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        style="@style/Widget.Aqua.PrimaryButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/edit_profile_save_button"
        android:contentDescription="@string/edit_profile_save_button_desc"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>