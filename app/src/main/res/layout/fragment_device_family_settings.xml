<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:ignore="Overdraw">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsContentScroll"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="@dimen/aqua_size_16"
        android:paddingTop="@dimen/aqua_size_12"
        android:paddingEnd="@dimen/aqua_size_16"
        android:paddingBottom="@dimen/aqua_size_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:id="@+id/settingsSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_18">

                    <TextView
                        android:id="@+id/tvDeviceInformationSectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold"
                        tools:text="Device information" />

                    <LinearLayout
                        android:id="@+id/deviceNameRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/aqua_size_8"
                        android:paddingBottom="@dimen/aqua_size_8">

                        <LinearLayout
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            tools:ignore="InefficientWeight">

                            <TextView
                                android:id="@+id/tvDeviceNameLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/aqua_content_secondary"
                                android:textSize="@dimen/aqua_text_size_caption"
                                tools:text="Device name" />

                            <TextView
                                android:id="@+id/tvDeviceNameValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/aqua_size_4"
                                android:textColor="@color/white"
                                android:textSize="@dimen/aqua_text_size_body_large"
                                android:textStyle="bold"
                                tools:text="WRGB Pro Elite 120" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvEditDeviceNameAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_12"
                            android:text="@string/common_edit_action"
                            android:textColor="@color/aqua_content_secondary"
                            android:textSize="@dimen/aqua_text_size_caption_plus"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_16"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSerialNumberLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/aqua_content_secondary"
                            android:textSize="@dimen/aqua_text_size_caption"
                            tools:text="Serial number" />

                        <TextView
                            android:id="@+id/tvSerialNumberValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_4"
                            android:textColor="@color/aqua_content_primary_soft"
                            android:textSize="@dimen/aqua_text_size_body_large"
                            tools:text="AQL-WPE-123456" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_16"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHardwareRevisionLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/aqua_content_secondary"
                            android:textSize="@dimen/aqua_text_size_caption"
                            tools:text="Hardware revision" />

                        <TextView
                            android:id="@+id/tvHardwareRevisionValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_4"
                            android:textColor="@color/aqua_content_primary_soft"
                            android:textSize="@dimen/aqua_text_size_body_large"
                            tools:text="2.0" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_14">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_18">

                    <TextView
                        android:id="@+id/tvSoftwareSectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold"
                        tools:text="Software" />

                    <TextView
                        android:id="@+id/tvFirmwareVersionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_16"
                        android:textColor="@color/aqua_content_secondary"
                        android:textSize="@dimen/aqua_text_size_caption"
                        tools:text="Installed firmware version" />

                    <TextView
                        android:id="@+id/tvFirmwareVersionValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_4"
                        android:textColor="@color/aqua_content_primary_soft"
                        android:textSize="@dimen/aqua_text_size_body_large"
                        tools:text="1.0.1" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardFirmwareUpdateStatus"
                        style="@style/Widget.Aqua.Card.Device.Update"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_device_settings_update_card_margin_top"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="yes"
                        android:minHeight="@dimen/aqua_device_settings_update_card_min_height">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/aqua_device_settings_update_card_padding_horizontal"
                            android:paddingTop="@dimen/aqua_device_settings_update_card_padding_vertical"
                            android:paddingEnd="@dimen/aqua_device_settings_update_card_padding_horizontal"
                            android:paddingBottom="@dimen/aqua_device_settings_update_card_padding_vertical">

                            <LinearLayout
                                android:layout_width="@dimen/aqua_size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                tools:ignore="InefficientWeight">

                                <TextView
                                    android:id="@+id/tvFirmwareUpdateTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAccessibility="no"
                                    android:textAppearance="@style/TextAppearance.Aqua.DeviceSettings.UpdateTitle"
                                    tools:text="Update available" />

                                <TextView
                                    android:id="@+id/tvFirmwareUpdateStatus"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_device_settings_update_status_text_spacing"
                                    android:importantForAccessibility="no"
                                    android:textAppearance="@style/TextAppearance.Aqua.DeviceSettings.UpdateDescription"
                                    tools:text="Firmware 1.1.0 is ready" />
                            </LinearLayout>

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progressCheckForUpdates"
                                android:layout_width="@dimen/aqua_device_settings_update_progress_size"
                                android:layout_height="@dimen/aqua_device_settings_update_progress_size"
                                android:layout_marginStart="@dimen/aqua_device_settings_update_status_indicator_margin_start"
                                android:importantForAccessibility="no"
                                android:indeterminate="true"
                                android:visibility="gone"
                                app:indicatorColor="@color/aqua_accent_primary"
                                app:indicatorSize="@dimen/aqua_device_settings_update_progress_size"
                                app:trackColor="@color/aqua_card_device_section_outline"
                                app:trackThickness="@dimen/aqua_device_settings_update_progress_track_thickness"
                                tools:visibility="visible" />

                            <View
                                android:id="@+id/viewFirmwareUpdateStatusIndicator"
                                android:layout_width="@dimen/aqua_device_settings_update_status_indicator_size"
                                android:layout_height="@dimen/aqua_device_settings_update_status_indicator_size"
                                android:layout_marginStart="@dimen/aqua_device_settings_update_status_indicator_margin_start"
                                android:background="@drawable/bg_device_settings_update_indicator"
                                android:importantForAccessibility="no" />

                            <ImageView
                                android:id="@+id/ivFirmwareUpdateArrow"
                                android:layout_width="@dimen/aqua_device_settings_update_status_arrow_size"
                                android:layout_height="@dimen/aqua_device_settings_update_status_arrow_size"
                                android:layout_marginStart="@dimen/aqua_device_settings_update_status_arrow_margin_start"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_arrow_right"
                                android:visibility="gone"
                                app:tint="@color/aqua_content_secondary"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:id="@+id/firmwareUpdateMetaRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_device_settings_update_meta_margin_top"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvFirmwareLastChecked"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Aqua.DeviceSettings.UpdateMeta"
                            tools:ignore="InefficientWeight"
                            tools:text="Last checked: Today, 11:20" />

                        <TextView
                            android:id="@+id/tvCheckForUpdatesAction"
                            style="@style/Widget.Aqua.DeviceSettings.UpdateCheckAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/device_settings_check_updates_action" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ViewStub
                android:id="@+id/lightSettingsSectionStub"
                android:inflatedId="@+id/lightSettingsSection"
                android:layout="@layout/layout_device_light_settings_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
