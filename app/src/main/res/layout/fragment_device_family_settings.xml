<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsContentScroll"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="@dimen/aqua_size_16"
        android:paddingTop="@dimen/aqua_size_12"
        android:paddingEnd="@dimen/aqua_size_16"
        android:paddingBottom="@dimen/aqua_size_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:id="@+id/settingsSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_18">

                    <TextView
                        android:id="@+id/tvDeviceInformationSectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold"
                        tools:text="Device information" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_16"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDeviceNameLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/aqua_content_secondary"
                                android:textSize="@dimen/aqua_text_size_caption"
                                tools:text="Device name" />

                            <TextView
                                android:id="@+id/tvDeviceNameValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/aqua_size_4"
                                android:textColor="@color/white"
                                android:textSize="@dimen/aqua_text_size_body_large"
                                android:textStyle="bold"
                                tools:text="WRGB Pro Elite 120" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditDeviceName"
                            style="@style/Widget.Aqua.Button.IconToggle"
                            android:layout_width="@dimen/aqua_button_height_compact"
                            android:layout_height="@dimen/aqua_button_height_compact"
                            android:layout_marginStart="@dimen/aqua_size_12"
                            android:enabled="false"
                            android:text=""
                            app:icon="@drawable/ic_edit_24"
                            tools:enabled="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_16"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSerialNumberLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/aqua_content_secondary"
                            android:textSize="@dimen/aqua_text_size_caption"
                            tools:text="Serial number" />

                        <TextView
                            android:id="@+id/tvSerialNumberValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_4"
                            android:textColor="@color/aqua_content_primary_soft"
                            android:textSize="@dimen/aqua_text_size_body_large"
                            tools:text="AQL-WPE-123456" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_16"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHardwareRevisionLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/aqua_content_secondary"
                            android:textSize="@dimen/aqua_text_size_caption"
                            tools:text="Hardware revision" />

                        <TextView
                            android:id="@+id/tvHardwareRevisionValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_4"
                            android:textColor="@color/aqua_content_primary_soft"
                            android:textSize="@dimen/aqua_text_size_body_large"
                            tools:text="2.0" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_14">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_18">

                    <TextView
                        android:id="@+id/tvSoftwareSectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold"
                        tools:text="Software" />

                    <TextView
                        android:id="@+id/tvFirmwareVersionLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_16"
                        android:textColor="@color/aqua_content_secondary"
                        android:textSize="@dimen/aqua_text_size_caption"
                        tools:text="Installed firmware version" />

                    <TextView
                        android:id="@+id/tvFirmwareVersionValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_4"
                        android:textColor="@color/aqua_content_primary_soft"
                        android:textSize="@dimen/aqua_text_size_body_large"
                        tools:text="1.0.0 / build 20260730" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckForUpdates"
                        style="@style/Widget.Aqua.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_button_height"
                        android:layout_marginTop="@dimen/aqua_size_18"
                        android:enabled="false"
                        tools:enabled="true"
                        tools:text="Check for updates" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ViewStub
                android:id="@+id/lightSettingsSectionStub"
                android:inflatedId="@+id/lightSettingsSection"
                android:layout="@layout/layout_device_light_settings_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
