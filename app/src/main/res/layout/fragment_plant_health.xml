<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/aqua_size_24"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_16"
            android:paddingTop="@dimen/aqua_size_8"
            android:paddingEnd="@dimen/aqua_size_16">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_48">

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/aqua_color_transparent"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="@dimen/aqua_size_10"
                    android:hint="@string/plant_health_search_hint"
                    android:includeFontPadding="false"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="@dimen/aqua_size_14"
                    android:paddingEnd="@dimen/aqua_size_14"
                    android:singleLine="true"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textColorHint="@color/aqua_content_muted"
                    android:textSize="@dimen/aqua_text_size_body_small" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_size_14">

                    <ImageView
                        android:layout_width="@dimen/aqua_size_32"
                        android:layout_height="@dimen/aqua_size_32"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_health_plant_24"
                        app:tint="@color/aqua_status_success" />

                    <LinearLayout
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodySmallBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/plant_health_home_info_title" />

                        <TextView
                            android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_4"
                            android:lineSpacingExtra="@dimen/aqua_size_2"
                            android:text="@string/plant_health_home_info_body" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/plantListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_14"
                android:orientation="vertical"
                tools:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmpty"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_14"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_24">

                    <ImageView
                        android:layout_width="@dimen/aqua_size_40"
                        android:layout_height="@dimen/aqua_size_40"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_health_plant_24"
                        app:tint="@color/aqua_content_secondary" />

                    <TextView
                        android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodyBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_12"
                        android:gravity="center"
                        android:text="@string/plant_health_no_plants_title" />

                    <TextView
                        android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:gravity="center"
                        android:text="@string/plant_health_no_plants_body" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
