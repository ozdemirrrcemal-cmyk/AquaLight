<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/background_color">

   <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

  <ScrollView
    android:id="@+id/contentScrollView"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="18dp"
    android:paddingBottom="120dp"
    android:scrollbars="none"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/appHeader">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card.Form"
        android:id="@+id/cardPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:padding="16dp">

          <ImageView
            android:id="@+id/ivLifeIconPreview"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_life_fish_24"
            app:tint="@android:color/white" />

          <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
              android:id="@+id/tvLifePreviewTitle"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:includeFontPadding="false"
              android:text="@string/aquarium_text_livestock"
              android:textColor="@color/aqua_card_text_primary"
              android:textSize="@dimen/aqua_text_size_body_xlarge"
              android:textStyle="bold" />

            <TextView
              android:id="@+id/tvLifeCategoryPreview"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="7dp"
              android:includeFontPadding="false"
              android:text="@string/aquarium_tank_type_fish"
              android:textColor="@color/aqua_card_text_secondary"
              android:textSize="@dimen/aqua_text_size_body_small" />

          </LinearLayout>

        </LinearLayout>

      </com.google.android.material.card.MaterialCardView>

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:includeFontPadding="false"
        android:text="@string/aquarium_text_name"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="@dimen/aqua_text_size_body_small"
        android:textStyle="bold" />

      <EditText
        style="@style/Widget.Aqua.Input.PlainEditText"
        android:id="@+id/etLifeName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="9dp"
        android:hint="@string/aquarium_hint_livestock_name_example"
        android:inputType="textCapWords"
        android:singleLine="true" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:includeFontPadding="false"
        android:text="@string/aquarium_text_category"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="@dimen/aqua_text_size_body_small"
        android:textStyle="bold" />

      <GridLayout
        android:id="@+id/categoryGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:columnCount="2" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:includeFontPadding="false"
        android:text="@string/aquarium_text_quantity"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="@dimen/aqua_text_size_body_small"
        android:textStyle="bold" />

      <LinearLayout
  style="@style/Widget.Aqua.SelectionRow.Control"
        android:id="@+id/quantityRow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/btnDecreaseQuantity"
          android:layout_width="42dp"
          android:layout_height="42dp"
          android:gravity="center"
          android:text="@string/common_minus"
          android:textColor="@color/aqua_card_text_primary"
          android:textSize="@dimen/aqua_text_size_header_title"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tvQuantityValue"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center"
          android:includeFontPadding="false"
          android:text="@string/aquarium_text_1"
          android:textColor="@color/aqua_card_text_primary"
          android:textSize="@dimen/aqua_text_size_title_small"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/btnIncreaseQuantity"
          android:layout_width="42dp"
          android:layout_height="42dp"
          android:gravity="center"
          android:text="@string/common_plus"
          android:textColor="@color/aqua_card_text_primary"
          android:textSize="@dimen/aqua_text_size_title_large"
          android:textStyle="bold" />

      </LinearLayout>

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:includeFontPadding="false"
        android:text="@string/aquarium_text_added_date"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="@dimen/aqua_text_size_body_small"
        android:textStyle="bold" />

      <LinearLayout
  style="@style/Widget.Aqua.SelectionRow"
        android:id="@+id/rowAddedDate"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="9dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/tvAddedDateValue"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:includeFontPadding="false"
          android:text="@string/aquarium_text_18_may_2026"
          android:textColor="@color/aqua_card_text_primary"
          android:textSize="@dimen/aqua_text_size_body"
          android:textStyle="bold" />

        <ImageView
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:src="@drawable/ic_arrow_right"
          app:tint="#8FA4BE" />

      </LinearLayout>

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:includeFontPadding="false"
        android:text="@string/aquarium_text_note"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="@dimen/aqua_text_size_body_small"
        android:textStyle="bold" />

      <EditText
        style="@style/Widget.Aqua.Input.PlainEditText.Multiline"
        android:id="@+id/etLifeNote"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginTop="9dp"
        android:gravity="top|start"
        android:hint="@string/aquarium_hint_optional_note"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="5"
        android:minLines="4" />

      <com.google.android.material.button.MaterialButton
        style="@style/Widget.Aqua.Button.Primary"
        android:id="@+id/btnSaveLife"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="26dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/aquarium_text_save_livestock"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/btnDeleteLife"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/aquarium_text_delete_livestock"
        android:textColor="#D85C5C"
        android:textSize="@dimen/aqua_text_size_body"
        android:textStyle="bold"
        android:visibility="gone" />

    </LinearLayout>

  </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>