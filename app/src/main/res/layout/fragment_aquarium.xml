<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Üst başlık -->
    <TextView
        android:id="@+id/tvMaintenance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Aquarium"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnAddDevice" />

    <!-- Sağ üst cihaz ekle butonu -->
    <ImageButton
        android:id="@+id/btnAddDevice"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/bg_add_button_small"
        android:src="@drawable/ic_add_24"
        android:contentDescription="Cihaz ekle"
        android:scaleType="center"
        android:padding="12dp"
        app:tint="?attr/colorOnSurface"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvMaintenance"
        app:layout_constraintBottom_toBottomOf="@id/tvMaintenance" />

</androidx.constraintlayout.widget.ConstraintLayout>