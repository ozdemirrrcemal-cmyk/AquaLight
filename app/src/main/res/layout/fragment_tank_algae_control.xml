<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <ScrollView
        android:id="@+id/algaeOverviewScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_14"
            android:paddingTop="@dimen/aqua_size_16"
            android:paddingEnd="@dimen/aqua_size_14"
            android:paddingBottom="@dimen/aqua_size_32">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Metric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_160"
                        android:columnCount="2"
                        android:rowCount="2">

                        <ImageView
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="@dimen/aqua_size_0"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/algae_green_spot" />

                        <ImageView
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="@dimen/aqua_size_0"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/algae_black_beard" />

                        <ImageView
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="@dimen/aqua_size_0"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/algae_brown_diatom" />

                        <ImageView
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="@dimen/aqua_size_0"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/algae_hair_thread" />

                    </GridLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_16"
                        android:layout_marginTop="@dimen/aqua_size_16"
                        android:layout_marginEnd="@dimen/aqua_size_16"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/algae_control_hero_title"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body_xlarge"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_16"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:layout_marginEnd="@dimen/aqua_size_16"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="@dimen/aqua_size_2"
                        android:text="@string/algae_control_hero_subtitle"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body_small" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNewObservation"
                        style="@style/Widget.Aqua.Button.CatalogAdd"
                        android:layout_marginStart="@dimen/aqua_size_14"
                        android:layout_marginTop="@dimen/aqua_size_16"
                        android:layout_marginEnd="@dimen/aqua_size_14"
                        android:text="@string/algae_control_add_observation" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:includeFontPadding="false"
                android:text="@string/algae_control_observations_title"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body_xlarge"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Metric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_18">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/algae_control_observations_empty_title"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/algae_control_observations_empty_subtitle"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body_small" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:includeFontPadding="false"
                android:text="@string/algae_control_common_types_title"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body_xlarge"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/commonAlgaeRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_8"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_18"
                app:strokeColor="@color/aqua_status_success">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_14">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/algae_control_tip_title"
                        android:textColor="@color/aqua_accent_positive"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="@dimen/aqua_size_2"
                        android:text="@string/algae_control_tip_body"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body_small" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <ScrollView
        android:id="@+id/algaeObservationScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_14"
            android:paddingTop="@dimen/aqua_size_16"
            android:paddingEnd="@dimen/aqua_size_14"
            android:paddingBottom="@dimen/aqua_size_32">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/algae_control_type_title"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body_xlarge"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_4"
                android:includeFontPadding="false"
                android:text="@string/algae_control_type_subtitle"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_body_small" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Aqua.Input.Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_12"
                android:hint="@string/algae_control_search_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAlgaeSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/algaeTypeRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:includeFontPadding="false"
                android:text="@string/algae_control_location_title"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body_xlarge"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_4"
                android:includeFontPadding="false"
                android:text="@string/algae_control_location_subtitle"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_body_small" />

            <GridLayout
                android:id="@+id/locationGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10"
                android:columnCount="3">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLocationFront"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="@dimen/aqua_size_3"
                    android:layout_marginBottom="@dimen/aqua_size_6"
                    android:text="@string/algae_location_front_glass"
                    android:textSize="@dimen/aqua_text_size_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLocationBack"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="@dimen/aqua_size_3"
                    android:layout_marginEnd="@dimen/aqua_size_3"
                    android:layout_marginBottom="@dimen/aqua_size_6"
                    android:text="@string/algae_location_back_glass"
                    android:textSize="@dimen/aqua_text_size_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLocationSide"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="@dimen/aqua_size_3"
                    android:layout_marginBottom="@dimen/aqua_size_6"
                    android:text="@string/algae_location_side_glass"
                    android:textSize="@dimen/aqua_text_size_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLocationPlants"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="@dimen/aqua_size_3"
                    android:layout_marginBottom="@dimen/aqua_size_6"
                    android:text="@string/algae_location_plants"
                    android:textSize="@dimen/aqua_text_size_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLocationWood"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="@dimen/aqua_size_3"
                    android:layout_marginEnd="@dimen/aqua_size_3"
                    android:layout_marginBottom="@dimen/aqua_size_6"
                    android:text="@string/algae_location_root_wood"
                    android:textSize="@dimen/aqua_text_size_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLocationRocks"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="@dimen/aqua_size_3"
                    android:layout_marginBottom="@dimen/aqua_size_6"
                    android:text="@string/algae_location_rocks"
                    android:textSize="@dimen/aqua_text_size_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLocationSubstrate"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="@dimen/aqua_size_3"
                    android:text="@string/algae_location_substrate"
                    android:textSize="@dimen/aqua_text_size_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLocationEquipment"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="@dimen/aqua_size_3"
                    android:layout_marginEnd="@dimen/aqua_size_3"
                    android:text="@string/algae_location_equipment"
                    android:textSize="@dimen/aqua_text_size_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLocationWaterColumn"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="@dimen/aqua_size_3"
                    android:layout_marginTop="@dimen/aqua_size_6"
                    android:text="@string/algae_location_water_column"
                    android:textSize="@dimen/aqua_text_size_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLocationOther"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="@dimen/aqua_size_3"
                    android:text="@string/algae_location_other"
                    android:textSize="@dimen/aqua_text_size_caption" />

            </GridLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:includeFontPadding="false"
                android:text="@string/algae_control_density_title"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body_xlarge"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_4"
                android:includeFontPadding="false"
                android:text="@string/algae_control_density_subtitle"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_body_small" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDensityLow"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_marginEnd="@dimen/aqua_size_3"
                    android:layout_weight="1"
                    android:text="@string/algae_density_low"
                    android:textSize="@dimen/aqua_text_size_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDensityMedium"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_marginStart="@dimen/aqua_size_3"
                    android:layout_marginEnd="@dimen/aqua_size_3"
                    android:layout_weight="1"
                    android:text="@string/algae_density_medium"
                    android:textSize="@dimen/aqua_text_size_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDensityHigh"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_marginStart="@dimen/aqua_size_3"
                    android:layout_weight="1"
                    android:text="@string/algae_density_high"
                    android:textSize="@dimen/aqua_text_size_caption" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:includeFontPadding="false"
                android:text="@string/algae_control_trend_title"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body_xlarge"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_4"
                android:includeFontPadding="false"
                android:text="@string/algae_control_trend_subtitle"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_body_small" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrendIncreasing"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_marginEnd="@dimen/aqua_size_3"
                    android:layout_weight="1"
                    android:text="@string/algae_trend_increasing"
                    android:textSize="@dimen/aqua_text_size_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrendStable"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_marginStart="@dimen/aqua_size_3"
                    android:layout_marginEnd="@dimen/aqua_size_3"
                    android:layout_weight="1"
                    android:text="@string/algae_trend_stable"
                    android:textSize="@dimen/aqua_text_size_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrendDecreasing"
                    style="@style/Widget.Aqua.Button.Secondary.Compact"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_44"
                    android:layout_marginStart="@dimen/aqua_size_3"
                    android:layout_weight="1"
                    android:text="@string/algae_trend_decreasing"
                    android:textSize="@dimen/aqua_text_size_caption" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:includeFontPadding="false"
                android:text="@string/algae_control_note_title"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body_xlarge"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Aqua.Input.Layout.Multiline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_8"
                android:hint="@string/algae_control_note_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etObservationNote"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/aqua_size_96"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="500" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnalyze"
                style="@style/Widget.Aqua.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_52"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:enabled="false"
                android:text="@string/algae_control_analyze" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_8"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/algae_control_analysis_data_note"
                android:textColor="@color/aqua_content_muted"
                android:textSize="@dimen/aqua_text_size_caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackToOverview"
                style="@style/Widget.Aqua.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_48"
                android:layout_marginTop="@dimen/aqua_size_12"
                android:text="@string/algae_control_back_to_overview" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>
