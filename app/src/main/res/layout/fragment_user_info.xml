<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/userInfoLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fitsSystemWindows="true"
    tools:context=".ui.tabs.settings.userinfo.UserInfoFragment">

    <!-- HEADER -->
<include
    android:id="@+id/appHeader"
    layout="@layout/layout_aqua_header"
    android:layout_width="@dimen/aqua_size_0"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <!-- CONTENT -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        android:paddingBottom="@dimen/aqua_size_24"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_10"
            android:paddingTop="@dimen/aqua_size_16"
            android:paddingEnd="@dimen/aqua_size_10"
            android:paddingBottom="@dimen/aqua_size_140">

            <!-- PROFILE -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfile"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_size_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_16">

                    <FrameLayout
                        android:layout_width="@dimen/aqua_size_64"
                        android:layout_height="@dimen/aqua_size_64"
                        android:background="@drawable/profile_background">

                        <ImageView
                            android:id="@+id/ivUserPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="@dimen/aqua_size_2"
                            android:background="@drawable/profile_clip_circle"
                            android:clickable="true"
                            android:clipToOutline="true"
                            android:contentDescription="@string/user_info_photo_desc"
                            android:focusable="true"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_profile_placeholder" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_12"
                        android:text="@string/user_info_name_default"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_4"
                        android:text="@string/user_info_email_default"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- USERNAME -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUsername"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_size_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_12">

                    <!-- LABEL -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user_info_username_hint"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro" />

                    <!-- INPUT -->

                    <EditText
                        style="@style/Widget.Aqua.Input.PlainEditText.Embedded"
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/user_info_username_hint"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLength="20"
                        android:maxLines="1"
                        android:padding="@dimen/aqua_size_0"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold"
                        android:contentDescription="@string/user_info_username_desc" />

                    <!-- ERROR -->

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvUsernameError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:textColor="@color/snackbar_error"
                        android:textSize="@dimen/aqua_text_size_caption"
                        android:visibility="gone"
                        tools:text="Username required" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ADDRESS -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAddress"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/rowAddress"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/aqua_size_56"
                    android:clickable="true"
                    android:contentDescription="@string/user_info_address_desc"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/aqua_size_16">

                    <ImageView
                        android:layout_width="@dimen/aqua_size_20"
                        android:layout_height="@dimen/aqua_size_20"
                        android:layout_marginEnd="@dimen/aqua_size_12"
                        android:contentDescription="@string/user_info_location_icon_desc"
                        android:src="@drawable/ic_location"
                        app:tint="@color/aqua_card_text_secondary" />

                    <TextView
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/user_info_address_label"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body_xlarge" />

                    <ImageView
                        android:layout_width="@dimen/aqua_size_20"
                        android:layout_height="@dimen/aqua_size_20"
                        android:contentDescription="@string/user_info_arrow_desc"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SAVE -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.Aqua.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_button_height"
                android:layout_marginTop="@dimen/aqua_size_32"
                android:text="@string/user_info_save_button"
                android:contentDescription="@string/user_info_save_button_desc" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>