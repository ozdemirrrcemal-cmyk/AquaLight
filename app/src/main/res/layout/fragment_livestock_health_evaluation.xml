<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/evaluationScroll"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/aqua_size_20"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/evaluationActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_16"
            android:paddingTop="@dimen/aqua_size_10"
            android:paddingEnd="@dimen/aqua_size_16">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:strokeColor="@color/dialog_icon_warning"
                app:strokeWidth="@dimen/aqua_size_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_size_14">

                    <FrameLayout
                        android:layout_width="@dimen/aqua_size_46"
                        android:layout_height="@dimen/aqua_size_46">

                        <ImageView
                            android:id="@+id/ivEvaluationLivestockIcon"
                            android:layout_width="@dimen/aqua_size_36"
                            android:layout_height="@dimen/aqua_size_36"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_life_fish_24"
                            app:tint="@color/dialog_icon_warning" />

                        <ImageView
                            android:layout_width="@dimen/aqua_size_16"
                            android:layout_height="@dimen/aqua_size_16"
                            android:layout_gravity="end|bottom"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_warning" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.Status.WarningBodyBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/livestock_health_change_control_title" />

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                            android:id="@+id/tvEvaluationSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_4"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="@dimen/aqua_size_2" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/aqua_size_14"
                    android:paddingTop="@dimen/aqua_size_12"
                    android:paddingEnd="@dimen/aqua_size_10"
                    android:paddingBottom="@dimen/aqua_size_8">

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodyBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/livestock_health_used_data_title" />

                    <LinearLayout
                        android:id="@+id/rowLastWaterMeasurement"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_58"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/aqua_size_24"
                            android:layout_height="@dimen/aqua_size_24"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_water_test_wave_24" />

                        <LinearLayout
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_10"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodySmallBold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/livestock_health_last_water_measurement" />

                            <TextView android:textAppearance="@style/TextAppearance.Aqua.Content.MutedMicro"
                                android:id="@+id/tvEvaluationWaterValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/aqua_size_2"
                                android:includeFontPadding="false"
                                android:text="@string/livestock_health_last_water_measurement_value" />

                        </LinearLayout>

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.Status.WarningMicro"
                            android:id="@+id/tvEvaluationWaterBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/aqua_size_24"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingStart="@dimen/aqua_size_7"
                            android:paddingEnd="@dimen/aqua_size_7"
                            android:text="@string/livestock_health_old_data_badge" />

                        <ImageView
                            android:layout_width="@dimen/aqua_size_20"
                            android:layout_height="@dimen/aqua_size_20"
                            android:layout_marginStart="@dimen/aqua_size_4"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tank_health_chevron_right_24"
                            app:tint="@color/aqua_content_secondary" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_1"
                        android:background="@color/aqua_card_divider" />

                    <LinearLayout
                        android:id="@+id/rowLastWaterChange"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_58"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/aqua_size_24"
                            android:layout_height="@dimen/aqua_size_24"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_care_water_change_24" />

                        <LinearLayout
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_10"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodySmallBold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/livestock_health_last_water_change" />

                            <TextView android:textAppearance="@style/TextAppearance.Aqua.Content.MutedMicro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/aqua_size_2"
                                android:includeFontPadding="false"
                                android:text="@string/livestock_health_last_water_change_value" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/aqua_size_20"
                            android:layout_height="@dimen/aqua_size_20"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tank_health_chevron_right_24"
                            app:tint="@color/aqua_content_secondary" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEvaluationDataNotice"
                style="@style/Widget.Aqua.Card.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10"
                app:strokeColor="@color/dialog_icon_warning">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_size_12">

                    <ImageView
                        android:layout_width="@dimen/aqua_size_22"
                        android:layout_height="@dimen/aqua_size_22"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_warning" />

                    <LinearLayout
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryCaptionBold"
                            android:id="@+id/tvEvaluationDataNoticeTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/livestock_health_fresh_measurement_warning_title" />

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryMicro"
                            android:id="@+id/tvEvaluationDataNoticeBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_2"
                            android:includeFontPadding="false"
                            android:text="@string/livestock_health_fresh_measurement_warning" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryTitleSmallBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:includeFontPadding="false"
                android:text="@string/livestock_health_check_first_title" />

            <TextView android:textAppearance="@style/TextAppearance.Aqua.Content.MutedMicro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_3"
                android:includeFontPadding="false"
                android:text="@string/livestock_health_check_first_subtitle" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_size_12">

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.Accent.DefaultBold"
                        android:layout_width="@dimen/aqua_size_28"
                        android:layout_height="@dimen/aqua_size_28"
                        android:gravity="center"
                        android:text="@string/livestock_health_step_number_1" />

                    <ImageView
                        android:id="@+id/ivCheckOne"
                        android:layout_width="@dimen/aqua_size_24"
                        android:layout_height="@dimen/aqua_size_24"
                        android:layout_marginStart="@dimen/aqua_size_6"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_water_test_wave_24" />

                    <LinearLayout
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodySmallBold"
                            android:id="@+id/tvCheckOneTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false" />

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                            android:id="@+id/tvCheckOneBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_3"
                            android:includeFontPadding="false" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_size_12">

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.Accent.DefaultBold"
                        android:layout_width="@dimen/aqua_size_28"
                        android:layout_height="@dimen/aqua_size_28"
                        android:gravity="center"
                        android:text="@string/livestock_health_step_number_2" />

                    <ImageView
                        android:id="@+id/ivCheckTwo"
                        android:layout_width="@dimen/aqua_size_24"
                        android:layout_height="@dimen/aqua_size_24"
                        android:layout_marginStart="@dimen/aqua_size_6"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_health_observation_fin_gill_24" />

                    <LinearLayout
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodySmallBold"
                            android:id="@+id/tvCheckTwoTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false" />

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                            android:id="@+id/tvCheckTwoBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_3"
                            android:includeFontPadding="false" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_size_12">

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.Accent.DefaultBold"
                        android:layout_width="@dimen/aqua_size_28"
                        android:layout_height="@dimen/aqua_size_28"
                        android:gravity="center"
                        android:text="@string/livestock_health_step_number_3" />

                    <ImageView
                        android:id="@+id/ivCheckThree"
                        android:layout_width="@dimen/aqua_size_24"
                        android:layout_height="@dimen/aqua_size_24"
                        android:layout_marginStart="@dimen/aqua_size_6"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_health_livestock_24" />

                    <LinearLayout
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodySmallBold"
                            android:id="@+id/tvCheckThreeTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false" />

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                            android:id="@+id/tvCheckThreeBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_3"
                            android:includeFontPadding="false" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_size_12">

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.Accent.DefaultBold"
                        android:layout_width="@dimen/aqua_size_28"
                        android:layout_height="@dimen/aqua_size_28"
                        android:gravity="center"
                        android:text="@string/livestock_health_step_number_4" />

                    <ImageView
                        android:id="@+id/ivCheckFour"
                        android:layout_width="@dimen/aqua_size_24"
                        android:layout_height="@dimen/aqua_size_24"
                        android:layout_marginStart="@dimen/aqua_size_6"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_health_observation_appetite_24" />

                    <LinearLayout
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodySmallBold"
                            android:id="@+id/tvCheckFourTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false" />

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                            android:id="@+id/tvCheckFourBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_3"
                            android:includeFontPadding="false" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_size_12">

                    <ImageView
                        android:layout_width="@dimen/aqua_size_22"
                        android:layout_height="@dimen/aqua_size_22"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info" />

                    <LinearLayout
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryCaptionBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/livestock_health_evaluation_basis_title" />

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryMicro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_2"
                            android:includeFontPadding="false"
                            android:text="@string/livestock_health_evaluation_basis_body" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView android:textAppearance="@style/TextAppearance.Aqua.Content.MutedMicro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/aqua_size_2"
                android:text="@string/livestock_health_evaluation_helper" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/evaluationActions"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/aqua_size_16"
        android:layout_marginEnd="@dimen/aqua_size_16"
        android:layout_marginBottom="@dimen/aqua_size_16"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewFollowup"
            style="@style/Widget.Aqua.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_48"
            android:text="@string/livestock_health_evaluation_start_followup" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
