<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notificationPermissionSheetRoot"
    style="@style/Widget.Aqua.BottomSheet.Root"
    android:gravity="center_horizontal">

    <View
        style="@style/Widget.Aqua.BottomSheet.Handle"
        android:layout_marginBottom="18dp" />

    <ImageView
        android:id="@+id/imgNotificationIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_bottomsheet_icon_surface"
        android:padding="14dp"
        android:src="@drawable/ic_notification"
        android:contentDescription="@string/notifications_permission_icon_description"
        app:tint="@color/aqua_bottom_sheet_text_primary" />

    <TextView
        android:id="@+id/tvDialogTitle"
        style="@style/TextAppearance.Aqua.BottomSheet.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notifications_permission_title"
        android:gravity="center"
        android:layout_marginTop="18dp"
        android:labelFor="@id/tvDialogMessage" />

    <TextView
        android:id="@+id/tvDialogMessage"
        style="@style/TextAppearance.Aqua.BottomSheet.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notifications_permission_message_info"
        android:gravity="center"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="18dp" />

    <LinearLayout
        android:id="@+id/layoutWifiBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:layout_marginBottom="10dp">

        <ImageView
            android:id="@+id/imgWifi"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_wifi"
            app:tint="@color/aqua_bottom_sheet_text_primary"
            android:contentDescription="@string/notifications_permission_wifi_icon_description" />

        <TextView
            android:id="@+id/tvWifiMessage"
            style="@style/TextAppearance.Aqua.BottomSheet.RowSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/notifications_permission_message_wifi"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutAquariumBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:layout_marginBottom="18dp">

        <ImageView
            android:id="@+id/imgAquarium"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_aquarium_notifications"
            app:tint="@color/aqua_bottom_sheet_text_primary"
            android:contentDescription="@string/notifications_permission_aquarium_icon_description" />

        <TextView
            android:id="@+id/tvAquariumMessage"
            style="@style/TextAppearance.Aqua.BottomSheet.RowSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/notifications_permission_message_aquarium"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSettings"
        style="@style/Widget.Aqua.BottomSheet.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/notifications_permission_button_open_settings" />

</LinearLayout>
