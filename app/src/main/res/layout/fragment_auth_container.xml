<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The visual backdrop deliberately reaches behind status, cutout and navigation areas. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/videoBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/aqua_system_bar_surface"
        app:resize_mode="zoom"
        app:use_controller="false" />

    <ImageView
        android:id="@+id/posterImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/main_login_video_background_description"
        android:scaleType="centerCrop"
        android:src="@drawable/aquarium_poster" />

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/main_login_blur_overlay_description"
        android:visibility="gone" />

    <!-- These scrims are resized to the real system-bar insets at runtime. -->
    <View
        android:id="@+id/authTopSystemBarScrim"
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_0"
        android:layout_gravity="top"
        android:background="@color/aqua_overlay_scrim_strong"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/authBottomSystemBarScrim"
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_0"
        android:layout_gravity="bottom"
        android:background="@color/aqua_overlay_scrim_strong"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- Only interactive/meaningful foreground content receives safe drawing and IME insets. -->
    <FrameLayout
        android:id="@+id/authSafeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/authBranding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_marginStart="@dimen/aqua_size_24"
            android:layout_marginTop="@dimen/aqua_size_24"
            android:gravity="start"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="@dimen/aqua_size_80"
                android:layout_height="@dimen/aqua_size_80"
                android:contentDescription="@string/main_login_logo_description"
                android:src="@drawable/logo_login" />

            <TextView
                android:id="@+id/tvAquaLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:text="@string/splasch_app_title"
                android:textColor="@color/aqua_tv_aqua_light_content"
                android:textSize="@dimen/aqua_text_size_title_medium" />

            <TextView
                android:id="@+id/tvNatureAquarium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/raleway_medium"
                android:includeFontPadding="false"
                android:text="@string/splasch_app_subtitle"
                android:textColor="@color/aqua_tv_nature_aquarium_content"
                android:textSize="@dimen/aqua_text_size_body_large" />

        </LinearLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/auth_nav_host"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/main_login_fragment_container_description"
            app:defaultNavHost="false"
            app:navGraph="@navigation/nav_graph_auth" />

    </FrameLayout>

</FrameLayout>
