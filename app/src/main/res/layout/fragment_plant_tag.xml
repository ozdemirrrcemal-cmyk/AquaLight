<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/aqua_space_value_24"
        android:layout_marginTop="@dimen/aqua_space_value_10"
        android:layout_marginEnd="@dimen/aqua_space_value_24"
        android:lineSpacingExtra="@dimen/aqua_space_value_3"
        android:text="@string/aquarium_text_tap_on_the_aquarium_photo_to_select_and_tag_the_plants_used"
        android:textColor="@color/aqua_palette_8fa4be"
        android:textSize="@dimen/aqua_text_size_body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardImage"
        android:layout_width="0dp"
        android:layout_height="@dimen/aqua_size_value_240"
        android:layout_marginStart="@dimen/aqua_space_value_24"
        android:layout_marginTop="@dimen/aqua_space_value_22"
        android:layout_marginEnd="@dimen/aqua_space_value_24"
        app:cardCornerRadius="@dimen/aqua_radius_value_20"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDescription"
        app:strokeWidth="0dp">

        <FrameLayout
            android:id="@+id/imageTouchArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgAquariumPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/aquarium_content_desc_aquarium_photo"
                android:scaleType="centerCrop"
                android:src="@drawable/nature_aquarium" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/aqua_palette_22000000" />

            <FrameLayout
                android:id="@+id/markerContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:id="@+id/plantListScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/aqua_space_value_20"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/aqua_space_value_24"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardImage">

        <LinearLayout
            android:id="@+id/plantListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_space_value_24"
            android:paddingEnd="@dimen/aqua_space_value_24"
            android:paddingBottom="@dimen/aqua_space_value_28" />

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>