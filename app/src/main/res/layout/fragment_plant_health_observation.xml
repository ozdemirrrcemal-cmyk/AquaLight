<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_16"
            android:paddingTop="@dimen/aqua_size_8"
            android:paddingEnd="@dimen/aqua_size_16"
            android:paddingBottom="@dimen/aqua_size_24">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_size_12">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Aqua.Card.Inline"
                        android:layout_width="@dimen/aqua_size_56"
                        android:layout_height="@dimen/aqua_size_56"
                        app:cardBackgroundColor="@color/aqua_surface_deep"
                        app:cardCornerRadius="@dimen/aqua_size_12"
                        app:cardElevation="@dimen/aqua_size_0">

                        <ImageView
                            android:id="@+id/imgPlant"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_health_plant_24"
                            app:tint="@null" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPlantName"
                            android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodySmallBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            tools:text="Anubias barteri var. caladiifolia" />

                        <TextView
                            android:id="@+id/tvPlantCategory"
                            android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_3"
                            tools:text="Epiphyte" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryTitleSmallBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_16"
                android:text="@string/plant_health_observation_question" />

            <TextView
                android:textAppearance="@style/TextAppearance.Aqua.Content.MutedCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_3"
                android:text="@string/plant_health_observation_helper" />

            <LinearLayout
                android:id="@+id/symptomGridContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10"
                android:orientation="vertical" />

            <TextView
                android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodyBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_16"
                android:text="@string/plant_health_note_optional" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_112"
                android:layout_marginTop="@dimen/aqua_size_8">

                <EditText
                    android:id="@+id/etNote"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/aqua_color_transparent"
                    android:gravity="top|start"
                    android:hint="@string/plant_health_note_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="500"
                    android:padding="@dimen/aqua_size_12"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textColorHint="@color/aqua_content_muted"
                    android:textSize="@dimen/aqua_text_size_body_small" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_52"
                android:layout_marginTop="@dimen/aqua_size_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/aqua_size_14"
                    android:paddingEnd="@dimen/aqua_size_14">

                    <ImageView
                        android:layout_width="@dimen/aqua_size_24"
                        android:layout_height="@dimen/aqua_size_24"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_camera_24"
                        app:tint="@color/aqua_content_secondary" />

                    <TextView
                        android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryBodySmall"
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_10"
                        android:layout_weight="1"
                        android:text="@string/plant_health_photo_add" />

                    <TextView
                        android:textAppearance="@style/TextAppearance.Aqua.Accent.TitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_plus" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartAnalysis"
                style="@style/Widget.Aqua.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_48"
                android:layout_marginTop="@dimen/aqua_size_16"
                android:enabled="false"
                android:text="@string/plant_health_analysis_start" />

            <TextView
                android:textAppearance="@style/TextAppearance.Aqua.Content.MutedMicro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_8"
                android:gravity="center"
                android:text="@string/plant_health_analysis_deferred" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
