<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">
    <include
        android:id="@+id/appHeader" layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toTopOf="@id/saveBar">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/aqua_size_16">
            <include
                android:id="@+id/plantIdentity" layout="@layout/layout_plant_health_identity" />
            <TextView
                android:id="@+id/tvQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryTitleSmallBold"
                android:text="@string/plant_health_observation_question"
                android:layout_marginTop="@dimen/aqua_size_12" />
            <TextView
                android:id="@+id/tvHelper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Aqua.Content.MutedCaption"
                android:text="@string/plant_health_observation_helper" />
            <LinearLayout
                android:id="@+id/symptomGridContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/aqua_size_10" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Aqua.Content.MutedMicro"
                android:text="@string/plant_health_symptom_image_note" />
            <TextView
                android:id="@+id/tvNoteLabel"
                android:labelFor="@id/etNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodySmallBold"
                android:text="@string/plant_health_note_optional"
                android:layout_marginTop="@dimen/aqua_size_12" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_8">
                <EditText
                    android:id="@+id/etNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/aqua_size_96"
                    android:background="@color/aqua_color_transparent"
                    android:gravity="top|start"
                    android:hint="@string/plant_health_note_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="4000"
                    android:padding="@dimen/aqua_size_12"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textColorHint="@color/aqua_content_muted"
                    android:textSize="@dimen/aqua_text_size_body_small" />
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:id="@+id/tvValidation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                android:text="@string/plant_health_other_requires_note"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite" />
            <TextView
                android:id="@+id/tvPhotoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodySmallBold"
                android:text="@string/plant_health_photo_optional"
                android:layout_marginTop="@dimen/aqua_size_12" />
            <TextView
                android:id="@+id/tvPhotoHelper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Aqua.Content.MutedCaption"
                android:text="@string/plant_health_photo_helper" />
            <LinearLayout
                android:id="@+id/photoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/aqua_size_8" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/saveBar"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/aqua_size_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:id="@+id/tvSaveError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
            android:text="@string/plant_health_save_failed"
            android:visibility="gone"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveObservation"
            style="@style/Widget.Aqua.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/aqua_size_48"
            android:layout_marginTop="@dimen/aqua_size_8"
            android:text="@string/plant_health_save" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
