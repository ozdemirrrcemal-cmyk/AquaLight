<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_color">

    <!-- Üst Başlık ve Kapat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Device"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_dark_onSurface" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/md_theme_dark_onSurface" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/device_menu_main"
        android:textColor="@color/settings_text_secondary"
        android:textStyle="bold"
        android:paddingTop="20dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:id="@+id/rowMainLight"
        style="@style/Aqua.DeviceMenuRow" />

    <LinearLayout
        android:id="@+id/rowMainTimer"
        style="@style/Aqua.DeviceMenuRow" />

    <LinearLayout
        android:id="@+id/rowMainTemperature"
        style="@style/Aqua.DeviceMenuRow" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/device_menu_settings"
        android:textColor="@color/settings_text_secondary"
        android:textStyle="bold"
        android:paddingTop="20dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:id="@+id/rowSettingsWifi"
        style="@style/Aqua.DeviceMenuRow" />

    <LinearLayout
        android:id="@+id/rowSettingsTime"
        style="@style/Aqua.DeviceMenuRow" />

    <LinearLayout
        android:id="@+id/rowSettingsGeneral"
        style="@style/Aqua.DeviceMenuRow" />

    <LinearLayout
        android:id="@+id/rowSettingsPwm"
        style="@style/Aqua.DeviceMenuRow" />

    <LinearLayout
        android:id="@+id/rowSettingsNet"
        style="@style/Aqua.DeviceMenuRow" />
		
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/device_menu_tools"
        android:textColor="@color/settings_text_secondary"
        android:textStyle="bold"
        android:paddingTop="20dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:id="@+id/rowToolsFilesystem"
        style="@style/Aqua.DeviceMenuRow" />

    <LinearLayout
        android:id="@+id/rowToolsReboot"
        style="@style/Aqua.DeviceMenuRow" />

    <LinearLayout
        android:id="@+id/rowToolsInfo"
        style="@style/Aqua.DeviceMenuRow" />

    <LinearLayout
        android:id="@+id/rowToolsAbout"
        style="@style/Aqua.DeviceMenuRow" />

</LinearLayout>