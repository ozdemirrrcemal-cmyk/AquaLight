<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/presetOptionsSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_light_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="18dp"
    android:paddingEnd="22dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_light_sheet_handle" />

    <TextView
        android:id="@+id/tvPresetSheetTitle"
        style="@style/TextAppearance.Aqua.Light.SheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        tools:text="@string/light_preset_options_preview_title" />

    <TextView
        android:id="@+id/tvPresetSheetSubtitle"
        style="@style/TextAppearance.Aqua.Light.SheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="@string/light_preset_options_preview_subtitle" />

    <LinearLayout
        android:id="@+id/rowApplyPreset"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_light_program_time_panel"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            style="@style/TextAppearance.Aqua.Light.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/light_preset_options_apply_to_device" />

        <TextView
            style="@style/TextAppearance.Aqua.Light.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_chevron_right" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowDeletePreset"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_light_program_time_panel"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            style="@style/TextAppearance.Aqua.Light.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/common_delete" />

        <TextView
            style="@style/TextAppearance.Aqua.Light.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_close_symbol" />

    </LinearLayout>

</LinearLayout>