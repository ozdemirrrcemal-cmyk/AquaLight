<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/presetOptionsSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_light_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="18dp"
    android:paddingEnd="22dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_light_sheet_handle" />
		
<TextView
    android:id="@+id/tvPresetSheetTitle"
    style="@style/TextAppearance.Aqua.Light.SheetTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="22dp"
    android:text="Plant Growth" />

<TextView
    android:id="@+id/tvPresetSheetSubtitle"
    style="@style/TextAppearance.Aqua.Light.SheetSubtitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="R90 · G75 · B45 · W90" />

    <LinearLayout
        android:id="@+id/rowApplyPreset"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_light_program_time_panel"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            style="@style/TextAppearance.Aqua.Light.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Apply to Device" />

        <TextView
            style="@style/TextAppearance.Aqua.Light.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="→" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowDeletePreset"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_light_program_time_panel"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            style="@style/TextAppearance.Aqua.Light.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Delete" />

        <TextView
            style="@style/TextAppearance.Aqua.Light.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="×" />

    </LinearLayout>

</LinearLayout>