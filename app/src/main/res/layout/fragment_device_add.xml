<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".ui.tabs.devices.add.DeviceAddFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="@dimen/aqua_size_16"
        android:paddingTop="@dimen/aqua_size_10"
        android:paddingEnd="@dimen/aqua_size_16"
        android:paddingBottom="@dimen/aqua_size_24"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/aqua_size_24"
                app:cardElevation="@dimen/aqua_size_0"
                app:strokeWidth="@dimen/aqua_size_0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_aqua_state_container"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/aqua_size_18"
                    android:paddingTop="@dimen/aqua_size_18"
                    android:paddingEnd="@dimen/aqua_size_18"
                    android:paddingBottom="@dimen/aqua_size_18">

                    <TextView
                        style="@style/Widget.Aqua.Chip.Status.Scan"
                        android:id="@+id/tvScanBadge"
                        tools:text="Ready" />

                    <com.aqua.aqualight.ui.tabs.devices.add.DeviceScanPulseView
                        android:id="@+id/scanPulseView"
                        android:layout_width="@dimen/aqua_size_150"
                        android:layout_height="@dimen/aqua_size_150"
                        android:layout_marginTop="@dimen/aqua_size_4" />

                    <TextView
                        android:id="@+id/tvHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/aqua_state_text_primary"
                        android:textSize="@dimen/aqua_text_size_section_title"
                        android:textStyle="bold"
                        tools:text="Add AquaLight securely" />

                    <TextView
                        android:id="@+id/tvHeroSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:gravity="center"
                        android:lineSpacingExtra="@dimen/aqua_size_2"
                        android:textColor="@color/aqua_state_text_secondary"
                        android:textSize="@dimen/aqua_text_size_state_body"
                        tools:text="Use QR for first setup. Use manual scan only after opening setup mode on the device." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQrSetup"
                        
                style="@style/Widget.Aqua.Button.Primary"
                android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_button_height"
                        android:layout_marginTop="@dimen/aqua_size_20"
                        android:text="@string/device_add_scan_secure_qr_action"
                        android:textAllCaps="false"
                        android:textSize="@dimen/aqua_text_size_body_large"
                        android:textStyle="bold"
                        app:cornerRadius="@dimen/aqua_size_17"
                        app:icon="@drawable/ic_qr_code_24"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/aqua_size_8" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScan"
                        
                style="@style/Widget.Aqua.Button.Secondary"
                android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_button_height"
                        android:layout_marginTop="@dimen/aqua_size_10"
                        android:text="@string/device_add_scan_button"
                        android:textAllCaps="false"
                        android:textSize="@dimen/aqua_text_size_body_large"
                        android:textStyle="bold"
                        app:cornerRadius="@dimen/aqua_size_17"
                        app:icon="@drawable/ic_radar"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/aqua_size_8" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tipContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_12"
                style="@style/Widget.Aqua.Card.Device">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/device_add_setup_rules_title"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_7"
                        android:lineSpacingExtra="@dimen/aqua_size_2"
                        android:text="@string/device_add_setup_rules_message"
                        android:textColor="@color/aqua_state_text_secondary"
                        android:textSize="@dimen/aqua_text_size_caption_plus" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvFoundDevicesLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_4"
                android:includeFontPadding="false"
                android:text="@string/device_add_available_devices_title"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_title_small"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvFoundDevicesHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_6"
                android:lineSpacingExtra="@dimen/aqua_size_2"
                android:text="@string/device_add_manual_scan_hint"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_caption_plus"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCandidates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_12"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone"
                tools:itemCount="2"
                tools:listitem="@layout/item_device_add_candidate"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
