<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/aqua_space_value_32">

    <TextView
        android:id="@+id/tvUnsupportedTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="@dimen/aqua_text_size_title_large"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvUnsupportedMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_space_value_12"
        android:gravity="center"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="@dimen/aqua_text_size_body" />

</LinearLayout>