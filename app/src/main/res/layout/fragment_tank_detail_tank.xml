<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tankDetailTankScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="@dimen/aqua_size_14"
    android:paddingTop="@dimen/aqua_size_16"
    android:paddingEnd="@dimen/aqua_size_14"
    android:paddingBottom="@dimen/aqua_size_120"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/tankSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTankHealth"
            style="@style/Widget.Aqua.Card.Metric"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_86"
            android:layout_marginBottom="@dimen/aqua_size_16"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:strokeColor="@color/aqua_status_success"
            app:strokeWidth="@dimen/aqua_size_2">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/aqua_size_14"
                android:paddingEnd="@dimen/aqua_size_12">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card.Inline"
                    android:id="@+id/cardTankHealthIcon"
                    android:layout_width="@dimen/aqua_size_44"
                    android:layout_height="@dimen/aqua_size_44"
                    app:cardBackgroundColor="@color/aqua_surface_positive"
                    app:cardCornerRadius="@dimen/aqua_size_22"
                    app:cardElevation="@dimen/aqua_size_0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="@dimen/aqua_size_22"
                        android:layout_height="@dimen/aqua_size_22"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_health_heart_24"
                        app:tint="@color/aqua_status_success" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvTankHealthTitle"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/aqua_size_12"
                    android:includeFontPadding="false"
                    android:text="@string/tank_health_entry_title"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/tvTankHealthSummary"
                    app:layout_constraintEnd_toStartOf="@id/cardTankHealthScore"
                    app:layout_constraintStart_toEndOf="@id/cardTankHealthIcon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tvTankHealthSummary"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/aqua_size_12"
                    android:layout_marginTop="@dimen/aqua_size_3"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/tank_health_entry_summary"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_body_small"
                    app:layout_constraintBottom_toTopOf="@id/tvTankHealthLastAnalysis"
                    app:layout_constraintEnd_toStartOf="@id/cardTankHealthScore"
                    app:layout_constraintStart_toEndOf="@id/cardTankHealthIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvTankHealthTitle" />

                <TextView
                    android:id="@+id/tvTankHealthLastAnalysis"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/aqua_size_12"
                    android:layout_marginTop="@dimen/aqua_size_3"
                    android:includeFontPadding="false"
                    android:text="@string/tank_health_entry_last_analysis"
                    android:textColor="@color/aqua_content_muted"
                    android:textSize="@dimen/aqua_text_size_caption"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/cardTankHealthScore"
                    app:layout_constraintStart_toEndOf="@id/cardTankHealthIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvTankHealthSummary" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card.Inline"
                    android:id="@+id/cardTankHealthScore"
                    android:layout_width="@dimen/aqua_size_40"
                    android:layout_height="@dimen/aqua_size_40"
                    android:layout_marginEnd="@dimen/aqua_size_8"
                    app:cardBackgroundColor="@color/aqua_color_transparent"
                    app:cardCornerRadius="@dimen/aqua_size_20"
                    app:cardElevation="@dimen/aqua_size_0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivTankHealthArrow"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/aqua_status_success"
                    app:strokeWidth="@dimen/aqua_size_2">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/tank_health_entry_score"
                        android:textColor="@color/aqua_status_success"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

                <ImageView
                    android:id="@+id/ivTankHealthArrow"
                    android:layout_width="@dimen/aqua_size_20"
                    android:layout_height="@dimen/aqua_size_20"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_right"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/aqua_card_text_secondary" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <GridLayout
            android:id="@+id/tankSummaryGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Metric"
                android:id="@+id/cardTankDays"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="@dimen/aqua_size_72"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/aqua_size_5"
                android:layout_marginBottom="@dimen/aqua_size_10"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/aqua_size_12"
                    android:paddingEnd="@dimen/aqua_size_8">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/aquarium_days_title"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro_caption" />

                    <TextView
                        android:id="@+id/tvTankDaysValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/aquarium_text_0_days"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Metric"
                android:id="@+id/cardTankValue"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="@dimen/aqua_size_72"
                android:layout_columnWeight="1"
                android:layout_marginStart="@dimen/aqua_size_5"
                android:layout_marginEnd="@dimen/aqua_size_5"
                android:layout_marginBottom="@dimen/aqua_size_10"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/aqua_size_12"
                    android:paddingEnd="@dimen/aqua_size_8">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/aquarium_volume_title"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro_caption" />

                    <TextView
                        android:id="@+id/tvTankVolumeValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/aquarium_text_79_gal"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Metric"
                android:id="@+id/cardTankSize"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="@dimen/aqua_size_72"
                android:layout_columnWeight="1"
                android:layout_marginStart="@dimen/aqua_size_5"
                android:layout_marginBottom="@dimen/aqua_size_10"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/aqua_size_12"
                    android:paddingEnd="@dimen/aqua_size_8">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/aquarium_size_title"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro_caption" />

                    <TextView
                        android:id="@+id/tvTankSizeValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/aquarium_text_120x50x50"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body_small"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Metric"
                android:id="@+id/cardTankType"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="@dimen/aqua_size_72"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/aqua_size_5"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/aqua_size_12"
                    android:paddingEnd="@dimen/aqua_size_8">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/aquarium_type_title"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro_caption" />

                    <TextView
                        android:id="@+id/tvTankTypeValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/aquarium_tank_type_shrimp"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Metric"
                android:id="@+id/cardTankSetup"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="@dimen/aqua_size_72"
                android:layout_columnWeight="1"
                android:layout_marginStart="@dimen/aqua_size_5"
                android:layout_marginEnd="@dimen/aqua_size_5"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/aqua_size_12"
                    android:paddingEnd="@dimen/aqua_size_8">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/aquarium_setup_title"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro_caption" />

                    <TextView
                        android:id="@+id/tvTankSetupDateValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/aquarium_text_17_may_26"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body_small"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Metric"
                android:id="@+id/cardTankStyle"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="@dimen/aqua_size_72"
                android:layout_columnWeight="1"
                android:layout_marginStart="@dimen/aqua_size_5"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/aqua_size_12"
                    android:paddingEnd="@dimen/aqua_size_8">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/aquarium_style_title"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro_caption" />

                    <TextView
                        android:id="@+id/tvTankStyleValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/aquarium_style_mountain"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body_small"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <TextView
            android:id="@+id/tvComponentsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_16"
            android:includeFontPadding="false"
            android:text="@string/aquarium_components_title"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body_xlarge"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTankBioTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_14"
            android:includeFontPadding="false"
            android:text="@string/aquarium_material_group_bio"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body_small" />

        <LinearLayout
            android:id="@+id/tankBioComponentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_8"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvTankHardwareTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_14"
            android:includeFontPadding="false"
            android:text="@string/aquarium_material_group_hardware"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body_small" />

        <LinearLayout
            android:id="@+id/tankHardwareComponentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_8"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>