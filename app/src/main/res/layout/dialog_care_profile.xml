<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/careProfileBottomSheetRoot"
  style="@style/Widget.Aqua.BottomSheet.Root"
  android:layout_height="match_parent">

  <View
    style="@style/Widget.Aqua.BottomSheet.Handle"
    android:layout_marginBottom="16dp" />

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="42dp">

    <TextView
      android:id="@+id/tvCareProfileTitle"
      style="@style/TextAppearance.Aqua.BottomSheet.SectionTitle"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:text="@string/aquarium_text_care_profile" />

    <TextView
      android:id="@+id/btnCloseCareProfile"
      android:layout_width="42dp"
      android:layout_height="42dp"
      android:layout_gravity="end|center_vertical"
      android:gravity="center"
      android:includeFontPadding="false"
      android:text="@string/common_close"
      android:textColor="@color/aqua_bottom_sheet_text_primary"
      android:textSize="30sp" />
  </FrameLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:orientation="horizontal">

    <TextView
      style="@style/TextAppearance.Aqua.BottomSheet.RowTitle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/aquarium_text_progress" />

    <TextView
      android:id="@+id/tvCareProfilePercent"
      style="@style/TextAppearance.Aqua.BottomSheet.RowTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/aquarium_text_0percent" />
  </LinearLayout>

  <FrameLayout
    android:id="@+id/careProgressTrack"
    android:layout_width="match_parent"
    android:layout_height="5dp"
    android:layout_marginTop="14dp">

    <View
      android:id="@+id/careProgressFill"
      android:layout_width="0dp"
      android:layout_height="match_parent" />
  </FrameLayout>

  <TextView
    android:id="@+id/tvCareProfileSummary"
    style="@style/TextAppearance.Aqua.BottomSheet.RowSubtitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="@string/aquarium_text_0_of_0_care_details_completed" />

  <TextView
    android:id="@+id/tvCareProfileDescription"
    style="@style/TextAppearance.Aqua.BottomSheet.Subtitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:lineSpacingExtra="3dp"
    android:text="@string/aquarium_text_complete_your_aquarium_profile_to_get_more_accurate_automati" />

  <androidx.core.widget.NestedScrollView
    android:id="@+id/careProfileItemsScroll"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="8dp"
    android:layout_weight="1"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:overScrollMode="never"
    android:paddingBottom="12dp"
    android:scrollbars="none">

    <LinearLayout
      android:id="@+id/careProfileItemsContainer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical" />
  </androidx.core.widget.NestedScrollView>

</LinearLayout>
