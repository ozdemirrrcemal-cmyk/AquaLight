<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@android:color/black">

    <!-- 🎬 ExoPlayer video arka plan -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/videoBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        android:keepScreenOn="true"
        app:resize_mode="zoom"
        android:contentDescription="@string/main_login_video_background_description" />

    <!-- 🧊 Blur efekti (tam ekran canlı render) -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.75"
        android:fitsSystemWindows="false"
        android:contentDescription="@string/main_login_blur_overlay_description" />

    <!-- 🌊 Üst kısım: Logo + yazılar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginTop="48dp"
        android:layout_marginStart="32dp"
        android:gravity="start">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo_login"
            android:contentDescription="@string/main_login_logo_description"
            android:importantForAccessibility="no"
            android:layout_marginBottom="8dp" />

        <!-- AquaLight -->
        <TextView
            android:id="@+id/tvAquaLight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_login_app_name"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="22sp"
            android:fontFamily="@font/poppins_bold"
            android:includeFontPadding="false" />

        <!-- Nature Aquarium -->
        <TextView
            android:id="@+id/tvNatureAquarium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_login_tagline"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="15sp"
            android:fontFamily="@font/raleway_medium"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- 🔘 Alt kısım: Giriş butonları -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingHorizontal="24dp"
        android:paddingBottom="36dp">

        <!-- Google ile giriş -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/login_google"
            android:contentDescription="@string/login_google_desc"
            style="@style/WhiteButton"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btnSignIn"
            android:layout_marginBottom="12dp" />

        <!-- Giriş yap -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignIn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/login_sign_in"
            android:contentDescription="@string/login_sign_in_desc"
            style="@style/RedButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btnRegister"
            android:layout_marginBottom="12dp" />

        <!-- Kayıt ol -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/login_register"
            android:contentDescription="@string/login_register_desc"
            style="@style/BlackButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>