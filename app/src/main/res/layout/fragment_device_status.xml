<?xml version="1.0" encoding="utf-8"?>  <androidx.constraintlayout.widget.ConstraintLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/background_color"
tools:context=".ui.tabs.settings.device.DeviceStatusFragment">

<!-- HEADER -->
<include
    android:id="@+id/appHeader"
    layout="@layout/layout_aqua_header"
    android:layout_width="@dimen/aqua_size_0"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

<!-- DEVICES RECYCLER -->
<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/rvDevices"
    android:layout_width="@dimen/aqua_size_0"
    android:layout_height="@dimen/aqua_size_0"

    android:layout_marginTop="@dimen/aqua_size_8"

    android:paddingStart="@dimen/aqua_size_3"
    android:paddingEnd="@dimen/aqua_size_3"
    android:paddingBottom="@dimen/aqua_size_20"

    android:clipToPadding="false"
    android:overScrollMode="never"

    tools:listitem="@layout/item_device_status"

    app:layout_constraintTop_toBottomOf="@id/appHeader"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"/>

<com.google.android.material.card.MaterialCardView
    style="@style/Widget.Aqua.Card.Inline"
    android:id="@+id/emptyStateContainer"
    android:layout_width="@dimen/aqua_size_0"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/aqua_size_28"
    android:layout_marginEnd="@dimen/aqua_size_28"
    android:visibility="gone"
    app:cardBackgroundColor="@color/aqua_state_container_surface"
    app:cardCornerRadius="@dimen/aqua_size_24"
    app:cardElevation="@dimen/aqua_size_0"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/appHeader"
    app:layout_constraintVertical_bias="0.48"
    app:strokeColor="@color/aqua_state_container_outline"
    app:strokeWidth="@dimen/aqua_size_1"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/aqua_size_22"
        android:paddingTop="@dimen/aqua_size_24"
        android:paddingEnd="@dimen/aqua_size_22"
        android:paddingBottom="@dimen/aqua_size_24">

        <TextView
            android:id="@+id/tvEmptyDeviceStatusTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/device_status_empty_title"
            android:textColor="@color/aqua_state_text_primary"
            android:textSize="@dimen/aqua_text_size_state_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptyDeviceStatusMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_10"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="@dimen/aqua_size_3"
            android:text="@string/device_status_empty_message"
            android:textColor="@color/aqua_state_text_secondary"
            android:textSize="@dimen/aqua_text_size_state_body" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>