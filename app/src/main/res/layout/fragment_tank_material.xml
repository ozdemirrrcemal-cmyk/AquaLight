<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/materialRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/aqua_size_20"
        android:paddingEnd="@dimen/aqua_size_20"
        android:paddingTop="@dimen/aqua_size_8"
        android:paddingBottom="@dimen/aqua_size_24">
		
        <TextView
            android:id="@+id/tvStepDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_8"
            android:text="@string/aquarium_text_add_the_biological_materials_and_hardware_used_in_this_aquar"
            android:textColor="@color/aqua_palette_hex_8fa4be"
            android:textSize="@dimen/aqua_text_size_body"
            android:lineSpacingExtra="@dimen/aqua_size_3" />

        <TextView
            android:id="@+id/tvBioTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_26"
            android:text="@string/aquarium_material_group_bio"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/aqua_text_size_body_large"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/bioContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_12"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvHardwareTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_26"
            android:text="@string/aquarium_material_group_hardware"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/aqua_text_size_body_large"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/hardwareContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_12"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>