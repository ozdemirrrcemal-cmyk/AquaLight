<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/maintenanceRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/background_color">

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/headerContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_color"
    android:elevation="8dp"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp"
    app:layout_constraintTop_toTopOf="parent">

    <TextView
      android:id="@+id/tvMaintenanceTitle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:includeFontPadding="false"
      android:text="Maintenance"
      android:textColor="?attr/colorOnSurface"
      android:textSize="24sp"
      android:textStyle="bold"
      app:layout_constraintBottom_toBottomOf="@id/btnAddCareTask"
      app:layout_constraintEnd_toStartOf="@id/btnAddCareTask"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="@id/btnAddCareTask" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnAddCareTask"
      android:layout_width="94dp"
      android:layout_height="42dp"
      android:insetTop="0dp"
      android:insetBottom="0dp"
      android:text="+ Add"
      android:textAllCaps="false"
      android:textColor="?attr/colorOnSurface"
      android:textSize="13sp"
      android:textStyle="bold"
      app:backgroundTint="#1C3252"
      app:cornerRadius="21dp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

    <HorizontalScrollView
      android:id="@+id/tabsScrollView"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:fillViewport="true"
      android:overScrollMode="never"
      android:scrollbars="none"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/btnAddCareTask">

      <LinearLayout
        android:id="@+id/tabsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/tabAll"
          android:layout_width="0dp"
          android:layout_height="38dp"
          android:layout_marginEnd="8dp"
          android:layout_weight="1"
          android:background="@drawable/bg_maintenance_tab_selected"
          android:gravity="center"
          android:includeFontPadding="false"
          android:text="All"
          android:textColor="@android:color/white"
          android:textSize="13sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tabToday"
          android:layout_width="0dp"
          android:layout_height="38dp"
          android:layout_marginEnd="8dp"
          android:layout_weight="1"
          android:background="@drawable/bg_maintenance_tab_unselected"
          android:gravity="center"
          android:includeFontPadding="false"
          android:text="Today"
          android:textColor="#8FA4BE"
          android:textSize="13sp" />

        <TextView
          android:id="@+id/tabUpcoming"
          android:layout_width="0dp"
          android:layout_height="38dp"
          android:layout_marginEnd="8dp"
          android:layout_weight="1"
          android:background="@drawable/bg_maintenance_tab_unselected"
          android:gravity="center"
          android:includeFontPadding="false"
          android:text="Upcoming"
          android:textColor="#8FA4BE"
          android:textSize="13sp" />

        <TextView
          android:id="@+id/tabHistory"
          android:layout_width="0dp"
          android:layout_height="38dp"
          android:layout_weight="1"
          android:background="@drawable/bg_maintenance_tab_unselected"
          android:gravity="center"
          android:includeFontPadding="false"
          android:text="History"
          android:textColor="#8FA4BE"
          android:textSize="13sp" />

      </LinearLayout>

    </HorizontalScrollView>

  </androidx.constraintlayout.widget.ConstraintLayout>

 <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/rvCareTasks"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="110dp"
    android:scrollbars="none"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/headerContainer" />
	
	
	<ScrollView
    android:id="@+id/historyScrollView"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="110dp"
    android:scrollbars="none"
    android:visibility="gone"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/headerContainer">

  <LinearLayout
    android:id="@+id/historyTimelineContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" />

</ScrollView>

  <LinearLayout
    android:id="@+id/emptyStateContainer"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:visibility="gone"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/headerContainer">

    <FrameLayout
      android:layout_width="76dp"
      android:layout_height="76dp"
      android:background="@drawable/bg_maintenance_empty_icon_circle">

      <ImageView
        android:id="@+id/ivEmptyMaintenanceIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_care_water_change_24"
        app:tint="#2196F3" />

    </FrameLayout>

    <TextView
      android:id="@+id/tvEmptyMaintenanceTitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="18dp"
      android:gravity="center"
      android:includeFontPadding="false"
      android:text="No care tasks yet"
      android:textColor="?attr/colorOnSurface"
      android:textSize="17sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/tvEmptyMaintenanceMessage"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:gravity="center"
      android:includeFontPadding="false"
      android:lineSpacingExtra="3dp"
      android:text="Add manual reminders or let AquaLight create smart care tasks based on your aquarium setup."
      android:textColor="#8FA4BE"
      android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnEmptyAddCareTask"
      android:layout_width="180dp"
      android:layout_height="46dp"
      android:layout_marginTop="22dp"
      android:insetTop="0dp"
      android:insetBottom="0dp"
      android:text="+ Add Task"
      android:textAllCaps="false"
      android:textColor="@android:color/white"
      android:textSize="13sp"
      android:textStyle="bold"
      app:backgroundTint="#2196F3"
      app:cornerRadius="23dp" />

  </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>