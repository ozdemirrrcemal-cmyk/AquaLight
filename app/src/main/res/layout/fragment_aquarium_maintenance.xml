<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/maintenanceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <HorizontalScrollView
        android:id="@+id/tabsScrollView"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/aqua_size_16"
        android:layout_marginTop="@dimen/aqua_size_18"
        android:layout_marginEnd="@dimen/aqua_size_16"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:id="@+id/tabsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="@dimen/aqua_size_38"
                android:layout_marginEnd="@dimen/aqua_size_8"
                android:layout_weight="1"
                android:background="@drawable/bg_maintenance_tab_selected"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/maintenance_tab_all"
                android:textColor="@color/aqua_content_on_dark"
                android:textSize="@dimen/aqua_text_size_body_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabToday"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="@dimen/aqua_size_38"
                android:layout_marginEnd="@dimen/aqua_size_8"
                android:layout_weight="1"
                android:background="@drawable/bg_maintenance_tab_unselected"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/maintenance_tab_today"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_caption" />

            <TextView
                android:id="@+id/tabUpcoming"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="@dimen/aqua_size_38"
                android:layout_marginEnd="@dimen/aqua_size_8"
                android:layout_weight="1"
                android:background="@drawable/bg_maintenance_tab_unselected"
                android:contentDescription="@string/maintenance_tab_upcoming"
                android:gravity="center"
                android:includeFontPadding="false"
                android:tag="@id/aqua_large_font_maintenance_tab_next"
                android:text="@string/maintenance_tab_upcoming"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_body_small" />

            <TextView
                android:id="@+id/tabHistory"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="@dimen/aqua_size_38"
                android:layout_weight="1"
                android:background="@drawable/bg_maintenance_tab_unselected"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/maintenance_tab_history"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_body_small" />

        </LinearLayout>

    </HorizontalScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCareProfileWarning"
        style="@style/Widget.Aqua.Card.Metric"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_72"
        android:layout_marginStart="@dimen/aqua_size_16"
        android:layout_marginTop="@dimen/aqua_size_14"
        android:layout_marginEnd="@dimen/aqua_size_16"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabsScrollView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/aqua_size_16"
            android:paddingEnd="@dimen/aqua_size_14">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.IconAccent"
                android:layout_width="@dimen/aqua_size_40"
                android:layout_height="@dimen/aqua_size_40">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/maintenance_warning_icon"
                    android:textColor="@color/aqua_content_warning"
                    android:textSize="@dimen/aqua_text_size_title_small"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/aqua_size_14"
                android:layout_marginEnd="@dimen/aqua_size_10"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCareProfileWarningTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/maintenance_care_profile_incomplete"
                    android:textColor="@color/aqua_content_on_dark"
                    android:textSize="@dimen/aqua_text_size_body_small"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCareProfileWarningMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_7"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/maintenance_improve_automatic_care_tasks"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_micro_plus" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCareProfileWarningPercent"
                android:layout_width="@dimen/aqua_size_48"
                android:layout_height="@dimen/aqua_size_28"
                android:background="@drawable/bg_maintenance_profile_percent_warning"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/aqua_content_warning"
                android:textSize="@dimen/aqua_text_size_caption"
                android:textStyle="bold"
                tools:text="@string/maintenance_percent_preview" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCareTasks"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/aqua_size_16"
        android:paddingTop="@dimen/aqua_size_16"
        android:paddingEnd="@dimen/aqua_size_16"
        android:paddingBottom="@dimen/aqua_size_90"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardCareProfileWarning" />

    <ScrollView
        android:id="@+id/historyScrollView"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/aqua_size_16"
        android:paddingTop="@dimen/aqua_size_16"
        android:paddingEnd="@dimen/aqua_size_16"
        android:paddingBottom="@dimen/aqua_size_90"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardCareProfileWarning">

        <LinearLayout
            android:id="@+id/historyTimelineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <LinearLayout
        android:id="@+id/emptyStateContainer"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/aqua_size_28"
        android:layout_marginEnd="@dimen/aqua_size_28"
        android:background="@drawable/bg_aqua_state_container"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/aqua_size_28"
        android:paddingTop="@dimen/aqua_size_24"
        android:paddingEnd="@dimen/aqua_size_28"
        android:paddingBottom="@dimen/aqua_size_24"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardCareProfileWarning">

        <FrameLayout
            android:layout_width="@dimen/aqua_size_76"
            android:layout_height="@dimen/aqua_size_76"
            android:background="@drawable/bg_maintenance_empty_icon_circle">

            <ImageView
                android:id="@+id/ivEmptyMaintenanceIcon"
                android:layout_width="@dimen/aqua_size_38"
                android:layout_height="@dimen/aqua_size_38"
                android:layout_gravity="center"
                android:src="@drawable/ic_care_water_change_24"
                app:tint="@color/aqua_accent_primary" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvEmptyMaintenanceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_18"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/maintenance_empty_no_tasks_title"
            android:textColor="@color/aqua_state_text_primary"
            android:textSize="@dimen/aqua_text_size_state_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptyMaintenanceMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_10"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="@dimen/aqua_size_3"
            android:text="@string/maintenance_empty_no_tasks_message"
            android:textColor="@color/aqua_state_text_secondary"
            android:textSize="@dimen/aqua_text_size_state_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptyAddCareTask"
            style="@style/Widget.Aqua.Button.Primary"
            android:layout_width="@dimen/aqua_size_180"
            android:layout_height="@dimen/aqua_button_height"
            android:layout_marginTop="@dimen/aqua_size_22"
            android:contentDescription="@string/maintenance_action_add_care_task"
            android:tag="@id/aqua_large_font_maintenance_action_add"
            android:text="@string/maintenance_action_add_task"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
