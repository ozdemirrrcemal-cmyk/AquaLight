<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/acclimationRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_light_bottom_sheet_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/light_stroke" />

    <TextView
        android:id="@+id/tvAcclimationSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:text="Acclimation"
        android:textColor="?attr/colorOnSurface"
        android:textSize="21sp" />

    <TextView
        android:id="@+id/tvAcclimationSheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:lineSpacingExtra="2dp"
        android:text="Gradually increase light intensity to protect new plants, shrimp or fish."
        android:textColor="@color/settings_text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAcclimationEnabled"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="@color/light_surface_deep"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/light_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/rowAcclimationEnabled"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardBackgroundColor="@color/light_chip_auto"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/light_accent"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="↗"
                    android:textColor="@color/light_accent"
                    android:textSize="17sp" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text="Enable Acclimation"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvAcclimationEnabledDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Apply reduced output temporarily"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAcclimationEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAcclimationDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/light_surface_deep"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/light_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvAcclimationDurationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:text="Duration"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAcclimationDurationValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:text="7 days"
                android:textColor="@color/light_accent"
                android:textSize="26sp" />

            <LinearLayout
                android:id="@+id/acclimationDurationRow"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAcclimation3Days"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_light_editor_chip_unselected"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="3 days"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipAcclimation7Days"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_light_editor_chip_selected"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="7 days"
                    android:textColor="@color/background_color"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipAcclimation14Days"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_light_editor_chip_unselected"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="14 days"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAcclimationStartIntensity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/light_surface_deep"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/light_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvAcclimationStartLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:text="Start Intensity"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAcclimationStartValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:text="40%"
                android:textColor="@color/light_accent"
                android:textSize="30sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderAcclimationStart"
                style="@style/Widget.Aqua.Light.Slider.Master"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:value="40"
                android:valueFrom="20"
                android:valueTo="80" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvAcclimationSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="2dp"
        android:text="Starts at 40% and gradually reaches full program intensity over 7 days."
        android:textColor="@color/settings_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btnAcclimationSave"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_light_primary_action"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="Save Acclimation"
        android:textColor="@color/background_color"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btnAcclimationCancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="Cancel"
        android:textColor="@color/settings_text_secondary"
        android:textSize="14sp" />

</LinearLayout>