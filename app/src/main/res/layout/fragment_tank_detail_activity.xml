<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/activityRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/background_color">

  <ScrollView
    android:id="@+id/activityScrollView"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="@dimen/aqua_space_value_14"
    android:paddingEnd="@dimen/aqua_space_value_14"
    android:paddingTop="@dimen/aqua_space_value_16"
    android:paddingBottom="@dimen/aqua_space_value_120"
    android:scrollbars="none"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
      android:id="@+id/activityContentContainer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <GridLayout
        android:id="@+id/activitySummaryGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2">

        <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Aqua.Card.Metric"
          android:layout_width="0dp"
          android:layout_height="@dimen/aqua_size_value_74"
          android:layout_columnWeight="1"
          android:layout_marginEnd="@dimen/aqua_space_value_7"
          android:layout_marginBottom="@dimen/aqua_space_value_8">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_space_value_12"
            android:paddingEnd="@dimen/aqua_space_value_12">

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center"
              android:includeFontPadding="false"
              android:text="@string/aquarium_text_last_trim"
              android:textColor="@color/aqua_card_text_secondary"
              android:textSize="@dimen/aqua_text_size_caption" />

            <TextView
              android:id="@+id/tvLastTrimValue"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/aqua_space_value_9"
              android:gravity="center"
              android:includeFontPadding="false"
              android:text="@string/aquarium_text_days_ago"
              android:textColor="@color/aqua_palette_5fd6b4"
              android:textSize="@dimen/aqua_text_size_caption"
              android:textStyle="bold" />

          </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Aqua.Card.Metric"
          android:layout_width="0dp"
          android:layout_height="@dimen/aqua_size_value_74"
          android:layout_columnWeight="1"
          android:layout_marginStart="@dimen/aqua_space_value_7"
          android:layout_marginBottom="@dimen/aqua_space_value_8">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_space_value_12"
            android:paddingEnd="@dimen/aqua_space_value_12">

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center"
              android:includeFontPadding="false"
              android:text="@string/aquarium_text_last_water_change"
              android:textColor="@color/aqua_card_text_secondary"
              android:textSize="@dimen/aqua_text_size_caption" />

            <TextView
              android:id="@+id/tvLastWaterChangeValue"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/aqua_space_value_9"
              android:gravity="center"
              android:includeFontPadding="false"
              android:text="@string/aquarium_text_days_ago"
              android:textColor="@color/aqua_palette_5fd6b4"
              android:textSize="@dimen/aqua_text_size_caption"
              android:textStyle="bold" />

          </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Aqua.Card.Metric"
          android:layout_width="0dp"
          android:layout_height="@dimen/aqua_size_value_74"
          android:layout_columnWeight="1"
          android:layout_marginEnd="@dimen/aqua_space_value_7">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_space_value_8"
            android:paddingEnd="@dimen/aqua_space_value_8">

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center"
              android:includeFontPadding="false"
              android:text="@string/aquarium_text_next_care"
              android:textColor="@color/aqua_card_text_secondary"
              android:textSize="@dimen/aqua_text_size_micro" />

            <TextView
              android:id="@+id/tvNextCareTaskTitle"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/aqua_space_value_6"
              android:ellipsize="end"
              android:gravity="center"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:text="@string/aquarium_text_value"
              android:textColor="@color/aqua_palette_f2c94c"
              android:textSize="@dimen/aqua_text_size_micro_label"
              android:textStyle="bold" />

            <TextView
              android:id="@+id/tvNextCareValue"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/aqua_space_value_4"
              android:ellipsize="end"
              android:gravity="center"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:text="@string/aquarium_text_value"
              android:textColor="@color/aqua_card_text_secondary"
              android:textSize="@dimen/aqua_text_size_micro_tight" />

          </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Aqua.Card.Metric"
          android:layout_width="0dp"
          android:layout_height="@dimen/aqua_size_value_74"
          android:layout_columnWeight="1"
          android:layout_marginStart="@dimen/aqua_space_value_7">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_space_value_12"
            android:paddingEnd="@dimen/aqua_space_value_12">

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center"
              android:includeFontPadding="false"
              android:text="@string/aquarium_text_last_filter_main"
              android:textColor="@color/aqua_card_text_secondary"
              android:textSize="@dimen/aqua_text_size_caption" />

            <TextView
              android:id="@+id/tvLastFilterValue"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/aqua_space_value_9"
              android:gravity="center"
              android:includeFontPadding="false"
              android:text="@string/aquarium_text_days_ago"
              android:textColor="@color/aqua_palette_5fd6b4"
              android:textSize="@dimen/aqua_text_size_caption"
              android:textStyle="bold" />

          </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

      </GridLayout>

      <TextView
        android:id="@+id/tvTimelineTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_space_value_16"
        android:includeFontPadding="false"
        android:text="@string/aquarium_text_timeline"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="@dimen/aqua_text_size_body_large"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/tvTimelineEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_space_value_14"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/aquarium_no_activity_yet"
        android:textColor="@color/aqua_card_text_secondary"
        android:textSize="@dimen/aqua_text_size_body_small"
        android:visibility="gone" />

      <LinearLayout
        android:id="@+id/activityTimelineContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_space_value_12"
        android:orientation="vertical" />

    </LinearLayout>

  </ScrollView>

  <com.google.android.material.card.MaterialCardView
    android:id="@+id/btnAddActivity"
    android:layout_width="@dimen/aqua_size_value_170"
    android:layout_height="@dimen/aqua_size_value_58"
    android:layout_marginBottom="@dimen/aqua_space_value_86"
    android:clickable="true"
    android:elevation="@dimen/aqua_elevation_value_18"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/aqua_palette_1c3252"
    app:cardElevation="0dp"
    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Aqua.DockedActivityButton"
    app:strokeColor="@color/aqua_palette_2c4b72"
    app:strokeWidth="@dimen/aqua_stroke_value_1"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:paddingStart="@dimen/aqua_space_value_2"
      android:paddingEnd="@dimen/aqua_space_value_6">

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/addActivityIconCircle"
        android:layout_width="@dimen/aqua_size_value_40"
        android:layout_height="@dimen/aqua_size_value_40"
        app:cardBackgroundColor="@color/aqua_palette_eaf4ff"
        app:cardCornerRadius="@dimen/aqua_radius_value_20"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
          android:layout_width="@dimen/aqua_size_value_22"
          android:layout_height="@dimen/aqua_size_value_22"
          android:layout_gravity="center"
          android:src="@drawable/ic_add_24"
          app:tint="@color/aqua_palette_2196f3" />

      </com.google.android.material.card.MaterialCardView>

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/aqua_space_value_15"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:text="@string/aquarium_text_add_activity"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="@dimen/aqua_text_size_body_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/addActivityIconCircle"
        app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

  </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>