<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/activityRoot"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <GridLayout
    android:id="@+id/activitySummaryGrid"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:columnCount="2"
    android:rowCount="2">

    <com.google.android.material.card.MaterialCardView
      android:layout_width="0dp"
      android:layout_height="74dp"
      android:layout_columnWeight="1"
      android:layout_marginEnd="7dp"
      android:layout_marginBottom="8dp"
      app:cardBackgroundColor="#10233A"
      app:cardCornerRadius="16dp"
      app:cardElevation="0dp"
      app:strokeColor="#223A57"
      app:strokeWidth="1dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:includeFontPadding="false"
          android:text="Last Trim"
          android:textColor="#8FA4BE"
          android:textSize="12sp" />

        <TextView
          android:id="@+id/tvLastTrimValue"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="9dp"
          android:gravity="center"
          android:includeFontPadding="false"
          android:text="-- days ago"
          android:textColor="#5FD6B4"
          android:textSize="12sp"
          android:textStyle="bold" />

      </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
      android:layout_width="0dp"
      android:layout_height="74dp"
      android:layout_columnWeight="1"
      android:layout_marginStart="7dp"
      android:layout_marginBottom="8dp"
      app:cardBackgroundColor="#10233A"
      app:cardCornerRadius="16dp"
      app:cardElevation="0dp"
      app:strokeColor="#223A57"
      app:strokeWidth="1dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:includeFontPadding="false"
          android:text="Last Water Change"
          android:textColor="#8FA4BE"
          android:textSize="12sp" />

        <TextView
          android:id="@+id/tvLastWaterChangeValue"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="9dp"
          android:gravity="center"
          android:includeFontPadding="false"
          android:text="-- days ago"
          android:textColor="#5FD6B4"
          android:textSize="12sp"
          android:textStyle="bold" />

      </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
      android:layout_width="0dp"
      android:layout_height="74dp"
      android:layout_columnWeight="1"
      android:layout_marginEnd="7dp"
      app:cardBackgroundColor="#10233A"
      app:cardCornerRadius="16dp"
      app:cardElevation="0dp"
      app:strokeColor="#223A57"
      app:strokeWidth="1dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:includeFontPadding="false"
          android:text="Next Care"
          android:textColor="#8FA4BE"
          android:textSize="11sp" />

        <TextView
          android:id="@+id/tvNextCareTaskTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:ellipsize="end"
          android:gravity="center"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="--"
          android:textColor="#F2C94C"
          android:textSize="10.6sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tvNextCareValue"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:ellipsize="end"
          android:gravity="center"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="--"
          android:textColor="#8FA4BE"
          android:textSize="10.4sp" />

      </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
      android:layout_width="0dp"
      android:layout_height="74dp"
      android:layout_columnWeight="1"
      android:layout_marginStart="7dp"
      app:cardBackgroundColor="#10233A"
      app:cardCornerRadius="16dp"
      app:cardElevation="0dp"
      app:strokeColor="#223A57"
      app:strokeWidth="1dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:includeFontPadding="false"
          android:text="Last Filter Main."
          android:textColor="#8FA4BE"
          android:textSize="12sp" />

        <TextView
          android:id="@+id/tvLastFilterValue"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="9dp"
          android:gravity="center"
          android:includeFontPadding="false"
          android:text="-- days ago"
          android:textColor="#5FD6B4"
          android:textSize="12sp"
          android:textStyle="bold" />

      </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

  </GridLayout>

  <TextView
    android:id="@+id/tvTimelineTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:includeFontPadding="false"
    android:text="Timeline"
    android:textColor="?attr/colorOnSurface"
    android:textSize="15sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/tvTimelineEmpty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:gravity="center"
    android:includeFontPadding="false"
    android:text="No activity yet."
    android:textColor="#8FA4BE"
    android:textSize="13sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/activityTimelineContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical" />

</LinearLayout>