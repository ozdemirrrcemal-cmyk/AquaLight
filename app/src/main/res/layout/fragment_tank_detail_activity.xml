<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/activityRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/background_color">

  <ScrollView
    android:id="@+id/activityScrollView"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="16dp"
    android:paddingBottom="120dp"
    android:scrollbars="none"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
      android:id="@+id/activityContentContainer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <GridLayout
        android:id="@+id/activitySummaryGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2">

        <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Aqua.Card.Metric"
          android:layout_width="0dp"
          android:layout_height="74dp"
          android:layout_columnWeight="1"
          android:layout_marginEnd="7dp"
          android:layout_marginBottom="8dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center"
              android:includeFontPadding="false"
              android:text="@string/aquarium_text_last_trim"
              android:textColor="@color/aqua_card_text_secondary"
              android:textSize="12sp" />

            <TextView
              android:id="@+id/tvLastTrimValue"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="9dp"
              android:gravity="center"
              android:includeFontPadding="false"
              android:text="@string/aquarium_text_days_ago"
              android:textColor="#5FD6B4"
              android:textSize="12sp"
              android:textStyle="bold" />

          </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Aqua.Card.Metric"
          android:layout_width="0dp"
          android:layout_height="74dp"
          android:layout_columnWeight="1"
          android:layout_marginStart="7dp"
          android:layout_marginBottom="8dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center"
              android:includeFontPadding="false"
              android:text="@string/aquarium_text_last_water_change"
              android:textColor="@color/aqua_card_text_secondary"
              android:textSize="12sp" />

            <TextView
              android:id="@+id/tvLastWaterChangeValue"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="9dp"
              android:gravity="center"
              android:includeFontPadding="false"
              android:text="@string/aquarium_text_days_ago"
              android:textColor="#5FD6B4"
              android:textSize="12sp"
              android:textStyle="bold" />

          </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Aqua.Card.Metric"
          android:layout_width="0dp"
          android:layout_height="74dp"
          android:layout_columnWeight="1"
          android:layout_marginEnd="7dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center"
              android:includeFontPadding="false"
              android:text="@string/aquarium_text_next_care"
              android:textColor="@color/aqua_card_text_secondary"
              android:textSize="11sp" />

            <TextView
              android:id="@+id/tvNextCareTaskTitle"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:ellipsize="end"
              android:gravity="center"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:text="@string/aquarium_text_value"
              android:textColor="#F2C94C"
              android:textSize="10.6sp"
              android:textStyle="bold" />

            <TextView
              android:id="@+id/tvNextCareValue"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:ellipsize="end"
              android:gravity="center"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:text="@string/aquarium_text_value"
              android:textColor="@color/aqua_card_text_secondary"
              android:textSize="10.4sp" />

          </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Aqua.Card.Metric"
          android:layout_width="0dp"
          android:layout_height="74dp"
          android:layout_columnWeight="1"
          android:layout_marginStart="7dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center"
              android:includeFontPadding="false"
              android:text="@string/aquarium_text_last_filter_main"
              android:textColor="@color/aqua_card_text_secondary"
              android:textSize="12sp" />

            <TextView
              android:id="@+id/tvLastFilterValue"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="9dp"
              android:gravity="center"
              android:includeFontPadding="false"
              android:text="@string/aquarium_text_days_ago"
              android:textColor="#5FD6B4"
              android:textSize="12sp"
              android:textStyle="bold" />

          </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

      </GridLayout>

      <TextView
        android:id="@+id/tvTimelineTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:includeFontPadding="false"
        android:text="@string/aquarium_text_timeline"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/tvTimelineEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/aquarium_no_activity_yet"
        android:textColor="@color/aqua_card_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

      <LinearLayout
        android:id="@+id/activityTimelineContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    </LinearLayout>

  </ScrollView>

  <com.google.android.material.card.MaterialCardView
    android:id="@+id/btnAddActivity"
    android:layout_width="170dp"
    android:layout_height="58dp"
    android:layout_marginBottom="86dp"
    android:clickable="true"
    android:elevation="18dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#1C3252"
    app:cardElevation="0dp"
    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Aqua.DockedActivityButton"
    app:strokeColor="#2C4B72"
    app:strokeWidth="1dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:paddingStart="2dp"
      android:paddingEnd="6dp">

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/addActivityIconCircle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardBackgroundColor="#EAF4FF"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:layout_gravity="center"
          android:src="@drawable/ic_add_24"
          app:tint="#2196F3" />

      </com.google.android.material.card.MaterialCardView>

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:text="@string/aquarium_text_add_activity"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/addActivityIconCircle"
        app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

  </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>