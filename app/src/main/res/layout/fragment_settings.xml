<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/aqua_size_16"
        android:paddingStart="@dimen/aqua_size_10"
        android:paddingEnd="@dimen/aqua_size_10"
        android:paddingBottom="@dimen/aqua_size_16">

        <!-- 🔹 Profile card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Aqua.Card.Elevated"
            android:layout_marginBottom="@dimen/aqua_size_5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/aqua_size_12">

                <FrameLayout
                    android:layout_width="@dimen/aqua_size_64"
                    android:layout_height="@dimen/aqua_size_64"
                    android:background="@drawable/profile_background">

                    <ImageView
                        android:id="@+id/ivProfilePhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/aqua_size_2"
                        android:background="@drawable/profile_clip_circle"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile_placeholder"
                        android:clipToOutline="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/settings_profile_photo_desc" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/aqua_size_16"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_default_username"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_caption"/>

                    <TextView
    android:id="@+id/tvEmail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/settings_default_email"
    android:textColor="@color/aqua_card_text_secondary"
    android:textSize="@dimen/aqua_text_size_caption"/>

<com.google.android.material.card.MaterialCardView
    style="@style/Widget.Aqua.Card.Inline"
    android:id="@+id/cardActiveDevices"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/aqua_size_8"
    app:cardCornerRadius="@dimen/aqua_size_50"
    app:cardElevation="@dimen/aqua_size_0"
    app:strokeColor="@color/aqua_card_outline_subtle"
    app:strokeWidth="@dimen/aqua_size_1">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/aqua_size_10"
        android:paddingTop="@dimen/aqua_size_5"
        android:paddingEnd="@dimen/aqua_size_10"
        android:paddingBottom="@dimen/aqua_size_5">

        <!-- Online / Offline Dot -->
        <View
            android:id="@+id/viewDeviceDot"
            android:layout_width="@dimen/aqua_size_8"
            android:layout_height="@dimen/aqua_size_8"
            android:background="@drawable/bg_online_dot" />

        <!-- Device Text -->
        <TextView
            android:id="@+id/tvActiveDevices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/aqua_size_8"
            android:text="@string/settings_active_devices_preview"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_micro"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 🔸 Menu card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Aqua.Card.Grouped">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1️⃣ User Info -->
                <LinearLayout
                    android:id="@+id/rowUserInfo"
                    android:layout_width="match_parent"
					android:layout_height="wrap_content"
                    android:minHeight="@dimen/aqua_size_56"
                    android:paddingHorizontal="@dimen/aqua_size_16"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/settings_user_info_desc">

                    <TextView
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_user_info"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body"/>

                    <ImageView
                        android:layout_width="@dimen/aqua_size_20"
                        android:layout_height="@dimen/aqua_size_20"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_arrow_desc"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/aqua_size_1"
                    android:background="@color/aqua_card_divider"/>

                <!-- 2️⃣ Device Status -->
                <LinearLayout
                    android:id="@+id/rowDeviceStatus"
                    android:layout_width="match_parent"
					android:layout_height="wrap_content"
                    android:minHeight="@dimen/aqua_size_56"
                    android:paddingHorizontal="@dimen/aqua_size_16"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/settings_device_status_desc">

                    <TextView
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_device_status"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body"/>

                    <ImageView
                        android:layout_width="@dimen/aqua_size_20"
                        android:layout_height="@dimen/aqua_size_20"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_arrow_desc"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/aqua_size_1"
                    android:background="@color/aqua_card_divider"/>
                <!-- 4️⃣ App Settings -->
                <LinearLayout
                    android:id="@+id/rowSettings"
                    android:layout_width="match_parent"
					android:layout_height="wrap_content"
                    android:minHeight="@dimen/aqua_size_56"
                    android:paddingHorizontal="@dimen/aqua_size_16"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/settings_app_desc">

                    <TextView
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_app"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body"/>

                    <ImageView
                        android:layout_width="@dimen/aqua_size_20"
                        android:layout_height="@dimen/aqua_size_20"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_arrow_desc"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/aqua_size_1"
                    android:background="@color/aqua_card_divider"/>

                <!-- 5️⃣ Usage Statistics -->
                <LinearLayout
                    android:id="@+id/rowUsage"
                    android:layout_width="match_parent"
					android:layout_height="wrap_content"
                    android:minHeight="@dimen/aqua_size_56"
                    android:paddingHorizontal="@dimen/aqua_size_16"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/settings_usage_desc">

                    <TextView
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_usage"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body"/>

                    <ImageView
                        android:layout_width="@dimen/aqua_size_20"
                        android:layout_height="@dimen/aqua_size_20"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_arrow_desc"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/aqua_size_1"
                    android:background="@color/aqua_card_divider"/>

                <!-- 6️⃣ Feedback / Support -->
                <LinearLayout
                    android:id="@+id/rowFeedback"
                    android:layout_width="match_parent"
					android:layout_height="wrap_content"
                    android:minHeight="@dimen/aqua_size_56"
                    android:paddingHorizontal="@dimen/aqua_size_16"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/settings_feedback_desc">

                    <TextView
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_feedback"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body"/>

                    <ImageView
                        android:layout_width="@dimen/aqua_size_20"
                        android:layout_height="@dimen/aqua_size_20"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_arrow_desc"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/aqua_size_1"
                    android:background="@color/aqua_card_divider"/>

                <!-- 7️⃣ Privacy and legal center -->
                <LinearLayout
                    android:id="@+id/rowLegal"
                    android:layout_width="match_parent"
					android:layout_height="wrap_content"
                    android:minHeight="@dimen/aqua_size_56"
                    android:paddingHorizontal="@dimen/aqua_size_16"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/settings_legal_desc">

                    <TextView
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_legal"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body"/>

                    <ImageView
                        android:layout_width="@dimen/aqua_size_20"
                        android:layout_height="@dimen/aqua_size_20"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_arrow_desc"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/aqua_size_1"
                    android:background="@color/aqua_card_divider"/>

                <!-- 8️⃣ About -->
                <LinearLayout
                    android:id="@+id/rowAbout"
                    android:layout_width="match_parent"
					android:layout_height="wrap_content"
                    android:minHeight="@dimen/aqua_size_56"
                    android:paddingHorizontal="@dimen/aqua_size_16"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/settings_about_desc">

                    <TextView
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_about"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body"/>

                    <ImageView
                        android:layout_width="@dimen/aqua_size_20"
                        android:layout_height="@dimen/aqua_size_20"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_arrow_desc"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/aqua_size_1"
                    android:background="@color/aqua_card_divider"/>

                <!-- 9️⃣ Logout / Account Management -->
                <LinearLayout
                    android:id="@+id/rowLogout"
                    android:layout_width="match_parent"
					android:layout_height="wrap_content"
                    android:minHeight="@dimen/aqua_size_56"
                    android:paddingHorizontal="@dimen/aqua_size_16"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/settings_logout_desc">

                    <TextView
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_logout"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body"/>

                    <ImageView
                        android:layout_width="@dimen/aqua_size_20"
                        android:layout_height="@dimen/aqua_size_20"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_arrow_desc"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 🔻 Sosyal medya ikonları (logout satırının ALTINDA) -->
        <LinearLayout
    android:id="@+id/rowSocialLinks"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:layout_marginTop="@dimen/aqua_size_25"
    android:layout_marginStart="@dimen/aqua_size_10"
    android:layout_marginEnd="@dimen/aqua_size_10">

            <ImageView
                android:id="@+id/ivSocialWebsite"
                android:layout_width="@dimen/aqua_size_48"
                android:layout_height="@dimen/aqua_size_48"
                android:src="@drawable/internet"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_social_website"/>

            <ImageView
                android:id="@+id/ivSocialFacebook"
                android:layout_width="@dimen/aqua_size_48"
                android:layout_height="@dimen/aqua_size_48"
                android:layout_marginStart="@dimen/aqua_size_24"
                android:src="@drawable/facebook"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_social_facebook"/>

            <ImageView
                android:id="@+id/ivSocialInstagram"
                android:layout_width="@dimen/aqua_size_48"
                android:layout_height="@dimen/aqua_size_48"
                android:layout_marginStart="@dimen/aqua_size_24"
                android:src="@drawable/instagram"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_social_instagram"/>

            <ImageView
                android:id="@+id/ivSocialYoutube"
                android:layout_width="@dimen/aqua_size_48"
                android:layout_height="@dimen/aqua_size_48"
                android:layout_marginStart="@dimen/aqua_size_24"
                android:src="@drawable/youtube"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_social_youtube"/>
        </LinearLayout>
		
		<!-- 🔻 Footer bilgi satırı -->
<TextView
    android:id="@+id/tvFooterInfo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/aqua_size_12"
    android:layout_marginBottom="@dimen/aqua_size_12"
    android:gravity="center"
    android:textColor="@color/aqua_card_text_secondary"
    android:textSize="@dimen/aqua_text_size_caption" />
    </LinearLayout>
</ScrollView>
