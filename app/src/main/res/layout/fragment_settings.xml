<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="16dp">

        <!-- 🔹 Profile card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Aqua.Card.Elevated"
            android:layout_marginBottom="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/profile_background">

                    <ImageView
                        android:id="@+id/ivProfilePhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:background="@drawable/profile_clip_circle"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile_placeholder"
                        android:clipToOutline="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/settings_profile_photo_desc" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_default_username"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_caption"/>

                    <TextView
    android:id="@+id/tvEmail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/settings_default_email"
    android:textColor="@color/aqua_card_text_secondary"
    android:textSize="@dimen/aqua_text_size_caption"/>

<com.google.android.material.card.MaterialCardView
    android:id="@+id/cardActiveDevices"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="50dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/aqua_card_outline_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <!-- Online / Offline Dot -->
        <View
            android:id="@+id/viewDeviceDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_online_dot" />

        <!-- Device Text -->
        <TextView
            android:id="@+id/tvActiveDevices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="3 Active Devices"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_micro"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 🔸 Menu card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Aqua.Card.Grouped">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1️⃣ User Info -->
                <LinearLayout
                    android:id="@+id/rowUserInfo"
                    android:layout_width="match_parent"
					android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/settings_user_info_desc">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_user_info"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_arrow_desc"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/aqua_card_divider"/>

                <!-- 2️⃣ Device Status -->
                <LinearLayout
                    android:id="@+id/rowDeviceStatus"
                    android:layout_width="match_parent"
					android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/settings_device_status_desc">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_device_status"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_arrow_desc"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/aqua_card_divider"/>
                <!-- 4️⃣ App Settings -->
                <LinearLayout
                    android:id="@+id/rowSettings"
                    android:layout_width="match_parent"
					android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/settings_app_desc">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_app"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_arrow_desc"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/aqua_card_divider"/>

                <!-- 5️⃣ Usage Statistics -->
                <LinearLayout
                    android:id="@+id/rowUsage"
                    android:layout_width="match_parent"
					android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/settings_usage_desc">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_usage"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_arrow_desc"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/aqua_card_divider"/>

                <!-- 6️⃣ Privacy Policy -->
                <LinearLayout
                    android:id="@+id/rowPrivacy"
                    android:layout_width="match_parent"
					android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/settings_privacy_desc">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_privacy"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_arrow_desc"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/aqua_card_divider"/>

                <!-- 7️⃣ Feedback / Support -->
                <LinearLayout
                    android:id="@+id/rowFeedback"
                    android:layout_width="match_parent"
					android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/settings_feedback_desc">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_feedback"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_arrow_desc"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/aqua_card_divider"/>

                <!-- 8️⃣ Logout / Account Management -->
                <LinearLayout
                    android:id="@+id/rowLogout"
                    android:layout_width="match_parent"
					android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/settings_logout_desc">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_logout"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_arrow_desc"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 🔻 Sosyal medya ikonları (logout satırının ALTINDA) -->
        <LinearLayout
    android:id="@+id/rowSocialLinks"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:layout_marginTop="25dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp">

            <ImageView
                android:id="@+id/ivSocialWebsite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/internet"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_social_website"/>

            <ImageView
                android:id="@+id/ivSocialFacebook"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:src="@drawable/facebook"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_social_facebook"/>

            <ImageView
                android:id="@+id/ivSocialInstagram"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:src="@drawable/instagram"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_social_instagram"/>

            <ImageView
                android:id="@+id/ivSocialYoutube"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:src="@drawable/youtube"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_social_youtube"/>
        </LinearLayout>
		
		<!-- 🔻 Footer bilgi satırı -->
<TextView
    android:id="@+id/tvFooterInfo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="12dp"
    android:gravity="center"
    android:textColor="@color/aqua_card_text_secondary"
    android:textSize="@dimen/aqua_text_size_caption" />
    </LinearLayout>
</ScrollView>