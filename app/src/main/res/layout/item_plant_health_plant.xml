<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Aqua.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/aqua_size_10"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/aqua_size_86"
        android:padding="@dimen/aqua_size_12">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/photoFrame"
            style="@style/Widget.Aqua.Card.Inline"
            android:layout_width="@dimen/aqua_size_64"
            android:layout_height="@dimen/aqua_size_64"
            app:cardBackgroundColor="@color/aqua_surface_deep"
            app:cardCornerRadius="@dimen/aqua_size_14"
            app:cardElevation="@dimen/aqua_size_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/aqua_card_outline"
            app:strokeWidth="@dimen/aqua_size_1">

            <ImageView
                android:id="@+id/imgPlant"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_health_plant_24"
                app:tint="@null" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvPlantName"
            android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodyBold"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/aqua_size_12"
            android:ellipsize="end"
            android:maxLines="2"
            app:layout_constraintEnd_toStartOf="@id/tvStatus"
            app:layout_constraintStart_toEndOf="@id/photoFrame"
            app:layout_constraintTop_toTopOf="@id/photoFrame"
            tools:text="Anubias barteri var. caladiifolia" />

        <TextView
            android:id="@+id/tvPlantMeta"
            android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/aqua_size_12"
            android:layout_marginTop="@dimen/aqua_size_6"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@id/ivArrow"
            app:layout_constraintStart_toEndOf="@id/photoFrame"
            app:layout_constraintTop_toBottomOf="@id/tvPlantName"
            tools:text="Epiphyte • Slow growth" />

        <TextView
            android:id="@+id/tvStatus"
            android:textAppearance="@style/TextAppearance.Aqua.Content.MutedStatusMicro"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/aqua_size_28"
            android:background="@drawable/bg_aqua_toolbar_pill_action_primary"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/aqua_size_10"
            android:paddingEnd="@dimen/aqua_size_10"
            android:text="@string/plant_health_status_no_observation"
            app:layout_constraintEnd_toStartOf="@id/ivArrow"
            app:layout_constraintTop_toTopOf="@id/photoFrame" />

        <ImageView
            android:id="@+id/ivArrow"
            android:layout_width="@dimen/aqua_size_20"
            android:layout_height="@dimen/aqua_size_20"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_arrow_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/aqua_card_text_secondary" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
