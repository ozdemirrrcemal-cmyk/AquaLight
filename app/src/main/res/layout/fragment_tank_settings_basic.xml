<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/basicScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="@dimen/aqua_space_value_16"
    android:paddingTop="@dimen/aqua_space_value_12"
    android:paddingEnd="@dimen/aqua_space_value_16"
    android:paddingBottom="@dimen/aqua_space_value_120"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/basicSectionRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTankPhoto"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_value_180"
            app:cardCornerRadius="@dimen/aqua_radius_value_20"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgTankPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/aquarium_content_desc_tank_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/nature_aquarium" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/aqua_palette_22000000" />

                <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card.PhotoOverlay"
                    android:id="@+id/btnChangePhoto"
                    android:layout_width="@dimen/aqua_size_value_44"
                    android:layout_height="@dimen/aqua_size_value_44"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="@dimen/aqua_space_value_14"
                    android:layout_marginBottom="@dimen/aqua_space_value_14"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    app:cardElevation="@dimen/aqua_elevation_value_4">

                    <ImageView
                        android:layout_width="@dimen/aqua_size_value_25"
                        android:layout_height="@dimen/aqua_size_value_25"
                        android:layout_gravity="center"
                        android:contentDescription="@string/aquarium_content_desc_select_photo"
                        android:src="@drawable/ic_camera_24"
                        app:tint="@android:color/white" />

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
    style="@style/Widget.Aqua.SelectionRow.Settings"
            android:id="@+id/rowTankName"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_value_60"
            android:layout_marginTop="@dimen/aqua_space_value_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/aqua_space_value_16"
                android:paddingEnd="@dimen/aqua_space_value_14">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/aquarium_tank_name_title"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSettingTankName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/aquarium_text_aquarium"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_body_small" />

                <ImageView
                    android:layout_width="@dimen/aqua_size_value_22"
                    android:layout_height="@dimen/aqua_size_value_22"
                    android:layout_marginStart="@dimen/aqua_space_value_7"
                    android:contentDescription="@string/aquarium_content_desc_open"
                    android:scaleType="center"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/aqua_card_text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
    style="@style/Widget.Aqua.SelectionRow.Settings"
            android:id="@+id/rowTankType"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_value_60"
            android:layout_marginTop="@dimen/aqua_space_value_10">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/aqua_space_value_16"
                android:paddingEnd="@dimen/aqua_space_value_14">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/aquarium_tank_type_title"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSettingTankType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/aquarium_tank_type_fish"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_body_small" />

                <ImageView
                    android:layout_width="@dimen/aqua_size_value_22"
                    android:layout_height="@dimen/aqua_size_value_22"
                    android:layout_marginStart="@dimen/aqua_space_value_7"
                    android:contentDescription="@string/aquarium_content_desc_open"
                    android:scaleType="center"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/aqua_card_text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
    style="@style/Widget.Aqua.SelectionRow.Settings"
            android:id="@+id/rowSize"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_value_60"
            android:layout_marginTop="@dimen/aqua_space_value_10">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/aqua_space_value_16"
                android:paddingEnd="@dimen/aqua_space_value_14">

                <TextView
                    android:id="@+id/tvSettingSizeTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/aquarium_tank_size_cm_title"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSettingSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/aquarium_text_10_w_x_10_l_x_10_h_2"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_body_small" />

                <ImageView
                    android:layout_width="@dimen/aqua_size_value_22"
                    android:layout_height="@dimen/aqua_size_value_22"
                    android:layout_marginStart="@dimen/aqua_space_value_7"
                    android:contentDescription="@string/aquarium_content_desc_open"
                    android:scaleType="center"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/aqua_card_text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
    style="@style/Widget.Aqua.SelectionRow.Settings"
            android:id="@+id/rowVolume"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_value_60"
            android:layout_marginTop="@dimen/aqua_space_value_10">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/aqua_space_value_16"
                android:paddingEnd="@dimen/aqua_space_value_14">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/aquarium_volume_title"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSettingVolume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/aquarium_text_1_l"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_body_small" />

                <ImageView
                    android:layout_width="@dimen/aqua_size_value_22"
                    android:layout_height="@dimen/aqua_size_value_22"
                    android:layout_marginStart="@dimen/aqua_space_value_7"
                    android:contentDescription="@string/aquarium_content_desc_open"
                    android:scaleType="center"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/aqua_card_text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
    style="@style/Widget.Aqua.SelectionRow.Settings"
            android:id="@+id/rowSetupDate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_value_60"
            android:layout_marginTop="@dimen/aqua_space_value_10">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/aqua_space_value_16"
                android:paddingEnd="@dimen/aqua_space_value_14">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/aquarium_setup_date_title"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSettingSetupDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/aquarium_text_17_may_2026"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_body_small" />

                <ImageView
                    android:layout_width="@dimen/aqua_size_value_22"
                    android:layout_height="@dimen/aqua_size_value_22"
                    android:layout_marginStart="@dimen/aqua_space_value_7"
                    android:contentDescription="@string/aquarium_content_desc_open"
                    android:scaleType="center"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/aqua_card_text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
    style="@style/Widget.Aqua.SelectionRow.Settings"
            android:id="@+id/rowStyle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_value_60"
            android:layout_marginTop="@dimen/aqua_space_value_10">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/aqua_space_value_16"
                android:paddingEnd="@dimen/aqua_space_value_14">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/aquarium_tank_style_title"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSettingStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:maxWidth="@dimen/aqua_size_value_190"
                    android:text="@string/aquarium_text_nature_aquarium"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_body_small" />

                <ImageView
                    android:layout_width="@dimen/aqua_size_value_22"
                    android:layout_height="@dimen/aqua_size_value_22"
                    android:layout_marginStart="@dimen/aqua_space_value_7"
                    android:contentDescription="@string/aquarium_content_desc_open"
                    android:scaleType="center"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/aqua_card_text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
    style="@style/Widget.Aqua.SelectionRow.Settings"
            android:id="@+id/rowIdea"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_value_60"
            android:layout_marginTop="@dimen/aqua_space_value_10">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/aqua_space_value_16"
                android:paddingEnd="@dimen/aqua_space_value_14">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/aquarium_tank_concept_title"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSettingIdea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:maxWidth="@dimen/aqua_size_value_190"
                    android:text="@string/aquarium_no_idea_added"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_body_small" />

                <ImageView
                    android:layout_width="@dimen/aqua_size_value_22"
                    android:layout_height="@dimen/aqua_size_value_22"
                    android:layout_marginStart="@dimen/aqua_space_value_7"
                    android:contentDescription="@string/aquarium_content_desc_open"
                    android:scaleType="center"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/aqua_card_text_secondary" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>