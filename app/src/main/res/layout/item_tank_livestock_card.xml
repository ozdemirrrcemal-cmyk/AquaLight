<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    style="@style/Widget.Aqua.Card.TankListItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/aqua_size_10"
    android:clickable="true"
    android:focusable="true"
>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/aqua_size_14"
        android:paddingTop="@dimen/aqua_size_12"
        android:paddingEnd="@dimen/aqua_size_14"
        android:paddingBottom="@dimen/aqua_size_12">

        <ImageView
            android:id="@+id/ivCategoryIcon"
            android:layout_width="@dimen/aqua_size_42"
            android:layout_height="@dimen/aqua_size_42"
            android:background="@drawable/bg_material_icon_box"
            android:contentDescription="@null"
            android:padding="@dimen/aqua_size_10"
            android:scaleType="centerInside"
            android:src="@drawable/ic_life_fish_24"
            app:tint="@color/aqua_content_on_dark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/aqua_size_14"
            android:layout_marginEnd="@dimen/aqua_size_10"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body"
                android:textStyle="bold"
                tools:text="Amano Karidesi" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_7"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_caption"
                tools:text="Karides • 6 adet" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_7"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_caption"
                tools:text="21 Eyl 2026 tarihinde eklendi" />

            <TextView
                android:id="@+id/tvNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_7"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_caption"
                android:visibility="gone"
                tools:text="Örnek not"
                tools:visibility="visible" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ivArrow"
            android:layout_width="@dimen/aqua_size_22"
            android:layout_height="@dimen/aqua_size_22"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/aqua_content_secondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
