<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/renameDeviceRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/light_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/light_stroke" />

    <TextView
        android:id="@+id/tvRenameDeviceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Rename Device"
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRenameDeviceSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Give this light controller a clear name."
        android:textColor="@color/settings_text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRenameInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="22dp"
        app:cardBackgroundColor="@color/light_surface_deep"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/light_stroke"
        app:strokeWidth="1dp">

        <EditText
            android:id="@+id/editLightDeviceName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="Device name"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="@color/settings_text_secondary"
            android:textSize="16sp" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvRenameDeviceHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Example: Living Room WRGB, Shrimp Tank Light, Nano Cube Light"
        android:textColor="@color/settings_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btnRenameDeviceSave"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="22dp"
        android:background="@color/light_accent"
        android:gravity="center"
        android:text="Save Name"
        android:textColor="@color/background_color"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnRenameDeviceCancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="Cancel"
        android:textColor="@color/settings_text_secondary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>