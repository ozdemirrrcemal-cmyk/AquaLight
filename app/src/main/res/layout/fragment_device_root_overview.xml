<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="@dimen/aqua_space_value_16"
        android:paddingTop="@dimen/aqua_space_value_12"
        android:paddingEnd="@dimen/aqua_space_value_16"
        android:paddingBottom="@dimen/aqua_space_value_24"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_space_value_18">

                    <TextView
                        android:id="@+id/tvProductName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_large"
                        android:textStyle="bold"
                        tools:text="Dose Pro 4" />

                    <TextView
                        android:id="@+id/tvDeviceUid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_space_value_6"
                        android:textColor="@color/aqua_palette_8fa4be"
                        android:textSize="@dimen/aqua_text_size_caption"
                        tools:text="AQL-DOSING-123456" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_space_value_16"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/device_cooling_root_text_text"
                                android:textColor="@color/aqua_palette_8fa4be"
                                android:textSize="@dimen/aqua_text_size_caption" />

                            <TextView
                                android:id="@+id/tvConnectionStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/aqua_space_value_4"
                                android:textColor="@color/white"
                                android:textSize="@dimen/aqua_text_size_body_large"
                                android:textStyle="bold"
                                tools:text="Online" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_space_value_14">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_space_value_18">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_cooling_root_text_text_2"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_space_value_14"
                        android:textColor="@color/aqua_palette_dce7f3"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="IP: 192.168.1.40" />

                    <TextView
                        android:id="@+id/tvFirmware"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_space_value_10"
                        android:textColor="@color/aqua_palette_dce7f3"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="Firmware: 1.0.0 / build 20260624" />

                    <TextView
                        android:id="@+id/tvModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_space_value_10"
                        android:textColor="@color/aqua_palette_dce7f3"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="Model: dose-pro-4" />

                    <TextView
                        android:id="@+id/tvPrimaryCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_space_value_10"
                        android:textColor="@color/aqua_palette_dce7f3"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="Dosing channels: 4" />

                    <TextView
                        android:id="@+id/tvFeatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_space_value_10"
                        android:textColor="@color/aqua_palette_dce7f3"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="Features: Dosing, Time sync, OTA" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_space_value_14">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_space_value_18">

                    <TextView
                        android:id="@+id/tvPrimarySectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold"
                        tools:text="Channel controls" />

                    <TextView
                        android:id="@+id/tvPrimarySectionPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_space_value_8"
                        android:textColor="@color/aqua_palette_8fa4be"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="Channel controls hazırlanıyor." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_space_value_14">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_space_value_18">

                    <TextView
                        android:id="@+id/tvSecondarySectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold"
                        tools:text="Schedules" />

                    <TextView
                        android:id="@+id/tvSecondarySectionPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_space_value_8"
                        android:textColor="@color/aqua_palette_8fa4be"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="Schedules hazırlanıyor." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
