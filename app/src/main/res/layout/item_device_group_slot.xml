<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="@dimen/aqua_size_96"
    android:layout_margin="@dimen/aqua_size_4" android:background="@drawable/bg_device_group_slot"
    android:importantForAccessibility="noHideDescendants">

    <ImageView android:id="@+id/ivGroupSlotLight"
        android:layout_width="@dimen/aqua_size_48" android:layout_height="@dimen/aqua_size_24"
        android:src="@drawable/ic_device_group_light_outline"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ivGroupSlotAdd"
        app:layout_constraintVertical_chainStyle="packed" />

    <ImageView android:id="@+id/ivGroupSlotAdd"
        android:layout_width="@dimen/aqua_size_24" android:layout_height="@dimen/aqua_size_24"
        android:layout_marginTop="@dimen/aqua_size_8"
        android:src="@drawable/ic_add_24" android:importantForAccessibility="no"
        app:tint="@color/aqua_content_muted"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivGroupSlotLight"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
