<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    style="@style/Widget.Aqua.Card"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTank"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginTop="10dp"
    app:rippleColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="176dp">

            <ImageView
                android:id="@+id/imgTankPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/aquarium_content_desc_aquarium_photo"
                android:scaleType="centerCrop"
                tools:src="@drawable/nature_aquarium" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#12000000" />

            <ImageView
                android:id="@+id/selectionCircle"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/aquarium_content_desc_selected"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:tint="@android:color/white" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/infoBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E8EEF8"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="11dp">

            <LinearLayout
                android:id="@+id/topInfoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTankName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/aquarium_text_yatak_odas"
                    android:textColor="#101820"
                    android:textSize="@dimen/aqua_text_size_body"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/dayContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTankDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/aquarium_text_day_35"
                        android:textColor="#101820"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_tank_status_dot" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvCareInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/aquarium_text_last_water_change_today_last_trim_today"
                android:textColor="#17202A"
                android:textSize="@dimen/aqua_text_size_micro" />

            <LinearLayout
                android:id="@+id/bottomInfoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTankSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/aquarium_text_120w_x_50l_x_50h"
                    android:textColor="#17202A"
                    android:textSize="@dimen/aqua_text_size_micro_caption" />

                <TextView
                    android:id="@+id/tvSetupDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/aquarium_text_setup_date_2026_04_12"
                    android:textColor="#17202A"
                    android:textSize="@dimen/aqua_text_size_micro_caption" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
