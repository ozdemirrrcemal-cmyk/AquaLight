<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    style="@style/Widget.Aqua.Card"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTank"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/aqua_size_0"
    android:layout_marginEnd="@dimen/aqua_size_0"
    android:layout_marginTop="@dimen/aqua_size_10"
    app:rippleColor="@color/aqua_color_transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_176">

            <ImageView
                android:id="@+id/imgTankPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/aquarium_content_desc_aquarium_photo"
                android:scaleType="centerCrop"
                tools:src="@drawable/nature_aquarium" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/aqua_item_aquarium_tank_background" />

            <ImageView
                android:id="@+id/selectionCircle"
                android:layout_width="@dimen/aqua_size_30"
                android:layout_height="@dimen/aqua_size_30"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/aqua_size_12"
                android:layout_marginEnd="@dimen/aqua_size_12"
                android:contentDescription="@string/aquarium_content_desc_selected"
                android:padding="@dimen/aqua_size_7"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:tint="@color/aqua_content_on_dark" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/infoBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/aqua_info_box_background"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_16"
            android:paddingEnd="@dimen/aqua_size_16"
            android:paddingTop="@dimen/aqua_size_10"
            android:paddingBottom="@dimen/aqua_size_11">

            <LinearLayout
                android:id="@+id/topInfoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTankName"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/aquarium_text_yatak_odas"
                    android:textColor="@color/aqua_tv_tank_name_content"
                    android:textSize="@dimen/aqua_text_size_body"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/dayContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTankDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/aquarium_text_day_35"
                        android:textColor="@color/aqua_tv_tank_day_content"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="@dimen/aqua_size_8"
                        android:layout_height="@dimen/aqua_size_8"
                        android:layout_marginStart="@dimen/aqua_size_7"
                        android:background="@drawable/bg_tank_status_dot" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvCareInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_7"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/aquarium_text_last_water_change_today_last_trim_today"
                android:textColor="@color/aqua_tv_care_info_content"
                android:textSize="@dimen/aqua_text_size_micro" />

            <LinearLayout
                android:id="@+id/bottomInfoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_5"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTankSize"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/aquarium_text_120w_x_50l_x_50h"
                    android:textColor="@color/aqua_tv_tank_size_content"
                    android:textSize="@dimen/aqua_text_size_micro_caption" />

                <TextView
                    android:id="@+id/tvSetupDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/aquarium_text_setup_date_2026_04_12"
                    android:textColor="@color/aqua_tv_setup_date_content"
                    android:textSize="@dimen/aqua_text_size_micro_caption" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
