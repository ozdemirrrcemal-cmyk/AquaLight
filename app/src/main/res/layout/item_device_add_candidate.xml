<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowCandidate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#0F2137"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="#243D5C"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="104dp"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:id="@+id/deviceImageContainer"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_device_add_image_box"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivDeviceIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:padding="3dp"
                android:scaleType="centerInside"
                tools:src="@drawable/ic_device_light" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvAction"
            app:layout_constraintStart_toEndOf="@id/deviceImageContainer"
            app:layout_constraintTop_toTopOf="@id/deviceImageContainer"
            tools:text="CoolPro" />

        <TextView
            android:id="@+id/tvDeviceFamily"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/settings_text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="@id/tvDeviceName"
            app:layout_constraintStart_toStartOf="@id/tvDeviceName"
            app:layout_constraintTop_toBottomOf="@id/tvDeviceName"
            tools:text="AquaCool" />

        <TextView
            android:id="@+id/tvDeviceState"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_device_add_status_setup"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:textColor="#6CB7FF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvDeviceName"
            app:layout_constraintTop_toBottomOf="@id/tvDeviceFamily"
            tools:text="● Setup mode" />

        <TextView
            android:id="@+id/tvAction"
            android:layout_width="74dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_device_add_status_setup"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#6CB7FF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/deviceImageContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/deviceImageContainer"
            tools:text="Set up" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>