<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCandidate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardUseCompatPadding="false"
    app:rippleColor="#24344A">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="96dp"
        android:paddingStart="16dp"
        android:paddingTop="15dp"
        android:paddingEnd="16dp"
        android:paddingBottom="15dp">

        <TextView
            android:id="@+id/tvDeviceIcon"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_devices_empty_orb"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="AQ"
            android:textColor="#F2F6FA"
            android:textSize="@dimen/aqua_text_size_body_small"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvCandidateTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#F2F6FA"
            android:textSize="@dimen/aqua_text_size_card_title"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvCandidateStatus"
            app:layout_constraintStart_toEndOf="@id/tvDeviceIcon"
            app:layout_constraintTop_toTopOf="@id/tvDeviceIcon"
            tools:text="WRGB Pro Elite" />

        <TextView
            android:id="@+id/tvCandidateSerial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#90A1B5"
            android:textSize="@dimen/aqua_text_size_caption_plus"
            app:layout_constraintEnd_toStartOf="@id/tvCandidateStatus"
            app:layout_constraintStart_toEndOf="@id/tvDeviceIcon"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateTitle"
            tools:text="Serial: AQL-LIGHT-123456" />

        <TextView
            android:id="@+id/tvCandidateModel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#5FD6B4"
            android:textSize="@dimen/aqua_text_size_caption_plus"
            app:layout_constraintEnd_toStartOf="@id/tvCandidateStatus"
            app:layout_constraintStart_toEndOf="@id/tvDeviceIcon"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateSerial"
            tools:text="Setup mode • RSSI -52 dBm" />

        <TextView
            android:id="@+id/tvCandidateStatus"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_device_compact_status_chip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="76dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#5FD6B4"
            android:textSize="@dimen/aqua_text_size_micro_plus"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvDeviceIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvDeviceIcon"
            tools:text="Ready" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
