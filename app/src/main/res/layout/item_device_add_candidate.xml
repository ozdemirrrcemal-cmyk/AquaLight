<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowCandidate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="22dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:id="@+id/deviceImageContainer"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_device_add_image_box"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivDeviceIcon"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:contentDescription="Device"
            android:padding="4dp"
            android:scaleType="centerInside"
            tools:src="@drawable/ic_device_light" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvDeviceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tvChevron"
        app:layout_constraintStart_toEndOf="@id/deviceImageContainer"
        app:layout_constraintTop_toTopOf="@id/deviceImageContainer"
        tools:text="WRGB Pro2" />

    <TextView
        android:id="@+id/tvDeviceFamily"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/settings_text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/tvDeviceName"
        app:layout_constraintStart_toStartOf="@id/tvDeviceName"
        app:layout_constraintTop_toBottomOf="@id/tvDeviceName"
        tools:text="AquaLight" />

    <TextView
        android:id="@+id/tvDeviceState"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_device_add_status_setup"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:textColor="#2D7BFF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/tvDeviceName"
        app:layout_constraintTop_toBottomOf="@id/tvDeviceFamily"
        tools:text="● Ready for setup" />

    <TextView
        android:id="@+id/tvConnectionInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/settings_text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/tvDeviceName"
        app:layout_constraintStart_toStartOf="@id/tvDeviceName"
        app:layout_constraintTop_toBottomOf="@id/tvDeviceState"
        tools:text="AquaLight-WRGBPro2-7872" />

    <TextView
        android:id="@+id/tvAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:includeFontPadding="false"
        android:textColor="#2D7BFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tvConnectionInfo"
        app:layout_constraintEnd_toStartOf="@id/tvChevron"
        tools:text="Set up" />

    <TextView
        android:id="@+id/tvChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="›"
        android:textColor="@color/settings_text_secondary"
        android:textSize="32sp"
        app:layout_constraintBottom_toBottomOf="@id/deviceImageContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/deviceImageContainer" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="88dp"
        android:background="#1E3552"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>