<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCandidate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/aqua_size_4"
    android:layout_marginTop="@dimen/aqua_size_8"
    android:layout_marginBottom="@dimen/aqua_size_6"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardUseCompatPadding="false"
    app:rippleColor="@color/aqua_palette_hex_24344a">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/aqua_size_96"
        android:paddingStart="@dimen/aqua_size_16"
        android:paddingTop="@dimen/aqua_size_15"
        android:paddingEnd="@dimen/aqua_size_16"
        android:paddingBottom="@dimen/aqua_size_15">

        <TextView
            android:id="@+id/tvDeviceIcon"
            android:layout_width="@dimen/aqua_size_54"
            android:layout_height="@dimen/aqua_size_54"
            android:background="@drawable/bg_devices_empty_orb"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/device_brand_short_code"
            android:textColor="@color/aqua_palette_hex_f2f6fa"
            android:textSize="@dimen/aqua_text_size_body_small"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvCandidateTitle"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/aqua_size_15"
            android:layout_marginEnd="@dimen/aqua_size_12"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/aqua_palette_hex_f2f6fa"
            android:textSize="@dimen/aqua_text_size_card_title"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvCandidateStatus"
            app:layout_constraintStart_toEndOf="@id/tvDeviceIcon"
            app:layout_constraintTop_toTopOf="@id/tvDeviceIcon"
            tools:text="WRGB Pro Elite" />

        <TextView
            android:id="@+id/tvCandidateSerial"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/aqua_size_15"
            android:layout_marginTop="@dimen/aqua_size_7"
            android:layout_marginEnd="@dimen/aqua_size_12"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/aqua_palette_hex_90a1b5"
            android:textSize="@dimen/aqua_text_size_caption_plus"
            app:layout_constraintEnd_toStartOf="@id/tvCandidateStatus"
            app:layout_constraintStart_toEndOf="@id/tvDeviceIcon"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateTitle"
            tools:text="Serial: AQL-LIGHT-123456" />

        <TextView
            android:id="@+id/tvCandidateModel"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/aqua_size_15"
            android:layout_marginTop="@dimen/aqua_size_6"
            android:layout_marginEnd="@dimen/aqua_size_12"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/aqua_palette_hex_5fd6b4"
            android:textSize="@dimen/aqua_text_size_caption_plus"
            app:layout_constraintEnd_toStartOf="@id/tvCandidateStatus"
            app:layout_constraintStart_toEndOf="@id/tvDeviceIcon"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateSerial"
            tools:text="Setup mode • RSSI -52 dBm" />

        <TextView
            style="@style/Widget.Aqua.Chip.Status.Candidate"
            android:id="@+id/tvCandidateStatus"
            app:layout_constraintBottom_toBottomOf="@id/tvDeviceIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvDeviceIcon"
            tools:text="Ready" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
