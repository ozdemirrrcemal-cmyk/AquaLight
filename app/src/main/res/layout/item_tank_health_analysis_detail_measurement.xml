<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Aqua.Card.Inline"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/aqua_size_8"
    app:cardCornerRadius="@dimen/aqua_size_12"
    app:strokeColor="@color/aqua_card_outline_subtle"
    app:strokeWidth="@dimen/aqua_size_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/aqua_size_12">

        <TextView
            android:id="@+id/tvParameterName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/aqua_card_text_secondary"
            android:textSize="@dimen/aqua_text_size_caption" />

        <TextView
            android:id="@+id/tvMeasurementValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_4"
            android:includeFontPadding="false"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body_xlarge"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCompatibilityStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_4"
            android:includeFontPadding="false"
            android:textSize="@dimen/aqua_text_size_body_small"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMeasurementMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_4"
            android:includeFontPadding="false"
            android:textColor="@color/aqua_content_muted"
            android:textSize="@dimen/aqua_text_size_micro_caption" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
