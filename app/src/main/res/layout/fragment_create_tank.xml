<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/createTankNavHost"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        app:defaultNavHost="false"
        app:navGraph="@navigation/nav_create_tank"
        app:layout_constraintBottom_toTopOf="@id/progressBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_4"
        android:indeterminate="false"
        android:max="100"
        android:progress="20"
        android:progressBackgroundTint="@color/aqua_progress_bar_progress_background_tint"
        android:progressTint="@color/aqua_progress_bar_progress_tint"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:background="@color/aqua_surface_action"
        android:orientation="vertical"
        android:padding="@dimen/aqua_size_12"
        android:paddingBottom="@dimen/aqua_size_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            style="@style/Widget.Aqua.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_button_height"
            android:text="@string/aquarium_action_next" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
