<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardLightDevice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#101D2C"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false"
    app:rippleColor="#24344A"
    app:strokeColor="#22354D"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/deviceIconContainer"
                android:layout_width="46dp"
                android:layout_height="46dp"
                app:cardBackgroundColor="#162A3E"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#2A4663"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivDeviceIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerInside"
                    tools:src="@drawable/ic_device_light" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvDeviceType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_marginEnd="10dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#90A1B5"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tvDeviceName"
                app:layout_constraintEnd_toStartOf="@id/tvConnectionStatus"
                app:layout_constraintStart_toEndOf="@id/deviceIconContainer"
                app:layout_constraintTop_toTopOf="@id/deviceIconContainer"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="AquaLight" />

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#F2F6FA"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/deviceIconContainer"
                app:layout_constraintEnd_toStartOf="@id/tvConnectionStatus"
                app:layout_constraintStart_toEndOf="@id/deviceIconContainer"
                app:layout_constraintTop_toBottomOf="@id/tvDeviceType"
                tools:text="WRGB Pro2" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_light_status_chip"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="68dp"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:textColor="#5FD6B4"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/deviceIconContainer"
                tools:text="Online" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/programSummaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#142437"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#24384F"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvProgramLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="ACTIVE PROGRAM"
                    android:textColor="#6F8197"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvProgramName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="10dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#F2F6FA"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvOutputPercent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvProgramLabel"
                    tools:text="Balanced Growth" />

                <TextView
                    android:id="@+id/tvOutputPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="#8EB8FF"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tvProgramName"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvProgramLabel"
                    tools:text="72%" />

                <LinearLayout
                    android:id="@+id/startTimeGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_light_time_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="9dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvProgramName">

                    <ImageView
                        android:id="@+id/ivRampUp"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_light_ramp_up_16"
                        app:tint="#C8A86B" />

                    <TextView
                        android:id="@+id/tvStartTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:includeFontPadding="false"
                        android:textColor="#A8B5C5"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        tools:text="08:00" />

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/tvLightTimeline"
                    android:layout_width="0dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="9dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/bg_light_timeline_track"
                    app:layout_constraintBottom_toBottomOf="@id/startTimeGroup"
                    app:layout_constraintEnd_toStartOf="@id/endTimeGroup"
                    app:layout_constraintStart_toEndOf="@id/startTimeGroup"
                    app:layout_constraintTop_toTopOf="@id/startTimeGroup">

                    <View
                        android:id="@+id/viewTimelineActive"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="start"
                        android:background="@drawable/bg_light_timeline_active"
                        tools:layout_width="96dp" />

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/endTimeGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_light_time_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="@id/startTimeGroup"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/startTimeGroup">

                    <TextView
                        android:id="@+id/tvEndTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="#A8B5C5"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        tools:text="22:00" />

                    <ImageView
                        android:id="@+id/ivRampDown"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_light_ramp_down_16"
                        app:tint="#8EB8FF" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/channelContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="vertical"
            tools:itemCount="4"
            tools:listitem="@layout/item_tank_light_channel_row" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>