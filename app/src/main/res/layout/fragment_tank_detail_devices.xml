<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/devicesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:paddingStart="@dimen/aqua_size_14"
    android:paddingTop="@dimen/aqua_size_16"
    android:paddingEnd="@dimen/aqua_size_14"
    android:paddingBottom="@dimen/aqua_size_0">


    <!-- Scenes and group actions remain separate from assigned device cards. -->
    <LinearLayout
        android:id="@+id/smartControlsSection"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/tank_scenes_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/aqua_text_size_title_small"
            android:textStyle="bold" />

        <!-- Display-only; scene behaviour will be implemented separately. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardScenesComingSoon"
            style="@style/Widget.Aqua.Card.Grouped"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_8"
            android:clickable="false"
            android:focusable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/aqua_size_14"
                android:paddingTop="@dimen/aqua_size_12"
                android:paddingEnd="@dimen/aqua_size_14"
                android:paddingBottom="@dimen/aqua_size_12">

                <ImageView
                    android:layout_width="@dimen/aqua_size_28"
                    android:layout_height="@dimen/aqua_size_28"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_light_quick_setup"
                    android:tint="@color/aqua_light_preset_shrimp_swatch" />

                <LinearLayout
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/aqua_size_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/tank_scenes_create"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body_large"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_2"
                        android:text="@string/tank_scenes_description"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body_small" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/aqua_size_8"
                    android:text="@string/tank_scenes_coming_soon"
                    android:textColor="@color/aqua_light_preset_shrimp_swatch"
                    android:textSize="@dimen/aqua_text_size_caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/controlGroupsHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_18"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/tank_control_groups_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/aqua_text_size_title_small"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateControlGroup"
                style="@style/Widget.Aqua.Button.InlineAdd"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/aqua_size_34"
                android:contentDescription="@string/tank_control_groups_create_content_description"
                android:text="@string/tank_control_groups_create" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_3"
            android:text="@string/tank_control_groups_description"
            android:textColor="@color/aqua_content_secondary"
            android:textSize="@dimen/aqua_text_size_body_small" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/devicesHeaderRow"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_18"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/smartControlsSection">

        <TextView
            android:id="@+id/tvDeviceTitle"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="@string/aquarium_detail_tab_devices"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/aqua_text_size_title_small"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Aqua.Button.InlineAdd"
            android:id="@+id/btnAddDevice"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/aqua_size_34"
            android:contentDescription="@string/devices_scan_button_desc"
            android:text="@string/aquarium_action_add"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAssignedDevices"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:layout_marginTop="@dimen/aqua_size_8"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/aqua_size_24"
        app:layout_constraintTop_toBottomOf="@id/devicesHeaderRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
    style="@style/Widget.Aqua.Card.Inline"
        android:id="@+id/cardDevicesEmpty"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_16"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/devicesHeaderRow"
        app:cardBackgroundColor="@color/aqua_state_container_surface"
        app:cardCornerRadius="@dimen/aqua_size_24"
        app:cardElevation="@dimen/aqua_size_0"
        app:strokeColor="@color/aqua_state_container_outline"
        app:strokeWidth="@dimen/aqua_size_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_18"
            android:paddingTop="@dimen/aqua_size_24"
            android:paddingEnd="@dimen/aqua_size_18"
            android:paddingBottom="@dimen/aqua_size_24">

            <TextView
                android:id="@+id/tvDevicesEmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/aquarium_no_device_connected"
                android:textColor="@color/aqua_state_text_primary"
                android:textSize="@dimen/aqua_text_size_state_title_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDevicesEmptyMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_9"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/aqua_size_3"
                android:text="@string/aquarium_text_add_a_saved_device_to_control_or_monitor_this_aquarium"
                android:textColor="@color/aqua_state_text_secondary"
                android:textSize="@dimen/aqua_text_size_state_body" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
