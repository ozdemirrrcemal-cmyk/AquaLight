<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/devicesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:paddingStart="@dimen/aqua_size_14"
    android:paddingTop="@dimen/aqua_size_16"
    android:paddingEnd="@dimen/aqua_size_14"
    android:paddingBottom="@dimen/aqua_size_120">

    <LinearLayout
        android:id="@+id/devicesHeaderRow"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvDeviceTitle"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="@string/aquarium_detail_tab_devices"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/aqua_text_size_title_small"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Aqua.Button.InlineAdd"
            android:id="@+id/btnAddDevice"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/aqua_size_34"
            android:contentDescription="@string/devices_scan_button_desc"
            android:text="@string/aquarium_action_add"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAssignedDevices"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:layout_marginTop="@dimen/aqua_size_8"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/aqua_size_24"
        app:layout_constraintTop_toBottomOf="@id/devicesHeaderRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDevicesEmpty"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_16"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/devicesHeaderRow"
        app:cardBackgroundColor="@color/aqua_state_container_surface"
        app:cardCornerRadius="@dimen/aqua_size_24"
        app:cardElevation="@dimen/aqua_size_0"
        app:strokeColor="@color/aqua_state_container_outline"
        app:strokeWidth="@dimen/aqua_size_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_18"
            android:paddingTop="@dimen/aqua_size_24"
            android:paddingEnd="@dimen/aqua_size_18"
            android:paddingBottom="@dimen/aqua_size_24">

            <TextView
                android:id="@+id/tvDevicesEmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/aquarium_no_device_connected"
                android:textColor="@color/aqua_state_text_primary"
                android:textSize="@dimen/aqua_text_size_state_title_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDevicesEmptyMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_9"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/aqua_size_3"
                android:text="@string/aquarium_text_add_a_saved_device_to_control_or_monitor_this_aquarium"
                android:textColor="@color/aqua_state_text_secondary"
                android:textSize="@dimen/aqua_text_size_state_body" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
