<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lightPointEditorScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_light_bottom_sheet_surface"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/lightPointEditorRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/light_stroke" />

        <TextView
            android:id="@+id/tvPointTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            tools:text="Edit Point" />

        <TextView
            android:id="@+id/tvPointLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text=""
            android:textColor="@color/settings_text_secondary"
            android:textSize="13sp"
            tools:text="Edit this curve point time and intensity." />

        <TextView
            android:id="@+id/tvPointNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:text="@string/light_point_editor_name_label"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/inputPointName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_light_editor_chip_unselected"
            android:fontFamily="@font/inter_regular"
            android:hint="@string/light_point_editor_name_hint"
            android:imeOptions="actionDone"
            android:includeFontPadding="false"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="@color/settings_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvPointNameHelper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:lineSpacingExtra="2dp"
            android:text=""
            android:textColor="@color/settings_text_secondary"
            android:textSize="11sp"
            tools:text="This name will be shown in the curve points list." />

        <TextView
            android:id="@+id/tvPointTimeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:text="@string/light_point_editor_time_label"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/pointTimeControlRow"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_light_editor_chip_unselected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/btnPointTimeMinus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/common_minus"
                android:textColor="@color/light_accent"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/tvPointTime"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="?attr/colorOnSurface"
                android:textSize="32sp"
                tools:text="10:00" />

            <TextView
                android:id="@+id/btnPointTimePlus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/common_plus"
                android:textColor="@color/light_accent"
                android:textSize="28sp" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPointIntensity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/light_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/light_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvPointIntensityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/light_point_editor_intensity_label"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvPointIntensityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="@color/light_accent"
                    android:textSize="34sp"
                    tools:text="80%" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderPointIntensity"
                    style="@style/Widget.Aqua.Light.Slider.Master"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:valueFrom="0"
                    android:valueTo="100"
                    tools:value="80" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/btnPointSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_light_primary_action"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="@color/background_color"
            android:textSize="15sp"
            tools:text="Save Point" />

        <TextView
            android:id="@+id/btnPointDelete"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/light_point_editor_delete"
            android:textColor="@color/light_error"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnPointCancel"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/common_cancel"
            android:textColor="@color/settings_text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>