<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/moonlightSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_light_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_light_sheet_handle" />

    <TextView
        android:id="@+id/tvSheetTitle"
        style="@style/TextAppearance.Aqua.Light.SheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Moonlight" />

    <TextView
        style="@style/TextAppearance.Aqua.Light.SheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Run soft night lighting after the main program." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.Aqua.Light.SheetRowTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Enable Moonlight" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchMoonlightEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/moonlightOptionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:alpha="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Aqua.Light.SheetRowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Follow Program End" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchFollowProgramEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowMoonlightStart"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Aqua.Light.SheetRowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start Time" />

            <TextView
                android:id="@+id/tvMoonlightStart"
                style="@style/TextAppearance.Aqua.Light.SheetRowSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Program End" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowMoonlightEnd"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Aqua.Light.SheetRowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="End Time" />

            <TextView
                android:id="@+id/tvMoonlightEnd"
                style="@style/TextAppearance.Aqua.Light.SheetRowSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="06:00" />

        </LinearLayout>

        <TextView
            style="@style/TextAppearance.Aqua.Light.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="CHANNEL" />

        <LinearLayout
            android:id="@+id/moonlightChannelSelector"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_light_filter_bar"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/channelBlue"
                style="@style/TextAppearance.Aqua.Light.Filter.Selected"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_light_filter_selected"
                android:gravity="center"
                android:text="Blue" />

            <TextView
                android:id="@+id/channelWhite"
                style="@style/TextAppearance.Aqua.Light.Filter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="White" />

            <TextView
                android:id="@+id/channelBlueWhite"
                style="@style/TextAppearance.Aqua.Light.Filter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Blue + White" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvMoonlightIntensity"
            style="@style/TextAppearance.Aqua.Light.BodyStrong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Intensity 5%" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMoonlightIntensity"
            style="@style/Widget.Aqua.Light.Slider.Blue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:value="5"
            app:valueFrom="1"
            app:valueTo="15"
            app:stepSize="1" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Aqua.Light.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="Cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            style="@style/Widget.Aqua.Light.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Apply" />

    </LinearLayout>

</LinearLayout>