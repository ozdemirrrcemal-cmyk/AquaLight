<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/themeSelectionSheetRoot"
    style="@style/Widget.Aqua.BottomSheet.Root"
    android:gravity="center_horizontal">

    <View
        style="@style/Widget.Aqua.BottomSheet.Handle"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvDialogTitle"
        style="@style/TextAppearance.Aqua.BottomSheet.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:text="@string/theme_selection_title"
        android:labelFor="@id/layoutLight" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Aqua.BottomSheet.SelectionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/theme_selection_light_option_description">

        <LinearLayout
            android:id="@+id/layoutLight"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="14dp"
                android:src="@drawable/ic_theme_light"
                app:tint="@color/aqua_bottom_sheet_text_primary" />

            <TextView
                android:id="@+id/tvLight"
                style="@style/TextAppearance.Aqua.BottomSheet.RowTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/theme_selection_light" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioLight"
                style="@style/Widget.Aqua.SettingsRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Aqua.BottomSheet.SelectionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/theme_selection_dark_option_description">

        <LinearLayout
            android:id="@+id/layoutDark"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="14dp"
                android:src="@drawable/ic_theme_dark"
                app:tint="@color/aqua_bottom_sheet_text_primary" />

            <TextView
                android:id="@+id/tvDark"
                style="@style/TextAppearance.Aqua.BottomSheet.RowTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/theme_selection_dark" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioDark"
                style="@style/Widget.Aqua.SettingsRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Aqua.BottomSheet.SelectionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/theme_selection_system_option_description">

        <LinearLayout
            android:id="@+id/layoutSystem"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="14dp"
                android:src="@drawable/ic_theme_system"
                app:tint="@color/aqua_bottom_sheet_text_primary" />

            <TextView
                android:id="@+id/tvSystem"
                style="@style/TextAppearance.Aqua.BottomSheet.RowTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/theme_selection_system_default" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioSystem"
                style="@style/Widget.Aqua.SettingsRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
