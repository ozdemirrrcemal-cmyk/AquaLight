<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/aqua_size_24"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_16"
            android:paddingTop="@dimen/aqua_size_10"
            android:paddingEnd="@dimen/aqua_size_16">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/aqua_size_14">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/followupPhotoFrame"
                        style="@style/Widget.Aqua.Card.Device.Media"
                        android:layout_width="@dimen/aqua_size_60"
                        android:layout_height="@dimen/aqua_size_60"
                        app:cardCornerRadius="@dimen/aqua_size_12"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/ivFollowupLivestock"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="center" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.CardPrimaryBodyBold"
                        android:id="@+id/tvFollowupLivestockName"
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_12"
                        android:includeFontPadding="false"
                        app:layout_constraintEnd_toStartOf="@id/tvFollowupBadge"
                        app:layout_constraintStart_toEndOf="@id/followupPhotoFrame"
                        app:layout_constraintTop_toTopOf="@id/followupPhotoFrame" />

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.SuccessStatusMicroBold"
                        android:id="@+id/tvFollowupBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/aqua_size_26"
                        android:background="@drawable/bg_aqua_toolbar_pill_action_primary"
                        android:gravity="center"
                        android:paddingStart="@dimen/aqua_size_9"
                        android:paddingEnd="@dimen/aqua_size_9"
                        android:text="@string/livestock_health_tracking_badge"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.CardSecondaryBodySmall"
                        android:id="@+id/tvFollowupIssue"
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_12"
                        android:layout_marginTop="@dimen/aqua_size_5"
                        android:text="@string/livestock_health_issue_surface"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/followupPhotoFrame"
                        app:layout_constraintTop_toBottomOf="@id/tvFollowupLivestockName" />

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.ContentMutedCaption"
                        android:id="@+id/tvFollowupAffected"
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_12"
                        android:layout_marginTop="@dimen/aqua_size_4"
                        app:layout_constraintBottom_toBottomOf="@id/followupPhotoFrame"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/followupPhotoFrame"
                        app:layout_constraintTop_toBottomOf="@id/tvFollowupIssue" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_size_14">

                    <ImageView
                        android:layout_width="@dimen/aqua_size_24"
                        android:layout_height="@dimen/aqua_size_24"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_water_test_wave_24" />

                    <LinearLayout
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.CardPrimaryBodySmallBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/livestock_health_issue_surface" />

                        <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.ContentMutedMicro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_3"
                            android:text="@string/livestock_health_issue_first_seen" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.CardPrimaryBodyBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:text="@string/livestock_health_last_status_title" />

            <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.ContentMutedMicro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_3"
                android:text="@string/livestock_health_last_check_time" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_48"
                android:layout_marginTop="@dimen/aqua_size_10"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStatusIncreased"
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.DangerStatusMicro"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/livestock_health_status_increased" />

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="@dimen/aqua_size_5"
                    android:layout_height="@dimen/aqua_size_1" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStatusSame"
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.WarningStatusMicro"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/livestock_health_status_same" />

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="@dimen/aqua_size_5"
                    android:layout_height="@dimen/aqua_size_1" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStatusDecreased"
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.SuccessStatusMicro"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/livestock_health_status_decreased" />

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="@dimen/aqua_size_5"
                    android:layout_height="@dimen/aqua_size_1" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStatusRecovered"
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.CardSecondaryStatusMicro"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/livestock_health_status_recovered" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.CardPrimaryBodyBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_20"
                android:text="@string/livestock_health_history_title" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10">

                <LinearLayout
                    android:id="@+id/historyContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/aqua_size_8"
                    android:paddingTop="@dimen/aqua_size_8"
                    android:paddingEnd="@dimen/aqua_size_8"
                    android:paddingBottom="@dimen/aqua_size_8" />

            </com.google.android.material.card.MaterialCardView>

            <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.CardPrimaryBodyBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_20"
                android:text="@string/livestock_health_tank_context_title" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/aqua_size_12"
                    android:paddingTop="@dimen/aqua_size_6"
                    android:paddingEnd="@dimen/aqua_size_12"
                    android:paddingBottom="@dimen/aqua_size_6">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_58"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Aqua.Card.IconAccent"
                            android:layout_width="@dimen/aqua_size_36"
                            android:layout_height="@dimen/aqua_size_36"
                            app:cardCornerRadius="@dimen/aqua_size_10">

                            <ImageView
                                android:layout_width="@dimen/aqua_size_22"
                                android:layout_height="@dimen/aqua_size_22"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_water_test_wave_24"
                                app:tint="@color/aqua_button_blue" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_10"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.CardPrimaryBodySmallBold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/livestock_health_tank_context_measurement_title" />

                            <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.ContentMutedMicro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/aqua_size_2"
                                android:includeFontPadding="false"
                                android:text="@string/livestock_health_tank_context_measurement_age" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_1"
                        android:background="@color/aqua_card_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_58"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Aqua.Card.IconAccent"
                            android:layout_width="@dimen/aqua_size_36"
                            android:layout_height="@dimen/aqua_size_36"
                            app:cardCornerRadius="@dimen/aqua_size_10">

                            <ImageView
                                android:layout_width="@dimen/aqua_size_22"
                                android:layout_height="@dimen/aqua_size_22"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_care_water_change_24"
                                app:tint="@color/aqua_content_secondary" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_10"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.CardPrimaryBodySmallBold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/livestock_health_tank_context_change_title" />

                            <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.ContentMutedMicro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/aqua_size_2"
                                android:includeFontPadding="false"
                                android:text="@string/livestock_health_tank_context_change_age" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewCheck"
                style="@style/Widget.Aqua.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_48"
                android:layout_marginTop="@dimen/aqua_size_16"
                android:text="@string/livestock_health_new_check"
                app:icon="@drawable/ic_add_24" />

            <TextView android:textAppearance="@style/TextAppearance.Aqua.LivestockHealth.ContentMutedMicro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_8"
                android:gravity="center"
                android:text="@string/livestock_health_recovered_helper" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
