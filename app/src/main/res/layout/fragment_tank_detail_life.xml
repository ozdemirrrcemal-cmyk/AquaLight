<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tankLifeScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="16dp"
    android:paddingBottom="120dp"
    android:scrollbars="none"
    android:background="@color/background_color">

    <LinearLayout
        android:id="@+id/tankLifeRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tankLifeHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTankLifeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/aquarium_tank_life_title"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_title_small"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddLife"
                android:layout_width="78dp"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingTop="0dp"
                android:paddingEnd="10dp"
                android:paddingBottom="0dp"
                android:text="@string/aquarium_action_add"
                android:textAllCaps="false"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_caption"
                android:textStyle="bold"
                android:contentDescription="@string/devices_scan_button_desc"
                app:backgroundTint="#1C3252"
                app:cornerRadius="17dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvTankLifeSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:text="@string/aquarium_no_livestock_yet"
            android:textColor="@color/aqua_card_text_secondary"
            android:textSize="@dimen/aqua_text_size_body_small" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card"
            android:id="@+id/cardTankLifeEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="24dp"
                android:paddingEnd="18dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvTankLifeEmptyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/aquarium_no_livestock_added"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body_large"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTankLifeEmptyMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/aquarium_text_add_fish_shrimp_coral_or_other_livestock_living_in_this_aqua"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_body_small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyAddLife"
                    android:layout_width="180dp"
                    android:layout_height="46dp"
                    android:layout_marginTop="18dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/aquarium_action_add_livestock"
                    android:textAllCaps="false"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body_small"
                    android:textStyle="bold"
                    app:backgroundTint="#1C3252"
                    app:cornerRadius="23dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/tankLifeListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>