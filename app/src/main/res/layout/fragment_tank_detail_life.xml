<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tankLifeScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="@dimen/aqua_size_14"
    android:paddingEnd="@dimen/aqua_size_14"
    android:paddingTop="@dimen/aqua_size_16"
    android:paddingBottom="@dimen/aqua_size_120"
    android:scrollbars="none"
    android:background="@color/background_color">

    <LinearLayout
        android:id="@+id/tankLifeRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tankLifeHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTankLifeTitle"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/aquarium_tank_life_title"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_title_small"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Aqua.Button.InlineAdd"
                android:id="@+id/btnAddLife"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/aqua_size_48"
                android:text="@string/aquarium_action_add"
                android:textStyle="bold"
                android:contentDescription="@string/devices_scan_button_desc" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvTankLifeSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_8"
            android:includeFontPadding="false"
            android:text="@string/aquarium_no_livestock_yet"
            android:textColor="@color/aqua_card_text_secondary"
            android:textSize="@dimen/aqua_text_size_body_small" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card"
            android:id="@+id/cardTankLifeEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="@dimen/aqua_size_18"
                android:paddingTop="@dimen/aqua_size_24"
                android:paddingEnd="@dimen/aqua_size_18"
                android:paddingBottom="@dimen/aqua_size_24">

                <TextView
                    android:id="@+id/tvTankLifeEmptyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/aquarium_no_livestock_added"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body_large"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTankLifeEmptyMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_9"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/aqua_size_3"
                    android:text="@string/aquarium_text_add_fish_shrimp_coral_or_other_livestock_living_in_this_aqua"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_body_small" />

                <com.google.android.material.button.MaterialButton
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:minWidth="@dimen/aqua_button_empty_action_min_width"
                    style="@style/Widget.Aqua.Button.Secondary"
                    android:id="@+id/btnEmptyAddLife"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/aqua_button_height"
                    android:layout_marginTop="@dimen/aqua_size_18"
                    android:text="@string/aquarium_action_add_livestock"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/tankLifeListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_14"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>