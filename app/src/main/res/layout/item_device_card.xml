<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginHorizontal="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/settings_card_background"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:cardUseCompatPadding="false"
    app:strokeWidth="1dp"
    app:strokeColor="#14FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <!-- Device Preview -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/ivDeviceIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_device_light"
                android:contentDescription="@string/app_name"/>

        </FrameLayout>

        <!-- Device Name -->
        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Wifi Hub"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@android:color/white"/>

        <!-- Status Icon -->
        <ImageView
            android:id="@+id/ivStatus"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_status_wifi"
            android:alpha="0.9"
            app:tint="#57D26A"
            android:contentDescription="@string/devices_scan_button_desc"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>