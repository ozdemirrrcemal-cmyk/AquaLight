<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/aquaHeaderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_color"
    android:paddingHorizontal="@dimen/aqua_size_16"
    android:paddingTop="@dimen/aqua_size_12"
    android:paddingBottom="@dimen/aqua_size_8">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="@dimen/aqua_size_48"
        android:layout_height="@dimen/aqua_size_48"
        android:clickable="true"
        android:contentDescription="@string/change_email_back_button_desc"
        android:focusable="true"
        android:padding="@dimen/aqua_size_9"
        android:scaleType="centerInside"
        android:src="@drawable/ic_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/aqua_toolbar_icon_tint" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchContainer"
        style="@style/Widget.Aqua.Card.Inline"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_48"
        android:layout_marginStart="@dimen/aqua_size_18"
        android:visibility="gone"
        app:cardBackgroundColor="@color/aqua_input_background"
        app:cardCornerRadius="@dimen/aqua_size_14"
        app:cardElevation="@dimen/aqua_size_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/aqua_input_stroke_unfocused"
        app:strokeWidth="@dimen/aqua_size_1"
        tools:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <EditText
                android:id="@+id/etHeaderSearch"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="match_parent"
                android:background="@color/aqua_color_transparent"
                android:gravity="center_vertical"
                android:hint="@string/catalog_search_hint"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="@dimen/aqua_size_16"
                android:paddingEnd="@dimen/aqua_size_8"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="@color/aqua_content_secondary"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/aqua_text_size_header_search"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnClearHeaderSearch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Anubias" />

            <TextView
                android:id="@+id/btnClearHeaderSearch"
                android:layout_width="@dimen/aqua_size_48"
                android:layout_height="@dimen/aqua_size_48"
                android:clickable="true"
                android:contentDescription="@string/common_clear_search_description"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/common_close"
                android:textColor="@color/aqua_toolbar_icon_secondary"
                android:textSize="@dimen/aqua_text_size_toolbar_clear_action"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/headerRightContainer"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/aqua_size_48"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack">

        <LinearLayout
            android:id="@+id/headerActionsContainer"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/aqua_size_48"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/btnActionOne"
                android:layout_width="@dimen/aqua_size_48"
                android:layout_height="@dimen/aqua_size_48"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/aqua_size_12"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:tint="@color/aqua_toolbar_icon_tint"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/btnActionTwo"
                android:layout_width="@dimen/aqua_size_48"
                android:layout_height="@dimen/aqua_size_48"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/aqua_size_12"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:tint="@color/aqua_toolbar_icon_tint"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/btnActionThree"
                android:layout_width="@dimen/aqua_size_48"
                android:layout_height="@dimen/aqua_size_48"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/aqua_size_12"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:tint="@color/aqua_toolbar_icon_tint"
                tools:visibility="visible" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnFilledIconAction"
            android:layout_width="@dimen/aqua_size_48"
            android:layout_height="@dimen/aqua_size_48"
            android:background="@drawable/bg_aqua_toolbar_filled_icon_action"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/aqua_size_14"
            android:scaleType="centerInside"
            android:visibility="gone"
            app:tint="@color/aqua_toolbar_icon_tint"
            tools:src="@drawable/ic_radar"
            tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCardIconAction"
            style="@style/Widget.Aqua.Card.Inline"
            android:layout_width="@dimen/aqua_size_48"
            android:layout_height="@dimen/aqua_size_48"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            app:cardBackgroundColor="@color/aqua_toolbar_action_success_container"
            app:cardCornerRadius="@dimen/aqua_size_24"
            app:cardElevation="@dimen/aqua_size_0"
            app:strokeColor="@color/aqua_toolbar_action_success_outline"
            app:strokeWidth="@dimen/aqua_size_1"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/ivCardIconAction"
                android:layout_width="@dimen/aqua_size_18"
                android:layout_height="@dimen/aqua_size_18"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:src="@drawable/ic_check_24"
                app:tint="@color/aqua_content_on_dark" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/btnPillTextAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_aqua_toolbar_pill_action_primary"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="@dimen/aqua_size_58"
            android:minHeight="@dimen/aqua_size_48"
            android:paddingStart="@dimen/aqua_size_14"
            android:paddingTop="@dimen/aqua_size_8"
            android:paddingEnd="@dimen/aqua_size_14"
            android:paddingBottom="@dimen/aqua_size_8"
            android:textColor="@color/aqua_content_on_dark"
            android:textSize="@dimen/aqua_text_size_toolbar_pill_action"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Edit"
            tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/scoreContainer"
            style="@style/Widget.Aqua.Card.Inline"
            android:layout_width="@dimen/aqua_size_48"
            android:layout_height="@dimen/aqua_size_48"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            app:cardBackgroundColor="@color/aqua_color_transparent"
            app:cardCornerRadius="@dimen/aqua_size_24"
            app:cardElevation="@dimen/aqua_size_0"
            app:strokeColor="@color/aqua_status_success"
            app:strokeWidth="@dimen/aqua_size_2"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/aqua_status_success"
                android:textSize="@dimen/aqua_text_size_toolbar_score"
                android:textStyle="bold"
                tools:text="25" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimaryAction"
            style="@style/Widget.Aqua.Button.ToolbarPrimaryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/aqua_size_78"
            android:minHeight="@dimen/aqua_size_48"
            android:maxLines="1"
            android:visibility="gone"
            tools:text="+ Add"
            tools:visibility="visible" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/titleStatusContainer"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/aqua_size_12"
        android:layout_marginEnd="@dimen/aqua_size_8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toStartOf="@id/headerRightContainer"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextAppearance.Aqua.EditProfileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:text="@string/screen_title_device"
            android:textColor="?attr/colorOnSurface"
            tools:text="WRGB Pro Elite" />

        <ImageView
            android:id="@+id/imgStatusIcon"
            android:layout_width="@dimen/aqua_size_16"
            android:layout_height="@dimen/aqua_size_16"
            android:layout_marginStart="@dimen/aqua_size_7"
            android:scaleType="center"
            android:visibility="gone"
            app:tint="?attr/colorPrimary"
            tools:src="@drawable/ic_status_wifi"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
