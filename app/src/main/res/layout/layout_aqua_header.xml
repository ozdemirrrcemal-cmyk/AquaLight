<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/aquaHeaderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_color"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:clickable="true"
        android:contentDescription="@string/change_email_back_button_desc"
        android:focusable="true"
        android:scaleType="center"
        android:src="@drawable/ic_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/aqua_toolbar_icon_tint" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchContainer"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="18dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/aqua_input_background"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/aqua_input_stroke_unfocused"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <EditText
                android:id="@+id/etHeaderSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:hint="Type here to search..."
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="#8FA4BE"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/aqua_text_size_header_search"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnClearHeaderSearch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Anubias" />

            <TextView
                android:id="@+id/btnClearHeaderSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:contentDescription="Clear search"
                android:focusable="true"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/aqua_toolbar_icon_secondary"
                android:textSize="@dimen/aqua_text_size_toolbar_clear_action"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/headerRightContainer"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack">

        <LinearLayout
            android:id="@+id/headerActionsContainer"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/btnActionOne"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:tint="@color/aqua_toolbar_icon_tint"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/btnActionTwo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:tint="@color/aqua_toolbar_icon_tint"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/btnActionThree"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:tint="@color/aqua_toolbar_icon_tint"
                tools:visibility="visible" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnFilledIconAction"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_aqua_toolbar_filled_icon_action"
            android:clickable="true"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:visibility="gone"
            app:tint="@color/aqua_toolbar_icon_tint"
            tools:src="@drawable/ic_radar"
            tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCardIconAction"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            app:cardBackgroundColor="@color/aqua_toolbar_action_success_container"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/aqua_toolbar_action_success_outline"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/ivCardIconAction"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:src="@drawable/ic_check_24"
                app:tint="@android:color/white" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/btnPillTextAction"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_aqua_toolbar_pill_action_primary"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="58dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@android:color/white"
            android:textSize="@dimen/aqua_text_size_toolbar_pill_action"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Edit"
            tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/scoreContainer"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#4CAF50"
            app:strokeWidth="2dp"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#4CAF50"
                android:textSize="@dimen/aqua_text_size_toolbar_score"
                android:textStyle="bold"
                tools:text="25" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimaryAction"
            android:layout_width="78dp"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="0dp"
            android:paddingEnd="10dp"
            android:paddingBottom="0dp"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/aqua_text_size_toolbar_primary_action"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/aqua_toolbar_primary_action_container"
            app:cornerRadius="17dp"
            tools:text="+ Add"
            tools:visibility="visible" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/titleStatusContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toStartOf="@id/headerRightContainer"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextAppearance.Aqua.EditProfileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:text="Device"
            android:textColor="?attr/colorOnSurface"
            tools:text="WRGB Pro Elite" />

        <ImageView
            android:id="@+id/imgStatusIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="7dp"
            android:scaleType="center"
            android:visibility="gone"
            app:tint="?attr/colorPrimary"
            tools:src="@drawable/ic_status_wifi"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>