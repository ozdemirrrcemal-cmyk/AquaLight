<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Aqua.Card.Metric"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/aqua_size_8"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/aqua_size_10">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_44">

            <ImageView
                android:id="@+id/ivCalendar"
                android:layout_width="@dimen/aqua_size_24"
                android:layout_height="@dimen/aqua_size_24"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tank_health_calendar_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/aqua_card_text_primary" />

            <LinearLayout
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/aqua_size_10"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivChevron"
                app:layout_constraintStart_toEndOf="@id/ivCalendar"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_2"
                    android:includeFontPadding="false"
                    android:textColor="@color/aqua_content_muted"
                    android:textSize="@dimen/aqua_text_size_caption" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivChevron"
                android:layout_width="@dimen/aqua_size_20"
                android:layout_height="@dimen/aqua_size_20"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tank_health_chevron_right_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/aqua_card_text_secondary" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/metricsRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_72"
            android:layout_marginTop="@dimen/aqua_size_6"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/metricCardFirst"
                style="@style/Widget.Aqua.Card.Metric"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/aqua_size_0"
                android:layout_marginEnd="@dimen/aqua_size_3"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/aqua_size_8">

                    <TextView
                        android:id="@+id/tvMetricFirstLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro_caption" />

                    <TextView
                        android:id="@+id/tvMetricFirstValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_2"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMetricFirstStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_1"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textSize="@dimen/aqua_text_size_status_micro" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/metricCardSecond"
                style="@style/Widget.Aqua.Card.Metric"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/aqua_size_3"
                android:layout_marginEnd="@dimen/aqua_size_3"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/aqua_size_8">

                    <TextView
                        android:id="@+id/tvMetricSecondLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro_caption" />

                    <TextView
                        android:id="@+id/tvMetricSecondValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_2"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMetricSecondStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_1"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textSize="@dimen/aqua_text_size_status_micro" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/metricCardThird"
                style="@style/Widget.Aqua.Card.Metric"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/aqua_size_3"
                android:layout_marginEnd="@dimen/aqua_size_0"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/aqua_size_8">

                    <TextView
                        android:id="@+id/tvMetricThirdLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro_caption" />

                    <TextView
                        android:id="@+id/tvMetricThirdValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_2"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMetricThirdStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_1"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textSize="@dimen/aqua_text_size_status_micro" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
