<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/presetCardRoot"
    style="@style/Widget.Aqua.Light.Card.Preset"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="1dp"
    android:layout_marginEnd="1dp"
    android:layout_marginBottom="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="84dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="11dp"
        android:paddingTop="9dp"
        android:paddingEnd="9dp"
        android:paddingBottom="9dp">

        <View
            android:id="@+id/viewPresetColor"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_light_filter_selected" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPresetTitle"
                    style="@style/TextAppearance.Aqua.Light.PresetTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Plant Growth" />

                <TextView
                    android:id="@+id/btnPresetMore"
                    style="@style/TextAppearance.Aqua.Light.PresetMore"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="⋮" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvPresetCategory"
                style="@style/TextAppearance.Aqua.Light.PresetMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Built-in" />

            <TextView
                android:id="@+id/tvPresetSubtitle"
                style="@style/TextAppearance.Aqua.Light.PresetSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Balanced spectrum for planted tanks" />

            <LinearLayout
                android:id="@+id/presetChannelContainer"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPresetRed"
                    style="@style/TextAppearance.Aqua.Light.PresetChannel.Red"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="R90" />

                <TextView
                    android:id="@+id/tvPresetGreen"
                    style="@style/TextAppearance.Aqua.Light.PresetChannel.Green"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:text="G75" />

                <TextView
                    android:id="@+id/tvPresetBlue"
                    style="@style/TextAppearance.Aqua.Light.PresetChannel.Blue"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:text="B45" />

                <TextView
                    android:id="@+id/tvPresetWhite"
                    style="@style/TextAppearance.Aqua.Light.PresetChannel.White"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:text="W90" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
