<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/presetCardRoot"
    style="@style/Widget.Aqua.Light.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewPresetColor"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_light_filter_selected" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPresetTitle"
                    style="@style/TextAppearance.Aqua.Light.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    tools:text="Plant Growth" />

                <TextView
                    android:id="@+id/tvPresetCategory"
                    style="@style/TextAppearance.Aqua.Light.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="1"
                    tools:text="Built-in" />

            </LinearLayout>

            <TextView
                android:id="@+id/btnPresetMore"
                style="@style/TextAppearance.Aqua.Light.SectionTitle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="⋮" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvPresetSubtitle"
            style="@style/TextAppearance.Aqua.Light.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="2"
            tools:text="Balanced spectrum for planted tanks" />

        <LinearLayout
            android:id="@+id/presetChannelContainer"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPresetRed"
                style="@style/TextAppearance.Aqua.Light.ChannelValue.Red"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="R90" />

            <TextView
                android:id="@+id/tvPresetGreen"
                style="@style/TextAppearance.Aqua.Light.ChannelValue.Green"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="G75" />

            <TextView
                android:id="@+id/tvPresetBlue"
                style="@style/TextAppearance.Aqua.Light.ChannelValue.Blue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="B45" />

            <TextView
                android:id="@+id/tvPresetWhite"
                style="@style/TextAppearance.Aqua.Light.ChannelValue.White"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="W90" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>