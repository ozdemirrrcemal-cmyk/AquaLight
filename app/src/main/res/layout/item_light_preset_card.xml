<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/presetCardRoot"
    style="@style/Widget.Aqua.Light.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <View
            android:id="@+id/viewPresetColor"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_light_filter_selected" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPresetTitle"
                    style="@style/TextAppearance.Aqua.Light.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    tools:text="Plant Growth" />

                <TextView
                    android:id="@+id/btnPresetMore"
                    style="@style/TextAppearance.Aqua.Light.SectionTitle"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="⋮" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvPresetCategory"
                style="@style/TextAppearance.Aqua.Light.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                tools:text="Built-in" />

            <TextView
                android:id="@+id/tvPresetSubtitle"
                style="@style/TextAppearance.Aqua.Light.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Balanced spectrum for planted tanks" />

            <LinearLayout
                android:id="@+id/presetChannelContainer"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPresetRed"
                    style="@style/TextAppearance.Aqua.Light.ChannelValue.Red"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="R90" />

                <TextView
                    android:id="@+id/tvPresetGreen"
                    style="@style/TextAppearance.Aqua.Light.ChannelValue.Green"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="14dp"
                    android:gravity="center_vertical"
                    android:text="G75" />

                <TextView
                    android:id="@+id/tvPresetBlue"
                    style="@style/TextAppearance.Aqua.Light.ChannelValue.Blue"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="14dp"
                    android:gravity="center_vertical"
                    android:text="B45" />

                <TextView
                    android:id="@+id/tvPresetWhite"
                    style="@style/TextAppearance.Aqua.Light.ChannelValue.White"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="14dp"
                    android:gravity="center_vertical"
                    android:text="W90" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>