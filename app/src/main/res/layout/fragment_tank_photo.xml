<?xml version="1.0" encoding="utf-8"?>
<ScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/background_color"
  android:fillViewport="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/aqua_size_24"
    android:paddingEnd="@dimen/aqua_size_24"
    android:paddingTop="@dimen/aqua_size_28"
    android:paddingBottom="@dimen/aqua_size_24">

    <!-- Açıklama -->
    <TextView
      android:id="@+id/tvStepDescription"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/aqua_size_10"
      android:text="@string/aquarium_text_add_a_visual_reference_for_this_aquarium_you_can_use_a_photo"
      android:textColor="@color/aqua_card_text_secondary"
      android:textSize="@dimen/aqua_text_size_body"
      android:lineSpacingExtra="@dimen/aqua_size_3" />

    <!-- Fotoğraf kartı -->
    <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card.Form"
      android:id="@+id/cardPhotoContainer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/aqua_size_34">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/aqua_size_18">

        <TextView
          android:id="@+id/tvInputTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/aquarium_photo_title_full"
          android:textColor="@color/aqua_card_text_primary"
          android:textSize="@dimen/aqua_text_size_body_xlarge"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/tvInputHint"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/aqua_size_4"
          android:text="@string/aquarium_text_use_a_photo_to_make_this_aquarium_easier_to_recognize_later"
          android:textColor="@color/aqua_card_text_secondary"
          android:textSize="@dimen/aqua_text_size_body_small"
          android:lineSpacingExtra="@dimen/aqua_size_2" />

        <!-- Görsel alanı -->
        <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardAquariumImage"
          android:layout_width="match_parent"
          android:layout_height="@dimen/aqua_size_220"
          android:layout_marginTop="@dimen/aqua_size_18"
          app:cardCornerRadius="@dimen/aqua_size_18"
          app:cardElevation="@dimen/aqua_size_0"
          app:strokeWidth="@dimen/aqua_size_0">

          <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
              android:id="@+id/imgAquariumPhoto"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:contentDescription="@string/aquarium_content_desc_aquarium_photo"
              android:scaleType="centerCrop"
              android:src="@drawable/nature_aquarium" />

            <!-- Hafif koyu overlay -->
            <View
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@color/aqua_palette_hex_26000000" />

            <!-- Sağ alt kamera butonu -->
            <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card.PhotoOverlay"
              android:id="@+id/btnCamera"
              android:layout_width="@dimen/aqua_size_44"
              android:layout_height="@dimen/aqua_size_44"
              android:layout_gravity="bottom|end"
              android:layout_marginEnd="@dimen/aqua_size_14"
              android:layout_marginBottom="@dimen/aqua_size_14"
              android:clickable="true"
              android:focusable="true"
              android:foreground="?attr/selectableItemBackgroundBorderless"
              app:cardElevation="@dimen/aqua_size_4">

              <ImageView
                android:layout_width="@dimen/aqua_size_20"
                android:layout_height="@dimen/aqua_size_20"
                android:layout_gravity="center"
                android:contentDescription="@string/aquarium_content_desc_select_photo"
                android:src="@drawable/ic_camera_24"
                app:tint="@android:color/white" />

            </com.google.android.material.card.MaterialCardView>

          </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Add Plant butonu -->
        <com.google.android.material.button.MaterialButton
          android:id="@+id/btnAddPlant"
          style="@style/Widget.Aqua.Button.Primary"
          android:layout_width="match_parent"
          android:layout_height="@dimen/aqua_button_height"
          android:layout_marginTop="@dimen/aqua_size_18"
          android:text="@string/aquarium_text_add_plant"
          android:textAllCaps="false"
          android:textSize="@dimen/aqua_text_size_body_xlarge"
          android:textStyle="bold" />
        <LinearLayout
          android:id="@+id/selectedPlantsContainer"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/aqua_size_18"
          android:orientation="vertical" />
      </LinearLayout>

    </com.google.android.material.card.MaterialCardView>



  </LinearLayout>

</ScrollView>