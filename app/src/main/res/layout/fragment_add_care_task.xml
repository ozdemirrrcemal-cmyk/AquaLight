<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/background_color">

  <include
    android:id="@+id/appHeader"
    layout="@layout/layout_aqua_header"
    android:layout_width="@dimen/aqua_size_0"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

  <ScrollView
    android:id="@+id/contentScrollView"
    android:layout_width="@dimen/aqua_size_0"
    android:layout_height="@dimen/aqua_size_0"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="@dimen/aqua_size_16"
    android:paddingTop="@dimen/aqua_size_18"
    android:paddingEnd="@dimen/aqua_size_16"
    android:paddingBottom="@dimen/aqua_size_24"
    android:scrollbars="none"
    app:layout_constraintBottom_toTopOf="@id/footerContainer"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/appHeader">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/maintenance_task_type_label"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="@dimen/aqua_text_size_body_large"
        android:textStyle="bold" />

      <LinearLayout
  style="@style/Widget.Aqua.SelectionRow.Large"
        android:id="@+id/rowTaskType"
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_72"
        android:layout_marginTop="@dimen/aqua_size_12"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
          android:id="@+id/taskTypeIconContainer"
          android:layout_width="@dimen/aqua_size_44"
          android:layout_height="@dimen/aqua_size_44"
          android:layout_marginEnd="@dimen/aqua_size_12"
          android:visibility="gone">

          <ImageView
            android:id="@+id/ivTaskTypeIcon"
            android:layout_width="@dimen/aqua_size_24"
            android:layout_height="@dimen/aqua_size_24"
            android:layout_gravity="center"
            android:scaleType="centerInside"
            app:tint="@color/aqua_content_on_dark" />

        </FrameLayout>

        <LinearLayout
          android:layout_width="@dimen/aqua_size_0"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/aqua_size_0"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/tvTaskTypeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/maintenance_select_care_task_type"
            android:textColor="@color/aqua_card_text_secondary"
            android:textSize="@dimen/aqua_text_size_body"
            android:textStyle="bold" />

          <TextView
            android:id="@+id/tvTaskTypeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_6"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/maintenance_required"
            android:textColor="@color/aqua_card_text_secondary"
            android:textSize="@dimen/aqua_text_size_caption_plus" />

        </LinearLayout>

        <ImageView
          android:layout_width="@dimen/aqua_size_22"
          android:layout_height="@dimen/aqua_size_22"
          android:src="@drawable/ic_arrow_right"
          app:tint="@color/aqua_card_text_secondary" />

      </LinearLayout>

      <LinearLayout
        android:id="@+id/customTitleSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_18"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:includeFontPadding="false"
          android:text="@string/maintenance_custom_title_label"
          android:textColor="@color/aqua_card_text_primary"
          android:textSize="@dimen/aqua_text_size_body_small"
          android:textStyle="bold" />

        <EditText
        style="@style/Widget.Aqua.Input.PlainEditText"
          android:id="@+id/etCustomTitle"
          android:layout_width="match_parent"
          android:layout_height="@dimen/aqua_size_50"
          android:layout_marginTop="@dimen/aqua_size_9"
          android:hint="@string/maintenance_custom_title_hint"
          android:inputType="textCapSentences"
          android:singleLine="true" />

      </LinearLayout>

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_22"
        android:includeFontPadding="false"
        android:text="@string/maintenance_aquarium_label"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="@dimen/aqua_text_size_body_large"
        android:textStyle="bold" />

      <LinearLayout
  style="@style/Widget.Aqua.SelectionRow"
        android:id="@+id/rowAquarium"
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_64"
        android:layout_marginTop="@dimen/aqua_size_12"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
          android:layout_width="@dimen/aqua_size_0"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

          <TextView
            android:id="@+id/tvAquariumTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/maintenance_select_aquarium"
            android:textColor="@color/aqua_card_text_secondary"
            android:textSize="@dimen/aqua_text_size_body"
            android:textStyle="bold" />

          <TextView
            android:id="@+id/tvAquariumSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_6"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/maintenance_required"
            android:textColor="@color/aqua_card_text_secondary"
            android:textSize="@dimen/aqua_text_size_caption_plus" />

        </LinearLayout>

        <ImageView
          android:layout_width="@dimen/aqua_size_22"
          android:layout_height="@dimen/aqua_size_22"
          android:src="@drawable/ic_arrow_right"
          app:tint="@color/aqua_card_text_secondary" />

      </LinearLayout>

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_22"
        android:includeFontPadding="false"
        android:text="@string/maintenance_schedule_label"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="@dimen/aqua_text_size_body_large"
        android:textStyle="bold" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_12"
        android:orientation="horizontal">

        <LinearLayout
  style="@style/Widget.Aqua.SelectionRow.Compact"
          android:id="@+id/rowDueDate"
          android:layout_width="@dimen/aqua_size_0"
          android:layout_height="@dimen/aqua_size_54"
          android:layout_marginEnd="@dimen/aqua_size_8"
          android:layout_weight="1"
          android:gravity="center_vertical"
          android:orientation="vertical">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/maintenance_date_label"
            android:textColor="@color/aqua_card_text_secondary"
            android:textSize="@dimen/aqua_text_size_micro_plus" />

          <TextView
            android:id="@+id/tvDueDateValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_5"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body"
            android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
  style="@style/Widget.Aqua.SelectionRow.Compact"
          android:id="@+id/rowDueTime"
          android:layout_width="@dimen/aqua_size_0"
          android:layout_height="@dimen/aqua_size_54"
          android:layout_marginStart="@dimen/aqua_size_8"
          android:layout_weight="1"
          android:gravity="center_vertical"
          android:orientation="vertical">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/maintenance_time_label"
            android:textColor="@color/aqua_card_text_secondary"
            android:textSize="@dimen/aqua_text_size_micro_plus" />

          <TextView
            android:id="@+id/tvDueTimeValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_5"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body"
            android:textStyle="bold" />

        </LinearLayout>

      </LinearLayout>

      <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_22">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="@dimen/aqua_size_14">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
              android:layout_width="@dimen/aqua_size_0"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">

              <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/maintenance_repeat_label"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body"
                android:textStyle="bold" />

              <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_6"
                android:includeFontPadding="false"
                android:text="@string/maintenance_repeat_description"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_caption_plus" />

            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
              android:id="@+id/switchRepeat"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />

          </LinearLayout>

          <LinearLayout
            android:id="@+id/repeatDaysContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_14"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
              android:layout_width="@dimen/aqua_size_0"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:includeFontPadding="false"
              android:text="@string/maintenance_repeat_every_label"
              android:textColor="@color/aqua_content_tertiary"
              android:textSize="@dimen/aqua_text_size_body_small" />

            <EditText
        style="@style/Widget.Aqua.Input.PlainEditText.Compact"
              android:id="@+id/etRepeatDays"
              android:layout_width="@dimen/aqua_size_70"
              android:layout_height="@dimen/aqua_size_42"
              android:gravity="center"
              android:inputType="number"
              android:maxLength="3"
              android:text="@string/maintenance_default_repeat_days"
              android:textStyle="bold" />

            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="@dimen/aqua_size_10"
              android:includeFontPadding="false"
              android:text="@string/maintenance_days_label"
              android:textColor="@color/aqua_content_tertiary"
              android:textSize="@dimen/aqua_text_size_body_small" />

          </LinearLayout>

        </LinearLayout>

      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_14">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="@dimen/aqua_size_14">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
              android:layout_width="@dimen/aqua_size_0"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">

              <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/maintenance_reminder_label"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body"
                android:textStyle="bold" />

              <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_6"
                android:includeFontPadding="false"
                android:text="@string/maintenance_reminder_description"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_caption_plus" />

            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
              android:id="@+id/switchReminder"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:checked="true" />

          </LinearLayout>

          <LinearLayout
            android:id="@+id/missedReminderSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_16"
            android:orientation="vertical">

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal">

              <LinearLayout
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:includeFontPadding="false"
                  android:text="@string/maintenance_missed_reminder_label"
                  android:textColor="@color/aqua_card_text_primary"
                  android:textSize="@dimen/aqua_text_size_body"
                  android:textStyle="bold" />

                <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/aqua_size_6"
                  android:includeFontPadding="false"
                  android:text="@string/maintenance_missed_reminder_description"
                  android:textColor="@color/aqua_card_text_secondary"
                  android:textSize="@dimen/aqua_text_size_caption_plus" />

              </LinearLayout>

              <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchMissedReminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

            </LinearLayout>

            <LinearLayout
              android:id="@+id/missedReminderDaysContainer"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/aqua_size_14"
              android:gravity="center_vertical"
              android:orientation="horizontal">

              <TextView
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/maintenance_repeat_missed_reminders_for_label"
                android:textColor="@color/aqua_content_tertiary"
                android:textSize="@dimen/aqua_text_size_body_small" />

              <EditText
        style="@style/Widget.Aqua.Input.PlainEditText.Compact"
                android:id="@+id/etMissedReminderDays"
                android:layout_width="@dimen/aqua_size_70"
                android:layout_height="@dimen/aqua_size_42"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="2"
                android:text="@string/maintenance_default_missed_reminder_days"
                android:textStyle="bold" />

              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/aqua_size_10"
                android:includeFontPadding="false"
                android:text="@string/maintenance_days_label"
                android:textColor="@color/aqua_content_tertiary"
                android:textSize="@dimen/aqua_text_size_body_small" />

            </LinearLayout>

          </LinearLayout>

        </LinearLayout>

      </com.google.android.material.card.MaterialCardView>

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_22"
        android:includeFontPadding="false"
        android:text="@string/maintenance_note_label"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="@dimen/aqua_text_size_body_small"
        android:textStyle="bold" />

      <EditText
        style="@style/Widget.Aqua.Input.PlainEditText.Multiline"
        android:id="@+id/etNote"
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_112"
        android:layout_marginTop="@dimen/aqua_size_9"
        android:gravity="top|start"
        android:hint="@string/maintenance_note_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="5"
        android:minLines="4" />

    </LinearLayout>

  </ScrollView>

  <LinearLayout
    android:id="@+id/footerContainer"
    android:layout_width="@dimen/aqua_size_0"
    android:layout_height="wrap_content"
    android:background="@color/background_color"
    android:elevation="@dimen/aqua_size_10"
    android:orientation="vertical"
    android:paddingStart="@dimen/aqua_size_16"
    android:paddingTop="@dimen/aqua_size_12"
    android:paddingEnd="@dimen/aqua_size_16"
    android:paddingBottom="@dimen/aqua_size_16"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">

    <com.google.android.material.button.MaterialButton
      style="@style/Widget.Aqua.Button.Primary"
      android:id="@+id/btnSaveTask"
      android:layout_width="match_parent"
      android:layout_height="@dimen/aqua_button_height"
      android:enabled="false"
      android:text="@string/maintenance_save_task"
      android:textStyle="bold" />

  </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>