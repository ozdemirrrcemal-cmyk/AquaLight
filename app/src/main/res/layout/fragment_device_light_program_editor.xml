<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_bg"
    tools:context=".ui.tabs.devices.detail.light.programs.editor.DeviceLightProgramEditorFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/editorScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="116dp"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toTopOf="@id/saveBarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/editorContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- GRAPH -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProgramGraph"
                style="@style/Widget.Aqua.Light.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="14dp">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.SectionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Light Curve" />

                        <TextView
                            android:id="@+id/btnPreviewProgram"
                            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_light_filter_selected"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Preview" />

                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/lightCurveGraphContainer"
                        android:layout_width="match_parent"
                        android:layout_height="260dp"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="0dp"
                        android:background="@drawable/bg_light_timeline_panel">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="12dp"
                            android:text="100%" />

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="12dp"
                            android:text="50%" />

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="34dp"
                            android:text="0%" />

                        <View
                            android:id="@+id/graphBaseline"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_gravity="bottom"
                            android:layout_marginStart="54dp"
                            android:layout_marginEnd="12dp"
                            android:layout_marginBottom="54dp"
                            android:background="@color/light_stroke" />

                        <TextView
                            android:id="@+id/tvGraphPlaceholder"
                            style="@style/TextAppearance.Aqua.Light.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Graph preview"
                            android:textColor="@color/light_text_tertiary" />

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="54dp"
                            android:layout_marginBottom="18dp"
                            android:text="0" />

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="130dp"
                            android:layout_marginBottom="18dp"
                            android:text="4" />

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="18dp"
                            android:text="8" />

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="92dp"
                            android:layout_marginBottom="18dp"
                            android:text="12" />

                    </FrameLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- TIMING -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardScheduleTiming"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Schedule Timing" />

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Set the shared timing for all color channels." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTimeStart"
                            style="@style/TextAppearance.Aqua.Light.BodyStrong"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_light_program_time_panel"
                            android:gravity="center_vertical"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="Start        07:00" />

                        <TextView
                            android:id="@+id/tvTimePeakStart"
                            style="@style/TextAppearance.Aqua.Light.BodyStrong"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_light_program_time_panel"
                            android:gravity="center_vertical"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="Peak Start   09:00" />

                        <TextView
                            android:id="@+id/tvTimePeakEnd"
                            style="@style/TextAppearance.Aqua.Light.BodyStrong"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_light_program_time_panel"
                            android:gravity="center_vertical"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="Peak End     17:00" />

                        <TextView
                            android:id="@+id/tvTimeEnd"
                            style="@style/TextAppearance.Aqua.Light.BodyStrong"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_light_program_time_panel"
                            android:gravity="center_vertical"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="End          20:00" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CHANNEL OUTPUT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChannelOutput"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Channel Output" />

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Set peak output level for each color channel." />

                    <TextView
                        android:id="@+id/tvRedValue"
                        style="@style/TextAppearance.Aqua.Light.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Red 80%" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="80"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="1" />

                    <TextView
                        android:id="@+id/tvGreenValue"
                        style="@style/TextAppearance.Aqua.Light.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Green 85%" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderGreen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="85"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="1" />

                    <TextView
                        android:id="@+id/tvBlueValue"
                        style="@style/TextAppearance.Aqua.Light.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Blue 100%" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderBlue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="100"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="1" />

                    <TextView
                        android:id="@+id/tvWhiteValue"
                        style="@style/TextAppearance.Aqua.Light.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="White 60%" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderWhite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="60"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="1" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- REPEAT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRepeat"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Repeat" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_light_filter_bar"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/repeatEvery"
                            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_filter_selected"
                            android:gravity="center"
                            android:text="Every" />

                        <TextView
                            android:id="@+id/repeatWeekdays"
                            style="@style/TextAppearance.Aqua.Light.Filter"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Weekdays" />

                        <TextView
                            android:id="@+id/repeatWeekend"
                            style="@style/TextAppearance.Aqua.Light.Filter"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Weekend" />

                        <TextView
                            android:id="@+id/repeatCustom"
                            style="@style/TextAppearance.Aqua.Light.Filter"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Custom" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- PROGRAM SETTINGS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProgramSettings"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Program Settings" />

                    <include
                        android:id="@+id/actionMoonlight"
                        layout="@layout/item_light_editor_action_row" />

                    <include
                        android:id="@+id/actionCloudSimulation"
                        layout="@layout/item_light_editor_action_row" />

                    <include
                        android:id="@+id/actionTransitionSmoothing"
                        layout="@layout/item_light_editor_action_row" />

                    <include
                        android:id="@+id/actionNaturalVariation"
                        layout="@layout/item_light_editor_action_row" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/saveBarContainer"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:background="@color/light_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoadToDevice"
            style="@style/Widget.Aqua.Light.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1.25"
            android:text="Load to Device" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAs"
            style="@style/Widget.Aqua.Light.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Save As" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>