<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_bg"
    tools:context=".ui.tabs.devices.detail.light.programs.editor.DeviceLightProgramEditorFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/editorScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="10dp"
        android:paddingTop="16dp"
        android:paddingEnd="10dp"
        android:paddingBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toTopOf="@id/saveBarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/editorContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- GRAPH -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProgramGraph"
                style="@style/Widget.Aqua.Light.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="14dp">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.SectionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Light Curve" />

                        <TextView
                            android:id="@+id/btnPreviewProgram"
                            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_light_filter_selected"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Preview" />

                    </LinearLayout>

                    <com.aqua.aqualight.ui.tabs.devices.detail.light.curve.view.LightCurveGraphView
                        android:id="@+id/lightCurveGraphView"
                        android:layout_width="match_parent"
                        android:layout_height="270dp" />
						
						<View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:background="@color/light_stroke" />

<LinearLayout
    android:id="@+id/curveStatsRow"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            style="@style/TextAppearance.Aqua.Light.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OUTPUT" />

        <TextView
            android:id="@+id/tvCurveOutput"
            style="@style/TextAppearance.Aqua.Light.BodyStrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="85%" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            style="@style/TextAppearance.Aqua.Light.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POWER" />

        <TextView
            android:id="@+id/tvCurvePower"
            style="@style/TextAppearance.Aqua.Light.BodyStrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="34.6W" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            style="@style/TextAppearance.Aqua.Light.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DURATION" />

        <TextView
            android:id="@+id/tvCurveDuration"
            style="@style/TextAppearance.Aqua.Light.BodyStrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="13h" />

    </LinearLayout>

</LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CHANNEL OUTPUT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChannelOutput"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="18dp">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Channel Output" />

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"
                        android:text="Peak output level for each color channel." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderRed"
                            style="@style/Widget.Aqua.Light.Slider.Red"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:value="80"
                            android:valueFrom="0"
                            android:valueTo="100"
                            android:stepSize="1" />

                        <TextView
                            android:id="@+id/tvRedValue"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Red"
                            android:layout_width="54dp"
                            android:layout_height="wrap_content"
                            android:gravity="end|center_vertical"
                            android:text="80%" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderGreen"
                            style="@style/Widget.Aqua.Light.Slider.Green"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:value="85"
                            android:valueFrom="0"
                            android:valueTo="100"
                            android:stepSize="1" />

                        <TextView
                            android:id="@+id/tvGreenValue"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Green"
                            android:layout_width="54dp"
                            android:layout_height="wrap_content"
                            android:gravity="end|center_vertical"
                            android:text="85%" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderBlue"
                            style="@style/Widget.Aqua.Light.Slider.Blue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:value="100"
                            android:valueFrom="0"
                            android:valueTo="100"
                            android:stepSize="1" />

                        <TextView
                            android:id="@+id/tvBlueValue"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Blue"
                            android:layout_width="54dp"
                            android:layout_height="wrap_content"
                            android:gravity="end|center_vertical"
                            android:text="100%" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderWhite"
                            style="@style/Widget.Aqua.Light.Slider.White"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:value="60"
                            android:valueFrom="0"
                            android:valueTo="100"
                            android:stepSize="1" />

                        <TextView
                            android:id="@+id/tvWhiteValue"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.White"
                            android:layout_width="54dp"
                            android:layout_height="wrap_content"
                            android:gravity="end|center_vertical"
                            android:text="60%" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- TIMING -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardScheduleTiming"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="18dp">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Schedule Timing" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/tvTimeStart"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_light_program_time_panel"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.TimeLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Start" />

                            <TextView
    android:id="@+id/tvTimeStartValue"
    style="@style/TextAppearance.Aqua.Light.TimeValue"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="07:00" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tvTimePeakStart"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_light_program_time_panel"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.TimeLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Peak Start" />

                            <TextView
    android:id="@+id/tvTimePeakStartValue"
    style="@style/TextAppearance.Aqua.Light.TimeValue"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="09:00" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tvTimePeakEnd"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_light_program_time_panel"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.TimeLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Peak End" />

                           <TextView
    android:id="@+id/tvTimePeakEndValue"
    style="@style/TextAppearance.Aqua.Light.TimeValue"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="17:00" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tvTimeEnd"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_light_program_time_panel"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.TimeLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="End" />

                            <TextView
    android:id="@+id/tvTimeEndValue"
    style="@style/TextAppearance.Aqua.Light.TimeValue"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="20:00" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- REPEAT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRepeat"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="18dp">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Repeat" />

                    <LinearLayout
                        android:id="@+id/repeatOptionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_light_filter_bar"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="3dp">

                        <TextView
                            android:id="@+id/repeatEvery"
                            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_filter_selected"
                            android:gravity="center"
                            android:text="Every"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/repeatWeekdays"
                            style="@style/TextAppearance.Aqua.Light.Filter"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Week"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/repeatWeekend"
                            style="@style/TextAppearance.Aqua.Light.Filter"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Weekend"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/repeatCustom"
                            style="@style/TextAppearance.Aqua.Light.Filter"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Custom"
                            android:textSize="12sp" />

                    </LinearLayout>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- PROGRAM SETTINGS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProgramSettings"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Program Settings" />

                    <include
                        android:id="@+id/actionMoonlight"
                        layout="@layout/item_light_editor_action_row" />

                    <include
                        android:id="@+id/actionCloudSimulation"
                        layout="@layout/item_light_editor_action_row" />

                    <include
                        android:id="@+id/actionTransitionSmoothing"
                        layout="@layout/item_light_editor_action_row" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/saveBarContainer"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:background="@color/light_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoadToDevice"
            style="@style/Widget.Aqua.Light.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1.25"
            android:text="Load to Device" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAs"
            style="@style/Widget.Aqua.Light.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Save As" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>