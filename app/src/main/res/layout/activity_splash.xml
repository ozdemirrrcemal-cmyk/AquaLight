<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.splash.SplashActivity">

    <!-- 🔹 Logo -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="@dimen/aqua_size_value_160"
        android:layout_height="@dimen/aqua_size_value_160"
        android:src="@drawable/logo_login"
        android:contentDescription="@string/splasch_logo_description"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/aqua_space_value_140" />

    <!-- 🔹 Başlık -->
    <TextView
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/SplashTitleText"
        android:text="@string/splasch_app_title"
        app:layout_constraintTop_toBottomOf="@id/logoImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/aqua_space_value_24" />

    <!-- 🔹 Alt başlık -->
    <TextView
        android:id="@+id/appSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/SplashSubtitleText"
        android:text="@string/splasch_app_subtitle"
        app:layout_constraintTop_toBottomOf="@id/appTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/aqua_space_value_6" />

</androidx.constraintlayout.widget.ConstraintLayout>