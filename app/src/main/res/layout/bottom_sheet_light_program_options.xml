<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/programOptionsSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_light_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_light_sheet_handle" />

    <TextView
        android:id="@+id/tvSheetTitle"
        style="@style/TextAppearance.Aqua.Light.SheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Program Options" />

    <TextView
        android:id="@+id/tvSheetSubtitle"
        style="@style/TextAppearance.Aqua.Light.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nature Day · 08:00 → 20:00" />

    <LinearLayout
        android:id="@+id/rowProgramActive"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_light_program_time_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="14dp">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_light_sheet_icon"
            android:gravity="center"
            android:text="●"
            android:textColor="@color/light_accent"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Aqua.Light.SheetRowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Program" />

           <TextView
    style="@style/TextAppearance.Aqua.Light.SheetRowSubtitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Use this program on the device" />

        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchProgramActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowDuplicateProgram"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="14dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_light_sheet_icon"
            android:gravity="center"
            android:text="⧉"
            android:textColor="@color/light_accent"
            android:textSize="18sp" />

        <TextView
            style="@style/TextAppearance.Aqua.Light.SheetRowTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Duplicate" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowRenameProgram"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_light_sheet_icon"
            android:gravity="center"
            android:text="Aa"
            android:textColor="@color/light_gold"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            style="@style/TextAppearance.Aqua.Light.SheetRowTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Rename" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowDeleteProgram"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_light_sheet_icon"
            android:gravity="center"
            android:text="!"
            android:textColor="@color/light_status_error"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            style="@style/TextAppearance.Aqua.Light.SheetRowTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Delete"
            android:textColor="@color/light_status_error" />

    </LinearLayout>

</LinearLayout>