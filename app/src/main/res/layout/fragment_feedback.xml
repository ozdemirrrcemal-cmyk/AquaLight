<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".ui.tabs.settings.feedback.FeedbackFragment">

    <!-- 🔹 Üst Bar -->
  <include
    android:id="@+id/appHeader"
    layout="@layout/layout_aqua_header"
    android:layout_width="@dimen/aqua_size_0"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <!-- 🔹 İçerik -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_10"
            android:paddingEnd="@dimen/aqua_size_10"
            android:paddingTop="@dimen/aqua_size_16"
            android:paddingBottom="@dimen/aqua_size_16">

            <!-- Üst açıklama -->
            <TextView
                android:id="@+id/tvSubInfo"
                style="@style/TextAppearance.Aqua.Feedback.SubInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_size_16"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/aqua_size_4"
                android:contentDescription="@string/feedback_subinfo_desc" />

            <!-- 🟦 FORM CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFeedbackForm"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/formContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_16">

                    <!-- CATEGORY -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutCategory"
                        style="@style/Widget.Aqua.Input.Layout.Feedback.Multiline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/feedback_hint_category"
                        app:startIconDrawable="@drawable/ic_category"
                        app:startIconTint="@color/aqua_accent_aqua"
                        app:endIconMode="dropdown_menu"
                        app:endIconTint="@color/aqua_input_layout_category_end_icon_tint">

                        <AutoCompleteTextView
                            android:id="@+id/autoCategory"
                            style="@style/Widget.Aqua.Input.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:focusable="true"
                            android:clickable="true"
                            android:cursorVisible="false" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- EMAIL -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutEmail"
                        style="@style/Widget.Aqua.Input.Layout.Feedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_16"
                        android:hint="@string/feedback_hint_email"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="@color/aqua_accent_aqua">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            style="@style/Widget.Aqua.Input.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- MESSAGE -->
                    <FrameLayout
                        android:id="@+id/messageContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_16">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLayoutMessage"
                            style="@style/Widget.Aqua.Input.Layout.Feedback.Multiline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/feedback_hint_message"
                            app:startIconDrawable="@drawable/ic_message"
                            app:startIconTint="@color/aqua_accent_aqua"
                            app:counterEnabled="true"
                            app:counterMaxLength="500">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMessage"
                                style="@style/Widget.Aqua.Input.EditText.Multiline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minLines="4"
                                android:gravity="top"
                                android:inputType="textMultiLine"
                                android:overScrollMode="never" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- SUCCESS LOTTIE -->
                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottieSuccess"
                            android:layout_width="@dimen/aqua_size_60"
                            android:layout_height="@dimen/aqua_size_60"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            app:lottie_rawRes="@raw/success_feedback"
                            app:lottie_autoPlay="false"
                            app:lottie_loop="false" />

                    </FrameLayout>

                    <!-- ATTACHMENT TITLE -->
                    <TextView
                        android:id="@+id/tvScreenshotLabel"
                        style="@style/TextAppearance.Aqua.Feedback.SubInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_16"
                        android:text="@string/feedback_attachment_title"
                        android:gravity="start" />

                    <!-- ATTACHMENT CARD -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardScreenshot"
                        style="@style/Widget.Aqua.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        app:cardElevation="@dimen/aqua_size_0"
                        app:cardUseCompatPadding="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- TOP ROW -->
                            <LinearLayout
                                android:id="@+id/rowAddScreenshot"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="@dimen/aqua_size_12"
                                android:paddingVertical="@dimen/aqua_size_10"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?attr/selectableItemBackgroundBorderless">

                                <ImageView
                                    android:id="@+id/ivScreenshotIcon"
                                    android:layout_width="@dimen/aqua_size_24"
                                    android:layout_height="@dimen/aqua_size_24"
                                    android:src="@drawable/ic_image"
                                    app:tint="@color/aqua_card_text_secondary" />

                                <TextView
                                    android:id="@+id/tvScreenshotInfo"
                                    android:layout_width="@dimen/aqua_size_0"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/aqua_size_12"
                                    android:layout_weight="1"
                                    android:text="@string/feedback_screenshot_add"
                                    android:textSize="@dimen/aqua_text_size_body"
                                    android:textColor="@color/aqua_card_text_secondary" />

                                <ImageView
                                    android:id="@+id/ivScreenshotClear"
                                    android:layout_width="@dimen/aqua_size_24"
                                    android:layout_height="@dimen/aqua_size_24"
                                    android:src="@drawable/ic_close"
                                    android:visibility="gone"
                                    app:tint="@color/aqua_card_text_secondary" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SEND BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSend"
                style="@style/Widget.Aqua.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_button_height"
                android:layout_marginTop="@dimen/aqua_size_24"
                android:text="@string/feedback_send"
                android:textAllCaps="false"
                android:contentDescription="@string/feedback_send_desc"
                app:icon="@drawable/ic_send"
                app:iconSize="@dimen/aqua_size_18"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/aqua_size_8" />

            <!-- PROGRESS -->
            <ProgressBar
                android:id="@+id/progressBarSending"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/aqua_size_8"
                android:visibility="gone" />

            <!-- FOOTER -->
            <TextView
                android:id="@+id/tvFooter"
                style="@style/TextAppearance.Aqua.Feedback.Footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_12"
                android:layout_marginBottom="@dimen/aqua_size_16"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/aqua_size_3"
                android:contentDescription="@string/feedback_footer_desc" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>