<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".ui.tabs.settings.feedback.FeedbackFragment">

    <!-- 🔹 Üst Bar (DEĞİŞMEYECEK) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:background="@color/background_color"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 🔙 Geri Butonu -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:scaleType="center"
            app:tint="?attr/colorOnSurface"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/feedback_back_button_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 🏷️ Başlık -->
        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextAppearance.Aqua.EditProfileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedback_title"
            android:importantForAccessibility="yes"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 🔹 İçerik -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Üst açıklama -->
            <TextView
                android:id="@+id/tvSubInfo"
                style="@style/TextAppearance.Aqua.Feedback.SubInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="@string/feedback_subinfo_desc" />

            <!-- 🟦 Feedback formu (card) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFeedbackForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Aqua.CardStyles">

                <LinearLayout
                    android:id="@+id/formContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:contentDescription="@string/feedback_form_desc">

                    <!-- Kategori seçimi -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutCategory"
                        style="@style/AuthTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/feedback_hint_category"
                        android:contentDescription="@string/feedback_category_desc"
                        app:startIconDrawable="@drawable/ic_category"
                        app:startIconTint="#64FFDA"
                        app:endIconMode="dropdown_menu"
                        app:endIconTint="#7A8CA3">

                        <AutoCompleteTextView
                            android:id="@+id/autoCategory"
                            style="@style/AuthEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:focusable="true"
                            android:clickable="true"
                            android:cursorVisible="false"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- E-posta (opsiyonel) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutEmail"
                        style="@style/AuthTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/feedback_hint_email"
                        android:layout_marginTop="16dp"
                        android:contentDescription="@string/feedback_email_desc"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="#64FFDA">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            style="@style/AuthEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Mesaj -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutMessage"
                        style="@style/AuthTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/feedback_hint_message"
                        android:layout_marginTop="16dp"
                        android:contentDescription="@string/feedback_message_area_desc"
                        app:startIconDrawable="@drawable/ic_message"
                        app:startIconTint="#64FFDA"
                        app:counterEnabled="true"
                        app:counterMaxLength="500">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMessage"
                            style="@style/AuthEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="4"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:overScrollMode="never" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Başarılı mesaj -->
                    <TextView
                        android:id="@+id/tvSuccessMessage"
                        style="@style/TextAppearance.Aqua.Feedback.Success"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:visibility="gone"
                        android:alpha="0"
                        android:contentDescription="@string/feedback_success_desc" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Gönder butonu -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSend"
                style="@style/Widget.Aqua.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/feedback_send"
                android:textAllCaps="false"
                app:icon="@drawable/ic_send"
                app:iconTint="#64FFDA"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:contentDescription="@string/feedback_send_desc" />

            <!-- Alt bilgi -->
            <TextView
                android:id="@+id/tvFooter"
                style="@style/TextAppearance.Aqua.Feedback.Footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:contentDescription="@string/feedback_footer_desc" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>