<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".ui.tabs.settings.feedback.FeedbackFragment">

    <!-- 🔹 Üst Bar -->
  <include
    android:id="@+id/appHeader"
    layout="@layout/layout_aqua_header"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <!-- 🔹 İçerik -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Üst açıklama -->
            <TextView
                android:id="@+id/tvSubInfo"
                style="@style/TextAppearance.Aqua.Feedback.SubInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:contentDescription="@string/feedback_subinfo_desc" />

            <!-- 🟦 FORM CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFeedbackForm"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/formContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- CATEGORY -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutCategory"
                        style="@style/Widget.Aqua.Input.Layout.Feedback.Multiline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/feedback_hint_category"
                        app:startIconDrawable="@drawable/ic_category"
                        app:startIconTint="#64FFDA"
                        app:endIconMode="dropdown_menu"
                        app:endIconTint="#7A8CA3">

                        <AutoCompleteTextView
                            android:id="@+id/autoCategory"
                            style="@style/Widget.Aqua.Input.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:focusable="true"
                            android:clickable="true"
                            android:cursorVisible="false" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- EMAIL -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutEmail"
                        style="@style/Widget.Aqua.Input.Layout.Feedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/feedback_hint_email"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="#64FFDA">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            style="@style/Widget.Aqua.Input.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- MESSAGE -->
                    <FrameLayout
                        android:id="@+id/messageContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputLayoutMessage"
                            style="@style/Widget.Aqua.Input.Layout.Feedback.Multiline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/feedback_hint_message"
                            app:startIconDrawable="@drawable/ic_message"
                            app:startIconTint="#64FFDA"
                            app:counterEnabled="true"
                            app:counterMaxLength="500">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMessage"
                                style="@style/Widget.Aqua.Input.EditText.Multiline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minLines="4"
                                android:gravity="top"
                                android:inputType="textMultiLine"
                                android:overScrollMode="never" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- SUCCESS LOTTIE -->
                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottieSuccess"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            app:lottie_rawRes="@raw/success_feedback"
                            app:lottie_autoPlay="false"
                            app:lottie_loop="false" />

                    </FrameLayout>

                    <!-- ATTACHMENT TITLE -->
                    <TextView
                        android:id="@+id/tvScreenshotLabel"
                        style="@style/TextAppearance.Aqua.Feedback.SubInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/feedback_attachment_title"
                        android:gravity="start" />

                    <!-- ATTACHMENT CARD -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardScreenshot"
                        style="@style/Widget.Aqua.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardElevation="0dp"
                        app:cardUseCompatPadding="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- TOP ROW -->
                            <LinearLayout
                                android:id="@+id/rowAddScreenshot"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="10dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?attr/selectableItemBackgroundBorderless">

                                <ImageView
                                    android:id="@+id/ivScreenshotIcon"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_image"
                                    app:tint="@color/aqua_card_text_secondary" />

                                <TextView
                                    android:id="@+id/tvScreenshotInfo"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:text="@string/feedback_screenshot_add"
                                    android:textSize="@dimen/aqua_text_size_body"
                                    android:textColor="@color/aqua_card_text_secondary" />

                                <ImageView
                                    android:id="@+id/ivScreenshotClear"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_close"
                                    android:visibility="gone"
                                    app:tint="@color/aqua_card_text_secondary" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SEND BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSend"
                style="@style/Widget.Aqua.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/feedback_send"
                android:textAllCaps="false"
                android:contentDescription="@string/feedback_send_desc"
                app:icon="@drawable/ic_send"
                app:iconTint="#64FFDA"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <!-- PROGRESS -->
            <ProgressBar
                android:id="@+id/progressBarSending"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- FOOTER -->
            <TextView
                android:id="@+id/tvFooter"
                style="@style/TextAppearance.Aqua.Feedback.Footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:contentDescription="@string/feedback_footer_desc" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>