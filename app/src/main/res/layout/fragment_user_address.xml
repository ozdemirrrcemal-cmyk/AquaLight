<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fitsSystemWindows="true"
    tools:context=".ui.tabs.settings.userinfo.UserAddressFragment">

    <!-- HEADER -->

    <include
    android:id="@+id/appHeader"
    layout="@layout/layout_aqua_header"
    android:layout_width="@dimen/aqua_size_0"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />
    <!-- CONTENT -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:fitsSystemWindows="true"
        android:paddingBottom="@dimen/aqua_size_24"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_10"
            android:paddingEnd="@dimen/aqua_size_10"
            android:paddingTop="@dimen/aqua_size_16"
            android:paddingBottom="@dimen/aqua_size_140">

            <!-- FIRST NAME -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFirstName"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_size_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/address_info_first_name_label"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro" />

                    <EditText
                        style="@style/Widget.Aqua.Input.PlainEditText.Embedded"
                        android:id="@+id/etFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/address_info_first_name_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        android:padding="@dimen/aqua_size_0"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvFirstNameError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:textColor="@color/snackbar_error"
                        android:textSize="@dimen/aqua_text_size_caption"
                        android:visibility="gone"
                        tools:text="First name required" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- LAST NAME -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLastName"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_size_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/address_info_last_name_label"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro" />

                    <EditText
                        style="@style/Widget.Aqua.Input.PlainEditText.Embedded"
                        android:id="@+id/etLastName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/address_info_last_name_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        android:padding="@dimen/aqua_size_0"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvLastNameError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:textColor="@color/snackbar_error"
                        android:textSize="@dimen/aqua_text_size_caption"
                        android:visibility="gone"
                        tools:text="Last name required" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- COUNTRY -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCountry"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_size_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_12">

                    <TextView
                        android:id="@+id/tvCountryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/address_info_country_label"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="@dimen/aqua_size_4">

                        <TextView
                            android:id="@+id/tvCountryValue"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/address_country_turkey"
                            android:textColor="@color/aqua_card_text_primary"
                            android:textSize="@dimen/aqua_text_size_body"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="@dimen/aqua_size_20"
                            android:layout_height="@dimen/aqua_size_20"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="@color/aqua_card_text_secondary" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.hbb20.CountryCodePicker
                android:id="@+id/ccpCountry"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="@dimen/aqua_size_0"
                android:visibility="gone" />

            <!-- CITY -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCity"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_size_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/address_info_city_label"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro" />

                    <EditText
                        style="@style/Widget.Aqua.Input.PlainEditText.Embedded"
                        android:id="@+id/etCity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/address_info_city_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textCapWords"
                        android:padding="@dimen/aqua_size_0"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvCityError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:textColor="@color/snackbar_error"
                        android:textSize="@dimen/aqua_text_size_caption"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ADDRESS -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAddressInput"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_size_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/address_info_address_label"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro" />

                    <EditText
                        style="@style/Widget.Aqua.Input.PlainEditText.Embedded"
                        android:id="@+id/etAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:hint="@string/address_info_address_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textMultiLine"
                        android:minLines="1"
                        android:maxLines="3"
                        android:padding="@dimen/aqua_size_0"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvAddressError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:textColor="@color/snackbar_error"
                        android:textSize="@dimen/aqua_text_size_caption"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- POST CODE -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPostCode"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_size_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/address_info_postcode_label"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro" />

                    <EditText
                        style="@style/Widget.Aqua.Input.PlainEditText.Embedded"
                        android:id="@+id/etPostCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/address_info_postcode_hint"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:padding="@dimen/aqua_size_0"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvPostCodeError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:textColor="@color/snackbar_error"
                        android:textSize="@dimen/aqua_text_size_caption"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- PHONE -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPhone"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_size_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/address_info_phone_label"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro" />

                    <EditText
                        style="@style/Widget.Aqua.Input.PlainEditText.Embedded"
                        android:id="@+id/etPhoneNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/address_info_phone_hint"
                        android:imeOptions="actionDone"
                        android:inputType="phone"
                        android:padding="@dimen/aqua_size_0"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvPhoneError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:textColor="@color/snackbar_error"
                        android:textSize="@dimen/aqua_text_size_caption"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- BUTTONS -->

           <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        style="@style/Widget.Aqua.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_button_height"
        android:text="@string/address_info_save_button" />

</LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>