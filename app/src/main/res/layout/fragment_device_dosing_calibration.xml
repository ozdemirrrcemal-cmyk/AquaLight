<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <!-- TOP BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background_color"
        android:elevation="8dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:scaleType="center"
            android:src="@drawable/ic_back"
            app:tint="?attr/colorOnSurface"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextAppearance.Aqua.EditProfileTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Calibration"
            android:textColor="?attr/colorOnSurface"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/calibrationScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background_color"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toTopOf="@id/footerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="18dp">

            <!-- PUMP VISUAL -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/pumpVisualContainer"
                android:layout_width="match_parent"
                android:layout_height="122dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/ivDosingPump"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:adjustViewBounds="false"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_dosing_pump_4ch"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidePumpIndicatorY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="0.486" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidePump1Center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.153" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidePump2Center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.386" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidePump3Center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.614" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidePump4Center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.846" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/selectedIndicatorPump1"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#22C55E"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#86EFAC"
                    app:strokeWidth="1dp"
                    app:layout_constraintBottom_toBottomOf="@id/guidePumpIndicatorY"
                    app:layout_constraintEnd_toEndOf="@id/guidePump1Center"
                    app:layout_constraintStart_toStartOf="@id/guidePump1Center"
                    app:layout_constraintTop_toTopOf="@id/guidePumpIndicatorY">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@android:color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/selectedIndicatorPump2"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#22C55E"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#86EFAC"
                    app:strokeWidth="1dp"
                    app:layout_constraintBottom_toBottomOf="@id/guidePumpIndicatorY"
                    app:layout_constraintEnd_toEndOf="@id/guidePump2Center"
                    app:layout_constraintStart_toStartOf="@id/guidePump2Center"
                    app:layout_constraintTop_toTopOf="@id/guidePumpIndicatorY">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@android:color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/selectedIndicatorPump3"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#22C55E"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#86EFAC"
                    app:strokeWidth="1dp"
                    app:layout_constraintBottom_toBottomOf="@id/guidePumpIndicatorY"
                    app:layout_constraintEnd_toEndOf="@id/guidePump3Center"
                    app:layout_constraintStart_toStartOf="@id/guidePump3Center"
                    app:layout_constraintTop_toTopOf="@id/guidePumpIndicatorY">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@android:color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/selectedIndicatorPump4"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#22C55E"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#86EFAC"
                    app:strokeWidth="1dp"
                    app:layout_constraintBottom_toBottomOf="@id/guidePumpIndicatorY"
                    app:layout_constraintEnd_toEndOf="@id/guidePump4Center"
                    app:layout_constraintStart_toStartOf="@id/guidePump4Center"
                    app:layout_constraintTop_toTopOf="@id/guidePumpIndicatorY">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="4"
                        android:textColor="@android:color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- STEP PROGRESS -->
            <LinearLayout
                android:id="@+id/stepProgressRow"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/stepProgress1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="#38BDF8" />

                <View
                    android:id="@+id/stepProgress2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="#24314F" />

                <View
                    android:id="@+id/stepProgress3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="#24314F" />

                <View
                    android:id="@+id/stepProgress4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="#24314F" />

                <View
                    android:id="@+id/stepProgress5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="#24314F" />

                <View
                    android:id="@+id/stepProgress6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#24314F" />

            </LinearLayout>

            <!-- HERO CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCalibrationStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#101426"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#24314F"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <!-- STEP HEADER -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStepBadge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:includeFontPadding="false"
                            android:text="STEP 1 OF 6"
                            android:textColor="#38BDF8"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStepMiniStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#17253C"
                            android:includeFontPadding="false"
                            android:paddingStart="9dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="9dp"
                            android:paddingBottom="5dp"
                            android:text="Setup"
                            android:textColor="#A8B0C3"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:ignore="UnusedAttribute" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStepTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:includeFontPadding="false"
                        android:text="Name the liquid"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStepDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="Give this dosing liquid a clear name before calibration."
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="13sp" />

                    <com.aqua.aqualight.ui.tabs.devices.detail.dosing.DosingCalibrationIllustrationView
                        android:id="@+id/calibrationIllustrationView"
                        android:layout_width="match_parent"
                        android:layout_height="142dp"
                        android:layout_marginTop="12dp" />

                    <!-- DEVICE ACTION AREA -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStepDeviceAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="#151E33"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#2D3E5A"
                        app:strokeWidth="1dp"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="11dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="11dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDeviceActionTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:text="Device action"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDeviceActionDescription"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:includeFontPadding="false"
                                    android:text="Run this action before continuing."
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="11sp" />

                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStepDeviceAction"
                                android:layout_width="118dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="10dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="Start"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:backgroundTint="#F43F5E"
                                app:cornerRadius="15dp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- LIQUID NAME INPUT -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLiquidNameLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Liquid name"
                        app:boxBackgroundColor="#1A2238"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="#33415F"
                        app:hintTextColor="@color/settings_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLiquidName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textCapWords"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="@color/settings_text_secondary"
                            android:textSize="14sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- MEASURED AMOUNT INPUT -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputMeasuredAmountLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Measured amount"
                        android:visibility="gone"
                        app:boxBackgroundColor="#1A2238"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="#33415F"
                        app:hintTextColor="@color/settings_text_secondary"
                        app:suffixText="ml"
                        tools:visibility="visible">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMeasuredAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="@color/settings_text_secondary"
                            android:textSize="14sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvStepHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="Example: Micro, Macro, Iron, NPK or KH buffer."
                        android:textColor="#7F8AA3"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- FOOTER: ONLY NAVIGATION -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/footerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#0B182C"
        app:cardCornerRadius="0dp"
        app:cardElevation="10dp"
        app:strokeColor="#17253C"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSecondaryAction"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#17253C"
                app:cornerRadius="17dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrimaryAction"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.45"
                android:minHeight="0dp"
                android:text="Continue"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#F43F5E"
                app:cornerRadius="17dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>