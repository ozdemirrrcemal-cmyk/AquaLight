<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_bg"
    tools:context=".ui.tabs.devices.detail.light.programs.DeviceLightProgramsFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- EMPTY STATE -->
    <LinearLayout
        android:id="@+id/emptyProgramsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <TextView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_light_empty_icon"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/light_accent"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            style="@style/TextAppearance.Aqua.Light.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="No light programs yet" />

        <TextView
            style="@style/TextAppearance.Aqua.Light.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Build a custom light schedule for sunrise, peak and sunset."/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddFirstProgram"
            style="@style/Widget.Aqua.Light.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="+ Add Program" />

    </LinearLayout>
	
	<LinearLayout
    android:id="@+id/programFilterBar"
    android:layout_width="0dp"
    android:layout_height="44dp"
    android:layout_marginStart="20dp"
    android:layout_marginTop="16dp"
    android:layout_marginEnd="20dp"
    android:background="@drawable/bg_light_filter_bar"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="4dp"
    android:visibility="gone"
    app:layout_constraintTop_toBottomOf="@id/appHeader"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <TextView
        android:id="@+id/filterAll"
        style="@style/TextAppearance.Aqua.Light.Filter.Selected"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_light_filter_selected"
        android:gravity="center"
        android:text="All" />

    <TextView
        android:id="@+id/filterActive"
        style="@style/TextAppearance.Aqua.Light.Filter"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Active" />

    <TextView
        android:id="@+id/filterDisabled"
        style="@style/TextAppearance.Aqua.Light.Filter"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Disabled" />

</LinearLayout>

    <!-- PROGRAM LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/programsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/programFilterBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:itemCount="3"
        tools:listitem="@layout/item_light_program_card"
        tools:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>