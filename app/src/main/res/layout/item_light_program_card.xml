<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/programCardRoot"
    style="@style/Widget.Aqua.Light.Card.Program"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/programHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewProgramAccent"
                android:layout_width="4dp"
                android:layout_height="52dp"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="13dp"
                android:background="@drawable/bg_light_program_active_bar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvProgramName"
                        style="@style/TextAppearance.Aqua.Light.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text=""
                        android:textSize="20sp"
                        tools:text="Device Custom Long Schedule" />

                    <ImageButton
                        android:id="@+id/btnProgramMore"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="-4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Program options"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_more_vert"
                        app:tint="@color/light_text_secondary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvProgramSubtitle"
                        style="@style/TextAppearance.Aqua.Light.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text=""
                        android:textSize="13sp"
                        tools:text="Custom schedule" />

                    <TextView
                        android:id="@+id/tvProgramState"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_light_active_chip"
                        android:gravity="center"
                        android:minWidth="78dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text=""
                        android:textColor="@color/light_accent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="ACTIVE" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- TIME PANEL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_light_program_time_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Aqua.Light.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="START" />

                <TextView
                    android:id="@+id/tvProgramStart"
                    style="@style/TextAppearance.Aqua.Light.MetricSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text=""
                    android:textSize="23sp"
                    tools:text="08:00" />

            </LinearLayout>

            <View
                android:layout_width="42dp"
                android:layout_height="1dp"
                android:layout_marginHorizontal="12dp"
                android:background="@color/light_stroke" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Aqua.Light.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="END" />

                <TextView
                    android:id="@+id/tvProgramEnd"
                    style="@style/TextAppearance.Aqua.Light.MetricSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text=""
                    android:textSize="23sp"
                    tools:text="18:00" />

            </LinearLayout>

        </LinearLayout>

        <!-- META -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProgramRamp"
                style="@style/TextAppearance.Aqua.Light.ProgramMetaChip"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1.15"
                android:background="@drawable/bg_light_stat_pill"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text=""
                android:textSize="12sp"
                tools:text="Rise 08–10" />

            <TextView
                android:id="@+id/tvProgramPoints"
                style="@style/TextAppearance.Aqua.Light.ProgramMetaChip"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="0.85"
                android:background="@drawable/bg_light_stat_pill"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text=""
                android:textSize="12sp"
                tools:text="4 pts" />

            <TextView
                android:id="@+id/tvProgramPeak"
                style="@style/TextAppearance.Aqua.Light.ProgramMetaChip"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_light_stat_pill"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text=""
                android:textSize="12sp"
                tools:text="Peak 88%" />

        </LinearLayout>

        <!-- CHANNEL SUMMARY -->
        <LinearLayout
            android:id="@+id/channelSummaryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProgramRed"
                style="@style/TextAppearance.Aqua.Light.ChannelChip.Red"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                tools:text="R88" />

            <TextView
                android:id="@+id/tvProgramGreen"
                style="@style/TextAppearance.Aqua.Light.ChannelChip.Green"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                tools:text="G59" />

            <TextView
                android:id="@+id/tvProgramBlue"
                style="@style/TextAppearance.Aqua.Light.ChannelChip.Blue"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                tools:text="B46" />

            <TextView
                android:id="@+id/tvProgramWhite"
                style="@style/TextAppearance.Aqua.Light.ChannelChip.White"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                tools:text="W35" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>