<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardProgramItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/light_surface"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/light_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/programCardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="13dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProgramCardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    tools:text="Every Day" />

                <TextView
                    android:id="@+id/tvProgramCardSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="12sp"
                    tools:text="Default planted tank schedule" />

            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchProgramCardEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/light_program_card_enabled_cd"
                tools:checked="true" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/programCardTimeRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="13dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_light_metric_circle"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/light_program_card_start_icon"
                    android:textColor="#F9C74F"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/light_program_card_start"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvProgramCardStartTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        tools:text="09:00" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_light_metric_circle"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/light_program_card_ramp_icon"
                    android:textColor="@color/light_accent"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/light_program_card_ramp"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvProgramCardRamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        tools:text="60 min" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_light_metric_circle"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/light_program_card_off_icon"
                    android:textColor="#FF8A65"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/light_program_card_off"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvProgramCardEndTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        tools:text="19:15" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <com.aqua.aqualight.ui.tabs.devices.detail.light.shared.curve.LightMiniCurveView
            android:id="@+id/viewProgramCardMiniCurve"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:id="@+id/programCardBottomRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProgramCardRepeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/settings_text_secondary"
                android:textSize="12sp"
                tools:text="Every day" />

            <LinearLayout
                android:id="@+id/programCardChannelsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProgramCardPeak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="@color/light_accent"
                    android:textSize="12sp"
                    tools:text="Peak 100 · " />

                <TextView
                    android:id="@+id/tvProgramCardRed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="@color/light_red"
                    android:textSize="12sp"
                    tools:text="R80 " />

                <TextView
                    android:id="@+id/tvProgramCardGreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="@color/light_green"
                    android:textSize="12sp"
                    tools:text="G84 " />

                <TextView
                    android:id="@+id/tvProgramCardBlue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="@color/light_blue"
                    android:textSize="12sp"
                    tools:text="B79 " />

                <TextView
                    android:id="@+id/tvProgramCardWhite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="@color/light_white"
                    android:textSize="12sp"
                    tools:text="W65" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>