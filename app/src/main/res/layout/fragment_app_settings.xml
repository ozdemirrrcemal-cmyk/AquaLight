<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".ui.tabs.settings.app.AppSettingsFragment">

    <!-- 🔹 Üst Bar -->
<include
    android:id="@+id/appHeader"
    layout="@layout/layout_aqua_header"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <!-- 🔹 İçerik -->
    <ScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_space_value_10"
            android:paddingEnd="@dimen/aqua_space_value_10"
            android:paddingTop="@dimen/aqua_space_value_16"
            android:paddingBottom="@dimen/aqua_space_value_16">

            <!-- 🔔 Notifications -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_space_value_12"
                style="@style/Widget.Aqua.Card">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/aqua_space_value_12"
                    android:gravity="center_vertical"
                    android:contentDescription="@string/settings_notifications_section_description">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvNotificationsTitle"
                            android:text="@string/settings_notifications_title"
                            android:textSize="@dimen/aqua_text_size_body"
                            android:textColor="@color/aqua_card_text_primary"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/switchNotifications" />

                        <TextView
                            android:id="@+id/tvNotificationsSubtitle"
                            android:text="@string/settings_notifications_subtitle"
                            android:textSize="@dimen/aqua_text_size_caption"
                            android:textColor="@color/aqua_card_text_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 🌐 Auto Updates -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAutoUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_space_value_12"
                style="@style/Widget.Aqua.Card">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/aqua_space_value_12"
                    android:gravity="center_vertical"
                    android:contentDescription="@string/settings_autoupdate_section_description">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvAutoUpdateTitle"
                            android:text="@string/settings_autoupdate_title"
                            android:textSize="@dimen/aqua_text_size_body"
                            android:textColor="@color/aqua_card_text_primary"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/switchAutoUpdate" />

                        <TextView
                            android:id="@+id/tvAutoUpdateSubtitle"
                            android:text="@string/settings_autoupdate_subtitle"
                            android:textSize="@dimen/aqua_text_size_caption"
                            android:textColor="@color/aqua_card_text_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoUpdate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 🌙 Theme Mode -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardThemeMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_space_value_12"
                style="@style/Widget.Aqua.Card"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/settings_theme_section_description">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/aqua_space_value_12"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvThemeTitle"
                            android:text="@string/settings_theme_title"
                            android:textSize="@dimen/aqua_text_size_body"
                            android:textColor="@color/aqua_card_text_primary"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tvThemeSummary"
                            android:text="@string/settings_theme_summary_light"
                            android:textSize="@dimen/aqua_text_size_caption"
                            android:textColor="@color/aqua_card_text_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/aqua_size_value_24"
                        android:layout_height="@dimen/aqua_size_value_24"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_theme_arrow_description" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 🌍 Language -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_space_value_12"
                style="@style/Widget.Aqua.Card"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/settings_language_section_description">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/aqua_space_value_12"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvLanguageSummary"
                            android:text="@string/settings_language_title"
                            android:textSize="@dimen/aqua_text_size_body"
                            android:textColor="@color/aqua_card_text_primary"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tvLanguageSubtitle"
                            android:text="@string/settings_language_subtitle"
                            android:textSize="@dimen/aqua_text_size_caption"
                            android:textColor="@color/aqua_card_text_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnLanguage"
                        android:layout_width="@dimen/aqua_size_value_24"
                        android:layout_height="@dimen/aqua_size_value_24"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_language_arrow_description" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
			
			<!-- 💾 Backup & Restore -->
<com.google.android.material.card.MaterialCardView
    android:id="@+id/cardBackupRestore"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/aqua_space_value_12"
    style="@style/Widget.Aqua.Card"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="@string/settings_backup_restore_section_description">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/aqua_space_value_12"
        android:gravity="center_vertical">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvBackupRestoreTitle"
                android:text="@string/settings_backup_restore_title"
                android:textSize="@dimen/aqua_text_size_body"
                android:textColor="@color/aqua_card_text_primary"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvBackupRestoreSubtitle"
                android:text="@string/settings_backup_restore_subtitle"
                android:textSize="@dimen/aqua_text_size_caption"
                android:textColor="@color/aqua_card_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnBackupRestore"
            android:layout_width="@dimen/aqua_size_value_24"
            android:layout_height="@dimen/aqua_size_value_24"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/aqua_card_text_secondary"
            android:contentDescription="@string/settings_backup_restore_arrow_description" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

            <!-- ℹ️ About -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_space_value_12"
                style="@style/Widget.Aqua.Card"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/settings_about_section_description">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/aqua_space_value_12"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvAboutTitle"
                            android:text="@string/settings_about_title"
                            android:textSize="@dimen/aqua_text_size_body"
                            android:textColor="@color/aqua_card_text_primary"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tvAboutSubtitle"
                            android:text="@string/settings_about_subtitle"
                            android:textSize="@dimen/aqua_text_size_caption"
                            android:textColor="@color/aqua_card_text_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnAbout"
                        android:layout_width="@dimen/aqua_size_value_24"
                        android:layout_height="@dimen/aqua_size_value_24"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary"
                        android:contentDescription="@string/settings_about_arrow_description" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>