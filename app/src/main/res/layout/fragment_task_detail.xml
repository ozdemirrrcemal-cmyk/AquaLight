<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/detailScrollView"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/aqua_size_16"
        android:paddingTop="@dimen/aqua_size_16"
        android:paddingEnd="@dimen/aqua_size_16"
        android:paddingBottom="@dimen/aqua_size_110"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Form"
                android:id="@+id/summaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_size_16">

                    <FrameLayout
                        android:id="@+id/iconContainer"
                        android:layout_width="@dimen/aqua_size_48"
                        android:layout_height="@dimen/aqua_size_48">

                        <ImageView
                            android:id="@+id/ivTaskIcon"
                            android:layout_width="@dimen/aqua_size_26"
                            android:layout_height="@dimen/aqua_size_26"
                            android:layout_gravity="center"
                            android:scaleType="centerInside"
                            app:tint="@color/aqua_content_on_dark" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_14"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvTaskTitle"
                                android:layout_width="@dimen/aqua_size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/aqua_content_on_dark"
                                android:textSize="@dimen/aqua_text_size_body_xlarge"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSourceBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/aqua_size_22"
                                android:layout_marginStart="@dimen/aqua_size_8"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:minWidth="@dimen/aqua_size_46"
                                android:paddingStart="@dimen/aqua_size_9"
                                android:paddingEnd="@dimen/aqua_size_9"
                                android:textColor="@color/aqua_content_on_dark"
                                android:textSize="@dimen/aqua_text_size_micro_caption"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStatusValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_7"
                            android:includeFontPadding="false"
                            android:textColor="@color/aqua_card_text_secondary"
                            android:textSize="@dimen/aqua_text_size_caption" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:includeFontPadding="false"
                android:text="@string/maintenance_task_information"
                android:textColor="@color/aqua_content_on_dark"
                android:textSize="@dimen/aqua_text_size_body_small"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/infoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowTaskType"
                    layout="@layout/item_task_detail_row" />

                <include
                    android:id="@+id/rowAquarium"
                    layout="@layout/item_task_detail_row" />

                <include
                    android:id="@+id/rowScheduledDate"
                    layout="@layout/item_task_detail_row" />

                <include
                    android:id="@+id/rowScheduledTime"
                    layout="@layout/item_task_detail_row" />

                <include
                    android:id="@+id/rowRepeat"
                    layout="@layout/item_task_detail_row" />

                <include
                    android:id="@+id/rowReminder"
                    layout="@layout/item_task_detail_row" />

                <include
                    android:id="@+id/rowMissedReminder"
                    layout="@layout/item_task_detail_row" />

                <include
                    android:id="@+id/rowCreatedDate"
                    layout="@layout/item_task_detail_row" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvDescriptionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:includeFontPadding="false"
                android:text="@string/maintenance_description_label"
                android:textColor="@color/aqua_content_on_dark"
                android:textSize="@dimen/aqua_text_size_body_small"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_9">

                <TextView
                    android:id="@+id/tvDescriptionValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/aqua_size_3"
                    android:minHeight="@dimen/aqua_size_64"
                    android:paddingStart="@dimen/aqua_size_14"
                    android:paddingTop="@dimen/aqua_size_13"
                    android:paddingEnd="@dimen/aqua_size_14"
                    android:paddingBottom="@dimen/aqua_size_13"
                    android:textColor="@color/aqua_content_tertiary"
                    android:textSize="@dimen/aqua_text_size_caption" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvNoteLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:includeFontPadding="false"
                android:text="@string/maintenance_note_label"
                android:textColor="@color/aqua_content_on_dark"
                android:textSize="@dimen/aqua_text_size_body_small"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Form"
                android:id="@+id/noteCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_9">

                <TextView
                    android:id="@+id/tvNoteValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/aqua_size_3"
                    android:minHeight="@dimen/aqua_size_64"
                    android:paddingStart="@dimen/aqua_size_14"
                    android:paddingTop="@dimen/aqua_size_13"
                    android:paddingEnd="@dimen/aqua_size_14"
                    android:paddingBottom="@dimen/aqua_size_13"
                    android:textColor="@color/aqua_content_tertiary"
                    android:textSize="@dimen/aqua_text_size_caption" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvAutoTaskInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:background="@color/aqua_surface_positive"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/aqua_size_3"
                android:padding="@dimen/aqua_size_14"
                android:text="@string/maintenance_automatic_task_info"
                android:textColor="@color/aqua_accent_positive"
                android:textSize="@dimen/aqua_text_size_caption"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Aqua.Button.Primary"
                android:id="@+id/btnCompleteTask"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_button_height"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:text="@string/maintenance_complete_task"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Aqua.Button.Danger"
                android:id="@+id/btnDeleteTask"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_button_height"
                android:layout_marginTop="@dimen/aqua_size_12"
                android:text="@string/maintenance_delete_task"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>