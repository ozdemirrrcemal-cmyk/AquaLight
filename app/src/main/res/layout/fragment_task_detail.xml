<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/detailScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="110dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Form"
                android:id="@+id/summaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <FrameLayout
                        android:id="@+id/iconContainer"
                        android:layout_width="48dp"
                        android:layout_height="48dp">

                        <ImageView
                            android:id="@+id/ivTaskIcon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:scaleType="centerInside"
                            app:tint="@android:color/white" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvTaskTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@android:color/white"
                                android:textSize="@dimen/aqua_text_size_body_xlarge"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSourceBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                android:layout_marginStart="8dp"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:minWidth="46dp"
                                android:paddingStart="9dp"
                                android:paddingEnd="9dp"
                                android:textColor="@android:color/white"
                                android:textSize="@dimen/aqua_text_size_micro_caption"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStatusValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/aqua_card_text_secondary"
                            android:textSize="@dimen/aqua_text_size_caption" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:includeFontPadding="false"
                android:text="@string/maintenance_task_information"
                android:textColor="@android:color/white"
                android:textSize="@dimen/aqua_text_size_body_small"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/infoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowTaskType"
                    layout="@layout/item_task_detail_row" />

                <include
                    android:id="@+id/rowAquarium"
                    layout="@layout/item_task_detail_row" />

                <include
                    android:id="@+id/rowScheduledDate"
                    layout="@layout/item_task_detail_row" />

                <include
                    android:id="@+id/rowScheduledTime"
                    layout="@layout/item_task_detail_row" />

                <include
                    android:id="@+id/rowRepeat"
                    layout="@layout/item_task_detail_row" />

                <include
                    android:id="@+id/rowReminder"
                    layout="@layout/item_task_detail_row" />

                <include
                    android:id="@+id/rowMissedReminder"
                    layout="@layout/item_task_detail_row" />

                <include
                    android:id="@+id/rowCreatedDate"
                    layout="@layout/item_task_detail_row" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvDescriptionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:includeFontPadding="false"
                android:text="@string/maintenance_description_label"
                android:textColor="@android:color/white"
                android:textSize="@dimen/aqua_text_size_body_small"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp">

                <TextView
                    android:id="@+id/tvDescriptionValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:minHeight="64dp"
                    android:paddingStart="14dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="13dp"
                    android:textColor="#B8C7D9"
                    android:textSize="@dimen/aqua_text_size_caption" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvNoteLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:includeFontPadding="false"
                android:text="@string/maintenance_note_label"
                android:textColor="@android:color/white"
                android:textSize="@dimen/aqua_text_size_body_small"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Form"
                android:id="@+id/noteCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp">

                <TextView
                    android:id="@+id/tvNoteValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:minHeight="64dp"
                    android:paddingStart="14dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="13dp"
                    android:textColor="#B8C7D9"
                    android:textSize="@dimen/aqua_text_size_caption" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvAutoTaskInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#12382F"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3dp"
                android:padding="14dp"
                android:text="@string/maintenance_automatic_task_info"
                android:textColor="#5FD6B4"
                android:textSize="@dimen/aqua_text_size_caption"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Aqua.Button.Primary"
                android:id="@+id/btnCompleteTask"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_button_height"
                android:layout_marginTop="18dp"
                android:text="@string/maintenance_complete_task"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Aqua.Button.Danger"
                android:id="@+id/btnDeleteTask"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_button_height"
                android:layout_marginTop="12dp"
                android:text="@string/maintenance_delete_task"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>