<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".ui.tabs.settings.app.OpenSourceLicensesFragment">

    <!-- 🔹 Üst Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:background="@color/background_color"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 🔙 Back -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:scaleType="center"
            app:tint="?attr/colorOnSurface"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/open_source_back_button_desc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 🏷️ Title -->
        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextAppearance.Aqua.EditProfileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_source_title"
            android:importantForAccessibility="yes"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 🔹 Content -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Intro -->
            <TextView
                android:id="@+id/tvOpenSourceIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_source_intro"
                android:textColor="@color/settings_text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <!-- Library list -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLibraries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Aqua.CardStyles">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvLibrariesTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/open_source_libraries_title"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <!-- Media3 -->
                    <TextView
                        android:id="@+id/tvLibMedia3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/open_source_media3"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <!-- Material Components -->
                    <TextView
                        android:id="@+id/tvLibMaterial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/open_source_material"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <!-- Firebase -->
                    <TextView
                        android:id="@+id/tvLibFirebase"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/open_source_firebase"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <!-- BlurView -->
                    <TextView
                        android:id="@+id/tvLibBlurView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/open_source_blurview"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <!-- DataStore / Proto -->
                    <TextView
                        android:id="@+id/tvLibDatastore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/open_source_datastore"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <!-- Navigation / other AndroidX -->
                    <TextView
                        android:id="@+id/tvLibAndroidx"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/open_source_androidx"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Note about full license text -->
            <TextView
                android:id="@+id/tvLicensesNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/open_source_full_text_note"
                android:textColor="@color/settings_text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>