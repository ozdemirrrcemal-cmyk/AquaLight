                        android:layout_height="@dimen/aqua_size_86"
                        android:layout_marginTop="@dimen/aqua_size_10"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Aqua.Card.Metric"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="@dimen/aqua_size_3"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="@dimen/aqua_size_8">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tank_health_metric_ph"
                                    android:textColor="@color/aqua_card_text_secondary"
                                    android:textSize="@dimen/aqua_text_size_micro_caption" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_6"
                                    android:text="@string/tank_health_value_ph"
                                    android:textColor="@color/aqua_card_text_primary"
                                    android:textSize="@dimen/aqua_text_size_body"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_4"
                                    android:text="@string/tank_health_status_normal"
                                    android:textColor="@color/aqua_status_success"
                                    android:textSize="@dimen/aqua_text_size_status_micro" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Aqua.Card.Metric"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="@dimen/aqua_size_3"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="@dimen/aqua_size_8">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tank_health_metric_no3"
                                    android:textColor="@color/aqua_card_text_secondary"
                                    android:textSize="@dimen/aqua_text_size_micro_caption" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_6"
                                    android:text="@string/tank_health_value_no3"
                                    android:textColor="@color/aqua_card_text_primary"
                                    android:textSize="@dimen/aqua_text_size_body"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_4"
                                    android:text="@string/tank_health_status_moderate"
                                    android:textColor="@color/aqua_content_warning"
                                    android:textSize="@dimen/aqua_text_size_status_micro" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Aqua.Card.Metric"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="@dimen/aqua_size_3"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="@dimen/aqua_size_8">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tank_health_metric_no2"
                                    android:textColor="@color/aqua_card_text_secondary"
                                    android:textSize="@dimen/aqua_text_size_micro_caption" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_6"
                                    android:text="@string/tank_health_value_no2"
                                    android:textColor="@color/aqua_card_text_primary"
                                    android:textSize="@dimen/aqua_text_size_body"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_4"
                                    android:text="@string/tank_health_status_normal"
                                    android:textColor="@color/aqua_status_success"
                                    android:textSize="@dimen/aqua_text_size_status_micro" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Aqua.Card.Metric"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/aqua_size_3"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="@dimen/aqua_size_8">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tank_health_metric_nh3_nh4"
                                    android:textColor="@color/aqua_card_text_secondary"
                                    android:textSize="@dimen/aqua_text_size_micro_caption" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_6"
                                    android:text="@string/tank_health_value_nh3_nh4"
                                    android:textColor="@color/aqua_card_text_primary"
                                    android:textSize="@dimen/aqua_text_size_body"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_4"
                                    android:text="@string/tank_health_status_normal"
                                    android:textColor="@color/aqua_status_success"
                                    android:textSize="@dimen/aqua_text_size_status_micro" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_86"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Aqua.Card.Metric"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="@dimen/aqua_size_3"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="@dimen/aqua_size_8">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tank_health_metric_temperature"
                                    android:textColor="@color/aqua_card_text_secondary"
                                    android:textSize="@dimen/aqua_text_size_micro_caption" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_6"
                                    android:text="@string/tank_health_value_temperature"
                                    android:textColor="@color/aqua_card_text_primary"
                                    android:textSize="@dimen/aqua_text_size_body"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_4"
                                    android:text="@string/tank_health_status_normal"
                                    android:textColor="@color/aqua_status_success"
                                    android:textSize="@dimen/aqua_text_size_status_micro" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Aqua.Card.Metric"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="@dimen/aqua_size_3"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="@dimen/aqua_size_8">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tank_health_metric_gh"
                                    android:textColor="@color/aqua_card_text_secondary"
                                    android:textSize="@dimen/aqua_text_size_micro_caption" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_6"
                                    android:text="@string/tank_health_value_gh"
                                    android:textColor="@color/aqua_card_text_primary"
                                    android:textSize="@dimen/aqua_text_size_body"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_4"
                                    android:text="@string/tank_health_status_normal"
                                    android:textColor="@color/aqua_status_success"
                                    android:textSize="@dimen/aqua_text_size_status_micro" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Aqua.Card.Metric"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="@dimen/aqua_size_3"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="@dimen/aqua_size_8">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tank_health_metric_kh"
                                    android:textColor="@color/aqua_card_text_secondary"
                                    android:textSize="@dimen/aqua_text_size_micro_caption" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_6"
                                    android:text="@string/tank_health_value_kh"
                                    android:textColor="@color/aqua_card_text_primary"
                                    android:textSize="@dimen/aqua_text_size_body"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_4"
                                    android:text="@string/tank_health_status_normal"
                                    android:textColor="@color/aqua_status_success"
                                    android:textSize="@dimen/aqua_text_size_status_micro" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Aqua.Card.Metric"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/aqua_size_3"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="@dimen/aqua_size_8">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tank_health_metric_po4"
                                    android:textColor="@color/aqua_card_text_secondary"
                                    android:textSize="@dimen/aqua_text_size_micro_caption" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_6"
                                    android:text="@string/tank_health_value_po4"
                                    android:textColor="@color/aqua_card_text_primary"
                                    android:textSize="@dimen/aqua_text_size_body"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_4"
                                    android:text="@string/tank_health_status_normal"
                                    android:textColor="@color/aqua_status_success"
                                    android:textSize="@dimen/aqua_text_size_status_micro" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Metric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_12">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/tank_health_analysis_sensor_title"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body_xlarge"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_4"
                        android:includeFontPadding="false"
                        android:text="@string/tank_health_analysis_sensor_detail_subtitle"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_caption" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Aqua.Card.Metric"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_60"
                        android:layout_marginTop="@dimen/aqua_size_10">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="@dimen/aqua_size_12">

                            <ImageView
                                android:id="@+id/ivDetailDevice"
                                android:layout_width="@dimen/aqua_size_24"
                                android:layout_height="@dimen/aqua_size_24"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_tank_health_device_24"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="@color/aqua_card_text_secondary" />

                            <LinearLayout
                                android:layout_width="@dimen/aqua_size_0"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/aqua_size_10"
                                android:orientation="vertical"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/cardDetailConnected"
                                app:layout_constraintStart_toEndOf="@id/ivDetailDevice"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
