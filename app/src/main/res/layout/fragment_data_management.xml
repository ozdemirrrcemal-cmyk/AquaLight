<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.tabs.settings.app.DataManagementFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_10"
            android:paddingTop="@dimen/aqua_size_16"
            android:paddingEnd="@dimen/aqua_size_10"
            android:paddingBottom="@dimen/aqua_size_16">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCreateBackup"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_size_12"
                android:clickable="true"
                android:contentDescription="@string/data_management_backup_card_description"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_size_12">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/data_management_backup_title"
                            android:textColor="@color/aqua_card_text_primary"
                            android:textSize="@dimen/aqua_text_size_body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/data_management_backup_subtitle"
                            android:textColor="@color/aqua_card_text_secondary"
                            android:textSize="@dimen/aqua_text_size_caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/aqua_size_24"
                        android:layout_height="@dimen/aqua_size_24"
                        android:contentDescription="@string/data_management_arrow_description"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRestoreBackup"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_size_12"
                android:clickable="true"
                android:contentDescription="@string/data_management_restore_card_description"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_size_12">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/data_management_restore_title"
                            android:textColor="@color/aqua_card_text_primary"
                            android:textSize="@dimen/aqua_text_size_body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/data_management_restore_subtitle"
                            android:textColor="@color/aqua_card_text_secondary"
                            android:textSize="@dimen/aqua_text_size_caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/aqua_size_24"
                        android:layout_height="@dimen/aqua_size_24"
                        android:contentDescription="@string/data_management_arrow_description"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExportData"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/aqua_size_12"
                android:clickable="true"
                android:contentDescription="@string/data_management_export_card_description"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_size_12">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/data_management_export_title"
                            android:textColor="@color/aqua_card_text_primary"
                            android:textSize="@dimen/aqua_text_size_body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/data_management_export_subtitle"
                            android:textColor="@color/aqua_card_text_secondary"
                            android:textSize="@dimen/aqua_text_size_caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/aqua_size_24"
                        android:layout_height="@dimen/aqua_size_24"
                        android:contentDescription="@string/data_management_arrow_description"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/aqua_card_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvDataManagementInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/aqua_size_8"
                android:paddingTop="@dimen/aqua_size_4"
                android:paddingEnd="@dimen/aqua_size_8"
                android:text="@string/data_management_info"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_caption" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
