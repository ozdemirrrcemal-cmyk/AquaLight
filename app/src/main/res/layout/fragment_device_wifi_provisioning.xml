<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".ui.tabs.devices.add.DeviceWifiProvisioningFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="@dimen/aqua_space_value_16"
        android:paddingTop="@dimen/aqua_space_value_10"
        android:paddingEnd="@dimen/aqua_space_value_16"
        android:paddingBottom="@dimen/aqua_space_value_24"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Aqua.Card.Device">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_space_value_18">

                    <TextView
                        android:id="@+id/tvDeviceName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="@color/aqua_palette_f2f6fa"
                        android:textSize="@dimen/aqua_text_size_title_medium"
                        android:textStyle="bold"
                        tools:text="Dosing Pro 4" />

                    <TextView
                        android:id="@+id/tvDeviceSerial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_space_value_7"
                        android:includeFontPadding="false"
                        android:textColor="@color/aqua_palette_90a1b5"
                        android:textSize="@dimen/aqua_text_size_caption_plus"
                        tools:text="Serial: AQL-DP4-336172" />

                    <TextView
                        android:id="@+id/tvDeviceModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_space_value_6"
                        android:includeFontPadding="false"
                        android:textColor="@color/aqua_palette_5fd6b4"
                        android:textSize="@dimen/aqua_text_size_caption_plus"
                        tools:text="QR setup" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_space_value_12"
                style="@style/Widget.Aqua.Card.Device">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_space_value_18">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/device_wifi_card_title"
                        android:textColor="@color/aqua_palette_f2f6fa"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_space_value_7"
                        android:lineSpacingExtra="@dimen/aqua_space_value_2"
                        android:text="@string/device_wifi_card_message_corrected"
                        android:textColor="@color/aqua_palette_90a1b5"
                        android:textSize="@dimen/aqua_text_size_caption_plus" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/wifiNetworkRow"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_value_52"
                        android:layout_marginTop="@dimen/aqua_space_value_16"
                        android:background="@drawable/bg_aqua_input"
                        android:paddingStart="@dimen/aqua_space_value_14"
                        android:paddingEnd="@dimen/aqua_space_value_14">

                        <ImageView
                            android:id="@+id/ivWifiIcon"
                            android:layout_width="@dimen/aqua_size_value_19"
                            android:layout_height="@dimen/aqua_size_value_19"
                            android:contentDescription="@string/device_wifi_icon_desc"
                            android:src="@drawable/ic_wifi_signal_pro_24"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/aqua_palette_f2f6fa" />

                        <EditText
                            android:id="@+id/etWifiSsid"
                            style="@style/Widget.Aqua.Input.PlainEditText.Embedded"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/aqua_space_value_12"
                            android:layout_marginEnd="@dimen/aqua_space_value_10"
                            android:hint="@string/device_wifi_network_hint"
                            android:includeFontPadding="false"
                            android:inputType="text"
                            android:maxLength="32"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/tvUseCurrentWifiAction"
                            app:layout_constraintStart_toEndOf="@id/ivWifiIcon"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvUseCurrentWifiAction"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:minWidth="@dimen/aqua_size_value_78"
                            android:text="@string/device_wifi_select_wifi_action"
                            android:textColor="@color/aqua_palette_5fd6b4"
                            android:textSize="@dimen/aqua_text_size_caption"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <EditText
                        android:id="@+id/etWifiPassword"
                        style="@style/Widget.Aqua.Input.PlainEditText.Compact"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_value_50"
                        android:layout_marginTop="@dimen/aqua_space_value_12"
                        android:hint="@string/device_wifi_password_hint"
                        android:inputType="textPassword"
                        android:maxLength="64"
                        android:maxLines="1"
                        android:singleLine="true" />

                    <CheckBox
                        android:id="@+id/cbShowPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_space_value_6"
                        android:buttonTint="@color/aqua_palette_5fd6b4"
                        android:text="@string/device_wifi_show_password"
                        android:textColor="@color/aqua_palette_90a1b5"
                        android:textSize="@dimen/aqua_text_size_caption_plus" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Aqua.Button.Primary"
                        android:id="@+id/btnContinue"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_button_height"
                        android:layout_marginTop="@dimen/aqua_space_value_16"
                        android:text="@string/device_wifi_continue"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFormHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_space_value_12"
                        android:lineSpacingExtra="@dimen/aqua_space_value_2"
                        android:text="@string/device_wifi_privacy_hint"
                        android:textColor="@color/aqua_palette_90a1b5"
                        android:textSize="@dimen/aqua_text_size_caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
