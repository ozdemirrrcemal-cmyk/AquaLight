<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/healthScroll"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/aqua_size_32"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_16"
            android:paddingTop="@dimen/aqua_size_10"
            android:paddingEnd="@dimen/aqua_size_16">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/aqua_size_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivHealthHero"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_170"
                        android:contentDescription="@string/livestock_health_hero_image_description"
                        android:scaleType="centerCrop"
                        android:src="@drawable/livestock_health_hero" />

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryTitleSmallBold"
                        android:id="@+id/tvHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_16"
                        android:layout_marginTop="@dimen/aqua_size_14"
                        android:layout_marginEnd="@dimen/aqua_size_16"
                        android:includeFontPadding="false"
                        android:text="@string/livestock_health_hero_empty_title" />

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryBodySmall"
                        android:id="@+id/tvHeroSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_16"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:layout_marginEnd="@dimen/aqua_size_16"
                        android:lineSpacingExtra="@dimen/aqua_size_2"
                        android:text="@string/livestock_health_hero_empty_subtitle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNewObservation"
                        style="@style/Widget.Aqua.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_48"
                        android:layout_marginStart="@dimen/aqua_size_14"
                        android:layout_marginTop="@dimen/aqua_size_14"
                        android:layout_marginEnd="@dimen/aqua_size_14"
                        android:layout_marginBottom="@dimen/aqua_size_14"
                        android:text="@string/livestock_health_new_observation"
                        app:icon="@drawable/ic_add_24"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryTitleSmallBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_20"
                android:includeFontPadding="false"
                android:text="@string/livestock_health_followups_section" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmptyFollowups"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_24">

                    <ImageView
                        android:layout_width="@dimen/aqua_size_64"
                        android:layout_height="@dimen/aqua_size_64"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_health_livestock_24"
                        app:tint="@color/aqua_content_secondary" />

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodyLargeBold"
                        android:id="@+id/tvEmptyFollowupsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_14"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/livestock_health_empty_followups_title" />

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryBodySmall"
                        android:id="@+id/tvEmptyFollowupsBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_7"
                        android:gravity="center"
                        android:lineSpacingExtra="@dimen/aqua_size_2"
                        android:text="@string/livestock_health_empty_followups_body" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/filledHealthContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaptionBold"
                    android:id="@+id/tvActiveFollowupsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_14"
                    android:includeFontPadding="false"
                    android:text="@string/livestock_health_active_followups_section" />

                <LinearLayout
                    android:id="@+id/activeFollowupsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_8"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/pastFollowupsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/aqua_size_40"
                    android:layout_marginTop="@dimen/aqua_size_14"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaptionBold"
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="@string/livestock_health_past_followups_section" />

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.Accent.CaptionBold"
                        android:id="@+id/btnViewAllPast"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/aqua_size_40"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="@dimen/aqua_size_8"
                        android:paddingEnd="@dimen/aqua_size_4"
                        android:text="@string/livestock_health_view_all" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pastFollowupsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView android:textAppearance="@style/TextAppearance.Aqua.Content.MutedCaption"
                    android:id="@+id/tvPastFollowupsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="@dimen/aqua_size_16"
                    android:paddingBottom="@dimen/aqua_size_16"
                    android:text="@string/livestock_health_past_followups_empty"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNoObservationInfo"
                style="@style/Widget.Aqua.Card.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/aqua_size_52"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/aqua_size_14"
                    android:paddingEnd="@dimen/aqua_size_14">

                    <ImageView
                        android:layout_width="@dimen/aqua_size_20"
                        android:layout_height="@dimen/aqua_size_20"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tank_health_info_24"
                        app:tint="@color/aqua_content_secondary" />

                    <TextView android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_12"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="@string/livestock_health_no_observation_notice" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
