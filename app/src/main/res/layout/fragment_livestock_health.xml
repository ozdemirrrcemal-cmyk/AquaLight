<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/healthScroll"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/aqua_size_32"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_16"
            android:paddingTop="@dimen/aqua_size_10"
            android:paddingEnd="@dimen/aqua_size_16">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/aqua_size_16"
                app:strokeWidth="@dimen/aqua_size_0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivHealthHero"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_170"
                        android:contentDescription="@string/livestock_health_hero_image_description"
                        android:scaleType="centerCrop"
                        android:src="@drawable/livestock_health_hero" />

                    <TextView
                        android:id="@+id/tvHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_16"
                        android:layout_marginTop="@dimen/aqua_size_14"
                        android:layout_marginEnd="@dimen/aqua_size_16"
                        android:includeFontPadding="false"
                        android:text="@string/livestock_health_hero_empty_title"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeroSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_16"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:layout_marginEnd="@dimen/aqua_size_16"
                        android:lineSpacingExtra="@dimen/aqua_size_2"
                        android:text="@string/livestock_health_hero_empty_subtitle"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body_small" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNewObservation"
                        style="@style/Widget.Aqua.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_48"
                        android:layout_marginStart="@dimen/aqua_size_14"
                        android:layout_marginTop="@dimen/aqua_size_14"
                        android:layout_marginEnd="@dimen/aqua_size_14"
                        android:layout_marginBottom="@dimen/aqua_size_14"
                        android:text="@string/livestock_health_new_observation"
                        app:icon="@drawable/ic_add_24"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_20"
                android:includeFontPadding="false"
                android:text="@string/livestock_health_followups_section"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_title_small"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmptyFollowups"
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_24">

                    <ImageView
                        android:layout_width="@dimen/aqua_size_48"
                        android:layout_height="@dimen/aqua_size_48"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_health_livestock_24"
                        app:tint="@color/aqua_content_secondary" />

                    <TextView
                        android:id="@+id/tvEmptyFollowupsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_14"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/livestock_health_empty_followups_title"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body_large"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEmptyFollowupsBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_7"
                        android:gravity="center"
                        android:lineSpacingExtra="@dimen/aqua_size_2"
                        android:text="@string/livestock_health_empty_followups_body"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body_small" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/filledHealthContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_14"
                    android:includeFontPadding="false"
                    android:text="@string/livestock_health_active_followups_section"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_caption"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardActiveFollowup"
                    style="@style/Widget.Aqua.Card.TankListItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_8"
                    android:clickable="true"
                    android:focusable="true">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/aqua_size_14">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/activePhotoFrame"
                            style="@style/Widget.Aqua.Card.Device.Media"
                            android:layout_width="@dimen/aqua_size_56"
                            android:layout_height="@dimen/aqua_size_56"
                            app:cardCornerRadius="@dimen/aqua_size_12"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/ivActiveLivestock"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:scaleType="center" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvActiveLivestockName"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_12"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/aqua_card_text_primary"
                            android:textSize="@dimen/aqua_text_size_body"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/tvActiveBadge"
                            app:layout_constraintStart_toEndOf="@id/activePhotoFrame"
                            app:layout_constraintTop_toTopOf="@id/activePhotoFrame"
                            tools:text="Beta" />

                        <TextView
                            android:id="@+id/tvActiveBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/aqua_size_26"
                            android:background="@drawable/bg_aqua_toolbar_pill_action_primary"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingStart="@dimen/aqua_size_9"
                            android:paddingEnd="@dimen/aqua_size_9"
                            android:text="@string/livestock_health_tracking_badge"
                            android:textColor="@color/aqua_status_success"
                            android:textSize="@dimen/aqua_text_size_status_micro"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvActiveIssue"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_12"
                            android:layout_marginTop="@dimen/aqua_size_5"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/livestock_health_issue_surface"
                            android:textColor="@color/aqua_card_text_secondary"
                            android:textSize="@dimen/aqua_text_size_body_small"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/activePhotoFrame"
                            app:layout_constraintTop_toBottomOf="@id/tvActiveLivestockName" />

                        <TextView
                            android:id="@+id/tvActiveLivestockAffected"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_12"
                            android:layout_marginTop="@dimen/aqua_size_4"
                            android:textColor="@color/aqua_content_muted"
                            android:textSize="@dimen/aqua_text_size_caption"
                            app:layout_constraintBottom_toBottomOf="@id/activePhotoFrame"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/activePhotoFrame"
                            app:layout_constraintTop_toBottomOf="@id/tvActiveIssue"
                            tools:text="1 / 4 canlı etkileniyor" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_18"
                    android:includeFontPadding="false"
                    android:text="@string/livestock_health_recent_observations_section"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_caption"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRecentObservation"
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_8"
                    android:clickable="true"
                    android:focusable="true">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/aqua_size_14">

                        <ImageView
                            android:id="@+id/ivRecentLivestock"
                            android:layout_width="@dimen/aqua_size_48"
                            android:layout_height="@dimen/aqua_size_48"
                            android:contentDescription="@null"
                            android:scaleType="center"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvRecentLivestockName"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_12"
                            android:includeFontPadding="false"
                            android:textColor="@color/aqua_card_text_primary"
                            android:textSize="@dimen/aqua_text_size_body_small"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/ivRecentLivestock"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="Beta" />

                        <TextView
                            android:id="@+id/tvRecentObservation"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_12"
                            android:layout_marginTop="@dimen/aqua_size_4"
                            android:text="@string/livestock_health_history_today_surface_same"
                            android:textColor="@color/aqua_card_text_secondary"
                            android:textSize="@dimen/aqua_text_size_caption"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/ivRecentLivestock"
                            app:layout_constraintTop_toBottomOf="@id/tvRecentLivestockName" />

                        <TextView
                            android:id="@+id/tvRecentLivestockAffected"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_12"
                            android:layout_marginTop="@dimen/aqua_size_3"
                            android:textColor="@color/aqua_content_muted"
                            android:textSize="@dimen/aqua_text_size_micro"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/ivRecentLivestock"
                            app:layout_constraintTop_toBottomOf="@id/tvRecentObservation"
                            tools:text="1 / 4 canlı etkileniyor" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_18">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_14">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/livestock_health_tank_context_title"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_12"
                        android:text="@string/livestock_health_tank_context_measurement"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body_small" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_7"
                        android:text="@string/livestock_health_tank_context_change"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body_small" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_14"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/aqua_size_2"
                android:text="@string/livestock_health_main_helper"
                android:textColor="@color/aqua_content_muted"
                android:textSize="@dimen/aqua_text_size_micro" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
