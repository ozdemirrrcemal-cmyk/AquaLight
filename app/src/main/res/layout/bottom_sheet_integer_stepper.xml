<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/integerStepperRoot"
    style="@style/Widget.Aqua.BottomSheet.Root">

    <View style="@style/Widget.Aqua.BottomSheet.Handle" />

    <TextView
        android:id="@+id/tvIntegerStepperTitle"
        style="@style/TextAppearance.Aqua.BottomSheet.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_18"
        android:gravity="center"
        tools:text="Temperature protection threshold" />

    <TextView
        android:id="@+id/tvIntegerStepperHelper"
        style="@style/TextAppearance.Aqua.BottomSheet.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_8"
        android:gravity="center"
        android:visibility="gone"
        tools:text="Select a value from 50 °C to 70 °C."
        tools:visibility="visible" />

    <LinearLayout
        style="@style/Widget.Aqua.BottomSheet.Stepper.Surface"
        android:layout_marginTop="@dimen/aqua_size_22">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIntegerStepperDecrease"
            style="@style/Widget.Aqua.BottomSheet.Button.Stepper"
            android:layout_width="@dimen/aqua_size_56"
            android:layout_height="@dimen/aqua_size_56"
            android:text=""
            app:icon="@drawable/ic_remove_24" />

        <TextView
            android:id="@+id/tvIntegerStepperValue"
            style="@style/TextAppearance.Aqua.BottomSheet.StepperValue"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            tools:ignore="InefficientWeight"
            tools:text="60 °C" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIntegerStepperIncrease"
            style="@style/Widget.Aqua.BottomSheet.Button.Stepper"
            android:layout_width="@dimen/aqua_size_56"
            android:layout_height="@dimen/aqua_size_56"
            android:text=""
            app:icon="@drawable/ic_add_24" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_54"
        android:layout_marginTop="@dimen/aqua_size_26"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIntegerStepperCancel"
            style="@style/Widget.Aqua.BottomSheet.Button.Neutral"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/aqua_size_8"
            android:layout_weight="1"
            tools:text="Cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIntegerStepperSave"
            style="@style/Widget.Aqua.BottomSheet.Button.Primary"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/aqua_size_8"
            android:layout_weight="1"
            tools:text="Save" />
    </LinearLayout>

</LinearLayout>
