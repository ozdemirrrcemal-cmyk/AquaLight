<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aqua_surface_deep"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/btnPhotoViewerClose"
        android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodyLargeBold"
        android:layout_width="@dimen/aqua_size_48"
        android:layout_height="@dimen/aqua_size_48"
        android:clickable="true"
        android:contentDescription="@string/livestock_health_photo_viewer_close"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/common_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/photoViewerPager"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        app:layout_constraintBottom_toTopOf="@id/tvPhotoViewerCounter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnPhotoViewerClose" />

    <TextView
        android:id="@+id/tvPhotoViewerCounter"
        android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryCaptionBold"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/aqua_size_48"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
