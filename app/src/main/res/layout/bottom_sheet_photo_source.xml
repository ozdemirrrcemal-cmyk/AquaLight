<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottomsheet_rounded"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp"
    android:contentDescription="@string/photo_bottom_sheet_desc">

    <!-- Küçük handle bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bottomsheet_handle"
        android:layout_marginBottom="12dp" />

    <!-- 📷 Kamera Butonu -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCamera"
        style="@style/RedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/photo_bottom_sheet_camera"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/photo_bottom_sheet_camera_desc" />

    <!-- 🖼️ Galeri Butonu -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGallery"
        style="@style/RedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/photo_bottom_sheet_gallery"
        android:textAllCaps="false"
        android:contentDescription="@string/photo_bottom_sheet_gallery_desc" />

</LinearLayout>