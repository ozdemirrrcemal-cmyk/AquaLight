<?xml version="1.0" encoding="utf-8"?>  <androidx.constraintlayout.widget.ConstraintLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/background_color"
tools:context=".ui.tabs.settings.app.AppSettingsFragment">

<!-- 🔹 Üst Bar -->  
<androidx.constraintlayout.widget.ConstraintLayout  
    android:id="@+id/headerContainer"  
    android:layout_width="match_parent"  
    android:layout_height="wrap_content"  
    android:paddingHorizontal="16dp"  
    android:paddingTop="20dp"  
    android:paddingBottom="12dp"  
    android:background="@color/background_color"  
    android:elevation="8dp"  
    app:layout_constraintTop_toTopOf="parent">  

    <!-- 🔙 Geri Butonu -->  
    <ImageView  
        android:id="@+id/btnBack"  
        android:layout_width="32dp"  
        android:layout_height="32dp"  
        android:src="@drawable/ic_back"  
        android:scaleType="center"  
        app:tint="?attr/colorOnSurface"  
        android:clickable="true"  
        android:focusable="true"  
        android:contentDescription="@string/app_settings_back_button_desc"  
        app:layout_constraintBottom_toBottomOf="parent"  
        app:layout_constraintStart_toStartOf="parent"  
        app:layout_constraintTop_toTopOf="parent" />  

    <!-- 🏷️ Başlık -->  
    <TextView  
        android:id="@+id/tvTitle"  
        style="@style/TextAppearance.Aqua.EditProfileTitle"  
        android:layout_width="wrap_content"  
        android:layout_height="wrap_content"  
        android:text="@string/app_settings_title"  
        android:importantForAccessibility="yes"  
        app:layout_constraintTop_toTopOf="parent"  
        app:layout_constraintBottom_toBottomOf="parent"  
        app:layout_constraintStart_toStartOf="parent"  
        app:layout_constraintEnd_toEndOf="parent" />  
</androidx.constraintlayout.widget.ConstraintLayout>  

<!-- 🔹 İçerik -->  
<ScrollView  
    android:id="@+id/scrollContainer"  
    android:layout_width="0dp"  
    android:layout_height="0dp"  
    android:fillViewport="true"  
    android:scrollbars="none"  
    app:layout_constraintTop_toBottomOf="@id/headerContainer"  
    app:layout_constraintBottom_toBottomOf="parent"  
    app:layout_constraintStart_toStartOf="parent"  
    app:layout_constraintEnd_toEndOf="parent">  

    <LinearLayout  
        android:id="@+id/contentContainer"  
        android:layout_width="match_parent"  
        android:layout_height="wrap_content"  
        android:orientation="vertical"  
        android:paddingStart="10dp"  
        android:paddingEnd="10dp"  
        android:paddingTop="16dp"  
        android:paddingBottom="16dp">  

        <!-- 🔔 Notifications -->  
        <com.google.android.material.card.MaterialCardView  
            android:id="@+id/cardNotifications"  
            android:layout_width="match_parent"  
            android:layout_height="wrap_content"  
            android:layout_marginBottom="12dp"  
            style="@style/Widget.Aqua.CardStyles">  

            <LinearLayout  
                android:orientation="horizontal"  
                android:layout_width="match_parent"  
                android:layout_height="wrap_content"  
                android:padding="12dp"  
                android:gravity="center_vertical"  
                android:contentDescription="@string/settings_notifications_section_description">  

                <LinearLayout  
                    android:orientation="vertical"  
                    android:layout_width="0dp"  
                    android:layout_weight="1"  
                    android:layout_height="wrap_content">  

                    <TextView  
                        android:id="@+id/tvNotificationsTitle"  
                        android:text="@string/settings_notifications_title"  
                        android:textSize="14sp"  
                        android:textColor="@android:color/white"  
                        android:textStyle="bold"  
                        android:layout_width="wrap_content"  
                        android:layout_height="wrap_content"  
                        android:labelFor="@id/switchNotifications" />  

                    <TextView  
                        android:id="@+id/tvNotificationsSubtitle"  
                        android:text="@string/settings_notifications_subtitle"  
                        android:textSize="12sp"  
                        android:textColor="@color/settings_text_secondary"  
                        android:layout_width="wrap_content"  
                        android:layout_height="wrap_content" />  
                </LinearLayout>  

                <com.google.android.material.materialswitch.MaterialSwitch  
                    android:id="@+id/switchNotifications"  
                    android:layout_width="wrap_content"  
                    android:layout_height="wrap_content" />  
            </LinearLayout>  
        </com.google.android.material.card.MaterialCardView>  

        <!-- 🌐 Auto Updates -->  
        <com.google.android.material.card.MaterialCardView  
            android:id="@+id/cardAutoUpdate"  
            android:layout_width="match_parent"  
            android:layout_height="wrap_content"  
            android:layout_marginBottom="12dp"  
            style="@style/Widget.Aqua.CardStyles">  

            <LinearLayout  
                android:orientation="horizontal"  
                android:layout_width="match_parent"  
                android:layout_height="wrap_content"  
                android:padding="12dp"  
                android:gravity="center_vertical"  
                android:contentDescription="@string/settings_autoupdate_section_description">  

                <LinearLayout  
                    android:orientation="vertical"  
                    android:layout_width="0dp"  
                    android:layout_weight="1"  
                    android:layout_height="wrap_content">  

                    <TextView  
                        android:id="@+id/tvAutoUpdateTitle"  
                        android:text="@string/settings_autoupdate_title"  
                        android:textSize="14sp"  
                        android:textColor="@android:color/white"  
                        android:textStyle="bold"  
                        android:layout_width="wrap_content"  
                        android:layout_height="wrap_content"  
                        android:labelFor="@id/switchAutoUpdate" />  

                    <TextView  
                        android:id="@+id/tvAutoUpdateSubtitle"  
                        android:text="@string/settings_autoupdate_subtitle"  
                        android:textSize="12sp"  
                        android:textColor="@color/settings_text_secondary"  
                        android:layout_width="wrap_content"  
                        android:layout_height="wrap_content" />  
                </LinearLayout>  

                <com.google.android.material.materialswitch.MaterialSwitch  
                    android:id="@+id/switchAutoUpdate"  
                    android:layout_width="wrap_content"  
                    android:layout_height="wrap_content" />  
            </LinearLayout>  
        </com.google.android.material.card.MaterialCardView>  

        <!-- 🌙 Theme Mode -->  
        <com.google.android.material.card.MaterialCardView  
            android:id="@+id/cardThemeMode"  
            android:layout_width="match_parent"  
            android:layout_height="wrap_content"  
            android:layout_marginBottom="12dp"  
            style="@style/Widget.Aqua.CardStyles"  
            android:clickable="true"  
            android:focusable="true"  
            android:contentDescription="@string/settings_theme_section_description">  

            <LinearLayout  
                android:orientation="horizontal"  
                android:layout_width="match_parent"  
                android:layout_height="wrap_content"  
                android:padding="12dp"  
                android:gravity="center_vertical">  

                <LinearLayout  
                    android:orientation="vertical"  
                    android:layout_width="0dp"  
                    android:layout_weight="1"  
                    android:layout_height="wrap_content">  

                    <TextView  
                        android:id="@+id/tvThemeTitle"  
                        android:text="@string/settings_theme_title"  
                        android:textSize="14sp"  
                        android:textColor="@android:color/white"  
                        android:textStyle="bold"  
                        android:layout_width="wrap_content"  
                        android:layout_height="wrap_content" />  

                    <TextView  
                        android:id="@+id/tvThemeSummary"  
                        android:text="@string/settings_theme_summary_light"  
                        android:textSize="12sp"  
                        android:textColor="@color/settings_text_secondary"  
                        android:layout_width="wrap_content"  
                        android:layout_height="wrap_content" />  
                </LinearLayout>  

                <ImageView  
                    android:layout_width="24dp"  
                    android:layout_height="24dp"  
                    android:src="@drawable/ic_arrow_right"  
                    app:tint="@color/settings_text_secondary"  
                    android:contentDescription="@string/settings_theme_arrow_description" />  
            </LinearLayout>  
        </com.google.android.material.card.MaterialCardView>  

        <!-- 🌍 Language -->  
        <com.google.android.material.card.MaterialCardView  
            android:id="@+id/cardLanguage"  
            android:layout_width="match_parent"  
            android:layout_height="wrap_content"  
            android:layout_marginBottom="12dp"  
            style="@style/Widget.Aqua.CardStyles"  
            android:clickable="true"  
            android:focusable="true"  
            android:contentDescription="@string/settings_language_section_description">  

            <LinearLayout  
                android:orientation="horizontal"  
                android:layout_width="match_parent"  
                android:layout_height="wrap_content"  
                android:padding="12dp"  
                android:gravity="center_vertical">  

                <LinearLayout  
                    android:orientation="vertical"  
                    android:layout_width="0dp"  
                    android:layout_weight="1"  
                    android:layout_height="wrap_content">  

                    <TextView  
                        android:id="@+id/tvLanguageSummary"  
                        android:text="@string/settings_language_title"  
                        android:textSize="14sp"  
                        android:textColor="@android:color/white"  
                        android:textStyle="bold"  
                        android:layout_width="wrap_content"  
                        android:layout_height="wrap_content" />  

                    <TextView  
                        android:id="@+id/tvLanguageSubtitle"  
                        android:text="@string/settings_language_subtitle"  
                        android:textSize="12sp"  
                        android:textColor="@color/settings_text_secondary"  
                        android:layout_width="wrap_content"  
                        android:layout_height="wrap_content" />  
                </LinearLayout>  

                <ImageView  
                    android:id="@+id/btnLanguage"  
                    android:layout_width="24dp"  
                    android:layout_height="24dp"  
                    android:src="@drawable/ic_arrow_right"  
                    app:tint="@color/settings_text_secondary"  
                    android:contentDescription="@string/settings_language_arrow_description" />  
            </LinearLayout>  
        </com.google.android.material.card.MaterialCardView>  

        <!-- ℹ️ About -->  
        <com.google.android.material.card.MaterialCardView  
            android:id="@+id/cardAbout"  
            android:layout_width="match_parent"  
            android:layout_height="wrap_content"  
            android:layout_marginBottom="12dp"  
            style="@style/Widget.Aqua.CardStyles"  
            android:clickable="true"  
            android:focusable="true"  
            android:contentDescription="@string/settings_about_section_description">  

            <LinearLayout  
                android:orientation="horizontal"  
                android:layout_width="match_parent"  
                android:layout_height="wrap_content"  
                android:padding="12dp"  
                android:gravity="center_vertical">  

                <LinearLayout  
                    android:orientation="vertical"  
                    android:layout_width="0dp"  
                    android:layout_weight="1"  
                    android:layout_height="wrap_content">  

                    <TextView  
                        android:id="@+id/tvAboutTitle"  
                        android:text="@string/settings_about_title"  
                        android:textSize="14sp"  
                        android:textColor="@android:color/white"  
                        android:textStyle="bold"  
                        android:layout_width="wrap_content"  
                        android:layout_height="wrap_content" />  

                    <TextView  
                        android:id="@+id/tvAboutSubtitle"  
                        android:text="@string/settings_about_subtitle"  
                        android:textSize="12sp"  
                        android:textColor="@color/settings_text_secondary"  
                        android:layout_width="wrap_content"  
                        android:layout_height="wrap_content" />  
                </LinearLayout>  

                <ImageView  
                    android:id="@+id/btnAbout"  
                    android:layout_width="24dp"  
                    android:layout_height="24dp"  
                    android:src="@drawable/ic_arrow_right"  
                    app:tint="@color/settings_text_secondary"  
                    android:contentDescription="@string/settings_about_arrow_description" />  
            </LinearLayout>  
        </com.google.android.material.card.MaterialCardView>  

    </LinearLayout>  
</ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>