<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
 android:background="@color/background_color">
 <include android:id="@+id/appHeader" layout="@layout/layout_aqua_header"
  android:layout_width="match_parent" android:layout_height="wrap_content" />
<androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp"
 android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:padding="@dimen/aqua_size_14">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:padding="@dimen/aqua_size_8" android:textColor="@color/aqua_card_text_primary"
 android:textSize="@dimen/aqua_text_size_body" android:accessibilityLiveRegion="polite"  />
<TextView android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:padding="@dimen/aqua_size_8" android:textColor="@color/aqua_card_text_primary"
 android:textSize="@dimen/aqua_text_size_body" android:accessibilityLiveRegion="polite"  />
<TextView android:id="@+id/subject" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:padding="@dimen/aqua_size_8" android:textColor="@color/aqua_card_text_primary"
 android:textSize="@dimen/aqua_text_size_body" android:accessibilityLiveRegion="polite"  />
<TextView android:id="@+id/findings" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:padding="@dimen/aqua_size_8" android:textColor="@color/aqua_card_text_primary"
 android:textSize="@dimen/aqua_text_size_body" android:accessibilityLiveRegion="polite"  />
<TextView android:id="@+id/evidence" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:padding="@dimen/aqua_size_8" android:textColor="@color/aqua_card_text_primary"
 android:textSize="@dimen/aqua_text_size_body" android:accessibilityLiveRegion="polite"  />
<TextView android:id="@+id/assessment" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:padding="@dimen/aqua_size_8" android:textColor="@color/aqua_card_text_primary"
 android:textSize="@dimen/aqua_text_size_body" android:accessibilityLiveRegion="polite"  />
<TextView android:id="@+id/notes" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:padding="@dimen/aqua_size_8" android:textColor="@color/aqua_card_text_primary"
 android:textSize="@dimen/aqua_text_size_body" android:accessibilityLiveRegion="polite"  />
<ImageView android:id="@+id/photo" android:layout_width="match_parent" android:layout_height="@dimen/aqua_size_160"
 android:contentDescription="@string/health_photo" android:scaleType="centerInside" />
<TextView android:id="@+id/historical" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:padding="@dimen/aqua_size_8" android:textColor="@color/aqua_card_text_primary"
 android:textSize="@dimen/aqua_text_size_body" android:accessibilityLiveRegion="polite" android:text="@string/health_deleted_subject" />
<TextView android:id="@+id/safety" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:padding="@dimen/aqua_size_8" android:textColor="@color/aqua_card_text_primary"
 android:textSize="@dimen/aqua_text_size_body" android:accessibilityLiveRegion="polite" android:text="@string/health_no_diagnosis" />
<com.google.android.material.button.MaterialButton android:id="@+id/algae"
 style="@style/Widget.Aqua.Button.Secondary" android:maxLines="3" android:ellipsize="none" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:minHeight="@dimen/aqua_size_48" android:text="@string/health_open_algae" />
<com.google.android.material.button.MaterialButton android:id="@+id/follow"
 style="@style/Widget.Aqua.Button.Secondary" android:maxLines="3" android:ellipsize="none" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:minHeight="@dimen/aqua_size_48" android:text="@string/health_follow" />
<com.google.android.material.button.MaterialButton android:id="@+id/delete"
 style="@style/Widget.Aqua.Button.Secondary" android:maxLines="3" android:ellipsize="none" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:minHeight="@dimen/aqua_size_48" android:text="@string/health_delete" />
</LinearLayout></androidx.core.widget.NestedScrollView>
</LinearLayout>
