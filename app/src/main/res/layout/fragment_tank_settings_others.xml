<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/othersScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="@dimen/aqua_size_16"
    android:paddingTop="@dimen/aqua_size_12"
    android:paddingEnd="@dimen/aqua_size_16"
    android:paddingBottom="@dimen/aqua_size_120"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/othersSectionRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAutomationRemindersTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_8"
            android:includeFontPadding="false"
            android:text="@string/aquarium_text_automation_reminders"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body" />

        <LinearLayout
    style="@style/Widget.Aqua.SelectionRow.Large"
            android:id="@+id/rowSmartCareSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/aqua_size_78"
                android:orientation="horizontal"
                android:paddingStart="@dimen/aqua_size_16"
                android:paddingTop="@dimen/aqua_size_12"
                android:paddingEnd="@dimen/aqua_size_14"
                android:paddingBottom="@dimen/aqua_size_12">

                <LinearLayout
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/aqua_size_12">

                    <TextView
                        android:id="@+id/tvSmartCareSuggestionsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/aquarium_text_smart_care_suggestions"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSmartCareSuggestionsSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="@dimen/aqua_size_2"
                        android:text="@string/aquarium_text_automatically_create_smart_care_tasks_for_this_tank"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_caption" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchSmartCareSuggestions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
    style="@style/Widget.Aqua.SelectionRow.Large"
            android:id="@+id/rowCareReminderNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_10">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/aqua_size_78"
                android:orientation="horizontal"
                android:paddingStart="@dimen/aqua_size_16"
                android:paddingTop="@dimen/aqua_size_12"
                android:paddingEnd="@dimen/aqua_size_14"
                android:paddingBottom="@dimen/aqua_size_12">

                <LinearLayout
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/aqua_size_12">

                    <TextView
                        android:id="@+id/tvCareReminderNotificationsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/aquarium_text_care_reminder_notifications"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCareReminderNotificationsSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="@dimen/aqua_size_2"
                        android:text="@string/aquarium_text_send_reminder_notifications_for_this_tank_s_care_tasks"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_caption" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchCareReminderNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvDataManagementTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_26"
            android:includeFontPadding="false"
            android:text="@string/aquarium_text_data_management"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body" />

        <LinearLayout
    style="@style/Widget.Aqua.SelectionRow.Settings"
            android:id="@+id/rowDuplicateTank"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_60"
            android:layout_marginTop="@dimen/aqua_size_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/aqua_size_16"
                android:paddingEnd="@dimen/aqua_size_14">

                <TextView
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/aquarium_text_duplicate_tank"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/aqua_size_22"
                    android:layout_height="@dimen/aqua_size_22"
                    android:contentDescription="@string/aquarium_content_desc_open"
                    android:scaleType="center"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/aqua_card_text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
    style="@style/Widget.Aqua.SelectionRow.Settings"
            android:id="@+id/rowExportTankData"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_60"
            android:layout_marginTop="@dimen/aqua_size_10">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/aqua_size_16"
                android:paddingEnd="@dimen/aqua_size_14">

                <TextView
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/aquarium_text_export_tank_data"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/aqua_size_22"
                    android:layout_height="@dimen/aqua_size_22"
                    android:contentDescription="@string/aquarium_content_desc_open"
                    android:scaleType="center"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/aqua_card_text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvDangerZoneTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_26"
            android:includeFontPadding="false"
            android:text="@string/aquarium_text_danger_zone"
            android:textColor="@color/aqua_tv_danger_zone_title_content"
            android:textSize="@dimen/aqua_text_size_body" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Aqua.Button.Danger"
            android:id="@+id/rowDeleteTank"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_button_height"
            android:layout_marginTop="@dimen/aqua_size_12"
            android:gravity="center"
            android:minWidth="@dimen/aqua_size_0"
            android:minHeight="@dimen/aqua_size_0"
            android:text="@string/aquarium_text_delete_tank"
            android:textStyle="bold"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textEnd"
            app:iconPadding="@dimen/aqua_size_8" />

    </LinearLayout>

</ScrollView>
