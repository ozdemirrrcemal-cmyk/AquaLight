<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">
    <include
        android:id="@+id/appHeader" layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/aqua_size_16">
            <include
                android:id="@+id/plantIdentity" layout="@layout/layout_plant_health_identity" />
            <TextView
                android:id="@+id/tvLoadError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                android:text="@string/plant_health_load_failed"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Widget.Aqua.Button.OutlineAccent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/aqua_size_48"
                android:layout_marginTop="@dimen/aqua_size_8"
                android:text="@string/plant_health_retry" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/recordContainer"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                    android:text="@string/plant_health_record_title"
                    android:layout_marginTop="@dimen/aqua_size_12" />
                <TextView
                    android:id="@+id/tvSignsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodySmallBold"
                    android:text="@string/plant_health_record_signs"
                    android:layout_marginTop="@dimen/aqua_size_12" />
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_8">
                    <TextView
                        android:id="@+id/tvSymptoms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodySmallBold"
                        android:text="@string/plant_health_record_title"
                        android:padding="@dimen/aqua_size_12" />
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:id="@+id/tvNoteLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodySmallBold"
                    android:text="@string/plant_health_record_note"
                    android:layout_marginTop="@dimen/aqua_size_12" />
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_8">
                    <TextView
                        android:id="@+id/tvNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryBodySmall"
                        android:text="@string/plant_health_note_optional"
                        android:padding="@dimen/aqua_size_12" />
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:id="@+id/photoContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/aqua_size_8" />
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_8">
                    <TextView
                        android:id="@+id/tvDeferred"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                        android:text="@string/plant_health_analysis_deferred"
                        android:padding="@dimen/aqua_size_12" />
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/algaeContainer"
                    android:layout_marginTop="@dimen/aqua_size_12"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tvAlgae"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                        android:text="@string/plant_health_algae_reported" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoAlgaeControl"
                        style="@style/Widget.Aqua.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/aqua_size_48"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:text="@string/plant_health_algae_go_control" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
