<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_bg"
    tools:context=".ui.tabs.devices.detail.light.DeviceLightFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/lightScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/lightContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HERO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLightHero"
                style="@style/Widget.Aqua.Light.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvActiveProgramName"
                                style="@style/TextAppearance.Aqua.Light.CardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nature Day"
                                tools:text="Nature Day" />

                            <TextView
                                android:id="@+id/tvLightRunStatus"
                                style="@style/TextAppearance.Aqua.Light.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Auto program running"
                                tools:text="Auto program running" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvOnlineChip"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_light_online_chip"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="ONLINE"
                            android:textColor="@color/light_status_online"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="ONLINE" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CURRENT POWER" />

                            <TextView
                                android:id="@+id/tvCurrentWatt"
                                style="@style/TextAppearance.Aqua.Light.Metric"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="34.6W"
                                tools:text="34.6W" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="OUTPUT" />

                            <TextView
                                android:id="@+id/tvCurrentOutputPercent"
                                style="@style/TextAppearance.Aqua.Light.MetricSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="78%"
                                tools:text="78%" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="24dp"
                        android:background="@color/light_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NOW" />

                            <TextView
                                android:id="@+id/tvDeviceTime"
                                style="@style/TextAppearance.Aqua.Light.BodyStrong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="14:37"
                                tools:text="14:37" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.4"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NEXT EVENT" />

                            <TextView
                                android:id="@+id/tvNextEvent"
                                style="@style/TextAppearance.Aqua.Light.BodyStrong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="18:30 Sunset"
                                tools:text="18:30 Sunset" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- LIVE TIMELINE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLiveTimeline"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.SectionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Live Timeline" />

                        <TextView
                            android:id="@+id/tvTimelineStatus"
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESP32 time"
                            tools:text="ESP32 time" />

                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/timelinePreviewContainer"
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_light_timeline_panel">

                        <View
                            android:id="@+id/viewTimelineBaseline"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_gravity="bottom"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:layout_marginBottom="34dp"
                            android:background="@color/light_stroke" />

                        <View
                            android:id="@+id/viewNowLine"
                            android:layout_width="2dp"
                            android:layout_height="112dp"
                            android:layout_gravity="center_horizontal|bottom"
                            android:layout_marginBottom="34dp"
                            android:background="@color/light_accent" />

                        <TextView
                            android:id="@+id/tvNowMarker"
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal|bottom"
                            android:layout_marginBottom="6dp"
                            android:text="NOW 14:37"
                            android:textColor="@color/light_accent"
                            tools:text="NOW 14:37" />

                        <TextView
                            android:id="@+id/tvTimelinePlaceholder"
                            style="@style/TextAppearance.Aqua.Light.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Curve preview"
                            android:textColor="@color/light_text_tertiary" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sunrise" />

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Peak" />

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="Sunset" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

      <!-- MAIN ACTIONS -->
<GridLayout
    android:id="@+id/lightActionsGrid"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:columnCount="2"
    android:rowCount="2"
    android:useDefaultMargins="false">

    <!-- Manual -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardManual"
        style="@style/Widget.Aqua.Light.Card.Action"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_columnWeight="1"
        android:layout_marginEnd="7dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_light_action_icon"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/light_accent"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Aqua.Light.ActionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Manual" />

                <TextView
                    style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Live control" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Programs -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPrograms"
        style="@style/Widget.Aqua.Light.Card.Action"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_columnWeight="1"
        android:layout_marginStart="7dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_light_action_icon"
                android:gravity="center"
                android:text="≋"
                android:textColor="@color/light_accent"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Aqua.Light.ActionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Programs" />

                <TextView
                    style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Schedule" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Setup -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuickSetup"
        style="@style/Widget.Aqua.Light.Card.Action"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_columnWeight="1"
        android:layout_marginEnd="7dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_light_action_icon"
                android:gravity="center"
                android:text="✦"
                android:textColor="@color/light_gold"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Aqua.Light.ActionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Quick Setup" />

                <TextView
                    style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Guided setup" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Presets -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPresets"
        style="@style/Widget.Aqua.Light.Card.Action"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_columnWeight="1"
        android:layout_marginStart="7dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_light_action_icon"
                android:gravity="center"
                android:text="●"
                android:textColor="@color/light_accent"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Aqua.Light.ActionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Presets" />

                <TextView
                    style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Scenes" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</GridLayout>

            <!-- DEVICE HEALTH -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDeviceHealth"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Device Health" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvHealthTemp"
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="0dp"
                            android:layout_height="68dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_stat_pill"
                            android:gravity="center"
                            android:text="Temp\n38°C"
                            tools:text="Temp\n38°C" />

                        <TextView
                            android:id="@+id/tvHealthFan"
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="0dp"
                            android:layout_height="68dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_stat_pill"
                            android:gravity="center"
                            android:text="Fan\nAuto"
                            tools:text="Fan\nAuto" />

                        <TextView
                            android:id="@+id/tvHealthTime"
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="0dp"
                            android:layout_height="68dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_stat_pill"
                            android:gravity="center"
                            android:text="Time\nSynced"
                            tools:text="Time\nSynced" />

                        <TextView
                            android:id="@+id/tvHealthFirmware"
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="0dp"
                            android:layout_height="68dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_stat_pill"
                            android:gravity="center"
                            android:text="FW\n1.0.4"
                            tools:text="FW\n1.0.4" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>