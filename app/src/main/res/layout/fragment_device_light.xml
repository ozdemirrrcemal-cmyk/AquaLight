<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_bg"
    tools:context=".ui.tabs.devices.detail.light.DeviceLightFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/lightScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="28dp"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/lightContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLightHero"
                style="@style/Widget.Aqua.Light.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvActiveProgramName"
                                style="@style/TextAppearance.Aqua.Light.ActionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text=""
                                tools:text="Nature Day" />

                            <TextView
                                android:id="@+id/tvLightRunStatus"
                                style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text=""
                                tools:text="Auto program running" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvLiveModeChip"
                            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_light_mode_chip_auto"
                            android:gravity="center"
                            android:minWidth="78dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text=""
                            tools:text="AUTO" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Aqua.Light.Card.Stat"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingStart="14dp"
                                android:paddingEnd="12dp">

                                <TextView
                                    style="@style/TextAppearance.Aqua.Light.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Current Power" />

                                <TextView
                                    android:id="@+id/tvCurrentWatt"
                                    style="@style/TextAppearance.Aqua.Light.BodyStrong"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text=""
                                    tools:text="120.0W" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Aqua.Light.Card.Stat"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingStart="14dp"
                                android:paddingEnd="12dp">

                                <TextView
                                    style="@style/TextAppearance.Aqua.Light.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Output" />

                                <TextView
                                    android:id="@+id/tvCurrentOutputPercent"
                                    style="@style/TextAppearance.Aqua.Light.BodyStrong"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text=""
                                    tools:text="100%" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/liveChannelChipsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLiveRedChannel"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Red"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_channel_chip_red"
                            android:gravity="center"
                            android:text=""
                            tools:text="R 80%" />

                        <TextView
                            android:id="@+id/tvLiveGreenChannel"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Green"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_channel_chip_green"
                            android:gravity="center"
                            android:text=""
                            tools:text="G 75%" />

                        <TextView
                            android:id="@+id/tvLiveBlueChannel"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Blue"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_channel_chip_blue"
                            android:gravity="center"
                            android:text=""
                            tools:text="B 90%" />

                        <TextView
                            android:id="@+id/tvLiveWhiteChannel"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.White"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_channel_chip_white"
                            android:gravity="center"
                            android:text=""
                            tools:text="W 65%" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Aqua.Light.Card.Stat"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="0.9">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingStart="14dp"
                                android:paddingEnd="10dp">

                                <TextView
                                    style="@style/TextAppearance.Aqua.Light.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Now" />

                                <TextView
                                    android:id="@+id/tvDeviceTime"
                                    style="@style/TextAppearance.Aqua.Light.BodyStrong"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text=""
                                    tools:text="14:37" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Aqua.Light.Card.Stat"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1.65">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingStart="14dp"
                                android:paddingEnd="12dp">

                                <TextView
                                    style="@style/TextAppearance.Aqua.Light.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Next Event" />

                                <TextView
                                    android:id="@+id/tvNextEvent"
                                    style="@style/TextAppearance.Aqua.Light.BodyStrong"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text=""
                                    android:textSize="14sp"
                                    tools:text="21:00 Peak End" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLiveTimeline"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ActionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Live Timeline" />

                        <TextView
                            android:id="@+id/tvTimelineStatus"
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text=""
                            tools:text="Today active plan" />

                    </LinearLayout>

                    <com.aqua.aqualight.ui.tabs.devices.detail.light.curve.view.TodayLightPlanGraphView
                        android:id="@+id/todayLightPlanGraphView"
                        android:layout_width="match_parent"
                        android:layout_height="178dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_light_timeline_panel" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <GridLayout
                android:id="@+id/lightActionsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="false">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardManual"
                    style="@style/Widget.Aqua.Light.Card.Action"
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingEnd="11dp">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_light_action_icon"
                            android:gravity="center"
                            android:text="☰"
                            android:textColor="@color/light_accent"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.ActionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Manual" />

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Live control" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPrograms"
                    style="@style/Widget.Aqua.Light.Card.Action"
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingEnd="11dp">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_light_action_icon"
                            android:gravity="center"
                            android:text="≋"
                            android:textColor="@color/light_accent"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.ActionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Programs" />

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Schedule" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQuickSetup"
                    style="@style/Widget.Aqua.Light.Card.Action"
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingEnd="11dp">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_light_action_icon"
                            android:gravity="center"
                            android:text="✦"
                            android:textColor="@color/light_gold"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.ActionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Quick Setup" />

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Smart setup" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPresets"
                    style="@style/Widget.Aqua.Light.Card.Action"
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingEnd="11dp">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_light_action_icon"
                            android:gravity="center"
                            android:text="●"
                            android:textColor="@color/light_accent"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.ActionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Presets" />

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Scenes" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDeviceHealth"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.ActionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Device Health" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardHealthTemperature"
                            style="@style/Widget.Aqua.Light.Card.Stat"
                            android:layout_width="0dp"
                            android:layout_height="92dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp">

                                <TextView
                                    style="@style/TextAppearance.Aqua.Light.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:gravity="start"
                                    android:maxLines="1"
                                    android:text="Controller Temp" />

                                <TextView
                                    android:id="@+id/tvHealthTempValue"
                                    style="@style/TextAppearance.Aqua.Light.BodyStrong"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="9dp"
                                    android:ellipsize="end"
                                    android:gravity="start"
                                    android:maxLines="1"
                                    android:text=""
                                    tools:text="38°C" />

                                <TextView
                                    android:id="@+id/tvHealthTempStatus"
                                    style="@style/TextAppearance.Aqua.Light.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:ellipsize="end"
                                    android:gravity="start"
                                    android:maxLines="1"
                                    android:text=""
                                    tools:text="Active" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardHealthFan"
                            style="@style/Widget.Aqua.Light.Card.Stat"
                            android:layout_width="0dp"
                            android:layout_height="92dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp">

                                <TextView
                                    style="@style/TextAppearance.Aqua.Light.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:gravity="start"
                                    android:maxLines="1"
                                    android:text="Cooling Fan" />

                                <TextView
                                    android:id="@+id/tvHealthFanValue"
                                    style="@style/TextAppearance.Aqua.Light.BodyStrong"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="9dp"
                                    android:ellipsize="end"
                                    android:gravity="start"
                                    android:maxLines="1"
                                    android:text=""
                                    tools:text="Auto · Off" />

                                <TextView
                                    android:id="@+id/tvHealthFanStatus"
                                    style="@style/TextAppearance.Aqua.Light.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:ellipsize="end"
                                    android:gravity="start"
                                    android:maxLines="1"
                                    android:text=""
                                    tools:text="2 fans" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>