<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/deviceHeader"
        layout="@layout/layout_device_detail_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/lightProgramListScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background_color"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/deviceHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/lightProgramListRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="28dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProgramSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/light_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/light_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvActiveProgramTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/inter_semibold"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text=""
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="19sp"
                                tools:text="Every Day Program" />

                            <TextView
                                android:id="@+id/tvActiveProgramSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text=""
                                android:textColor="@color/settings_text_secondary"
                                android:textSize="12sp"
                                tools:text="09:00 → 19:15 · Every day" />

                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginStart="10dp"
                            app:cardBackgroundColor="@color/light_chip_auto"
                            app:cardCornerRadius="15dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/light_accent"
                            app:strokeWidth="1dp">

                            <TextView
                                android:id="@+id/tvActiveProgramChip"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/inter_semibold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text=""
                                android:textColor="@color/light_accent"
                                android:textSize="11sp"
                                tools:text="ACTIVE" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <com.aqua.aqualight.ui.tabs.devices.detail.light.shared.curve.LightCurveChartView
                        android:id="@+id/viewActiveProgramCurve"
                        android:layout_width="match_parent"
                        android:layout_height="172dp"
                        android:layout_marginTop="14dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/light_stroke" />

                    <LinearLayout
                        android:id="@+id/programSummaryStats"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_light_metric_circle"
                                android:fontFamily="@font/inter_semibold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="@string/light_program_summary_peak_icon"
                                android:textColor="@color/light_accent"
                                android:textSize="17sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/light_program_summary_peak_output"
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvProgramSummaryPeak"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="@font/inter_semibold"
                                    android:includeFontPadding="false"
                                    android:text=""
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="17sp"
                                    tools:text="100%" />

                            </LinearLayout>

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:alpha="0.75"
                            android:background="@color/light_stroke" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_light_metric_circle"
                                android:fontFamily="@font/inter_semibold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="@string/light_program_summary_photoperiod_icon"
                                android:textColor="@color/light_accent"
                                android:textSize="18sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/light_program_summary_photoperiod"
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvProgramPhotoperiod"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="@font/inter_semibold"
                                    android:includeFontPadding="false"
                                    android:text=""
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="17sp"
                                    tools:text="10h 15m" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/programFilterRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipProgramsAll"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/light_accent_soft"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/light_accent"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:text="@string/light_program_filter_all"
                        android:textColor="@color/light_accent"
                        android:textSize="12sp" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipProgramsActive"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/light_surface_deep"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/light_stroke"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:text="@string/light_program_filter_active"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="12sp" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipProgramsDisabled"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/light_surface_deep"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/light_stroke"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:text="@string/light_program_filter_disabled"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="12sp" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/programsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="2"
                tools:listitem="@layout/item_light_program_card" />

            <LinearLayout
                android:id="@+id/programsEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="28dp"
                android:paddingEnd="18dp"
                android:paddingBottom="28dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_light_metric_circle"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/common_plus"
                    android:textColor="@color/light_accent"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/tvProgramsEmptyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/light_programs_empty_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvProgramsEmptyDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/light_programs_empty_description"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnEmptyAddProgram"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/light_accent"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/light_add_program"
                        android:textColor="@color/background_color"
                        android:textSize="14sp" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>