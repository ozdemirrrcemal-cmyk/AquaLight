<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_bg"
    tools:context=".ui.tabs.devices.detail.light.quicksetup.DeviceLightQuickSetupFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/quickSetupScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomActionsBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/quickSetupContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/noLinkedTankContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Light.Card.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="22dp"
                        android:paddingTop="42dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="42dp">

                        <TextView
                            android:id="@+id/tvNoLinkedTankTitle"
                            style="@style/TextAppearance.Aqua.Light.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No tank linked"
                            tools:text="Preparing setup" />

                        <TextView
                            android:id="@+id/tvNoLinkedTankMessage"
                            style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                            android:layout_width="280dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="Link this light device to a tank to generate a smart lighting setup." />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/recommendationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSmartSummary"
                    style="@style/Widget.Aqua.Light.Card.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="18dp">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Smart Recommendation" />

                        <TextView
                            android:id="@+id/tvRecommendationTitle"
                            style="@style/TextAppearance.Aqua.Light.SectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Smart Light Program"
                            tools:text="First Week Safe Start" />

                        <TextView
                            android:id="@+id/tvRecommendationSubtitle"
                            style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Analyzing your tank profile..."
                            tools:text="Marine / reef display · Blue-weighted viewing" />
                        <LinearLayout
                            android:id="@+id/recommendationMetaChipsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvSetupPhaseChip"
                                style="@style/TextAppearance.Aqua.Light.Caption"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_light_program_time_panel"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="Phase"
                                tools:text="Stabilizing" />

                            <TextView
                                android:id="@+id/tvTechLevelChip"
                                style="@style/TextAppearance.Aqua.Light.Caption"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="6dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_light_program_time_panel"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="Tech"
                                tools:text="Low-tech" />

                            <TextView
                                android:id="@+id/tvConfidenceChip"
                                style="@style/TextAppearance.Aqua.Light.Caption"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_light_program_time_panel"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="Confidence"
                                tools:text="Medium confidence" />

                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                style="@style/Widget.Aqua.Light.Card.Stat"
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:layout_marginEnd="7dp"
                                android:layout_weight="1">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp">

                                    <TextView
                                        style="@style/TextAppearance.Aqua.Light.Caption"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Duration" />

                                    <TextView
                                        android:id="@+id/tvDurationValue"
                                        style="@style/TextAppearance.Aqua.Light.BodyStrong"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:textSize="16sp"
                                        tools:text="4h" />

                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                style="@style/Widget.Aqua.Light.Card.Stat"
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:layout_marginStart="7dp"
                                android:layout_weight="1">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp">

                                    <TextView
                                        style="@style/TextAppearance.Aqua.Light.Caption"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Intensity" />

                                    <TextView
                                        android:id="@+id/tvIntensityValue"
                                        style="@style/TextAppearance.Aqua.Light.BodyStrong"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:textSize="16sp"
                                        tools:text="Very Gentle" />

                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTankSummary"
                    style="@style/Widget.Aqua.Light.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="16dp">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ActionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tank Analysis" />

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Profile data used by the recommendation engine." />

                        <LinearLayout
                            android:id="@+id/tankSummaryContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProgramPreview"
                    style="@style/Widget.Aqua.Light.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="18dp">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ActionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Suggested Program" />

                        <TextView
                            android:id="@+id/tvProgramGoal"
                            style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            tools:text="Blue-weighted viewing · High confidence" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.card.MaterialCardView
                                    style="@style/Widget.Aqua.Light.Card.Stat"
                                    android:layout_width="0dp"
                                    android:layout_height="64dp"
                                    android:layout_marginEnd="7dp"
                                    android:layout_weight="1">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <TextView
                                            style="@style/TextAppearance.Aqua.Light.Caption"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Start" />

                                        <TextView
                                            android:id="@+id/tvStartTime"
                                            style="@style/TextAppearance.Aqua.Light.BodyStrong"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:textSize="17sp"
                                            tools:text="10:00" />

                                    </LinearLayout>

                                </com.google.android.material.card.MaterialCardView>

                                <com.google.android.material.card.MaterialCardView
                                    style="@style/Widget.Aqua.Light.Card.Stat"
                                    android:layout_width="0dp"
                                    android:layout_height="64dp"
                                    android:layout_marginStart="7dp"
                                    android:layout_weight="1">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <TextView
                                            style="@style/TextAppearance.Aqua.Light.Caption"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Peak" />

                                        <TextView
                                            android:id="@+id/tvPeakStartTime"
                                            style="@style/TextAppearance.Aqua.Light.BodyStrong"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:textSize="17sp"
                                            tools:text="10:30" />

                                    </LinearLayout>

                                </com.google.android.material.card.MaterialCardView>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal">

                                <com.google.android.material.card.MaterialCardView
                                    style="@style/Widget.Aqua.Light.Card.Stat"
                                    android:layout_width="0dp"
                                    android:layout_height="64dp"
                                    android:layout_marginEnd="7dp"
                                    android:layout_weight="1">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <TextView
                                            style="@style/TextAppearance.Aqua.Light.Caption"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Hold" />

                                        <TextView
                                            android:id="@+id/tvPeakEndTime"
                                            style="@style/TextAppearance.Aqua.Light.BodyStrong"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:textSize="17sp"
                                            tools:text="13:30" />

                                    </LinearLayout>

                                </com.google.android.material.card.MaterialCardView>

                                <com.google.android.material.card.MaterialCardView
                                    style="@style/Widget.Aqua.Light.Card.Stat"
                                    android:layout_width="0dp"
                                    android:layout_height="64dp"
                                    android:layout_marginStart="7dp"
                                    android:layout_weight="1">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <TextView
                                            style="@style/TextAppearance.Aqua.Light.Caption"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="End" />

                                        <TextView
                                            android:id="@+id/tvEndTime"
                                            style="@style/TextAppearance.Aqua.Light.BodyStrong"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:textSize="17sp"
                                            tools:text="14:00" />

                                    </LinearLayout>

                                </com.google.android.material.card.MaterialCardView>

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/channelValuesContainer"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvRedValue"
                                style="@style/TextAppearance.Aqua.Light.ChannelChip.Red"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                tools:text="R3" />

                            <TextView
                                android:id="@+id/tvGreenValue"
                                style="@style/TextAppearance.Aqua.Light.ChannelChip.Green"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                tools:text="G8" />

                            <TextView
                                android:id="@+id/tvBlueValue"
                                style="@style/TextAppearance.Aqua.Light.ChannelChip.Blue"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                tools:text="B40" />

                            <TextView
                                android:id="@+id/tvWhiteValue"
                                style="@style/TextAppearance.Aqua.Light.ChannelChip.White"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="5dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                tools:text="W19" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReasoning"
                    style="@style/Widget.Aqua.Light.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="16dp">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ActionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Why this setup?" />

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Top factors behind this recommendation." />

                        <LinearLayout
                            android:id="@+id/reasoningContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/btnShowAllReasons"
                            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_light_filter_bar"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:text="View all reasons"
                            android:textColor="@color/light_accent"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWarnings"
                    style="@style/Widget.Aqua.Light.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="16dp">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ActionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Before applying" />

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Important notes before saving this program." />

                        <LinearLayout
                            android:id="@+id/warningsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/btnShowAllWarnings"
                            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_light_filter_bar"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:text="View all notes"
                            android:textColor="@color/light_accent"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomActionsBar"
        android:layout_width="0dp"
        android:layout_height="92dp"
        android:background="@color/light_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProgram"
            style="@style/Widget.Aqua.Light.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Save"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoadToDevice"
            style="@style/Widget.Aqua.Light.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.25"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Load to Device"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>