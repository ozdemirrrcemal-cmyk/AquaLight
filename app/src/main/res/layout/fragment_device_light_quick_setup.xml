<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_bg"
    tools:context=".ui.tabs.devices.detail.light.quicksetup.DeviceLightQuickSetupFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/quickSetupScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="14dp"
        android:paddingEnd="10dp"
        android:paddingBottom="110dp"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/quickSetupContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/noLinkedTankContainer"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    style="@style/TextAppearance.Aqua.Light.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No tank linked" />

                <TextView
                    android:id="@+id/tvNoLinkedTankMessage"
                    style="@style/TextAppearance.Aqua.Light.Body"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Link this light device to a tank to generate a smart lighting setup." />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/recommendationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- SMART SUMMARY -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSmartSummary"
                    style="@style/Widget.Aqua.Light.Card.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Smart Quick Setup" />

                        <TextView
                            android:id="@+id/tvRecommendationTitle"
                            style="@style/TextAppearance.Aqua.Light.SectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Smart Light Program"
                            tools:text="First Week Safe Start" />

                        <TextView
                            android:id="@+id/tvRecommendationSubtitle"
                            style="@style/TextAppearance.Aqua.Light.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Analyzing your tank profile..."
                            tools:text="New planted tank · Low algae pressure setup" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_light_program_time_panel"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.Aqua.Light.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Duration" />

                                <TextView
                                    android:id="@+id/tvDurationValue"
                                    style="@style/TextAppearance.Aqua.Light.SectionTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    tools:text="6h" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_light_program_time_panel"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.Aqua.Light.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Intensity" />

                                <TextView
                                    android:id="@+id/tvIntensityValue"
                                    style="@style/TextAppearance.Aqua.Light.SectionTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    tools:text="Gentle" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- TANK SUMMARY -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTankSummary"
                    style="@style/Widget.Aqua.Light.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.SectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tank Analysis" />

                        <LinearLayout
                            android:id="@+id/tankSummaryContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- PROGRAM PREVIEW -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProgramPreview"
                    style="@style/Widget.Aqua.Light.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.SectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Suggested Program" />

                        <TextView
                            android:id="@+id/tvProgramGoal"
                            style="@style/TextAppearance.Aqua.Light.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            tools:text="Plant Growth + Stability" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/TextAppearance.Aqua.Light.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Start" />

                                <TextView
                                    android:id="@+id/tvStartTime"
                                    style="@style/TextAppearance.Aqua.Light.SectionTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="10:00" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/TextAppearance.Aqua.Light.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Peak Start" />

                                <TextView
                                    android:id="@+id/tvPeakStartTime"
                                    style="@style/TextAppearance.Aqua.Light.SectionTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="11:00" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/TextAppearance.Aqua.Light.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Peak End" />

                                <TextView
                                    android:id="@+id/tvPeakEndTime"
                                    style="@style/TextAppearance.Aqua.Light.SectionTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="16:00" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/TextAppearance.Aqua.Light.Caption"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="End" />

                                <TextView
                                    android:id="@+id/tvEndTime"
                                    style="@style/TextAppearance.Aqua.Light.SectionTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="17:00" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/channelValuesContainer"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_light_program_time_panel"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <TextView
                                android:id="@+id/tvRedValue"
                                style="@style/TextAppearance.Aqua.Light.ChannelValue.Red"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                tools:text="R55" />

                            <TextView
                                android:id="@+id/tvGreenValue"
                                style="@style/TextAppearance.Aqua.Light.ChannelValue.Green"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                tools:text="G55" />

                            <TextView
                                android:id="@+id/tvBlueValue"
                                style="@style/TextAppearance.Aqua.Light.ChannelValue.Blue"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                tools:text="B35" />

                            <TextView
                                android:id="@+id/tvWhiteValue"
                                style="@style/TextAppearance.Aqua.Light.ChannelValue.White"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                tools:text="W50" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- REASONING -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReasoning"
                    style="@style/Widget.Aqua.Light.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.SectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Why this setup?" />

                        <LinearLayout
                            android:id="@+id/reasoningContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- WARNINGS -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWarnings"
                    style="@style/Widget.Aqua.Light.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.SectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Before applying" />

                        <LinearLayout
                            android:id="@+id/warningsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomActionsBar"
        android:layout_width="0dp"
        android:layout_height="86dp"
        android:background="@color/light_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProgram"
            style="@style/Widget.Aqua.Light.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Save Program" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoadToDevice"
            style="@style/Widget.Aqua.Light.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Load to Device" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>