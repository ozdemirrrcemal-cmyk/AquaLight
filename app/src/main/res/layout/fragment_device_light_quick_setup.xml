<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/deviceHeader"
        layout="@layout/layout_device_detail_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/lightQuickSetupScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background_color"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/deviceHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/lightQuickSetupRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/light_screen_padding_horizontal"
            android:paddingTop="@dimen/light_screen_padding_top"
            android:paddingEnd="@dimen/light_screen_padding_horizontal"
            android:paddingBottom="@dimen/light_screen_padding_bottom">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuickSetupIntro"
                style="@style/Widget.Aqua.Light.Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/light_hero_margin_top"
                app:cardCornerRadius="@dimen/light_card_corner_radius_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/light_card_padding">

                    <TextView
                        android:id="@+id/tvQuickIntroTitle"
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/light_quick_setup_intro_title" />

                    <TextView
                        android:id="@+id/tvQuickIntroDesc"
                        style="@style/TextAppearance.Aqua.Light.BodyMuted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/light_quick_setup_intro_description" />

                    <LinearLayout
                        android:id="@+id/quickIntroMiniCurve"
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="3"
                            android:background="@color/light_stroke" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/light_accent_soft" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="5"
                            android:background="@color/light_accent" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/light_accent_soft" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="4"
                            android:background="@color/light_stroke" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuickDays"
                style="@style/Widget.Aqua.Light.Card.SurfaceDeep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/light_card_margin_top"
                app:cardCornerRadius="@dimen/light_card_corner_radius_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/light_card_padding">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/light_quick_setup_step_repeat_days" />

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.BodyMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/light_quick_setup_repeat_days_description" />

                    <LinearLayout
                        android:id="@+id/dayChipsRow"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipDayMon"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_editor_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_semibold"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/common_day_mon_short"
                            android:textColor="@color/background_color"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chipDayTue"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_editor_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_semibold"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/common_day_tue_short"
                            android:textColor="@color/background_color"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chipDayWed"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_editor_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_semibold"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/common_day_wed_short"
                            android:textColor="@color/background_color"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chipDayThu"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_editor_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_semibold"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/common_day_thu_short"
                            android:textColor="@color/background_color"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chipDayFri"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_editor_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_semibold"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/common_day_fri_short"
                            android:textColor="@color/background_color"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chipDaySat"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_editor_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_semibold"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/common_day_sat_short"
                            android:textColor="@color/background_color"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chipDaySun"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_editor_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_semibold"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/common_day_sun_short"
                            android:textColor="@color/background_color"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuickTimeRange"
                style="@style/Widget.Aqua.Light.Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/light_card_margin_top"
                app:cardCornerRadius="@dimen/light_card_corner_radius_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/light_card_padding">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/light_quick_setup_step_time_range" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/btnSunriseStart"
                            android:layout_width="0dp"
                            android:layout_height="86dp"
                            android:layout_marginEnd="7dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.LabelSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/light_quick_setup_sunrise_start" />

                            <TextView
                                android:id="@+id/tvSunriseStartTime"
                                style="@style/TextAppearance.Aqua.Light.OutputValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text=""
                                tools:text="09:00" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnSunsetEnd"
                            android:layout_width="0dp"
                            android:layout_height="86dp"
                            android:layout_marginStart="7dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.LabelSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/light_quick_setup_sunset_end" />

                            <TextView
                                android:id="@+id/tvSunsetEndTime"
                                style="@style/TextAppearance.Aqua.Light.OutputValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text=""
                                tools:text="19:15" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuickRamp"
                style="@style/Widget.Aqua.Light.Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/light_card_margin_top"
                app:cardCornerRadius="@dimen/light_card_corner_radius_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/light_card_padding">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/light_quick_setup_step_ramp_duration" />

                    <TextView
                        android:id="@+id/tvRampDurationValue"
                        style="@style/TextAppearance.Aqua.Light.OutputValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textColor="@color/light_accent"
                        tools:text="60 min" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRampDuration"
                        style="@style/Widget.Aqua.Light.Slider.Master"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:valueFrom="15"
                        android:valueTo="120"
                        android:stepSize="15"
                        tools:value="60" />

                    <LinearLayout
                        android:id="@+id/rampPresetRow"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnRamp30"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_editor_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_semibold"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/light_quick_setup_ramp_30"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnRamp60"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_editor_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_semibold"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/light_quick_setup_ramp_60"
                            android:textColor="@color/background_color"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnRamp90"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_editor_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_semibold"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/light_quick_setup_ramp_90"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuickIntensity"
                style="@style/Widget.Aqua.Light.Card.SurfaceDeep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/light_card_margin_top"
                app:cardCornerRadius="@dimen/light_card_corner_radius_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/light_card_padding">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/light_quick_setup_step_peak_intensity" />

                    <TextView
                        android:id="@+id/tvPeakIntensityValue"
                        style="@style/TextAppearance.Aqua.Light.OutputValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        tools:text="100%" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderPeakIntensity"
                        style="@style/Widget.Aqua.Light.Slider.Master"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:valueFrom="10"
                        android:valueTo="100"
                        android:stepSize="1"
                        tools:value="100" />

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.ActionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/light_quick_setup_channel_balance" />

                    <LinearLayout
                        android:id="@+id/balancePresetRow"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipBalanceNatural"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_editor_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_semibold"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/light_quick_setup_balance_natural"
                            android:textColor="@color/background_color"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/chipBalancePlant"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_editor_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_semibold"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/light_quick_setup_balance_plant"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/chipBalanceWarm"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_editor_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_semibold"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/light_quick_setup_balance_warm"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/chipBalanceBlue"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_light_editor_chip_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/inter_semibold"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/light_quick_setup_balance_blue"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvQuickChannelSummary"
                        style="@style/TextAppearance.Aqua.Light.AccentSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text=""
                        tools:text="R80  G84  B79  W65" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuickPreview"
                style="@style/Widget.Aqua.Light.Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/light_card_margin_top"
                app:cardCornerRadius="@dimen/light_card_corner_radius_large"
                app:strokeColor="@color/light_accent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/light_card_padding">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/light_quick_setup_step_preview" />

                    <TextView
                        android:id="@+id/tvQuickPreviewSummary"
                        style="@style/TextAppearance.Aqua.Light.BodyMuted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text=""
                        tools:text="09:00 sunrise → 10:00 peak → 18:15 sunset ramp → 19:15 off · Every day" />

                    <LinearLayout
                        android:id="@+id/quickPreviewCurve"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="3"
                            android:background="@color/light_stroke" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/light_accent_soft" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="5"
                            android:background="@color/light_accent" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/light_accent_soft" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="4"
                            android:background="@color/light_stroke" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnCreateQuickProgram"
                        style="@style/TextAppearance.Aqua.Light.ButtonText"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_light_primary_action"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:text="@string/light_quick_setup_create_program" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>