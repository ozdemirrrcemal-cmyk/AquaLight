<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quickSetupInfoSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_light_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_light_sheet_handle" />

    <TextView
        android:id="@+id/tvSheetTitle"
        style="@style/TextAppearance.Aqua.Light.SheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Details"
        tools:text="Why this setup?" />

    <TextView
        android:id="@+id/tvSheetSubtitle"
        style="@style/TextAppearance.Aqua.Light.SheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Detailed information about this recommendation."
        tools:text="Main factors used by the smart recommendation engine." />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/infoScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:fadingEdgeLength="0dp"
        android:overScrollMode="never"
        android:scrollbarStyle="insideOverlay"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/infoRowsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        style="@style/Widget.Aqua.Light.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="26dp"
        android:text="Close" />

</LinearLayout>