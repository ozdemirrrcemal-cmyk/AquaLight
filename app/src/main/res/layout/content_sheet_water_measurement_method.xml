<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/water_measurement_sheet_subtitle"
        android:textColor="@color/aqua_card_text_secondary"
        android:textSize="@dimen/aqua_text_size_caption" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Aqua.Card.Metric"
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_52"
        android:layout_marginTop="@dimen/aqua_size_14"
        app:cardCornerRadius="@dimen/aqua_size_14">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMethodManual"
                style="@style/Widget.Aqua.Card.Inline"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/aqua_size_2"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/aqua_color_transparent"
                app:cardCornerRadius="@dimen/aqua_size_12"
                app:cardElevation="@dimen/aqua_size_0"
                app:strokeColor="@color/aqua_card_metric_outline"
                app:strokeWidth="@dimen/aqua_size_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivMethodManual"
                        android:layout_width="@dimen/aqua_size_18"
                        android:layout_height="@dimen/aqua_size_18"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_edit_24"
                        app:tint="@color/aqua_card_text_secondary" />

                    <TextView
                        android:id="@+id/tvMethodManual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_5"
                        android:includeFontPadding="false"
                        android:text="@string/water_measurement_method_manual"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_caption" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMethodTestKit"
                style="@style/Widget.Aqua.Card.Inline"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/aqua_size_2"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/aqua_accent_primary"
                app:cardCornerRadius="@dimen/aqua_size_12"
                app:cardElevation="@dimen/aqua_size_0"
                app:strokeColor="@color/aqua_accent_primary"
                app:strokeWidth="@dimen/aqua_size_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivMethodTestKit"
                        android:layout_width="@dimen/aqua_size_18"
                        android:layout_height="@dimen/aqua_size_18"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_care_water_test_24"
                        app:tint="@color/aqua_content_on_dark" />

                    <TextView
                        android:id="@+id/tvMethodTestKit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_5"
                        android:includeFontPadding="false"
                        android:text="@string/water_measurement_method_test_kit"
                        android:textColor="@color/aqua_content_on_dark"
                        android:textSize="@dimen/aqua_text_size_caption"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMethodDigital"
                style="@style/Widget.Aqua.Card.Inline"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/aqua_size_2"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/aqua_color_transparent"
                app:cardCornerRadius="@dimen/aqua_size_12"
                app:cardElevation="@dimen/aqua_size_0"
                app:strokeColor="@color/aqua_card_metric_outline"
                app:strokeWidth="@dimen/aqua_size_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivMethodDigital"
                        android:layout_width="@dimen/aqua_size_18"
                        android:layout_height="@dimen/aqua_size_18"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tank_health_device_24"
                        app:tint="@color/aqua_card_text_secondary" />

                    <TextView
                        android:id="@+id/tvMethodDigital"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_5"
                        android:includeFontPadding="false"
                        android:text="@string/water_measurement_method_digital"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_caption" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMethodSensor"
                style="@style/Widget.Aqua.Card.Inline"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/aqua_size_2"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/aqua_color_transparent"
                app:cardCornerRadius="@dimen/aqua_size_12"
                app:cardElevation="@dimen/aqua_size_0"
                app:strokeColor="@color/aqua_card_metric_outline"
                app:strokeWidth="@dimen/aqua_size_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivMethodSensor"
                        android:layout_width="@dimen/aqua_size_18"
                        android:layout_height="@dimen/aqua_size_18"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tank_health_sensor_24"
                        app:tint="@color/aqua_card_text_secondary" />

                    <TextView
                        android:id="@+id/tvMethodSensor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_5"
                        android:includeFontPadding="false"
                        android:text="@string/water_measurement_method_sensor"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_caption" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Aqua.Card.Metric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_12"
        app:cardCornerRadius="@dimen/aqua_size_14">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/rowTestKit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_64"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="@dimen/aqua_size_12">

                <ImageView
                    android:id="@+id/ivTestKit"
                    android:layout_width="@dimen/aqua_size_22"
                    android:layout_height="@dimen/aqua_size_22"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_care_water_test_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/aqua_accent_primary" />

                <LinearLayout
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/aqua_size_10"
                    android:layout_marginEnd="@dimen/aqua_size_8"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvTestKitValue"
                    app:layout_constraintStart_toEndOf="@id/ivTestKit"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/water_measurement_test_kit"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body_small" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_2"
                        android:includeFontPadding="false"
                        android:text="@string/water_measurement_test_kit_helper"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro_caption" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvTestKitValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/aqua_size_6"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body_small"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivTestKitChevron"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivTestKitChevron"
                    android:layout_width="@dimen/aqua_size_18"
                    android:layout_height="@dimen/aqua_size_18"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tank_health_chevron_right_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/aqua_card_text_secondary" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_1"
                android:layout_marginStart="@dimen/aqua_size_44"
                android:background="@color/aqua_card_divider" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/rowBasis"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_64"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="@dimen/aqua_size_12">

                <ImageView
                    android:id="@+id/ivBasis"
                    android:layout_width="@dimen/aqua_size_22"
                    android:layout_height="@dimen/aqua_size_22"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_water_test_molecule_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/aqua_content_on_dark" />

                <LinearLayout
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/aqua_size_10"
                    android:layout_marginEnd="@dimen/aqua_size_8"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvBasisValue"
                    app:layout_constraintStart_toEndOf="@id/ivBasis"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/water_measurement_basis"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body_small" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_2"
                        android:includeFontPadding="false"
                        android:text="@string/water_measurement_basis_helper"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro_caption" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvBasisValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/aqua_size_6"
                    android:includeFontPadding="false"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body_small"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivBasisChevron"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivBasisChevron"
                    android:layout_width="@dimen/aqua_size_18"
                    android:layout_height="@dimen/aqua_size_18"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tank_health_chevron_right_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/aqua_card_text_secondary" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_1"
                android:layout_marginStart="@dimen/aqua_size_44"
                android:background="@color/aqua_card_divider" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/rowUnit"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_64"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="@dimen/aqua_size_12">

                <ImageView
                    android:id="@+id/ivUnit"
                    android:layout_width="@dimen/aqua_size_22"
                    android:layout_height="@dimen/aqua_size_22"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_dosing_manual_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/aqua_accent_primary" />

                <LinearLayout
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/aqua_size_10"
                    android:layout_marginEnd="@dimen/aqua_size_8"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvUnitValue"
                    app:layout_constraintStart_toEndOf="@id/ivUnit"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/water_measurement_unit"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body_small" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_2"
                        android:includeFontPadding="false"
                        android:text="@string/water_measurement_unit_helper"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_micro_caption" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvUnitValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/aqua_size_6"
                    android:includeFontPadding="false"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body_small"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivUnitChevron"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivUnitChevron"
                    android:layout_width="@dimen/aqua_size_18"
                    android:layout_height="@dimen/aqua_size_18"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tank_health_chevron_right_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/aqua_card_text_secondary" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Aqua.Card.Info"
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_56"
        android:layout_marginTop="@dimen/aqua_size_12"
        app:cardCornerRadius="@dimen/aqua_size_14"
        app:strokeColor="@color/aqua_accent_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/aqua_size_12">

            <ImageView
                android:layout_width="@dimen/aqua_size_22"
                android:layout_height="@dimen/aqua_size_22"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tank_health_info_24"
                app:tint="@color/aqua_accent_primary" />

            <TextView
                android:id="@+id/tvCanonicalInfo"
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/aqua_size_10"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:textColor="@color/aqua_accent_primary"
                android:textSize="@dimen/aqua_text_size_caption" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApply"
        style="@style/Widget.Aqua.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_54"
        android:layout_marginTop="@dimen/aqua_size_12"
        android:text="@string/water_measurement_apply" />

</LinearLayout>
