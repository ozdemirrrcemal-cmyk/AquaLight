<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    style="@style/Widget.Aqua.Card"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardCareTask"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/aqua_size_12"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="@dimen/aqua_size_14"
        android:paddingTop="@dimen/aqua_size_13"
        android:paddingEnd="@dimen/aqua_size_14"
        android:paddingBottom="@dimen/aqua_size_13">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="@dimen/aqua_size_44"
            android:layout_height="@dimen/aqua_size_44"
            android:layout_marginTop="@dimen/aqua_size_3">

            <ImageView
                android:id="@+id/ivTaskIcon"
                android:layout_width="@dimen/aqua_size_24"
                android:layout_height="@dimen/aqua_size_24"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                app:tint="@android:color/white" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/textContainer"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/aqua_size_13"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/titleRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTaskTitle"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/aqua_text_size_body_precise"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSourceBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/aqua_size_22"
                    android:layout_marginStart="@dimen/aqua_size_8"
                    android:background="@drawable/bg_care_task_source_badge"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="@dimen/aqua_size_46"
                    android:paddingStart="@dimen/aqua_size_9"
                    android:paddingEnd="@dimen/aqua_size_9"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/aqua_text_size_micro_caption"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvTaskMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_7"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/aqua_palette_hex_b8c7d9"
                android:textSize="@dimen/aqua_text_size_caption" />

            <TextView
                android:id="@+id/tvTaskSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_6"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/aqua_palette_hex_b8c7d9"
                android:textSize="@dimen/aqua_text_size_caption" />

            <TextView
                android:id="@+id/tvTaskDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_6"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_caption_precise" />

            <TextView
                android:id="@+id/tvCompletedBadge"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/aqua_size_30"
                android:layout_marginTop="@dimen/aqua_size_9"
                android:background="@drawable/bg_care_task_completed_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="@dimen/aqua_size_78"
                android:paddingStart="@dimen/aqua_size_11"
                android:paddingEnd="@dimen/aqua_size_11"
                android:text="@string/maintenance_status_completed"
                android:textColor="@color/aqua_palette_hex_5fd6b4"
                android:textSize="@dimen/aqua_text_size_micro_plus"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>