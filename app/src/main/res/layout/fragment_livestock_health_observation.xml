<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/aqua_size_24"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/btnEvaluate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_16"
            android:paddingTop="@dimen/aqua_size_10"
            android:paddingEnd="@dimen/aqua_size_16">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/livestock_health_step_livestock"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:id="@+id/livestockSelectorScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/livestockSelectorContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvNoLivestock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_12"
                android:gravity="center"
                android:padding="@dimen/aqua_size_20"
                android:text="@string/livestock_health_no_livestock_body"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_body_small"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_20"
                android:text="@string/livestock_health_step_observation"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_4"
                android:text="@string/livestock_health_select_single"
                android:textColor="@color/aqua_content_muted"
                android:textSize="@dimen/aqua_text_size_caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSymptomNormal"
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_76"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/aqua_size_24"
                            android:layout_height="@dimen/aqua_size_24"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_health_heart_24"
                            app:tint="@color/aqua_status_success" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_6"
                            android:text="@string/livestock_health_symptom_normal"
                            android:textColor="@color/aqua_card_text_primary"
                            android:textSize="@dimen/aqua_text_size_caption" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="@dimen/aqua_size_8"
                    android:layout_height="@dimen/aqua_size_1" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSymptomSurface"
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_76"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/aqua_size_24"
                            android:layout_height="@dimen/aqua_size_24"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_water_test_wave_24" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_6"
                            android:gravity="center"
                            android:text="@string/livestock_health_symptom_surface"
                            android:textColor="@color/aqua_card_text_primary"
                            android:textSize="@dimen/aqua_text_size_caption" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_8"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSymptomAppetite"
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_76"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="@dimen/aqua_size_8"
                        android:text="@string/livestock_health_symptom_appetite"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_caption" />

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="@dimen/aqua_size_8"
                    android:layout_height="@dimen/aqua_size_1" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSymptomHiding"
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_76"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="@dimen/aqua_size_8"
                        android:text="@string/livestock_health_symptom_hiding"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_caption" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_8"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSymptomFins"
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_76"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="@dimen/aqua_size_8"
                        android:text="@string/livestock_health_symptom_fins"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_caption" />

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="@dimen/aqua_size_8"
                    android:layout_height="@dimen/aqua_size_1" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSymptomOther"
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_76"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="@dimen/aqua_size_8"
                        android:text="@string/livestock_health_symptom_other"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_caption" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_20"
                android:text="@string/livestock_health_step_affected"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_64"
                android:layout_marginTop="@dimen/aqua_size_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/aqua_size_14"
                    android:paddingEnd="@dimen/aqua_size_14">

                    <TextView
                        android:id="@+id/btnAffectedMinus"
                        android:layout_width="@dimen/aqua_size_48"
                        android:layout_height="@dimen/aqua_size_48"
                        android:background="@drawable/bg_aqua_toolbar_pill_action_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/common_minus"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_title_small" />

                    <TextView
                        android:id="@+id/tvAffectedCount"
                        android:layout_width="@dimen/aqua_size_56"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/livestock_health_default_count"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_title_medium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAffectedTotal"
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/livestock_health_affected_total_preview"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="@dimen/aqua_text_size_body_small" />

                    <TextView
                        android:id="@+id/btnAffectedPlus"
                        android:layout_width="@dimen/aqua_size_48"
                        android:layout_height="@dimen/aqua_size_48"
                        android:background="@drawable/bg_aqua_toolbar_pill_action_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/common_plus"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_title_small" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_20"
                android:text="@string/livestock_health_step_when"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_56"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/aqua_size_14"
                        android:text="@string/livestock_health_when_today"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body_small" />

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="@dimen/aqua_size_8"
                    android:layout_height="@dimen/aqua_size_1" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_56"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/aqua_size_14"
                        android:text="@string/livestock_health_when_now"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textSize="@dimen/aqua_text_size_body_small" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_20"
                android:text="@string/livestock_health_photo_optional"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_72"
                android:layout_marginTop="@dimen/aqua_size_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_size_14">

                    <ImageView
                        android:layout_width="@dimen/aqua_size_32"
                        android:layout_height="@dimen/aqua_size_32"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_camera_24"
                        app:tint="@color/aqua_button_blue" />

                    <LinearLayout
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/livestock_health_photo_add"
                            android:textColor="@color/aqua_card_text_primary"
                            android:textSize="@dimen/aqua_text_size_body_small"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_3"
                            android:text="@string/livestock_health_photo_hint"
                            android:textColor="@color/aqua_content_muted"
                            android:textSize="@dimen/aqua_text_size_micro" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_20"
                android:text="@string/livestock_health_note_label"
                android:textColor="@color/aqua_card_text_primary"
                android:textSize="@dimen/aqua_text_size_body"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10"
                android:hint="@string/livestock_health_note_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/aqua_size_90"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:maxLength="240"
                    android:maxLines="4"
                    android:minLines="3"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textColorHint="@color/aqua_content_muted" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEvaluate"
        style="@style/Widget.Aqua.Button.Primary"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_48"
        android:layout_marginStart="@dimen/aqua_size_16"
        android:layout_marginEnd="@dimen/aqua_size_16"
        android:layout_marginBottom="@dimen/aqua_size_16"
        android:text="@string/livestock_health_save_evaluate"
        app:icon="@drawable/ic_check_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
