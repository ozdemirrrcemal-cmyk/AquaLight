<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_16"
            android:paddingEnd="@dimen/aqua_size_16"
            android:paddingBottom="@dimen/aqua_size_24">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_160">

                <ImageView
                    android:id="@+id/imgPlantHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_health_plant_24"
                    app:tint="@null" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlantName"
                        android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryTitleSmallBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        tools:text="Anubias barteri var. caladiifolia" />

                    <TextView
                        android:id="@+id/tvPlantCategory"
                        android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_3"
                        tools:text="Epiphyte" />

                </LinearLayout>

                <TextView
                    android:textAppearance="@style/TextAppearance.Aqua.Content.MutedStatusMicro"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/aqua_size_28"
                    android:background="@drawable/bg_aqua_toolbar_pill_action_primary"
                    android:gravity="center"
                    android:paddingStart="@dimen/aqua_size_10"
                    android:paddingEnd="@dimen/aqua_size_10"
                    android:text="@string/plant_health_status_no_observation" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_12"
                android:orientation="horizontal"
                android:weightSum="4">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card.Metric"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_72"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/aqua_size_4">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/aqua_size_6">
                        <TextView
                            android:id="@+id/tvMetricGrowthValue"
                            android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryCaptionBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Slow" />
                        <TextView
                            android:textAppearance="@style/TextAppearance.Aqua.Content.MutedStatusNano"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_3"
                            android:gravity="center"
                            android:text="@string/plant_health_metric_growth" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card.Metric"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_72"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/aqua_size_4"
                    android:layout_marginEnd="@dimen/aqua_size_4">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/aqua_size_6">
                        <TextView
                            android:id="@+id/tvMetricDifficultyValue"
                            android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryCaptionBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Easy" />
                        <TextView
                            android:textAppearance="@style/TextAppearance.Aqua.Content.MutedStatusNano"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_3"
                            android:gravity="center"
                            android:text="@string/plant_health_metric_difficulty" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card.Metric"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_72"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/aqua_size_4"
                    android:layout_marginEnd="@dimen/aqua_size_4">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/aqua_size_6">
                        <TextView
                            android:id="@+id/tvMetricLightValue"
                            android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryCaptionBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Low–high" />
                        <TextView
                            android:textAppearance="@style/TextAppearance.Aqua.Content.MutedStatusNano"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_3"
                            android:gravity="center"
                            android:text="@string/plant_health_metric_light" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card.Metric"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="@dimen/aqua_size_72"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/aqua_size_4">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/aqua_size_6">
                        <TextView
                            android:id="@+id/tvMetricCo2Value"
                            android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryCaptionBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Optional" />
                        <TextView
                            android:textAppearance="@style/TextAppearance.Aqua.Content.MutedStatusNano"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_3"
                            android:gravity="center"
                            android:text="@string/plant_health_metric_co2" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabRow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_48"
                android:layout_marginTop="@dimen/aqua_size_12"
                android:orientation="horizontal"
                android:weightSum="4">

                <TextView
                    android:id="@+id/tabOverview"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/plant_health_tab_overview"
                    android:textColor="@color/aqua_accent_primary"
                    android:textSize="@dimen/aqua_text_size_caption"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabObservations"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/plant_health_tab_observations"
                    android:textColor="@color/aqua_content_secondary"
                    android:textSize="@dimen/aqua_text_size_caption" />

                <TextView
                    android:id="@+id/tabCare"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/plant_health_tab_care"
                    android:textColor="@color/aqua_content_secondary"
                    android:textSize="@dimen/aqua_text_size_caption" />

                <TextView
                    android:id="@+id/tabNotes"
                    android:layout_width="@dimen/aqua_size_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/plant_health_tab_notes"
                    android:textColor="@color/aqua_content_secondary"
                    android:textSize="@dimen/aqua_text_size_caption" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_1"
                android:background="@color/aqua_card_divider" />

            <LinearLayout
                android:id="@+id/overviewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodyBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_16"
                    android:text="@string/plant_health_last_status_title" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_8">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/aqua_size_14">
                        <ImageView
                            android:layout_width="@dimen/aqua_size_32"
                            android:layout_height="@dimen/aqua_size_32"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_health_plant_24"
                            app:tint="@color/aqua_content_secondary" />
                        <LinearLayout
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_12"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodySmallBold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/plant_health_no_observation_title" />
                            <TextView
                                android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/aqua_size_4"
                                android:text="@string/plant_health_no_observation_body" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodyBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_16"
                    android:text="@string/plant_health_basic_info_title" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_8">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/aqua_size_14">

                        <TextView android:id="@+id/tvSpecies" android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption" android:layout_width="match_parent" android:layout_height="wrap_content" tools:text="Species   Anubias barteri var. caladiifolia" />
                        <TextView android:id="@+id/tvPlacement" android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/aqua_size_8" tools:text="Placement   foreground • epiphyte" />
                        <TextView android:id="@+id/tvTemperature" android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/aqua_size_8" tools:text="Ideal temperature   22 – 26 °C" />
                        <TextView android:id="@+id/tvPh" android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/aqua_size_8" tools:text="pH   5.0 – 8.0" />
                        <TextView android:id="@+id/tvKh" android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/aqua_size_8" tools:text="KH   0 – 15 dKH" />
                        <TextView android:id="@+id/tvGh" android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/aqua_size_8" tools:text="GH   2 – 20 dGH" />
                        <TextView android:id="@+id/tvNutrients" android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/aqua_size_8" tools:text="Nutrient demand   Low" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/observationsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_16">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/aqua_size_24">
                        <ImageView
                            android:layout_width="@dimen/aqua_size_36"
                            android:layout_height="@dimen/aqua_size_36"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_health_plant_24"
                            app:tint="@color/aqua_content_secondary" />
                        <TextView
                            android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodyBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_10"
                            android:gravity="center"
                            android:text="@string/plant_health_observations_empty_title" />
                        <TextView
                            android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_6"
                            android:gravity="center"
                            android:text="@string/plant_health_observations_empty_body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenHistory"
                    style="@style/Widget.Aqua.Button.OutlineAccent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/aqua_size_48"
                    android:layout_marginTop="@dimen/aqua_size_12"
                    android:text="@string/plant_health_open_history" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/careContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodyBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_16"
                    android:text="@string/plant_health_care_species_title" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_8">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/aqua_size_14">
                        <TextView android:id="@+id/tvCareLight" android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption" android:layout_width="match_parent" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tvCareCo2" android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/aqua_size_8" />
                        <TextView android:id="@+id/tvCareNutrients" android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/aqua_size_8" />
                        <TextView android:id="@+id/tvCareSubstrate" android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/aqua_size_8" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodyBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_16"
                    android:text="@string/plant_health_care_tank_context_title" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card.Info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_8">
                    <TextView
                        android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/aqua_size_14"
                        android:text="@string/plant_health_care_tank_context_body" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/notesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_16">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/aqua_size_24">
                        <ImageView
                            android:layout_width="@dimen/aqua_size_32"
                            android:layout_height="@dimen/aqua_size_32"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_info"
                            app:tint="@color/aqua_content_secondary" />
                        <TextView
                            android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodyBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_10"
                            android:gravity="center"
                            android:text="@string/plant_health_notes_empty_title" />
                        <TextView
                            android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_6"
                            android:gravity="center"
                            android:text="@string/plant_health_notes_empty_body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewObservation"
                style="@style/Widget.Aqua.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_48"
                android:layout_marginTop="@dimen/aqua_size_18"
                android:text="@string/plant_health_new_observation" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
