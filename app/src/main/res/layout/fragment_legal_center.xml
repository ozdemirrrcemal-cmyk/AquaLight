<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".ui.tabs.settings.legal.LegalCenterFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_10"
            android:paddingTop="@dimen/aqua_size_16"
            android:paddingEnd="@dimen/aqua_size_10"
            android:paddingBottom="@dimen/aqua_size_16">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/aqua_size_6"
                android:layout_marginEnd="@dimen/aqua_size_6"
                android:layout_marginBottom="@dimen/aqua_size_12"
                android:text="@string/legal_center_description"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="@dimen/aqua_text_size_body_small" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Aqua.Card.Grouped">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowPrivacyNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/aqua_size_56"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/legal_center_privacy_desc"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/aqua_size_16">

                        <TextView
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/legal_privacy_title"
                            android:textColor="@color/aqua_card_text_secondary"
                            android:textSize="@dimen/aqua_text_size_body" />

                        <ImageView
                            android:layout_width="@dimen/aqua_size_20"
                            android:layout_height="@dimen/aqua_size_20"
                            android:contentDescription="@string/settings_arrow_desc"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="@color/aqua_card_text_secondary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_1"
                        android:background="@color/aqua_card_divider" />

                    <LinearLayout
                        android:id="@+id/rowTermsOfUse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/aqua_size_56"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/legal_center_terms_desc"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/aqua_size_16">

                        <TextView
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/legal_terms_title"
                            android:textColor="@color/aqua_card_text_secondary"
                            android:textSize="@dimen/aqua_text_size_body" />

                        <ImageView
                            android:layout_width="@dimen/aqua_size_20"
                            android:layout_height="@dimen/aqua_size_20"
                            android:contentDescription="@string/settings_arrow_desc"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="@color/aqua_card_text_secondary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_1"
                        android:background="@color/aqua_card_divider" />

                    <LinearLayout
                        android:id="@+id/rowThirdPartyLicenses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/aqua_size_56"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/legal_center_third_party_licenses_desc"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/aqua_size_16">

                        <TextView
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/legal_third_party_licenses_title"
                            android:textColor="@color/aqua_card_text_secondary"
                            android:textSize="@dimen/aqua_text_size_body"
                            tools:ignore="InefficientWeight" />

                        <ImageView
                            android:layout_width="@dimen/aqua_size_20"
                            android:layout_height="@dimen/aqua_size_20"
                            android:contentDescription="@string/settings_arrow_desc"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="@color/aqua_card_text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
