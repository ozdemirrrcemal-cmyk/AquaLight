<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/deviceHeader"
        layout="@layout/layout_device_detail_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/lightManualScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background_color"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/deviceHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/lightManualRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/light_screen_padding_horizontal"
            android:paddingTop="@dimen/light_screen_padding_top"
            android:paddingEnd="@dimen/light_screen_padding_horizontal"
            android:paddingBottom="@dimen/light_screen_padding_bottom">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardManualHero"
                style="@style/Widget.Aqua.Light.Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/light_hero_margin_top"
                app:cardCornerRadius="@dimen/light_card_corner_radius_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/light_card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvManualTitle"
                                style="@style/TextAppearance.Aqua.Light.HeroTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/light_manual_master_brightness" />

                            <TextView
                                android:id="@+id/tvManualSubtitle"
                                style="@style/TextAppearance.Aqua.Light.BodyMuted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/light_manual_subtitle" />

                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chipManualState"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/light_mode_chip_height"
                            app:cardBackgroundColor="@color/light_chip_auto"
                            app:cardCornerRadius="@dimen/light_mode_chip_radius"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/light_accent"
                            app:strokeWidth="@dimen/light_card_stroke_width">

                            <TextView
                                android:id="@+id/tvManualPowerState"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/inter_semibold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingStart="@dimen/light_mode_chip_padding_horizontal"
                                android:paddingEnd="@dimen/light_mode_chip_padding_horizontal"
                                android:text=""
                                android:textColor="@color/light_accent"
                                android:textSize="12sp"
                                tools:text="LIVE" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvManualOutputLabel"
                        style="@style/TextAppearance.Aqua.Light.BodyMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/light_manual_current_output" />

                    <TextView
                        android:id="@+id/tvManualOutputValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="34sp"
                        tools:text="78%" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderMasterBrightness"
                        style="@style/Widget.Aqua.Light.Slider.Master"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:valueFrom="0"
                        android:valueTo="100" />

                    <TextView
                        android:id="@+id/tvManualNotice"
                        style="@style/TextAppearance.Aqua.Light.BodyMuted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/light_manual_notice" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChannelControl"
                style="@style/Widget.Aqua.Light.Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/light_card_margin_top"
                app:cardCornerRadius="@dimen/light_card_corner_radius_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/light_card_padding">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/light_manual_channel_control" />

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.BodyMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/light_manual_channel_control_subtitle" />

                    <LinearLayout
                        android:id="@+id/redChannelHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@color/light_red" />

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ActionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/light_channel_red" />

                        <TextView
                            android:id="@+id/tvRedValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text=""
                            android:textColor="@color/light_red"
                            android:textSize="14sp"
                            tools:text="80%" />

                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRed"
                        style="@style/Widget.Aqua.Light.Slider.Red"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="100" />

                    <LinearLayout
                        android:id="@+id/greenChannelHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@color/light_green" />

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ActionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/light_channel_green" />

                        <TextView
                            android:id="@+id/tvGreenValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text=""
                            android:textColor="@color/light_green"
                            android:textSize="14sp"
                            tools:text="84%" />

                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderGreen"
                        style="@style/Widget.Aqua.Light.Slider.Green"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="100" />

                    <LinearLayout
                        android:id="@+id/blueChannelHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@color/light_blue" />

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ActionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/light_channel_blue" />

                        <TextView
                            android:id="@+id/tvBlueValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text=""
                            android:textColor="@color/light_blue"
                            android:textSize="14sp"
                            tools:text="79%" />

                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderBlue"
                        style="@style/Widget.Aqua.Light.Slider.Blue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="100" />

                    <LinearLayout
                        android:id="@+id/whiteChannelHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@color/light_white" />

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ActionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/light_channel_white" />

                        <TextView
                            android:id="@+id/tvWhiteValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text=""
                            android:textColor="@color/light_white"
                            android:textSize="14sp"
                            tools:text="65%" />

                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderWhite"
                        style="@style/Widget.Aqua.Light.Slider.White"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="100" />

                    <LinearLayout
                        android:id="@+id/manualQuickSetRow"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnAll100"
                            style="@style/Widget.Aqua.Light.Card.Metric"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/light_manual_all_100"
                                android:textColor="@color/light_accent" />

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnAll50"
                            style="@style/Widget.Aqua.Light.Card.Metric"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/light_manual_all_50"
                                android:textColor="@color/light_accent" />

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnAllOff"
                            style="@style/Widget.Aqua.Light.Card.Metric"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/light_manual_all_off"
                                android:textColor="@color/light_accent" />

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnResetChannels"
                            style="@style/Widget.Aqua.Light.Card.Metric"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/light_manual_reset"
                                android:textColor="@color/settings_text_secondary" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLivePreview"
                style="@style/Widget.Aqua.Light.Card.SurfaceDeep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/light_card_margin_top"
                app:cardCornerRadius="@dimen/light_card_corner_radius_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/light_card_padding">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/light_manual_light_preview" />

                    <com.aqua.aqualight.ui.tabs.devices.detail.light.shared.view.LightWrgbOutputPreviewView
                        android:id="@+id/viewLiveOutputPreview"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="14dp" />
                    <TextView
                        android:id="@+id/tvPreviewAppearance"
                        style="@style/TextAppearance.Aqua.Light.BodyMuted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text=""
                        tools:text="Approx. appearance: Neutral daylight" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardManualActions"
                style="@style/Widget.Aqua.Light.Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/light_card_margin_top"
                app:cardCornerRadius="@dimen/light_card_corner_radius_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/light_card_padding">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnApplyTemporary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/light_accent"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/light_manual_apply_temporary"
                            android:textColor="@color/background_color"
                            android:textSize="15sp" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnSaveAsPreset"
                        style="@style/Widget.Aqua.Light.Card.Metric"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/light_manual_save_as_preset"
                            android:textColor="@color/light_accent"
                            android:textSize="14sp" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnApplyToProgram"
                        style="@style/Widget.Aqua.Light.Card.Metric"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:alpha="0.55"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/light_manual_apply_to_program"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="14sp" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>