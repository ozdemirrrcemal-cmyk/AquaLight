<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_bg"
    tools:context=".ui.tabs.devices.detail.light.manual.DeviceLightManualFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/manualScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="14dp"
        android:paddingEnd="10dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toTopOf="@id/manualBottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/manualContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- MANUAL MODE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardManualStatus"
                style="@style/Widget.Aqua.Light.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manual Mode" />

                        <TextView
                            android:id="@+id/tvManualModeSubtitle"
                            style="@style/TextAppearance.Aqua.Light.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="Live RGBW control. Automatic schedule paused." />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchManualPower"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- MASTER OUTPUT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMasterOutput"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="26dp">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Master Output" />

                    <FrameLayout
                        android:layout_width="230dp"
                        android:layout_height="230dp"
                        android:layout_marginTop="18dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/masterOutputProgress"
                            android:layout_width="230dp"
                            android:layout_height="230dp"
                            android:indeterminate="false"
                            android:progress="0"
                            app:indicatorColor="@color/light_accent"
                            app:indicatorDirectionCircular="clockwise"
                            app:indicatorInset="4dp"
                            app:indicatorSize="218dp"
                            app:trackColor="@color/light_stroke"
                            app:trackThickness="18dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvEstimatedPower"
                                style="@style/TextAppearance.Aqua.Light.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0W"
                                android:textSize="27sp"
                                tools:text="96.0W" />

                            <TextView
                                style="@style/TextAppearance.Aqua.Light.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Estimated Power" />

                        </LinearLayout>

                    </FrameLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CHANNEL MIXER -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChannelMixer"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="RGBW Mixer" />

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Adjust each channel. Changes are sent while manual mode is active." />

                    <!-- RED -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Red"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:text="R" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderRed"
                            style="@style/Widget.Aqua.Light.Slider.Red"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:value="0"
                            android:valueFrom="0"
                            android:valueTo="100"
                            android:stepSize="1" />

                        <TextView
                            android:id="@+id/tvRedValue"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Red"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0%" />

                    </LinearLayout>

                    <!-- GREEN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Green"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:text="G" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderGreen"
                            style="@style/Widget.Aqua.Light.Slider.Green"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:value="0"
                            android:valueFrom="0"
                            android:valueTo="100"
                            android:stepSize="1" />

                        <TextView
                            android:id="@+id/tvGreenValue"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Green"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0%" />

                    </LinearLayout>

                    <!-- BLUE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Blue"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:text="B" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderBlue"
                            style="@style/Widget.Aqua.Light.Slider.Blue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:value="0"
                            android:valueFrom="0"
                            android:valueTo="100"
                            android:stepSize="1" />

                        <TextView
                            android:id="@+id/tvBlueValue"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Blue"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0%" />

                    </LinearLayout>

                    <!-- WHITE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.White"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:text="W" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderWhite"
                            style="@style/Widget.Aqua.Light.Slider.White"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:value="0"
                            android:valueFrom="0"
                            android:valueTo="100"
                            android:stepSize="1" />

                        <TextView
                            android:id="@+id/tvWhiteValue"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.White"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0%" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- QUICK SCENES -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuickScenes"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quick Scenes" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:columnCount="2"
                        android:rowCount="3">

                        <TextView
                            android:id="@+id/scenePlantGrowth"
                            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_light_program_time_panel"
                            android:gravity="center"
                            android:text="Plant" />

                        <TextView
                            android:id="@+id/sceneFishDisplay"
                            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_light_program_time_panel"
                            android:gravity="center"
                            android:text="Fish" />

                        <TextView
                            android:id="@+id/sceneShrimpSafe"
                            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_light_program_time_panel"
                            android:gravity="center"
                            android:text="Shrimp" />

                        <TextView
                            android:id="@+id/sceneBlueAccent"
                            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_light_program_time_panel"
                            android:gravity="center"
                            android:text="Blue" />
							
						 <TextView
                            android:id="@+id/sceneRed"
                            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_light_program_time_panel"
                            android:gravity="center"
                            android:text="Red" />
							
                        <TextView
                            android:id="@+id/sceneFullSpectrum"
                            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_light_program_time_panel"
                            android:gravity="center"
                            android:text="Full" />

                       

                    </GridLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM ACTION BAR -->
    <LinearLayout
        android:id="@+id/manualBottomBar"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:background="@color/light_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResumeAuto"
            style="@style/Widget.Aqua.Light.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="9dp"
            android:layout_weight="1"
            android:text="Resume Auto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePreset"
            style="@style/Widget.Aqua.Light.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:text="Save Preset" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>