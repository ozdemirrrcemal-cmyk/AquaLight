<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lightManualScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/lightManualRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/light_screen_padding_horizontal"
        android:paddingTop="@dimen/light_screen_padding_top"
        android:paddingEnd="@dimen/light_screen_padding_horizontal"
        android:paddingBottom="@dimen/light_screen_padding_bottom">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardManualHero"
            style="@style/Widget.Aqua.Light.Card.Surface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/light_hero_margin_top"
            app:cardCornerRadius="@dimen/light_card_corner_radius_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/light_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvManualTitle"
                            style="@style/TextAppearance.Aqua.Light.HeroTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/light_manual_title" />

                        <TextView
                            android:id="@+id/tvManualSubtitle"
                            style="@style/TextAppearance.Aqua.Light.BodyMuted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/light_manual_subtitle" />

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/chipManualState"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/light_mode_chip_height"
                        app:cardBackgroundColor="@color/light_chip_auto"
                        app:cardCornerRadius="@dimen/light_mode_chip_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/light_accent"
                        app:strokeWidth="@dimen/light_card_stroke_width">

                        <TextView
                            android:id="@+id/tvManualPowerState"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingStart="@dimen/light_mode_chip_padding_horizontal"
                            android:paddingEnd="@dimen/light_mode_chip_padding_horizontal"
                            android:text="LIVE"
                            android:textColor="@color/light_accent"
                            android:textSize="12sp"
                            tools:text="LIVE" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvManualOutputLabel"
                    style="@style/TextAppearance.Aqua.Light.BodyMuted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/light_manual_current_output" />

                <TextView
                    android:id="@+id/tvManualOutputValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text="78%"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="36sp"
                    tools:text="78%" />

                <LinearLayout
                    android:id="@+id/manualChannelSummaryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManualRedSummary"
                        style="@style/Widget.Aqua.Light.Card.Metric"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/light_channel_chip_height"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp">

                            <View
                                android:layout_width="14dp"
                                android:layout_height="@dimen/light_channel_line_height"
                                android:background="@color/light_red" />

                            <TextView
                                android:id="@+id/tvManualRedSummaryValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="@font/inter_semibold"
                                android:includeFontPadding="false"
                                android:text="R80%"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="11sp"
                                tools:text="R80%" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManualGreenSummary"
                        style="@style/Widget.Aqua.Light.Card.Metric"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/light_channel_chip_height"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp">

                            <View
                                android:layout_width="14dp"
                                android:layout_height="@dimen/light_channel_line_height"
                                android:background="@color/light_green" />

                            <TextView
                                android:id="@+id/tvManualGreenSummaryValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="@font/inter_semibold"
                                android:includeFontPadding="false"
                                android:text="G84%"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="11sp"
                                tools:text="G84%" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManualBlueSummary"
                        style="@style/Widget.Aqua.Light.Card.Metric"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/light_channel_chip_height"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp">

                            <View
                                android:layout_width="14dp"
                                android:layout_height="@dimen/light_channel_line_height"
                                android:background="@color/light_blue" />

                            <TextView
                                android:id="@+id/tvManualBlueSummaryValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="@font/inter_semibold"
                                android:includeFontPadding="false"
                                android:text="B79%"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="11sp"
                                tools:text="B79%" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManualWhiteSummary"
                        style="@style/Widget.Aqua.Light.Card.Metric"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/light_channel_chip_height"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp">

                            <View
                                android:layout_width="14dp"
                                android:layout_height="@dimen/light_channel_line_height"
                                android:background="@color/light_white" />

                            <TextView
                                android:id="@+id/tvManualWhiteSummaryValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="@font/inter_semibold"
                                android:includeFontPadding="false"
                                android:text="W65%"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="11sp"
                                tools:text="W65%" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderMasterBrightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:value="78"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:haloColor="@color/light_accent"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/light_accent"
                    app:trackColorActive="@color/light_accent"
                    app:trackColorInactive="@color/light_stroke"
                    app:trackHeight="6dp" />

                <TextView
                    android:id="@+id/tvManualNotice"
                    style="@style/TextAppearance.Aqua.Light.BodyMuted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/light_manual_notice" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChannelControl"
            style="@style/Widget.Aqua.Light.Card.Surface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/light_card_margin_top"
            app:cardCornerRadius="@dimen/light_card_corner_radius_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/light_card_padding">

                <TextView
                    style="@style/TextAppearance.Aqua.Light.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/light_manual_channel_control" />

                <TextView
                    style="@style/TextAppearance.Aqua.Light.BodyMuted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/light_manual_channel_control_subtitle" />

                <LinearLayout
                    android:id="@+id/redChannelHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@color/light_red" />

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.ActionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/light_channel_red" />

                    <TextView
                        android:id="@+id/tvRedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text="80%"
                        android:textColor="@color/light_red"
                        android:textSize="14sp"
                        tools:text="80%" />

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderRed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="80"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:haloColor="@color/light_red"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/light_red"
                    app:trackColorActive="@color/light_red"
                    app:trackColorInactive="@color/light_stroke"
                    app:trackHeight="6dp" />

                <LinearLayout
                    android:id="@+id/greenChannelHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@color/light_green" />

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.ActionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/light_channel_green" />

                    <TextView
                        android:id="@+id/tvGreenValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text="84%"
                        android:textColor="@color/light_green"
                        android:textSize="14sp"
                        tools:text="84%" />

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderGreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="84"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:haloColor="@color/light_green"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/light_green"
                    app:trackColorActive="@color/light_green"
                    app:trackColorInactive="@color/light_stroke"
                    app:trackHeight="6dp" />

                <LinearLayout
                    android:id="@+id/blueChannelHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@color/light_blue" />

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.ActionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/light_channel_blue" />

                    <TextView
                        android:id="@+id/tvBlueValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text="79%"
                        android:textColor="@color/light_blue"
                        android:textSize="14sp"
                        tools:text="79%" />

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderBlue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="79"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:haloColor="@color/light_blue"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/light_blue"
                    app:trackColorActive="@color/light_blue"
                    app:trackColorInactive="@color/light_stroke"
                    app:trackHeight="6dp" />

                <LinearLayout
                    android:id="@+id/whiteChannelHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@color/light_white" />

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.ActionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/light_channel_white" />

                    <TextView
                        android:id="@+id/tvWhiteValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text="65%"
                        android:textColor="@color/light_white"
                        android:textSize="14sp"
                        tools:text="65%" />

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderWhite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="65"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:haloColor="@color/light_white"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/light_white"
                    app:trackColorActive="@color/light_white"
                    app:trackColorInactive="@color/light_stroke"
                    app:trackHeight="6dp" />

                <LinearLayout
                    android:id="@+id/manualQuickSetRow"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnAll100"
                        style="@style/Widget.Aqua.Light.Card.Metric"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/light_manual_all_100"
                            android:textColor="@color/light_accent" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnAll50"
                        style="@style/Widget.Aqua.Light.Card.Metric"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/light_manual_all_50"
                            android:textColor="@color/light_accent" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnAllOff"
                        style="@style/Widget.Aqua.Light.Card.Metric"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/light_manual_all_off"
                            android:textColor="@color/light_accent" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnResetChannels"
                        style="@style/Widget.Aqua.Light.Card.Metric"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ActionSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/light_manual_reset"
                            android:textColor="@color/settings_text_secondary" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLivePreview"
            style="@style/Widget.Aqua.Light.Card.SurfaceDeep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/light_card_margin_top"
            app:cardCornerRadius="@dimen/light_card_corner_radius_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/light_card_padding">

                <TextView
                    style="@style/TextAppearance.Aqua.Light.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/light_manual_current_mix" />

                <View
                    android:id="@+id/viewLivePreviewGradient"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_light_preview_mix" />

                <TextView
                    android:id="@+id/tvPreviewAppearance"
                    style="@style/TextAppearance.Aqua.Light.BodyMuted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Estimated appearance: Neutral daylight"
                    tools:text="Estimated appearance: Neutral daylight" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardManualActions"
            style="@style/Widget.Aqua.Light.Card.Surface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/light_card_margin_top"
            app:cardCornerRadius="@dimen/light_card_corner_radius_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/light_card_padding">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnApplyTemporary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/light_accent"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/light_manual_apply_temporary"
                        android:textColor="@color/background_color"
                        android:textSize="15sp" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnSaveAsPreset"
                    style="@style/Widget.Aqua.Light.Card.Metric"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/light_manual_save_as_preset"
                        android:textColor="@color/light_accent"
                        android:textSize="14sp" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnApplyToProgram"
                    style="@style/Widget.Aqua.Light.Card.Metric"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:alpha="0.55"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/light_manual_apply_to_program"
                        android:textColor="@color/settings_text_secondary"
