<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_bg"
    tools:context=".ui.tabs.devices.detail.light.manual.DeviceLightManualFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/manualScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="14dp"
        android:paddingEnd="10dp"
        android:paddingBottom="38dp"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toTopOf="@id/manualBottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardManualStatus"
                style="@style/Widget.Aqua.Light.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvManualModeTitle"
                            style="@style/TextAppearance.Aqua.Light.SectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
							android:textSize="16sp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text=""
                            tools:text="Auto Schedule Active" />

                        <TextView
                            android:id="@+id/tvManualModeSubtitle"
                            style="@style/TextAppearance.Aqua.Light.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
							android:textSize="13sp"
                            android:maxLines="1"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text=""
                            tools:text="Automatic schedule is running." />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvManualModeChip"
                        style="@style/TextAppearance.Aqua.Light.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_light_mode_chip_auto"
                        android:gravity="center"
                        android:minWidth="64dp"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
						android:textSize="12sp"
                        android:text="AUTO"
                        android:textColor="@color/light_accent" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMasterOutput"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manual Light Control" />

                    <TextView
                        android:id="@+id/tvOutputModeHint"
                        style="@style/TextAppearance.Aqua.Light.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text=""
                        tools:text="Auto output preview · drag any slider to override" />

                    <FrameLayout
                        android:layout_width="178dp"
                        android:layout_height="178dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/masterOutputProgress"
                            android:layout_width="178dp"
                            android:layout_height="178dp"
                            android:indeterminate="false"
                            android:progress="0"
                            app:indicatorColor="@color/light_accent"
                            app:indicatorDirectionCircular="clockwise"
                            app:indicatorInset="10dp"
                            app:indicatorSize="158dp"
                            app:trackColor="@color/light_stroke"
                            app:trackThickness="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvEstimatedPower"
                                style="@style/TextAppearance.Aqua.Light.SectionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text=""
                                android:textSize="24sp"
                                tools:text="21.9W" />

                        </LinearLayout>

                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Red"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:text="R" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderRed"
                            style="@style/Widget.Aqua.Light.Slider.Red"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:stepSize="1"
                            android:value="0"
                            android:valueFrom="0"
                            android:valueTo="100" />

                        <TextView
                            android:id="@+id/tvRedValue"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Red"
                            android:layout_width="50dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text=""
                            tools:text="0%" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Green"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:text="G" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderGreen"
                            style="@style/Widget.Aqua.Light.Slider.Green"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:stepSize="1"
                            android:value="0"
                            android:valueFrom="0"
                            android:valueTo="100" />

                        <TextView
                            android:id="@+id/tvGreenValue"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Green"
                            android:layout_width="50dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text=""
                            tools:text="0%" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Blue"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:text="B" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderBlue"
                            style="@style/Widget.Aqua.Light.Slider.Blue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:stepSize="1"
                            android:value="0"
                            android:valueFrom="0"
                            android:valueTo="100" />

                        <TextView
                            android:id="@+id/tvBlueValue"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.Blue"
                            android:layout_width="50dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text=""
                            tools:text="0%" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.White"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:text="W" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderWhite"
                            style="@style/Widget.Aqua.Light.Slider.White"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:stepSize="1"
                            android:value="0"
                            android:valueFrom="0"
                            android:valueTo="100" />

                        <TextView
                            android:id="@+id/tvWhiteValue"
                            style="@style/TextAppearance.Aqua.Light.ChannelValue.White"
                            android:layout_width="50dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text=""
                            tools:text="0%" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuickScenes"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/TextAppearance.Aqua.Light.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quick Scenes" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:columnCount="2"
                        android:rowCount="3">

                        <TextView
                            android:id="@+id/scenePlantGrowth"
                            style="@style/TextAppearance.Aqua.Light.Filter"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_light_manual_scene_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:text="Plant"
                            android:textColor="@color/color_light_manual_scene_button_text" />

                        <TextView
                            android:id="@+id/sceneFishDisplay"
                            style="@style/TextAppearance.Aqua.Light.Filter"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_light_manual_scene_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:text="Fish"
                            android:textColor="@color/color_light_manual_scene_button_text" />

                        <TextView
                            android:id="@+id/sceneShrimpSafe"
                            style="@style/TextAppearance.Aqua.Light.Filter"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_light_manual_scene_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:text="Shrimp"
                            android:textColor="@color/color_light_manual_scene_button_text" />

                        <TextView
                            android:id="@+id/sceneBlueAccent"
                            style="@style/TextAppearance.Aqua.Light.Filter"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_light_manual_scene_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:text="Blue"
                            android:textColor="@color/color_light_manual_scene_button_text" />

                        <TextView
                            android:id="@+id/sceneRed"
                            style="@style/TextAppearance.Aqua.Light.Filter"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_light_manual_scene_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:text="Red"
                            android:textColor="@color/color_light_manual_scene_button_text" />

                        <TextView
                            android:id="@+id/sceneFullSpectrum"
                            style="@style/TextAppearance.Aqua.Light.Filter"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="5dp"
                            android:background="@drawable/bg_light_manual_scene_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:text="Full"
                            android:textColor="@color/color_light_manual_scene_button_text" />

                    </GridLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/manualBottomBar"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:background="@color/light_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResumeAuto"
            style="@style/Widget.Aqua.Light.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="9dp"
            android:layout_weight="1"
            android:text="Resume Auto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSavePreset"
            style="@style/Widget.Aqua.Light.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:text="Save Preset" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>