<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/aqua_size_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <ImageView
            android:layout_width="@dimen/aqua_size_64"
            android:layout_height="@dimen/aqua_size_64"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_warning"
            app:tint="@color/dialog_icon_warning" />

        <TextView
            android:textAppearance="@style/TextAppearance.Aqua.Status.WarningBodyBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_14"
            android:gravity="center"
            android:text="@string/plant_health_algae_detection_title" />

        <TextView
            android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryBodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_8"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/aqua_size_2"
            android:text="@string/plant_health_algae_detection_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoAlgaeControl"
            style="@style/Widget.Aqua.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_48"
            android:layout_marginTop="@dimen/aqua_size_18"
            android:enabled="false"
            android:text="@string/plant_health_algae_go_control" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLater"
            style="@style/Widget.Aqua.Button.OutlineAccent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_48"
            android:layout_marginTop="@dimen/aqua_size_8"
            android:enabled="false"
            android:text="@string/plant_health_later" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
