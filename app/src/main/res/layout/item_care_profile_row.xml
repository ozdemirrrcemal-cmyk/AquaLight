<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    style="@style/Widget.Aqua.Card"
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/careProfileRowRoot"
  android:layout_width="match_parent"
  android:layout_height="@dimen/aqua_size_value_64"
  android:layout_marginTop="@dimen/aqua_space_value_10"
  android:clickable="true"
  android:focusable="true"
  android:foreground="?attr/selectableItemBackground">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/aqua_space_value_16"
    android:paddingEnd="@dimen/aqua_space_value_14">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/tvCareProfileItemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/aquarium_care_profile_tank_name"
        android:textColor="@android:color/white"
        android:textSize="@dimen/aqua_text_size_body"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/tvCareProfileItemSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_space_value_7"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/aquarium_no_value_placeholder"
        android:textColor="@color/aqua_card_text_secondary"
        android:textSize="@dimen/aqua_text_size_body_small" />

    </LinearLayout>

    <TextView
      android:id="@+id/tvCareProfileItemStatus"
      android:layout_width="@dimen/aqua_size_value_76"
      android:layout_height="@dimen/aqua_size_value_28"
      android:layout_marginStart="@dimen/aqua_space_value_12"
      android:gravity="center"
      android:includeFontPadding="false"
      android:text="@string/aquarium_action_complete"
      android:textSize="@dimen/aqua_text_size_micro"
      android:textStyle="bold" />

  </LinearLayout>

</com.google.android.material.card.MaterialCardView>