<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <EditText
        style="@style/Widget.Aqua.Input.PlainEditText.Multiline"
    android:id="@+id/inputTankName"
    android:layout_width="match_parent"
    android:layout_height="@dimen/aqua_size_value_48"
    android:hint="@string/aquarium_hint_tank_name"
    android:includeFontPadding="false"
    android:inputType="text"
    android:maxLines="1"
    android:selectAllOnFocus="true"
    android:singleLine="true" />

  <com.google.android.material.button.MaterialButton
    android:id="@+id/btnSave"
    android:layout_width="match_parent"
    android:layout_height="@dimen/aqua_size_value_50"
    android:layout_marginTop="@dimen/aqua_space_value_26"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:minHeight="0dp"
    android:minWidth="0dp"
    android:text="@string/common_save"
    android:textAllCaps="false"
    android:textColor="@android:color/white"
    android:textSize="@dimen/aqua_text_size_body"
    android:textStyle="bold"
    app:backgroundTint="@color/aqua_palette_2196f3"
    app:cornerRadius="@dimen/aqua_radius_value_16" />

  <TextView
    android:id="@+id/btnCancel"
    android:layout_width="match_parent"
    android:layout_height="@dimen/aqua_size_value_40"
    android:layout_marginTop="@dimen/aqua_space_value_10"
    android:gravity="center"
    android:includeFontPadding="false"
    android:text="@string/common_cancel"
    android:textColor="@color/aqua_palette_8fa4be"
    android:textSize="@dimen/aqua_text_size_body" />

</LinearLayout>