<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <EditText
        style="@style/Widget.Aqua.Input.PlainEditText.Multiline"
    android:id="@+id/inputTankName"
    android:layout_width="match_parent"
    android:layout_height="@dimen/aqua_size_48"
    android:hint="@string/aquarium_hint_tank_name"
    android:includeFontPadding="false"
    android:inputType="text"
    android:maxLines="1"
    android:selectAllOnFocus="true"
    android:singleLine="true" />

  <com.google.android.material.button.MaterialButton
    style="@style/Widget.Aqua.BottomSheet.Button.EditorSave"
    android:id="@+id/btnSave"
    android:layout_width="match_parent"
    android:layout_height="@dimen/aqua_size_50"
    android:layout_marginTop="@dimen/aqua_size_26"
    android:text="@string/common_save"
    app:cornerRadius="@dimen/aqua_size_16" />

  <TextView
    android:id="@+id/btnCancel"
    android:layout_width="match_parent"
    android:layout_height="@dimen/aqua_size_40"
    android:layout_marginTop="@dimen/aqua_size_10"
    android:gravity="center"
    android:includeFontPadding="false"
    android:text="@string/common_cancel"
    android:textColor="@color/aqua_content_secondary"
    android:textSize="@dimen/aqua_text_size_body" />

</LinearLayout>