<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/customDaysSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_light_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_light_sheet_handle" />

    <TextView
        android:id="@+id/tvSheetTitle"
        style="@style/TextAppearance.Aqua.Light.SheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/light_custom_days_title" />

    <TextView
        style="@style/TextAppearance.Aqua.Light.SheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/light_custom_days_description" />

    <GridLayout
        android:id="@+id/daysGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:columnCount="2">

        <TextView
            android:id="@+id/dayMonday"
            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_columnWeight="1"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_light_filter_selected"
            android:gravity="center"
            android:text="@string/common_day_monday" />

        <TextView
            android:id="@+id/dayTuesday"
            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_columnWeight="1"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_light_filter_selected"
            android:gravity="center"
            android:text="@string/common_day_tuesday" />

        <TextView
            android:id="@+id/dayWednesday"
            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_columnWeight="1"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_light_filter_selected"
            android:gravity="center"
            android:text="@string/common_day_wednesday" />

        <TextView
            android:id="@+id/dayThursday"
            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_columnWeight="1"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_light_filter_selected"
            android:gravity="center"
            android:text="@string/common_day_thursday" />

        <TextView
            android:id="@+id/dayFriday"
            style="@style/TextAppearance.Aqua.Light.Filter.Selected"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_columnWeight="1"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_light_filter_selected"
            android:gravity="center"
            android:text="@string/common_day_friday" />

        <TextView
            android:id="@+id/daySaturday"
            style="@style/TextAppearance.Aqua.Light.Filter"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_columnWeight="1"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:text="@string/common_day_saturday" />

        <TextView
            android:id="@+id/daySunday"
            style="@style/TextAppearance.Aqua.Light.Filter"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_columnWeight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="@string/common_day_sunday" />

    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Aqua.Light.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="@string/common_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            style="@style/Widget.Aqua.Light.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/common_apply" />

    </LinearLayout>

</LinearLayout>