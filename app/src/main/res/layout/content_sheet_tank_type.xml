<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/aquarium_water_environment_title"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="@dimen/aqua_text_size_body"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_4"
        android:includeFontPadding="false"
        android:text="@string/aquarium_water_environment_helper"
        android:textColor="@color/aqua_card_text_secondary"
        android:textSize="@dimen/aqua_text_size_caption" />

    <GridLayout
        android:id="@+id/environmentOptionsGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_8"
        android:columnCount="3">

        <TextView
            android:id="@+id/optionEnvironmentFreshwater"
            style="@style/Widget.Aqua.SelectionRow.GridOption"
            android:text="@string/aquarium_water_environment_freshwater" />

        <TextView
            android:id="@+id/optionEnvironmentBrackish"
            style="@style/Widget.Aqua.SelectionRow.GridOption"
            android:text="@string/aquarium_water_environment_brackish" />

        <TextView
            android:id="@+id/optionEnvironmentMarine"
            style="@style/Widget.Aqua.SelectionRow.GridOption"
            android:text="@string/aquarium_water_environment_marine" />

    </GridLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_1"
        android:layout_marginHorizontal="@dimen/aqua_size_5"
        android:layout_marginTop="@dimen/aqua_size_10"
        android:background="@color/aqua_card_divider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_14"
        android:includeFontPadding="false"
        android:text="@string/aquarium_tank_profile_title"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="@dimen/aqua_text_size_body"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvProfileHelper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_4"
        android:includeFontPadding="false"
        android:text="@string/aquarium_tank_profile_helper"
        android:textColor="@color/aqua_card_text_secondary"
        android:textSize="@dimen/aqua_text_size_caption" />

    <GridLayout
        android:id="@+id/typeOptionsGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_8"
        android:columnCount="2">

        <TextView
            android:id="@+id/optionProfile1"
            style="@style/Widget.Aqua.SelectionRow.GridOption"
            tools:text="Balık / Genel" />

        <TextView
            android:id="@+id/optionProfile2"
            style="@style/Widget.Aqua.SelectionRow.GridOption"
            tools:text="Bitkili" />

        <TextView
            android:id="@+id/optionProfile3"
            style="@style/Widget.Aqua.SelectionRow.GridOption"
            tools:text="Karides" />

        <TextView
            android:id="@+id/optionProfile4"
            style="@style/Widget.Aqua.SelectionRow.GridOption"
            tools:text="Diğer" />

        <TextView
            android:id="@+id/optionProfile5"
            style="@style/Widget.Aqua.SelectionRow.GridOption"
            android:visibility="gone"
            tools:text="SPS Resif"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/optionProfile6"
            style="@style/Widget.Aqua.SelectionRow.GridOption"
            android:visibility="gone"
            tools:text="Karma Resif"
            tools:visibility="visible" />

    </GridLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        style="@style/Widget.Aqua.BottomSheet.Button.EditorSave"
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_50"
        android:layout_marginTop="@dimen/aqua_size_18"
        android:text="@string/common_save"
        android:textColor="@color/aqua_card_text_primary"
        app:cornerRadius="@dimen/aqua_size_16" />

    <TextView
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_40"
        android:layout_marginTop="@dimen/aqua_size_10"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/common_cancel"
        android:textColor="@color/aqua_card_text_secondary"
        android:textSize="@dimen/aqua_text_size_body" />

</LinearLayout>
