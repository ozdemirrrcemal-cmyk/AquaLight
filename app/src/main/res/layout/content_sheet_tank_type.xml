<?xml version="1.0" encoding="utf-8"?>
<GridLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/typeOptionsGrid"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:columnCount="3">

  <TextView
    android:id="@+id/optionFish"
    style="@style/Widget.Aqua.SelectionRow.GridOption"
    android:text="@string/aquarium_tank_type_fish" />

  <TextView
    android:id="@+id/optionShrimp"
    style="@style/Widget.Aqua.SelectionRow.GridOption"
    android:text="@string/aquarium_tank_type_shrimp" />

  <TextView
    android:id="@+id/optionPlanted"
    style="@style/Widget.Aqua.SelectionRow.GridOption"
    android:text="@string/aquarium_tank_type_planted" />

  <TextView
    android:id="@+id/optionMarine"
    style="@style/Widget.Aqua.SelectionRow.GridOption"
    android:text="@string/aquarium_tank_type_marine" />

  <TextView
    android:id="@+id/optionSofties"
    style="@style/Widget.Aqua.SelectionRow.GridOption"
    android:text="@string/aquarium_tank_type_softies" />

  <TextView
    android:id="@+id/optionMixedReef"
    style="@style/Widget.Aqua.SelectionRow.GridOption"
    android:text="@string/aquarium_tank_type_mixed_reef" />

  <TextView
    android:id="@+id/optionSps"
    style="@style/Widget.Aqua.SelectionRow.GridOption"
    android:text="@string/aquarium_tank_type_sps" />

  <TextView
    android:id="@+id/optionCoral"
    style="@style/Widget.Aqua.SelectionRow.GridOption"
    android:text="@string/aquarium_tank_type_coral" />

  <TextView
    android:id="@+id/optionOther"
    style="@style/Widget.Aqua.SelectionRow.GridOption"
    android:text="@string/aquarium_tank_type_other" />

  <com.google.android.material.button.MaterialButton
    android:id="@+id/btnSave"
    android:layout_width="match_parent"
    android:layout_height="@dimen/aqua_size_value_50"
    android:layout_columnSpan="3"
    android:layout_marginTop="@dimen/aqua_space_value_18"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:minWidth="0dp"
    android:minHeight="0dp"
    android:text="@string/common_save"
    android:textAllCaps="false"
    android:textColor="@color/aqua_card_text_primary"
    android:textSize="@dimen/aqua_text_size_body"
    android:textStyle="bold"
    app:backgroundTint="@color/aqua_palette_2196f3"
    app:cornerRadius="@dimen/aqua_radius_value_16" />

  <TextView
    android:id="@+id/btnCancel"
    android:layout_width="match_parent"
    android:layout_height="@dimen/aqua_size_value_40"
    android:layout_columnSpan="3"
    android:layout_marginTop="@dimen/aqua_space_value_10"
    android:gravity="center"
    android:includeFontPadding="false"
    android:text="@string/common_cancel"
    android:textColor="@color/aqua_card_text_secondary"
    android:textSize="@dimen/aqua_text_size_body" />

</GridLayout>