<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_16"
            android:paddingTop="@dimen/aqua_size_8"
            android:paddingEnd="@dimen/aqua_size_16"
            android:paddingBottom="@dimen/aqua_size_24">

            <TextView
                android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryTitleSmallBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/plant_health_algae_question" />

            <LinearLayout
                android:id="@+id/algaeGridContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_10"
                android:orientation="vertical" />

            <TextView
                android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodyBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_16"
                android:text="@string/plant_health_algae_context_title" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_8">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_14">
                    <TextView
                        android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/plant_health_context_light_duration" />
                    <TextView
                        android:textAppearance="@style/TextAppearance.Aqua.Content.MutedCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_3"
                        android:text="@string/plant_health_value_not_available" />
                    <TextView
                        android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_10"
                        android:text="@string/plant_health_context_last_water_change" />
                    <TextView
                        android:textAppearance="@style/TextAppearance.Aqua.Content.MutedCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_3"
                        android:text="@string/plant_health_value_not_available" />
                    <TextView
                        android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_10"
                        android:text="@string/plant_health_context_last_fertilization" />
                    <TextView
                        android:textAppearance="@style/TextAppearance.Aqua.Content.MutedCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_3"
                        android:text="@string/plant_health_value_not_available" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:textAppearance="@style/TextAppearance.Aqua.Card.PrimaryBodyBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_16"
                android:text="@string/plant_health_algae_first_steps_title" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_8">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_14">
                    <TextView
                        android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/plant_health_algae_first_step_prune" />
                    <TextView
                        android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:text="@string/plant_health_algae_first_step_light" />
                    <TextView
                        android:textAppearance="@style/TextAppearance.Aqua.Card.SecondaryCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:text="@string/plant_health_algae_first_step_care" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.Aqua.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_48"
                android:layout_marginTop="@dimen/aqua_size_16"
                android:enabled="false"
                android:text="@string/plant_health_algae_save" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
