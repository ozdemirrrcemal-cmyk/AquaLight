<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_bg"
    tools:context=".ui.tabs.devices.detail.light.automation.DeviceLightAutomationFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAutomationIntro"
                style="@style/TextAppearance.Aqua.Light.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:text="Configure independent lighting effects that run outside the daily schedule." />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMoonlight"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="96dp"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <FrameLayout
                        android:id="@+id/moonIconContainer"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_light_action_icon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_light_moon_24"
                            app:tint="@color/light_accent" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvMoonTitle"
                        style="@style/TextAppearance.Aqua.Light.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="10dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Moonlight"
                        android:textSize="18sp"
                        app:layout_constraintStart_toEndOf="@id/moonIconContainer"
                        app:layout_constraintEnd_toStartOf="@id/tvMoonStatus"
                        app:layout_constraintTop_toTopOf="@id/moonIconContainer" />

                    <TextView
                        android:id="@+id/tvMoonStatus"
                        style="@style/TextAppearance.Aqua.Light.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_light_mode_chip_idle"
                        android:gravity="center"
                        android:minWidth="58dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="OFF"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/moonIconContainer" />

                    <TextView
                        android:id="@+id/tvMoonSubtitle"
                        style="@style/TextAppearance.Aqua.Light.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Tap to configure night output"
                        android:textSize="13sp"
                        app:layout_constraintStart_toEndOf="@id/moonIconContainer"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvMoonTitle" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCloudSimulation"
                style="@style/Widget.Aqua.Light.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="96dp"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <FrameLayout
                        android:id="@+id/cloudIconContainer"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_light_action_icon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_light_cloud_24"
                            app:tint="@color/light_accent" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvCloudTitle"
                        style="@style/TextAppearance.Aqua.Light.CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="10dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Cloud Simulation"
                        android:textSize="18sp"
                        app:layout_constraintStart_toEndOf="@id/cloudIconContainer"
                        app:layout_constraintEnd_toStartOf="@id/tvCloudStatus"
                        app:layout_constraintTop_toTopOf="@id/cloudIconContainer" />

                    <TextView
                        android:id="@+id/tvCloudStatus"
                        style="@style/TextAppearance.Aqua.Light.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_light_mode_chip_idle"
                        android:gravity="center"
                        android:minWidth="58dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="OFF"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/cloudIconContainer" />

                    <TextView
                        android:id="@+id/tvCloudSubtitle"
                        style="@style/TextAppearance.Aqua.Light.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="5dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Tap to configure cloud dimming"
                        android:textSize="13sp"
                        app:layout_constraintStart_toEndOf="@id/cloudIconContainer"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvCloudTitle" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
