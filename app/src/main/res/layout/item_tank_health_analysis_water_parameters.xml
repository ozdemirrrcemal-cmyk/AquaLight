<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Aqua.Card.Metric"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/aqua_size_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/aqua_size_12">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/tank_health_analysis_water_parameters_title"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body_xlarge"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_4"
            android:includeFontPadding="false"
            android:text="@string/tank_health_analysis_water_parameters_subtitle"
            android:textColor="@color/aqua_card_text_secondary"
            android:textSize="@dimen/aqua_text_size_caption" />

        <TextView
            android:id="@+id/tvProfileContext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_10"
            android:includeFontPadding="false"
            android:textColor="@color/aqua_accent_primary"
            android:textSize="@dimen/aqua_text_size_caption" />

        <TextView
            android:id="@+id/tvRecommendedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_12"
            android:includeFontPadding="false"
            android:text="@string/tank_health_analysis_recommended_tests"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body_small"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/recommendedParametersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_6"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvAdditionalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_14"
            android:includeFontPadding="false"
            android:text="@string/tank_health_analysis_additional_tests"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body_small"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/additionalParametersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_6"
            android:orientation="vertical"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddTest"
            style="@style/Widget.Aqua.Button.OutlineAccent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_48"
            android:layout_marginTop="@dimen/aqua_size_12"
            android:text="@string/tank_health_analysis_add_test"
            app:cornerRadius="@dimen/aqua_size_14" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_12">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/aqua_size_10"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:padding="@dimen/aqua_size_12"
                android:text="@string/tank_health_analysis_test_kit_note"
                android:textColor="@color/aqua_accent_primary"
                android:textSize="@dimen/aqua_text_size_caption"
                app:drawableStartCompat="@drawable/ic_tank_health_info_24"
                app:drawableTint="@color/aqua_accent_primary" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
