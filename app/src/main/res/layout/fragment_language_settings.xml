<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".ui.tabs.settings.app.LanguageSettingsFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:fillViewport="true"
        android:scrollbars="none"
        android:paddingStart="@dimen/aqua_size_10"
        android:paddingEnd="@dimen/aqua_size_10"
        android:paddingTop="@dimen/aqua_size_16"
        android:paddingBottom="@dimen/aqua_size_16"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/aqua_size_4"
                android:layout_marginBottom="@dimen/aqua_size_12"
                android:text="@string/language_available_description"
                android:textColor="@color/aqua_content_secondary"
                android:textSize="@dimen/aqua_text_size_body" />

            <RadioGroup
                android:id="@+id/radioGroupLanguages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEnglish"
                    style="@style/Widget.Aqua.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/aqua_size_12"
                    android:clickable="true"
                    android:contentDescription="@string/language_english_row_desc"
                    android:focusable="true"
                    android:minHeight="@dimen/aqua_size_56">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/aqua_size_56"
                        android:orientation="horizontal"
                        android:padding="@dimen/aqua_size_12">

                        <ImageView
                            android:layout_width="@dimen/aqua_size_32"
                            android:layout_height="@dimen/aqua_size_32"
                            android:layout_marginEnd="@dimen/aqua_size_12"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/flag_en" />

                        <TextView
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/language_english"
                            android:textColor="@color/aqua_card_text_primary"
                            android:textSize="@dimen/aqua_text_size_body"
                            android:textStyle="bold" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioEnglish"
                            style="@style/Widget.Aqua.SettingsRadio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:contentDescription="@string/language_english_radio_desc"
                            android:focusable="false"
                            android:minWidth="@dimen/aqua_size_48"
                            android:minHeight="@dimen/aqua_size_48" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </RadioGroup>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
