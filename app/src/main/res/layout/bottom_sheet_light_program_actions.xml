<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/programActionsRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_light_bottom_sheet_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/light_stroke" />

    <TextView
        android:id="@+id/tvProgramActionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="Every Day Program" />

    <TextView
        android:id="@+id/tvProgramActionSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/settings_text_secondary"
        android:textSize="13sp"
        tools:text="09:00 → 19:15 · Every day" />

    <TextView
        android:id="@+id/btnProgramActionEdit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@color/light_accent"
        android:gravity="center"
        android:text="@string/light_program_action_edit"
        android:textColor="@color/background_color"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnProgramActionPreview"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/light_program_action_preview"
        android:textColor="@color/light_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnProgramActionDuplicate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/light_program_action_duplicate"
        android:textColor="@color/light_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnProgramActionSetActive"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/light_program_action_set_active"
        android:textColor="@color/light_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnProgramActionToggle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/light_program_action_disable"
        android:textColor="@color/light_warning"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnProgramActionDelete"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/light_program_action_delete"
        android:textColor="@color/light_error"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnProgramActionCancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/common_cancel"
        android:textColor="@color/settings_text_secondary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>