<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".ui.tabs.settings.logout.ChangePasswordFragment">

   <include
    android:id="@+id/appHeader"
    layout="@layout/layout_aqua_header"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />
	
    <!-- 🔹 İçerik -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Üst açıklama -->
            <TextView
                android:id="@+id/tvSubInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/change_password_subinfo"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="@string/change_password_subinfo_desc" />

            <!-- 🟦 Şifre değiştirme formu -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Aqua.Card">

                <LinearLayout
                    android:id="@+id/formContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:contentDescription="@string/change_password_form_desc">

                    <!-- Mevcut şifre -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutCurrentPassword"
                        style="@style/AuthTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/change_password_current_hint"
                        app:endIconMode="password_toggle"
                        android:contentDescription="@string/change_password_current_desc">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCurrentPassword"
                            style="@style/AuthEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Yeni şifre -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutNewPassword"
                        style="@style/AuthTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/change_password_new_hint"
                        app:endIconMode="password_toggle"
                        android:contentDescription="@string/change_password_new_desc">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNewPassword"
                            style="@style/AuthEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Yeni şifre tekrar -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutConfirmPassword"
                        style="@style/AuthTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/change_password_confirm_hint"
                        app:endIconMode="password_toggle"
                        android:contentDescription="@string/change_password_confirm_desc">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            style="@style/AuthEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Hata / başarı mesajı istersen visibility ile yönetirsin -->
                    <TextView
                        android:id="@+id/tvPasswordMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/change_password_success"
                        android:textColor="@color/aqua_card_text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter_regular"
                        android:visibility="gone"
                        android:alpha="0"
                        android:contentDescription="@string/change_password_success_desc" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 💾 Kaydet butonu -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePassword"
                style="@style/Widget.Aqua.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/change_password_save"
                android:contentDescription="@string/change_password_save_desc" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>