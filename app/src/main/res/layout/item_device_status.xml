<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDevice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="8dp"
    android:backgroundTint="#1E2A38"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#31465D"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
		android:paddingStart="6dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <!-- Tip ikonu -->
        <ImageView
            android:id="@+id/ivDeviceIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_device_aqua_ster"
            app:tint="@android:color/white"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true" />

        <!-- İsim + Tank -->
        <LinearLayout
            android:id="@+id/llDeviceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/ivDeviceIcon"
            android:layout_marginStart="12dp"
            android:layout_alignTop="@id/ivDeviceIcon">

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CO2 Regülatör"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvTankName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Akvaryum 1"
                android:textColor="#8BCAFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Sağ üst durum -->
        <LinearLayout
            android:id="@+id/llStatusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/llDeviceInfo">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_online_dot" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="ONLINE"
                android:textColor="#39D353"
                android:textSize="10sp"/>

            <ImageView
                android:id="@+id/ivAlarm"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_alarm_red"
                android:visibility="gone" />
        </LinearLayout>

        <!-- İnce ayraç -->
        <View
            android:id="@+id/viewMetaTopDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/ivDeviceIcon"
            android:layout_marginTop="5dp"
            android:layout_toEndOf="@id/ivDeviceIcon"
            android:layout_marginStart="12dp"
            android:background="#24384F" />

        <!-- Alt bilgi satırı -->
        <LinearLayout
            android:id="@+id/llDeviceMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/viewMetaTopDivider"
            android:layout_toEndOf="@id/ivDeviceIcon"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- IP -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvIpTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP"
                    android:textColor="#8BCAFF"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="192.168.1.33"
                    android:textColor="#EEF4FF"
                    android:textSize="8sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="6dp"
                android:background="#24384F" />

            <!-- Serial -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSerialTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Serial"
                    android:textColor="#8BCAFF"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvSerial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="CA-628206344"
                    android:textColor="#EEF4FF"
                    android:textSize="8sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="6dp"
                android:background="#24384F" />

            <!-- Firmware -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFirmwareTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Firmware"
                    android:textColor="#8BCAFF"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvFirmware"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="v5.1.4"
                    android:textColor="#EEF4FF"
                    android:textSize="8sp"
                    android:textStyle="normal" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="6dp"
                android:background="#24384F" />

            <!-- Last Seen -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLastSeenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last seen"
                    android:textColor="#8BCAFF"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvLastSeen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Just now"
                    android:textColor="#EEF4FF"
                    android:textSize="8sp"
                    android:textStyle="normal" />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>