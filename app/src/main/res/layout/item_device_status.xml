<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDevice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="3dp"
    android:layout_marginVertical="6dp"
    android:backgroundTint="#1E2A38"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeColor="#31465D"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/flDeviceIconContainer"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_device_icon_container"
            android:padding="8dp">

            <ImageView
                android:id="@+id/ivDeviceIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Device Icon"
                android:scaleType="centerInside"
                android:src="@drawable/ic_device_aqua_ster"
                app:tint="@android:color/white" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/llDeviceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/flDeviceIconContainer"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/flDeviceIconContainer"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CO2 Regülatör"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTankName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Akvaryum 1"
                android:textColor="#8BCAFF"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/flPresenceContainer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/llDeviceInfo">

            <ImageView
                android:id="@+id/ivPresenceIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Device presence"
                android:src="@drawable/ic_status_wifi"
                app:tint="#5FD6B4" />
        </FrameLayout>

        <View
            android:id="@+id/viewMetaTopDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/flDeviceIconContainer"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_toEndOf="@id/flDeviceIconContainer"
            android:background="#24384F" />

        <LinearLayout
            android:id="@+id/llDeviceMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/viewMetaTopDivider"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_toEndOf="@id/flDeviceIconContainer"
            android:orientation="horizontal"
            android:weightSum="4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvIpTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP"
                    android:textColor="#8BCAFF"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="192.168.1.33"
                    android:textColor="#EEF4FF"
                    android:textSize="8sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="6dp"
                android:background="#24384F" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSerialTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Serial"
                    android:textColor="#8BCAFF"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvSerial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="CA-628206344"
                    android:textColor="#EEF4FF"
                    android:textSize="7sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="6dp"
                android:background="#24384F" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFirmwareTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Firmware"
                    android:textColor="#8BCAFF"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvFirmware"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="v5.1.4"
                    android:textColor="#EEF4FF"
                    android:textSize="8sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="6dp"
                android:background="#24384F" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivLastSeen"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Last seen icon"
                    android:src="@drawable/ic_last_seen" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLastSeenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Last seen"
                        android:textColor="#8BCAFF"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvLastSeen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Just now"
                        android:textColor="#EEF4FF"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
