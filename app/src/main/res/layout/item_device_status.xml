<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDevice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:backgroundTint="#1e2a38"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#2c3e50"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Tip ikonu -->
        <ImageView
            android:id="@+id/ivDeviceIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_device_aqua_ster"
            android:tint="@android:color/white"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"/>

        <!-- İsim + Tank -->
        <LinearLayout
            android:id="@+id/llDeviceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/ivDeviceIcon"
            android:layout_marginStart="12dp"
            android:layout_alignTop="@id/ivDeviceIcon">

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CO2 Regülatör"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvTankName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Akvaryum 1"
                android:textColor="#8bcaff"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- Sağ üst: Online/Offline + Alarm -->
        <LinearLayout
            android:id="@+id/llStatusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/llDeviceInfo">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:backgroundTint="#4caf50"
                android:background="@drawable/bg_dot_circle"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="ONLINE"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/ivAlarm"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_alarm_red"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Alt: IP / Serial / Firmware / Last Seen dikey -->
        <LinearLayout
            android:id="@+id/llDeviceMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_below="@id/ivDeviceIcon"
            android:layout_alignStart="@id/ivDeviceIcon"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvIpTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP"
                    android:textColor="#8bcaff"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tvIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="192.168.1.33"
                    android:textColor="#8bcaff"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvSerialTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Serial"
                    android:textColor="#8bcaff"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tvSerial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CA-628206344"
                    android:textColor="#8bcaff"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvFirmwareTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Firmware"
                    android:textColor="#8bcaff"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tvFirmware"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.4.2"
                    android:textColor="#8bcaff"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvLastSeenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last seen"
                    android:textColor="#8bcaff"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tvLastSeen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12 h ago"
                    android:textColor="#8bcaff"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>