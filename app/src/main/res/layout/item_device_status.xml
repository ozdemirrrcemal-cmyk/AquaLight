<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDevice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Sol: Tip ikonu -->
        <ImageView
            android:id="@+id/ivDeviceIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_device_aqua_ster"
            app:tint="@android:color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <!-- Orta: İsim + Tank adı -->
        <LinearLayout
            android:id="@+id/llDeviceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/ivDeviceIcon"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CO2 Regülatör"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tvTankName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Akvaryum 1"
                android:textColor="@color/settings_text_secondary"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Alt: IP / Serial / Firmware yatay -->
        <LinearLayout
            android:id="@+id/llDeviceMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@id/llDeviceInfo"
            android:layout_alignStart="@id/llDeviceInfo"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP: 192.168.1.33"
                android:textColor="@color/settings_text_secondary"
                android:textSize="12sp"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tvSerial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Serial: CA-628206344"
                android:textColor="@color/settings_text_secondary"
                android:textSize="12sp"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tvFirmware"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Firmware: v1.4.2"
                android:textColor="@color/settings_text_secondary"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Sağ üst: Online/Offline dot + tvStatus + Alarm -->
        <LinearLayout
            android:id="@+id/llStatusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/llDeviceInfo">

            <!-- Online/Offline dot -->
            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_online_dot"/>

            <!-- ONLINE/OFFLINE yazısı -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="ONLINE"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <!-- Alarm / Hata icon -->
            <ImageView
                android:id="@+id/ivAlarm"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_alarm_red"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Sağ alt: Son görülme -->
        <TextView
            android:id="@+id/tvLastSeen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/llDeviceMeta"
            android:layout_alignStart="@id/llDeviceInfo"
            android:layout_marginTop="4dp"
            android:text="Last seen: 12 h ago"
            android:textColor="@color/settings_text_secondary"
            android:textSize="12sp"/>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>