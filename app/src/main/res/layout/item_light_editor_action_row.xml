<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editorActionRowRoot"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:layout_marginTop="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvActionIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_light_sheet_icon"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/light_accent"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvActionTitle"
            style="@style/TextAppearance.Aqua.Light.SheetRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preview Day"
            tools:text="Preview Day" />

        <TextView
            android:id="@+id/tvActionSubtitle"
            style="@style/TextAppearance.Aqua.Light.SheetRowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Simulate the full daily curve"
            tools:text="Simulate the full daily curve" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="@color/light_text_tertiary"
        android:textSize="28sp" />

</LinearLayout>