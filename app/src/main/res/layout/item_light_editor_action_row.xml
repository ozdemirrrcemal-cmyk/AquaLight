<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editorActionRowRoot"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginTop="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivActionIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_light_sheet_icon"
        android:contentDescription="@null"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_light_moon_24"
        app:tint="@color/light_accent"
        tools:src="@drawable/ic_light_moon_24" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvActionTitle"
            style="@style/TextAppearance.Aqua.Light.SheetRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Moonlight"
            tools:text="Moonlight" />

        <TextView
            android:id="@+id/tvActionSubtitle"
            style="@style/TextAppearance.Aqua.Light.SheetRowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Soft output after sunset"
            tools:text="Soft output after sunset" />

    </LinearLayout>

    <TextView
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="›"
        android:textColor="@color/light_text_tertiary"
        android:textSize="28sp" />

</LinearLayout>