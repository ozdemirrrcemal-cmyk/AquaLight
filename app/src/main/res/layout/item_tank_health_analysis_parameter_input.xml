<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_40"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvParameterName"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_caption" />

        <TextView
            android:id="@+id/tvParameterSymbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/aqua_size_4"
            android:includeFontPadding="false"
            android:textColor="@color/aqua_accent_primary"
            android:textSize="@dimen/aqua_text_size_caption"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnRemoveParameter"
            android:layout_width="@dimen/aqua_size_40"
            android:layout_height="@dimen/aqua_size_40"
            android:layout_marginStart="@dimen/aqua_size_2"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tank_health_analysis_remove_test"
            android:padding="@dimen/aqua_size_10"
            android:src="@drawable/ic_remove_24"
            app:tint="@color/aqua_card_text_secondary" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayout"
        style="@style/Widget.Aqua.Input.Layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputValue"
            style="@style/Widget.Aqua.Input.EditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_size_54"
            android:inputType="numberDecimal"
            android:selectAllOnFocus="true" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
