<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/card"
    style="@style/Widget.Aqua.Card.Device"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="@dimen/aqua_size_4" android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="@dimen/aqua_size_128" android:orientation="vertical" android:padding="@dimen/aqua_size_12">
        <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/aqua_size_40">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/ic_device_light" android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
            <ImageView android:id="@+id/ivDragGrip" android:layout_width="@dimen/aqua_size_16"
                android:layout_height="@dimen/aqua_size_20" android:layout_gravity="top|end"
                android:src="@drawable/ic_device_group_drag" android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView android:id="@+id/tvDeviceName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_8" android:textColor="@color/aqua_content_primary"
            android:textSize="@dimen/aqua_text_size_body_large" android:textStyle="bold" android:maxLines="2"
            android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/tvModel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_4" android:textColor="@color/aqua_content_muted"
            android:textSize="@dimen/aqua_text_size_caption_plus" android:maxLines="2" android:ellipsize="end"
            android:includeFontPadding="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="@dimen/aqua_size_6">
            <View android:id="@+id/presenceDot" android:layout_width="@dimen/aqua_size_10"
                android:layout_height="@dimen/aqua_size_10" android:background="@drawable/bg_device_group_status_dot"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/tvPresence" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/aqua_size_6" android:textColor="@color/aqua_content_muted"
                android:textSize="@dimen/aqua_text_size_caption_plus" android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
