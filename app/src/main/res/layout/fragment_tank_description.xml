<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/aqua_space_value_24"
        android:paddingEnd="@dimen/aqua_space_value_24"
        android:paddingTop="@dimen/aqua_space_value_28"
        android:paddingBottom="@dimen/aqua_space_value_24">

        <!-- Açıklama -->
        <TextView
            android:id="@+id/tvStepDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_space_value_10"
            android:text="@string/aquarium_text_describe_the_inspiration_mood_or_story_you_want_this_aquariu"
            android:textSize="@dimen/aqua_text_size_body"
            android:lineSpacingExtra="@dimen/aqua_space_value_3" />

        <!-- Form kartı -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card.Form"
            android:id="@+id/cardTankDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_space_value_34">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/aqua_space_value_18">

                <TextView
                    android:id="@+id/tvInputTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/aquarium_concept_field_title"
                    android:textSize="@dimen/aqua_text_size_body_xlarge"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInputHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_space_value_4"
                    android:text="@string/aquarium_text_example_a_calm_nature_inspired_planted_tank_with_a_forest_st"
                    android:textSize="@dimen/aqua_text_size_body_small"
                    android:lineSpacingExtra="@dimen/aqua_space_value_2" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Aqua.Input.Layout.Multiline"
                    android:id="@+id/tilTankDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_space_value_18"
                    android:hint="@string/aquarium_hint_tank_description"
                    app:errorEnabled="true"
                    app:counterEnabled="true"
                    app:counterMaxLength="500">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/Widget.Aqua.Input.EditText.Multiline"
                        android:id="@+id/etTankDescription"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/aqua_size_value_150"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="500"
                        android:minLines="5"
                        android:maxLines="8"
                        android:overScrollMode="always"
                        android:scrollbars="vertical"
                        android:textSize="@dimen/aqua_text_size_body_xlarge" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Bilgi kutusu -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card.Info"
            android:id="@+id/cardInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_space_value_18">

            <TextView
                android:id="@+id/tvDescriptionInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/aqua_space_value_16"
                android:text="@string/aquarium_text_this_concept_will_help_keep_your_aquarium_design_consistent"
                android:textSize="@dimen/aqua_text_size_body_small"
                android:lineSpacingExtra="@dimen/aqua_space_value_2" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>