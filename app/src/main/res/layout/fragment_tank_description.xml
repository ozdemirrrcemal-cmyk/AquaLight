<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- Açıklama -->
        <TextView
            android:id="@+id/tvStepDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/aquarium_text_describe_the_inspiration_mood_or_story_you_want_this_aquariu"
            android:textColor="@color/aqua_card_text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!-- Form kartı -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card.Form"
            android:id="@+id/cardTankDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvInputTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/aquarium_concept_field_title"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInputHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/aquarium_text_example_a_calm_nature_inspired_planted_tank_with_a_forest_st"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTankDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:hint="@string/aquarium_hint_tank_description"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/aqua_input_background"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/aqua_input_stroke_color"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/aqua_input_hint_color"
                    app:errorEnabled="true"
                    app:counterEnabled="true"
                    app:counterMaxLength="500">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTankDescription"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="500"
                        android:minLines="5"
                        android:maxLines="8"
                        android:overScrollMode="always"
                        android:scrollbars="vertical"
                        android:textColor="@color/aqua_card_text_primary"
                        android:textColorHint="@color/aqua_input_hint_unfocused"
                        android:textCursorDrawable="@null"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Bilgi kutusu -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Aqua.Card.Info"
            android:id="@+id/cardInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/tvDescriptionInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/aquarium_text_this_concept_will_help_keep_your_aquarium_design_consistent"
                android:textColor="@color/aqua_card_text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>