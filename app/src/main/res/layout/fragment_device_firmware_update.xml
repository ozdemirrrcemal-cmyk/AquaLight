<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:ignore="Overdraw">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/firmwareUpdateScroll"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/updateActionSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:id="@+id/firmwareUpdateContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_16"
            android:paddingTop="@dimen/aqua_size_12"
            android:paddingEnd="@dimen/aqua_size_16"
            android:paddingBottom="@dimen/aqua_size_24">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/updateStatusCard"
                style="@style/Widget.Aqua.Card.FirmwareUpdate.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_firmware_update_hero_padding">

                    <TextView
                        android:id="@+id/tvUpdateStatusBadge"
                        style="@style/Widget.Aqua.Chip.Status.Candidate"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/device_settings_update_status_checking"
                        tools:text="Update available" />

                    <FrameLayout
                        android:id="@+id/updateHeroIconContainer"
                        android:layout_width="@dimen/aqua_firmware_update_hero_icon_container_size"
                        android:layout_height="@dimen/aqua_firmware_update_hero_icon_container_size"
                        android:layout_marginTop="@dimen/aqua_size_20"
                        android:background="@drawable/bg_firmware_update_hero_orb"
                        android:importantForAccessibility="no">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivUpdateHeroIcon"
                            android:layout_width="@dimen/aqua_firmware_update_hero_icon_size"
                            android:layout_height="@dimen/aqua_firmware_update_hero_icon_size"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_firmware_update"
                            app:tint="@color/aqua_accent_primary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvUpdateHeroTitle"
                        style="@style/TextAppearance.Aqua.FirmwareUpdate.HeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_18"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center"
                        tools:text="A new software version is ready" />

                    <TextView
                        android:id="@+id/tvUpdateHeroSummary"
                        style="@style/TextAppearance.Aqua.FirmwareUpdate.HeroSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:gravity="center"
                        tools:text="Version 1.1.0 is ready to install. Review the verified release information below before continuing." />

                    <TextView
                        android:id="@+id/tvUpdateDeviceName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_14"
                        android:gravity="center"
                        android:textColor="@color/aqua_content_tertiary"
                        android:textSize="@dimen/aqua_text_size_body_small"
                        android:textStyle="bold"
                        tools:text="For WRGB Pro Elite 120" />

                    <LinearLayout
                        android:id="@+id/updateVersionsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_20"
                        android:background="@drawable/bg_firmware_update_version_panel"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/aqua_firmware_update_version_panel_padding">

                        <LinearLayout
                            android:id="@+id/installedVersionGroup"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            tools:ignore="InefficientWeight">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/device_settings_update_installed_version_label"
                                android:textColor="@color/aqua_content_secondary"
                                android:textSize="@dimen/aqua_text_size_caption" />

                            <TextView
                                android:id="@+id/tvInstalledVersion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/aqua_size_4"
                                android:textColor="@color/aqua_content_primary_soft"
                                android:textSize="@dimen/aqua_text_size_body_xlarge"
                                android:textStyle="bold"
                                tools:text="1.0.1" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivVersionArrow"
                            android:layout_width="@dimen/aqua_size_20"
                            android:layout_height="@dimen/aqua_size_20"
                            android:layout_marginStart="@dimen/aqua_size_12"
                            android:layout_marginEnd="@dimen/aqua_size_12"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="@color/aqua_accent_primary" />

                        <LinearLayout
                            android:id="@+id/targetVersionGroup"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            tools:ignore="InefficientWeight">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/device_settings_update_target_version_label"
                                android:textColor="@color/aqua_content_secondary"
                                android:textSize="@dimen/aqua_text_size_caption" />

                            <TextView
                                android:id="@+id/tvTargetVersion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/aqua_size_4"
                                android:textColor="@color/aqua_accent_positive"
                                android:textSize="@dimen/aqua_text_size_body_xlarge"
                                android:textStyle="bold"
                                tools:text="1.1.0" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/updateProgressCard"
                style="@style/Widget.Aqua.Card.FirmwareUpdate.Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_firmware_update_card_spacing">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_firmware_update_section_padding">

                    <FrameLayout
                        android:id="@+id/updateProgressHero"
                        android:layout_width="@dimen/aqua_size_176"
                        android:layout_height="@dimen/aqua_size_176">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressFirmwareUpdate"
                            style="@style/Widget.Aqua.FirmwareUpdate.Progress"
                            android:layout_width="@dimen/aqua_size_160"
                            android:layout_height="@dimen/aqua_size_160"
                            android:layout_gravity="center"
                            android:indeterminate="true" />

                        <LinearLayout
                            android:id="@+id/progressTextGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvUpdateProgressPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:accessibilityLiveRegion="polite"
                                android:textColor="@color/white"
                                android:textSize="@dimen/aqua_text_size_display"
                                android:textStyle="bold"
                                tools:text="64%" />

                            <TextView
                                android:id="@+id/tvUpdateProgressCaption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/aqua_size_2"
                                android:textColor="@color/aqua_content_secondary"
                                android:textSize="@dimen/aqua_text_size_caption"
                                tools:text="Installing" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivUpdateStateIcon"
                            android:layout_width="@dimen/aqua_size_56"
                            android:layout_height="@dimen/aqua_size_56"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:visibility="gone"
                            tools:src="@drawable/ic_check_24"
                            tools:tint="@color/aqua_status_success"
                            tools:visibility="visible" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvUpdatePhase"
                        style="@style/TextAppearance.Aqua.FirmwareUpdate.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        tools:text="Installing device software…" />

                    <TextView
                        android:id="@+id/tvUpdateProgressDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:gravity="center"
                        android:textColor="@color/aqua_content_secondary"
                        android:textSize="@dimen/aqua_text_size_body_small"
                        tools:text="640 KB of 1 MB" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/releaseNotesCard"
                style="@style/Widget.Aqua.Card.FirmwareUpdate.Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_firmware_update_card_spacing"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_firmware_update_section_padding">

                    <TextView
                        style="@style/TextAppearance.Aqua.FirmwareUpdate.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_settings_update_release_notes_heading" />

                    <TextView
                        android:id="@+id/tvReleaseTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_14"
                        android:textColor="@color/aqua_content_primary_soft"
                        android:textSize="@dimen/aqua_text_size_body_xlarge"
                        android:textStyle="bold"
                        tools:text="More reliable device control" />

                    <TextView
                        android:id="@+id/tvReleaseSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:textColor="@color/aqua_content_secondary"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="This release improves reconnect reliability and device stability." />

                    <TextView
                        android:id="@+id/tvReleaseChangesHeading"
                        style="@style/TextAppearance.Aqua.FirmwareUpdate.SubsectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_18"
                        android:text="@string/device_settings_update_changes_heading" />

                    <LinearLayout
                        android:id="@+id/releaseChangesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvReleaseWarningsHeading"
                        style="@style/TextAppearance.Aqua.FirmwareUpdate.WarningTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_18"
                        android:text="@string/device_settings_update_release_warnings_heading" />

                    <LinearLayout
                        android:id="@+id/releaseWarningsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/releaseNotesUnavailableCard"
                style="@style/Widget.Aqua.Card.FirmwareUpdate.Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_firmware_update_card_spacing"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="@dimen/aqua_firmware_update_section_padding">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/aqua_size_24"
                        android:layout_height="@dimen/aqua_size_24"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info"
                        app:tint="@color/aqua_accent_primary" />

                    <LinearLayout
                        android:layout_width="@dimen/aqua_size_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/aqua_size_12"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        tools:ignore="InefficientWeight">

                        <TextView
                            style="@style/TextAppearance.Aqua.FirmwareUpdate.SubsectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/device_settings_update_release_details_unavailable_title" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_6"
                            android:text="@string/device_settings_update_release_details_unavailable_message"
                            android:textColor="@color/aqua_content_secondary"
                            android:textSize="@dimen/aqua_text_size_body" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/updateRequirementsCard"
                style="@style/Widget.Aqua.Card.FirmwareUpdate.Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_firmware_update_card_spacing"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_firmware_update_section_padding">

                    <TextView
                        style="@style/TextAppearance.Aqua.FirmwareUpdate.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_settings_update_requirements_heading" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:text="@string/device_settings_update_requirements_summary"
                        android:textColor="@color/aqua_content_secondary"
                        android:textSize="@dimen/aqua_text_size_body" />

                    <LinearLayout
                        android:id="@+id/updateRequirementsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_10"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/updateActionSurface"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:background="@color/background_color"
        android:elevation="@dimen/aqua_firmware_update_action_elevation"
        android:orientation="vertical"
        android:paddingStart="@dimen/aqua_size_16"
        android:paddingTop="@dimen/aqua_size_10"
        android:paddingEnd="@dimen/aqua_size_16"
        android:paddingBottom="@dimen/aqua_size_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvUpdateActionHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/aqua_size_10"
            android:gravity="center"
            android:text="@string/device_settings_update_action_hint_available"
            android:textColor="@color/aqua_content_secondary"
            android:textSize="@dimen/aqua_text_size_caption" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_button_height">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateAction"
                style="@style/Widget.Aqua.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/device_settings_update_action_loading" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressUpdateAction"
                android:layout_width="@dimen/aqua_size_24"
                android:layout_height="@dimen/aqua_size_24"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/white"
                app:indicatorSize="@dimen/aqua_size_24"
                app:trackThickness="@dimen/aqua_size_2" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
