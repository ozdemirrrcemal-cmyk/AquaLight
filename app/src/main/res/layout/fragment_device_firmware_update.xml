<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:ignore="Overdraw">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/firmwareUpdateScroll"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/updateActionSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appHeader">

        <LinearLayout
            android:id="@+id/firmwareUpdateContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/aqua_size_16"
            android:paddingTop="@dimen/aqua_size_12"
            android:paddingEnd="@dimen/aqua_size_16"
            android:paddingBottom="@dimen/aqua_size_24">

            <LinearLayout
                android:id="@+id/updateDetailsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Aqua.Card.Device.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/aqua_size_18">

                        <TextView
                            android:id="@+id/tvUpdateStatusBadge"
                            style="@style/Widget.Aqua.Chip.Status.Candidate"
                            android:text="@string/device_settings_update_status_available"
                            tools:text="Güncelleme hazır" />

                        <TextView
                            android:id="@+id/tvUpdateDeviceName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_16"
                            android:textColor="@color/white"
                            android:textSize="@dimen/aqua_text_size_title_large"
                            android:textStyle="bold"
                            tools:text="WRGB Pro Elite 120" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/aqua_size_18"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="@dimen/aqua_size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                tools:ignore="InefficientWeight">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/device_settings_update_installed_version_label"
                                    android:textColor="@color/aqua_content_secondary"
                                    android:textSize="@dimen/aqua_text_size_caption" />

                                <TextView
                                    android:id="@+id/tvInstalledVersion"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_4"
                                    android:textColor="@color/aqua_content_primary_soft"
                                    android:textSize="@dimen/aqua_text_size_body_xlarge"
                                    android:textStyle="bold"
                                    tools:text="1.0.1" />
                            </LinearLayout>

                            <View
                                android:layout_width="@dimen/aqua_size_1"
                                android:layout_height="@dimen/aqua_size_40"
                                android:layout_marginStart="@dimen/aqua_size_14"
                                android:layout_marginEnd="@dimen/aqua_size_14"
                                android:background="@color/aqua_card_divider" />

                            <LinearLayout
                                android:layout_width="@dimen/aqua_size_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                tools:ignore="InefficientWeight">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/device_settings_update_target_version_label"
                                    android:textColor="@color/aqua_content_secondary"
                                    android:textSize="@dimen/aqua_text_size_caption" />

                                <TextView
                                    android:id="@+id/tvTargetVersion"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/aqua_size_4"
                                    android:textColor="@color/aqua_accent_positive"
                                    android:textSize="@dimen/aqua_text_size_body_xlarge"
                                    android:textStyle="bold"
                                    tools:text="1.1.0" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/releaseNotesCard"
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_14"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_18">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_settings_update_release_notes_heading"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReleaseTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_14"
                        android:textColor="@color/aqua_content_primary_soft"
                        android:textSize="@dimen/aqua_text_size_body_xlarge"
                        android:textStyle="bold"
                        tools:text="Bağlantı ve kararlılık iyileştirmeleri" />

                    <TextView
                        android:id="@+id/tvReleaseSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:textColor="@color/aqua_content_secondary"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="Bu sürüm bağlantı güvenilirliğini ve çalışma kararlılığını geliştirir." />

                    <TextView
                        android:id="@+id/tvReleaseChangesHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_18"
                        android:text="@string/device_settings_update_changes_heading"
                        android:textColor="@color/aqua_content_primary_soft"
                        android:textSize="@dimen/aqua_text_size_body_large"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/releaseChangesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvReleaseWarningsHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_18"
                        android:text="@string/device_settings_update_warnings_heading"
                        android:textColor="@color/aqua_content_warning"
                        android:textSize="@dimen/aqua_text_size_body_large"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/releaseWarningsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/updateRequirementsCard"
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_14"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_18">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_settings_update_warnings_heading"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_10"
                        android:text="@string/device_settings_update_power_warning"
                        android:textColor="@color/aqua_content_secondary"
                        android:textSize="@dimen/aqua_text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/updateProgressCard"
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_20">

                    <FrameLayout
                        android:layout_width="@dimen/aqua_size_176"
                        android:layout_height="@dimen/aqua_size_176">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressFirmwareUpdate"
                            style="@style/Widget.Aqua.FirmwareUpdate.Progress"
                            android:layout_width="@dimen/aqua_size_160"
                            android:layout_height="@dimen/aqua_size_160"
                            android:layout_gravity="center"
                            android:indeterminate="true" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvUpdateProgressPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:accessibilityLiveRegion="polite"
                                android:textColor="@color/white"
                                android:textSize="@dimen/aqua_text_size_display"
                                android:textStyle="bold"
                                tools:text="65%" />

                            <TextView
                                android:id="@+id/tvUpdateProgressCaption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/aqua_size_2"
                                android:textColor="@color/aqua_content_secondary"
                                android:textSize="@dimen/aqua_text_size_caption"
                                tools:text="Güncelleme sürüyor" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvUpdatePhase"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_small"
                        android:textStyle="bold"
                        tools:text="Cihaz yazılımı yükleniyor…" />

                    <TextView
                        android:id="@+id/tvUpdateProgressDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:gravity="center"
                        android:textColor="@color/aqua_content_secondary"
                        android:textSize="@dimen/aqua_text_size_body_small"
                        tools:text="640 KB / 1 MB" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/updateTimelineCard"
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_14"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_18">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStepPrepareIcon"
                            android:layout_width="@dimen/aqua_size_28"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/aqua_accent_primary"
                            android:textSize="@dimen/aqua_text_size_title_small"
                            tools:text="•" />

                        <TextView
                            android:id="@+id/tvStepPrepareTitle"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_10"
                            android:layout_weight="1"
                            android:text="@string/device_settings_update_phase_starting"
                            android:textColor="@color/aqua_content_primary_soft"
                            android:textSize="@dimen/aqua_text_size_body" />
                    </LinearLayout>

                    <include
                        layout="@layout/layout_device_firmware_timeline_divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStepDownloadIcon"
                            android:layout_width="@dimen/aqua_size_28"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/aqua_content_secondary"
                            android:textSize="@dimen/aqua_text_size_title_small"
                            tools:text="○" />

                        <TextView
                            android:id="@+id/tvStepDownloadTitle"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_10"
                            android:layout_weight="1"
                            android:text="@string/device_settings_update_phase_downloading"
                            android:textColor="@color/aqua_content_secondary"
                            android:textSize="@dimen/aqua_text_size_body" />
                    </LinearLayout>

                    <include
                        layout="@layout/layout_device_firmware_timeline_divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStepInstallIcon"
                            android:layout_width="@dimen/aqua_size_28"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/aqua_content_secondary"
                            android:textSize="@dimen/aqua_text_size_title_small"
                            tools:text="○" />

                        <TextView
                            android:id="@+id/tvStepInstallTitle"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_10"
                            android:layout_weight="1"
                            android:text="@string/device_settings_update_phase_writing"
                            android:textColor="@color/aqua_content_secondary"
                            android:textSize="@dimen/aqua_text_size_body" />
                    </LinearLayout>

                    <include
                        layout="@layout/layout_device_firmware_timeline_divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStepVerifyIcon"
                            android:layout_width="@dimen/aqua_size_28"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/aqua_content_secondary"
                            android:textSize="@dimen/aqua_text_size_title_small"
                            tools:text="○" />

                        <TextView
                            android:id="@+id/tvStepVerifyTitle"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_10"
                            android:layout_weight="1"
                            android:text="@string/device_settings_update_phase_verifying"
                            android:textColor="@color/aqua_content_secondary"
                            android:textSize="@dimen/aqua_text_size_body" />
                    </LinearLayout>

                    <include
                        layout="@layout/layout_device_firmware_timeline_divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStepRestartIcon"
                            android:layout_width="@dimen/aqua_size_28"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/aqua_content_secondary"
                            android:textSize="@dimen/aqua_text_size_title_small"
                            tools:text="○" />

                        <TextView
                            android:id="@+id/tvStepRestartTitle"
                            android:layout_width="@dimen/aqua_size_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/aqua_size_10"
                            android:layout_weight="1"
                            android:text="@string/device_settings_update_phase_restarting"
                            android:textColor="@color/aqua_content_secondary"
                            android:textSize="@dimen/aqua_text_size_body" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/updateCompletionCard"
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_24">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivUpdateCompleteIcon"
                        android:layout_width="@dimen/aqua_size_80"
                        android:layout_height="@dimen/aqua_size_80"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_24" />

                    <TextView
                        android:id="@+id/tvUpdateCompleteTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_18"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_large"
                        android:textStyle="bold"
                        tools:text="Güncelleme tamamlandı" />

                    <TextView
                        android:id="@+id/tvUpdateCompleteBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_10"
                        android:gravity="center"
                        android:textColor="@color/aqua_content_secondary"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="Hedef sürüm yeniden başlatma sonrasında doğrulandı." />

                    <TextView
                        android:id="@+id/tvUpdateCompleteVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_16"
                        android:textColor="@color/aqua_accent_positive"
                        android:textSize="@dimen/aqua_text_size_body_xlarge"
                        android:textStyle="bold"
                        tools:text="1.1.0" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/updateFailureCard"
                style="@style/Widget.Aqua.Card.Device.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_24">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivUpdateFailureIcon"
                        android:layout_width="@dimen/aqua_size_64"
                        android:layout_height="@dimen/aqua_size_64"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_error" />

                    <TextView
                        android:id="@+id/tvUpdateFailureTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_18"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="@dimen/aqua_text_size_title_large"
                        android:textStyle="bold"
                        tools:text="Güncelleme başarısız" />

                    <TextView
                        android:id="@+id/tvUpdateFailureBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_10"
                        android:gravity="center"
                        android:textColor="@color/aqua_content_secondary"
                        android:textSize="@dimen/aqua_text_size_body"
                        tools:text="Bağlantıyı kontrol edip tekrar deneyin." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/updateActionSurface"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        android:background="@color/background_color"
        android:orientation="vertical"
        android:paddingStart="@dimen/aqua_size_16"
        android:paddingTop="@dimen/aqua_size_10"
        android:paddingEnd="@dimen/aqua_size_16"
        android:paddingBottom="@dimen/aqua_size_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvUpdateActionHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/aqua_size_10"
            android:gravity="center"
            android:text="@string/device_settings_update_power_warning"
            android:textColor="@color/aqua_content_secondary"
            android:textSize="@dimen/aqua_text_size_caption" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/aqua_button_height">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateAction"
                style="@style/Widget.Aqua.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/device_settings_update_action_loading" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressUpdateAction"
                android:layout_width="@dimen/aqua_size_24"
                android:layout_height="@dimen/aqua_size_24"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/white"
                app:indicatorSize="@dimen/aqua_size_24"
                app:trackThickness="@dimen/aqua_size_2" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>