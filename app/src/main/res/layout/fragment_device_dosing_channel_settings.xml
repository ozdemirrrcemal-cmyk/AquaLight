<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:orientation="vertical">

   <!-- TOP BAR -->
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/channelSettingsTopBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_color"
    android:elevation="8dp"
    android:paddingHorizontal="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/back"
        android:scaleType="center"
        android:src="@drawable/ic_back"
        app:tint="?attr/colorOnSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvChannelSettingsTitle"
        style="@style/TextAppearance.Aqua.EditProfileTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Channel 1"
        android:textColor="?attr/colorOnSurface"
        android:importantForAccessibility="yes"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />

</androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/channelSettingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background_color"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="28dp">

        <!-- CHANNEL SELECTOR / PUMP VISUAL -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pumpVisualContainer"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/ivDosingPump"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:adjustViewBounds="false"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/img_dosing_pump_4ch"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePumpIndicatorY"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.486" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump1Center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.153" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump2Center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.386" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump3Center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.614" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidePump4Center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.846" />

            <!-- SELECTED CHANNEL INDICATORS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/selectedIndicatorPump1"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:visibility="visible"
                app:cardBackgroundColor="#22C55E"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:strokeColor="#86EFAC"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="@id/guidePumpIndicatorY"
                app:layout_constraintEnd_toEndOf="@id/guidePump1Center"
                app:layout_constraintStart_toStartOf="@id/guidePump1Center"
                app:layout_constraintTop_toTopOf="@id/guidePumpIndicatorY">

                <TextView
                    android:id="@+id/tvSelectedPumpIndicator1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@android:color/black"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/selectedIndicatorPump2"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:visibility="gone"
                app:cardBackgroundColor="#22C55E"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:strokeColor="#86EFAC"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="@id/guidePumpIndicatorY"
                app:layout_constraintEnd_toEndOf="@id/guidePump2Center"
                app:layout_constraintStart_toStartOf="@id/guidePump2Center"
                app:layout_constraintTop_toTopOf="@id/guidePumpIndicatorY">

                <TextView
                    android:id="@+id/tvSelectedPumpIndicator2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@android:color/black"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/selectedIndicatorPump3"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:visibility="gone"
                app:cardBackgroundColor="#22C55E"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:strokeColor="#86EFAC"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="@id/guidePumpIndicatorY"
                app:layout_constraintEnd_toEndOf="@id/guidePump3Center"
                app:layout_constraintStart_toStartOf="@id/guidePump3Center"
                app:layout_constraintTop_toTopOf="@id/guidePumpIndicatorY">

                <TextView
                    android:id="@+id/tvSelectedPumpIndicator3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@android:color/black"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/selectedIndicatorPump4"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:visibility="gone"
                app:cardBackgroundColor="#22C55E"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:strokeColor="#86EFAC"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="@id/guidePumpIndicatorY"
                app:layout_constraintEnd_toEndOf="@id/guidePump4Center"
                app:layout_constraintStart_toStartOf="@id/guidePump4Center"
                app:layout_constraintTop_toTopOf="@id/guidePumpIndicatorY">

                <TextView
                    android:id="@+id/tvSelectedPumpIndicator4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@android:color/black"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- SCHEDULE MASTER -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardScheduleMaster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#101426"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#24314F"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="15dp"
                android:paddingEnd="14dp"
                android:paddingBottom="15dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="Activate schedule"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:includeFontPadding="false"
                        android:text="Enable automatic dosing for this channel"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchScheduleEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- DAILY DOSE -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDailyDose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#101426"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#24314F"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="15dp"
                android:paddingEnd="16dp"
                android:paddingBottom="15dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="Daily dose"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:includeFontPadding="false"
                        android:text="Total amount dosed per day"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="86dp"
                    android:layout_height="42dp"
                    app:cardBackgroundColor="#1A2238"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#33415F"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tvDailyDoseValue"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="0 ml"
                        android:textColor="#F43F5E"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- DOSING SCHEDULE -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDosingSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#101426"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#24314F"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="Dosing schedule"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:includeFontPadding="false"
                    android:text="Choose how the daily dose is distributed"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="12sp" />

                <!-- SINGLE -->
                <LinearLayout
                    android:id="@+id/rowModeSingle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioModeSingle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="Single"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:includeFontPadding="false"
                            android:text="Give the daily dose once"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#A8B0C3"
                        android:textSize="24sp" />

                </LinearLayout>

                <!-- 24 HOURLY -->
                <LinearLayout
                    android:id="@+id/rowModeHourly"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioModeHourly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="24 hourly"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:includeFontPadding="false"
                            android:text="Split dose across the day"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#A8B0C3"
                        android:textSize="24sp" />

                </LinearLayout>

                <!-- CUSTOM PERIODS -->
                <LinearLayout
                    android:id="@+id/rowModeCustomPeriods"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioModeCustomPeriods"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="Custom periods"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:includeFontPadding="false"
                            android:text="Create your own dosing windows"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#A8B0C3"
                        android:textSize="24sp" />

                </LinearLayout>

                <!-- TIMER -->
                <LinearLayout
                    android:id="@+id/rowModeTimer"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioModeTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="Timer"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:includeFontPadding="false"
                            android:text="Dose by timer-based intervals"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#A8B0C3"
                        android:textSize="24sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- RECURRENCE -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRecurrence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#101426"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#24314F"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="Recurrence"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/rowEveryDay"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioEveryDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="Every day"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dayChipContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipDayMon"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="#702536"
                        android:gravity="center"
                        android:text="MON"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipDayTue"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="#702536"
                        android:gravity="center"
                        android:text="TUE"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipDayWed"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="#702536"
                        android:gravity="center"
                        android:text="WED"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipDayThu"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="#702536"
                        android:gravity="center"
                        android:text="THU"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipDayFri"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="#702536"
                        android:gravity="center"
                        android:text="FRI"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipDaySat"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="#702536"
                        android:gravity="center"
                        android:text="SAT"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipDaySun"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:background="#702536"
                        android:gravity="center"
                        android:text="SUN"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- CALIBRATION -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCalibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#101426"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#24314F"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="Calibration"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLastCalibrated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:includeFontPadding="false"
                        android:text="Last calibrated: Not calibrated"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalibrate"
                    android:layout_width="112dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="Calibrate"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#315B7A"
                    app:cornerRadius="16dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- MISSED DOSE COMPENSATION -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMissedDoseCompensation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#101426"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#24314F"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="15dp"
                android:paddingEnd="14dp"
                android:paddingBottom="15dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="Missed dose compensation"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:includeFontPadding="false"
                        android:text="If a scheduled dose is missed, dose at the next safe opportunity"
                        android:textColor="@color/settings_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchMissedDoseCompensation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- RESERVOIR -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReservoir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#101426"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#24314F"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="Reservoir tracking"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:includeFontPadding="false"
                            android:text="Track liquid level and warn when the container is low"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchReservoirTracking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowContainerVolume"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="Container volume"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="96dp"
                        android:layout_height="38dp"
                        app:cardBackgroundColor="#1A2238"
                        app:cardCornerRadius="13dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#33415F"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/tvContainerVolumeValue"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="450.0 ml"
                            android:textColor="#F43F5E"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- MANUAL ACTIONS -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardManualActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#101426"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#24314F"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="Manual actions"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManualDosing"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:minHeight="0dp"
                    android:text="Manual dosing"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#F43F5E"
                    app:cornerRadius="17dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetChannel"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:minHeight="0dp"
                    android:text="Reset channel"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#7F1D2D"
                    app:cornerRadius="17dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

</LinearLayout>