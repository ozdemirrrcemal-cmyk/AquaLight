<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timerManualControlRoot"
    style="@style/Widget.Aqua.BottomSheet.Root">

    <View style="@style/Widget.Aqua.BottomSheet.Handle" />

    <TextView
        android:id="@+id/tvTimerManualTitle"
        style="@style/TextAppearance.Aqua.BottomSheet.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_18"
        android:gravity="start" />

    <TextView
        android:id="@+id/tvTimerManualMessage"
        style="@style/TextAppearance.Aqua.BottomSheet.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_52"
        android:layout_marginTop="@dimen/aqua_size_18"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTimerManualOn"
            style="@style/Widget.Aqua.SelectionRow.BottomSheet"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/aqua_size_4"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body" />

        <TextView
            android:id="@+id/btnTimerManualOff"
            style="@style/Widget.Aqua.SelectionRow.BottomSheet"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/aqua_size_4"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTimerManualDurationLabel"
        style="@style/TextAppearance.Aqua.BottomSheet.RowSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_18" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_46"
        android:layout_marginTop="@dimen/aqua_size_8"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTimerDuration15"
            style="@style/Widget.Aqua.SelectionRow.BottomSheet"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/aqua_size_3"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body_small" />

        <TextView
            android:id="@+id/btnTimerDuration30"
            style="@style/Widget.Aqua.SelectionRow.BottomSheet"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/aqua_size_3"
            android:layout_marginEnd="@dimen/aqua_size_3"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body_small" />

        <TextView
            android:id="@+id/btnTimerDuration60"
            style="@style/Widget.Aqua.SelectionRow.BottomSheet"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/aqua_size_3"
            android:layout_marginEnd="@dimen/aqua_size_3"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body_small" />

        <TextView
            android:id="@+id/btnTimerDurationCustom"
            style="@style/Widget.Aqua.SelectionRow.BottomSheet"
            android:layout_width="@dimen/aqua_size_0"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/aqua_size_3"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/aqua_card_text_primary"
            android:textSize="@dimen/aqua_text_size_body_small" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTimerManualStart"
        style="@style/Widget.Aqua.BottomSheet.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_52"
        android:layout_marginTop="@dimen/aqua_size_18" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTimerManualResume"
        style="@style/Widget.Aqua.BottomSheet.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="@dimen/aqua_size_48"
        android:layout_marginTop="@dimen/aqua_size_6" />

</LinearLayout>
