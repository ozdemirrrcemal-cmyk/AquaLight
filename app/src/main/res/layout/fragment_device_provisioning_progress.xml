<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".ui.tabs.devices.add.DeviceProvisioningProgressFragment">

    <include
        android:id="@+id/appHeader"
        layout="@layout/layout_aqua_header"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="@dimen/aqua_size_0"
        android:layout_height="@dimen/aqua_size_0"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="@dimen/aqua_size_16"
        android:paddingTop="@dimen/aqua_size_10"
        android:paddingEnd="@dimen/aqua_size_16"
        android:paddingBottom="@dimen/aqua_size_24"
        app:layout_constraintTop_toBottomOf="@id/appHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_20">

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleLarge"
                        android:layout_width="@dimen/aqua_size_58"
                        android:layout_height="@dimen/aqua_size_58"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/aqua_accent_positive" />

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_17"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/aqua_content_primary"
                        android:textSize="@dimen/aqua_text_size_title_intermediate"
                        android:textStyle="bold"
                        tools:text="Connecting to device" />

                    <TextView
                        android:id="@+id/tvMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_8"
                        android:gravity="center"
                        android:lineSpacingExtra="@dimen/aqua_size_2"
                        android:textColor="@color/aqua_content_muted"
                        android:textSize="@dimen/aqua_text_size_caption_plus"
                        tools:text="AquaLight device setup is in progress." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_16">

                    <TextView
                        android:id="@+id/tvDeviceName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="@color/aqua_content_primary"
                        android:textSize="@dimen/aqua_text_size_card_title"
                        android:textStyle="bold"
                        tools:text="WRGB Pro Elite" />

                    <TextView
                        android:id="@+id/tvDeviceSerial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_7"
                        android:includeFontPadding="false"
                        android:textColor="@color/aqua_content_muted"
                        android:textSize="@dimen/aqua_text_size_caption_plus"
                        tools:text="Serial: AQL-LIGHT-123456" />

                    <TextView
                        android:id="@+id/tvBleAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_6"
                        android:includeFontPadding="false"
                        android:textColor="@color/aqua_accent_positive"
                        android:textSize="@dimen/aqua_text_size_caption_plus"
                        tools:text="BLE: AA:BB:CC:DD:EE:FF" />

                    <TextView
                        android:id="@+id/tvWifiSsid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_12"
                        android:includeFontPadding="false"
                        android:textColor="@color/aqua_content_primary"
                        android:textSize="@dimen/aqua_text_size_body_small"
                        tools:text="Wi-Fi: HomeNetwork" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqua.Card.Device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/aqua_size_16">

                    <TextView
                        android:id="@+id/tvStepOne"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/device_provisioning_step_device_selected"
                        android:textColor="@color/aqua_content_primary"
                        android:textSize="@dimen/aqua_text_size_body_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStepTwo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_10"
                        android:includeFontPadding="false"
                        android:text="@string/device_provisioning_step_wifi_prepared"
                        android:textColor="@color/aqua_content_primary"
                        android:textSize="@dimen/aqua_text_size_body_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStepThree"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/aqua_size_10"
                        android:includeFontPadding="false"
                        android:text="@string/device_provisioning_step_preparing_secure"
                        android:textColor="@color/aqua_content_muted"
                        android:textSize="@dimen/aqua_text_size_body_small"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Aqua.Button.Primary"
                android:id="@+id/btnStartProvisioning"
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_button_height"
                android:layout_marginTop="@dimen/aqua_size_16"
                android:text="@string/device_provisioning_try_again"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
