<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lightDayPickerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_light_bottom_sheet_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/light_stroke" />

    <TextView
        android:id="@+id/tvDayPickerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/light_day_picker_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDayPickerSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/light_day_picker_subtitle"
        android:textColor="@color/settings_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/dayPickerRow"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipPickerMon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_light_editor_chip_selected"
            android:gravity="center"
            android:text="@string/common_day_mon_short"
            android:textColor="@color/background_color"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipPickerTue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_light_editor_chip_selected"
            android:gravity="center"
            android:text="@string/common_day_tue_short"
            android:textColor="@color/background_color"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipPickerWed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_light_editor_chip_selected"
            android:gravity="center"
            android:text="@string/common_day_wed_short"
            android:textColor="@color/background_color"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipPickerThu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_light_editor_chip_selected"
            android:gravity="center"
            android:text="@string/common_day_thu_short"
            android:textColor="@color/background_color"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipPickerFri"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_light_editor_chip_selected"
            android:gravity="center"
            android:text="@string/common_day_fri_short"
            android:textColor="@color/background_color"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipPickerSat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_light_editor_chip_selected"
            android:gravity="center"
            android:text="@string/common_day_sat_short"
            android:textColor="@color/background_color"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipPickerSun"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_light_editor_chip_selected"
            android:gravity="center"
            android:text="@string/common_day_sun_short"
            android:textColor="@color/background_color"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvDayPickerSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text=""
        android:textColor="@color/light_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Every day selected" />

    <TextView
        android:id="@+id/btnDayPickerWeekdays"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/light_day_picker_select_weekdays"
        android:textColor="@color/light_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnDayPickerWeekend"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/light_day_picker_select_weekend"
        android:textColor="@color/light_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnDayPickerEveryDay"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/light_day_picker_select_every_day"
        android:textColor="@color/light_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnDayPickerSave"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@color/light_accent"
        android:gravity="center"
        android:text="@string/light_day_picker_save"
        android:textColor="@color/background_color"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnDayPickerCancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/common_cancel"
        android:textColor="@color/settings_text_secondary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>