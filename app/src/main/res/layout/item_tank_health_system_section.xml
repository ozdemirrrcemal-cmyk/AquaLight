<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_18"
        android:includeFontPadding="false"
        android:text="@string/tank_health_system_summary_title"
        android:textColor="@color/aqua_card_text_primary"
        android:textSize="@dimen/aqua_text_size_body_xlarge"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Aqua.Card.Metric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/aqua_size_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/aqua_size_4"
            android:paddingBottom="@dimen/aqua_size_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_44"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/aqua_size_12">

                <ImageView
                    android:layout_width="@dimen/aqua_size_20"
                    android:layout_height="@dimen/aqua_size_20"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_care_co2_24"
                    app:tint="@color/aqua_card_text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/aqua_size_12"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/tank_health_system_co2"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body_small" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/tank_health_system_co2_value"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_body_small" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_44"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/aqua_size_12">

                <ImageView
                    android:layout_width="@dimen/aqua_size_20"
                    android:layout_height="@dimen/aqua_size_20"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_devices"
                    app:tint="@color/aqua_card_text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/aqua_size_12"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/tank_health_system_lighting"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body_small" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/tank_health_system_lighting_value"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_caption" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_44"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/aqua_size_12">

                <ImageView
                    android:layout_width="@dimen/aqua_size_20"
                    android:layout_height="@dimen/aqua_size_20"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_care_filter_24"
                    app:tint="@color/aqua_card_text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/aqua_size_12"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/tank_health_system_filter"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body_small" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/tank_health_system_filter_value"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_caption" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/aqua_size_44"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/aqua_size_12">

                <ImageView
                    android:layout_width="@dimen/aqua_size_20"
                    android:layout_height="@dimen/aqua_size_20"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_care_livestock_24"
                    app:tint="@color/aqua_card_text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/aqua_size_12"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/tank_health_system_livestock_load"
                    android:textColor="@color/aqua_card_text_primary"
                    android:textSize="@dimen/aqua_text_size_body_small" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/tank_health_system_livestock_load_value"
                    android:textColor="@color/aqua_card_text_secondary"
                    android:textSize="@dimen/aqua_text_size_body_small" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
