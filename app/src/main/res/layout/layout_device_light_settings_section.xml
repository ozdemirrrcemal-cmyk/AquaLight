<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Aqua.Card.Device.Section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/aqua_size_14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/aqua_size_18">

        <TextView
            android:id="@+id/tvLightProtectionSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/aqua_text_size_title_small"
            android:textStyle="bold"
            tools:text="Light protection" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_16"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCurrentTemperatureLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/aqua_content_secondary"
                android:textSize="@dimen/aqua_text_size_caption"
                tools:text="Current temperature" />

            <TextView
                android:id="@+id/tvCurrentTemperatureValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aqua_size_4"
                android:textColor="@color/aqua_content_primary_soft"
                android:textSize="@dimen/aqua_text_size_body_large"
                tools:text="54 °C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/temperatureProtectionThresholdRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aqua_size_8"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/aqua_size_8"
            android:paddingBottom="@dimen/aqua_size_8">

            <LinearLayout
                android:layout_width="@dimen/aqua_size_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                tools:ignore="InefficientWeight">

                <TextView
                    android:id="@+id/tvTemperatureProtectionThresholdLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/aqua_content_secondary"
                    android:textSize="@dimen/aqua_text_size_caption"
                    tools:text="Temperature protection threshold" />

                <TextView
                    android:id="@+id/tvTemperatureProtectionThresholdValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/aqua_size_4"
                    android:textColor="@color/white"
                    android:textSize="@dimen/aqua_text_size_body_large"
                    android:textStyle="bold"
                    tools:text="60 °C" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivTemperatureProtectionThresholdArrow"
                android:layout_width="@dimen/aqua_size_24"
                android:layout_height="@dimen/aqua_size_24"
                android:layout_marginStart="@dimen/aqua_size_12"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/aqua_content_secondary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>