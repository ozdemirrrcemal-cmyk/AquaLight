<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 🌙 Night Mode için koyu tonlarla uyumlu Material 3 Tema -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Arka plan tamamen aynı koyu ton -->
        <item name="android:colorBackground">#0A192F</item>
        <item name="colorSurface">#0A192F</item>
        <item name="colorOnSurface">#FFFFFF</item>

        <!-- Sistem barlar -->
        <item name="android:statusBarColor">#0A192F</item>
        <item name="android:navigationBarColor">#0A192F</item>

        <!-- Beyaz ikonlar görünür olsun -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- ActionBar kapalı -->
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

    </style>

    <!-- Splash metin stilleri gece de aynı kalsın -->
    <style name="SplashTitleText">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">32sp</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <style name="SplashSubtitleText">
        <item name="android:textColor">#AAB6C1</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/raleway_medium</item>
    </style>

</resources>