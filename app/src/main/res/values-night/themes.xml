<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 🌙 Material 3 Dark Tema -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Ana renkler -->
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/md_theme_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_dark_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_dark_onSecondaryContainer</item>

        <!-- Arka plan ve yüzey -->
        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>

        <!-- Varyant & outline & error -->
        <item name="colorSurfaceVariant">@color/md_theme_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_dark_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_dark_outlineVariant</item>
        <item name="colorError">@color/md_theme_dark_error</item>
        <item name="colorOnError">@color/md_theme_dark_onError</item>

        <!-- Aqua bottom navigation tokens -->
        <item name="aquaBottomNavBackground">@color/bottom_nav_background</item>
        <item name="aquaBottomNavActiveIndicator">@color/bottom_nav_active_indicator</item>
        <item name="aquaBottomNavItemActive">@color/md_theme_dark_onSurface</item>
        <item name="aquaBottomNavItemInactive">@color/md_theme_dark_onSurfaceVariant</item>

        <item name="bottomSheetDialogTheme">@style/AquaBottomSheetDialogTheme</item>

        <!-- Sistem bar renkleri -->
        <item name="android:statusBarColor">@color/aqua_color_transparent</item>
        <item name="android:navigationBarColor">@color/aqua_system_bar_surface</item>

        <!-- Koyu modda beyaz ikonlar -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- ActionBar kapalı -->
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- 🌙 Splash metin stilleri -->
    <style name="SplashTitleText">
        <item name="android:textColor">@color/md_theme_dark_onPrimary</item>
        <item name="android:textSize">@dimen/aqua_text_size_display</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SplashSubtitleText">
        <item name="android:textColor">@color/md_theme_dark_onSurface</item>
        <item name="android:textSize">@dimen/aqua_text_size_body_xlarge</item>
        <item name="fontFamily">@font/raleway_medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
