<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_app"
    app:startDestination="@id/aquariumFragment">

    <!-- 🐠 Aquarium Tab -->
    <fragment
        android:id="@+id/aquariumFragment"
        android:name="com.aqua.aqualight.ui.tabs.aquarium.AquariumFragment"
        android:label="Aquarium"
        tools:layout="@layout/fragment_aquarium" />
		
		<fragment
    android:id="@+id/createTankFragment"
    android:name="com.aqua.aqualight.ui.tabs.aquarium.CreateTankFragment"
    android:label="Create Tank"
    tools:layout="@layout/fragment_create_tank" />

<action
    android:id="@+id/action_aquariumFragment_to_createTankFragment"
    app:destination="@id/createTankFragment" />
		
    <!-- Maintenance Tab -->
		<fragment
        android:id="@+id/aquariumMaintenanceFragment"
		android:name="com.aqua.aqualight.ui.tabs.maintenance.AquariumMaintenanceFragment"
        android:label="Maintenance"
        tools:layout="@layout/fragment_aquarium_maintenance" />

  <!-- 📟 Devices Tab -->
<fragment
    android:id="@+id/devicesFragment"
    android:name="com.aqua.aqualight.ui.tabs.devices.DevicesFragment"
    android:label="Devices"
    tools:layout="@layout/fragment_devices">

    <action
        android:id="@+id/action_devicesFragment_to_scanDevicesFragment"
        app:destination="@id/scanDevicesFragment" />

    <action
        android:id="@+id/action_devicesFragment_to_deviceMenuFragment"
        app:destination="@id/deviceMenuFragment" />

</fragment>

    <!-- 📡 Cihaz Tara -->
    <fragment
        android:id="@+id/scanDevicesFragment"
        android:name="com.aqua.aqualight.ui.tabs.devices.ScanDevicesFragment"
        android:label="Scan devices"
        tools:layout="@layout/fragment_scan_devices" />
		
		<fragment
    android:id="@+id/deviceMenuFragment"
    android:name="com.aqua.aqualight.ui.tabs.devices.menu.DeviceMenuFragment"
    android:label="Device Menu"
    tools:layout="@layout/fragment_device_menu" />

    <!-- ⚙️ Settings Tab -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <!-- 🧍‍♂️ Edit Profile -->
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.profile.EditProfileFragment"
        android:label="Edit profile"
        tools:layout="@layout/fragment_edit_profile" />

    <!-- 👤 User Info -->
    <fragment
        android:id="@+id/userInfoFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.userinfo.UserInfoFragment"
        android:label="User info"
        tools:layout="@layout/fragment_user_info" />

    <!-- 🏠 User Address -->
    <fragment
        android:id="@+id/userAddressFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.userinfo.UserAddressFragment"
        android:label="User address"
        tools:layout="@layout/fragment_user_address" />

    <!-- 📡 Device Status -->
    <fragment
        android:id="@+id/deviceStatusFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.device.DeviceStatusFragment"
        android:label="Device status"
        tools:layout="@layout/fragment_device_status" />

    <!-- 🌐 Network -->
    <fragment
        android:id="@+id/networkFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.network.NetworkFragment"
        android:label="Network"
        tools:layout="@layout/fragment_network" />

    <!-- ⚙️ App Settings -->
    <fragment
        android:id="@+id/appSettingsFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.app.AppSettingsFragment"
        android:label="App settings"
        tools:layout="@layout/fragment_app_settings" />

    <!-- 📊 Usage -->
    <fragment
        android:id="@+id/usageFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.usage.UsageFragment"
        android:label="Usage"
        tools:layout="@layout/fragment_usage" />

    <!-- 🔒 Privacy -->
    <fragment
        android:id="@+id/privacyFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.privacy.PrivacyFragment"
        android:label="Privacy"
        tools:layout="@layout/fragment_privacy" />

    <!-- 💬 Feedback -->
    <fragment
        android:id="@+id/feedbackFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.feedback.FeedbackFragment"
        android:label="Feedback"
        tools:layout="@layout/fragment_feedback" />

    <!-- 🚪 Logout -->
    <fragment
        android:id="@+id/logoutFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.logout.LogoutFragment"
        android:label="Logout"
        tools:layout="@layout/fragment_logout">

        <!-- 🔀 Logout ekranından alt ekrana geçişler -->
        <action
            android:id="@+id/action_logoutFragment_to_changePasswordFragment"
            app:destination="@id/changePasswordFragment" />

        <action
            android:id="@+id/action_logoutFragment_to_changeEmailFragment"
            app:destination="@id/changeEmailFragment" />

        <action
            android:id="@+id/action_logoutFragment_to_securitySettingsFragment"
            app:destination="@id/securitySettingsFragment" />
    </fragment>

    <!-- 🔐 Change Password -->
    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.logout.ChangePasswordFragment"
        android:label="Change password"
        tools:layout="@layout/fragment_change_password" />

    <!-- 📧 Change Email -->
    <fragment
        android:id="@+id/changeEmailFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.logout.ChangeEmailFragment"
        android:label="Change email"
        tools:layout="@layout/fragment_change_email" />

    <!-- 🛡 Security Settings -->
    <fragment
        android:id="@+id/securitySettingsFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.logout.SecuritySettingsFragment"
        android:label="Security settings"
        tools:layout="@layout/fragment_security_settings" />
		
		<!-- 🔐 Re-Authenticate -->
<fragment
    android:id="@+id/reAuthenticateFragment"
    android:name="com.aqua.aqualight.ui.auth.security.ReAuthenticateFragment"
    android:label="ReAuthenticate"
    tools:layout="@layout/fragment_re_authenticate" />
	
    <!-- 🌍 Language Settings -->
    <fragment
        android:id="@+id/languageSettingsFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.app.LanguageSettingsFragment"
        android:label="Language"
        tools:layout="@layout/fragment_language_settings" />

    <!-- ℹ️ About App -->
    <fragment
        android:id="@+id/aboutAppFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.app.AboutAppFragment"
        android:label="About"
        tools:layout="@layout/fragment_about_app" />

    <fragment
        android:id="@+id/termsOfUseFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.app.TermsOfUseFragment"
        android:label="@string/terms_title" />

    <fragment
        android:id="@+id/openSourceLicensesFragment"
        android:name="com.aqua.aqualight.ui.tabs.settings.app.OpenSourceLicensesFragment"
        android:label="@string/open_source_title" />

</navigation>