<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_devices"
    app:startDestination="@id/devicesFragment">

    <fragment
        android:id="@+id/devicesFragment"
        android:name="com.aqua.aqualight.ui.tabs.devices.DevicesFragment"
        android:label="@string/screen_title_devices"
        tools:layout="@layout/fragment_devices" />

    <fragment
        android:id="@+id/deviceRouterFragment"
        android:name="com.aqua.aqualight.ui.tabs.devices.detail.DeviceRouterFragment"
        android:label="@string/screen_title_device"
        tools:layout="@layout/fragment_device_router">
        <argument
            android:name="deviceId"
            app:argType="long" />
        <argument
            android:name="deviceTitle"
            app:argType="string"
            android:defaultValue="" />
        <deepLink app:uri="aqualight://app/device/{deviceId}" />
        <deepLink app:uri="aqualight://app/device/{deviceId}?deviceTitle={deviceTitle}" />

        <action
            android:id="@+id/action_deviceRouterFragment_to_unsupportedDeviceFragment"
            app:destination="@id/unsupportedDeviceFragment"
            app:popUpTo="@id/deviceRouterFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/nav_slide_in_right"
            app:exitAnim="@anim/nav_slide_out_left"
            app:popEnterAnim="@anim/nav_slide_in_left"
            app:popExitAnim="@anim/nav_slide_out_right">
            <argument
                android:name="deviceId"
                app:argType="long"
                android:defaultValue="0L" />
            <argument
                android:name="deviceTitle"
                app:argType="string"
                android:defaultValue="" />
            <argument
                android:name="message"
                app:argType="string"
                android:defaultValue="" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/unsupportedDeviceFragment"
        android:name="com.aqua.aqualight.ui.tabs.devices.detail.UnsupportedDeviceFragment"
        android:label="@string/screen_title_unsupported_device"
        tools:layout="@layout/fragment_unsupported_device">
        <argument
            android:name="deviceTitle"
            app:argType="string"
            android:defaultValue="Device" />
        <argument
            android:name="message"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="deviceId"
            app:argType="long"
            android:defaultValue="0L" />
    </fragment>
</navigation>
