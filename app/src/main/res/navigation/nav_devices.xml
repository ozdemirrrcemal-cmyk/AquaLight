<?xml version='1.0' encoding='utf-8'?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/nav_devices" app:startDestination="@id/devicesFragment">
    <!-- 📟 Devices Tab -->
    <fragment android:id="@+id/devicesFragment" android:name="com.aqua.aqualight.ui.tabs.devices.DevicesFragment" android:label="@string/screen_title_devices" tools:layout="@layout/fragment_devices">
        <action android:id="@+id/action_devicesFragment_to_deviceAddFragment" app:destination="@id/deviceAddFragment" app:enterAnim="@anim/nav_slide_in_right" app:exitAnim="@anim/nav_slide_out_left" app:popEnterAnim="@anim/nav_slide_in_left" app:popExitAnim="@anim/nav_slide_out_right" />
    </fragment>

    <fragment android:id="@+id/deviceAddFragment" android:name="com.aqua.aqualight.ui.tabs.devices.add.DeviceAddFragment" android:label="@string/screen_title_add_device" tools:layout="@layout/fragment_device_add">
        <action android:id="@+id/action_deviceAddFragment_to_deviceSetupFragment" app:destination="@id/deviceSetupFragment" app:enterAnim="@anim/nav_slide_in_right" app:exitAnim="@anim/nav_slide_out_left" app:popEnterAnim="@anim/nav_slide_in_left" app:popExitAnim="@anim/nav_slide_out_right">
            <argument android:name="setupSsid" app:argType="string" android:defaultValue="" />
            <argument android:name="displayName" app:argType="string" android:defaultValue="Device" />
            <argument android:name="familyName" app:argType="string" android:defaultValue="Aqua device" />
            <argument android:name="productId" app:argType="string" android:defaultValue="" />
            <argument android:name="productKey" app:argType="string" android:defaultValue="" />
            <argument android:name="category" app:argType="string" android:defaultValue="" />
            <argument android:name="setupCode" app:argType="string" android:defaultValue="" />
            <argument android:name="setupShortId" app:argType="string" android:defaultValue="" />
        </action>
    </fragment>

    <fragment android:id="@+id/deviceSetupFragment" android:name="com.aqua.aqualight.ui.tabs.devices.setup.DeviceSetupFragment" android:label="@string/screen_title_device_setup" tools:layout="@layout/fragment_device_setup">
        <argument android:name="setupSsid" app:argType="string" android:defaultValue="" />
        <argument android:name="displayName" app:argType="string" android:defaultValue="Device" />
        <argument android:name="familyName" app:argType="string" android:defaultValue="Aqua device" />
        <argument android:name="productId" app:argType="string" android:defaultValue="" />
        <argument android:name="productKey" app:argType="string" android:defaultValue="" />
        <argument android:name="category" app:argType="string" android:defaultValue="" />
        <argument android:name="setupCode" app:argType="string" android:defaultValue="" />
        <argument android:name="setupShortId" app:argType="string" android:defaultValue="" />
    </fragment>

</navigation>
