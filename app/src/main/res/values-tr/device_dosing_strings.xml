    <string name="device_dosing_calibration_name_title">Dozaj kanalını tanımlayın</string>
    <string name="device_dosing_calibration_name_description">Bu kanalda kullandığınız besin veya katkının adını girin. AquaLight, dozaj planlarında ve uyarılarda bu adı gösterecek.</string>
    <string name="device_dosing_calibration_prime_title">Hortumu doldurun</string>
    <string name="device_dosing_calibration_prime_description">Emiş hortumunu sıvı kabına, çıkış hortumunu atık kabına yerleştirin. Basılı tutun; sıvı uçtan kesintisiz ve hava kabarcığı olmadan akınca bırakın.</string>
    <string name="device_dosing_calibration_run_title">5 saniyelik kalibrasyon dozunu toplayın</string>
    <string name="device_dosing_calibration_run_description">Çıkış hortumunu temiz, kuru ve düşük hacimli dereceli silindire yerleştirin. Başlattığınızda pompa tam 5 saniye çalışır; silindiri işlem bitene kadar hareket ettirmeyin.</string>
    <string name="device_dosing_calibration_measure_title">Gerçek hacmi girin</string>
    <string name="device_dosing_calibration_measure_description">Silindiri düz bir zemine koyun. Göz hizasında, menisküsün en alt noktasını 0,05 ml hassasiyetle okuyup girin.</string>
    <string name="device_dosing_calibration_verify_title">4,00 ml test dozunu verin</string>
    <string name="device_dosing_calibration_verify_description">Silindiri tamamen boşaltıp kurulayın ve çıkış hortumunu yeniden içine yerleştirin. AquaLight, yeni hesaplanan ayarla bir kez 4,00 ml verecek.</string>
    <string name="device_dosing_calibration_confirm_title">Test dozunu kontrol edin</string>
    <string name="device_dosing_calibration_confirm_description">Silindiri düz zeminde göz hizasında okuyun. Seviye 3,95–4,05 ml arasındaysa kaydedin; değilse yeniden kalibre edin. Kaydetmedikçe önceki kalibrasyon korunur.</string>
    <string name="device_dosing_calibration_name_illustration_description">Sıvı kabı ve ad etiketinin animasyonlu gösterimi.</string>
    <string name="device_dosing_calibration_prime_illustration_description">Sıvının kaptan peristaltik pompaya, hortumdan da atık kabına aktığını gösteren animasyon.</string>
    <string name="device_dosing_calibration_run_illustration_description">Sıvının pompa ve hortumdan dereceli silindire aktığını gösteren animasyon.</string>
    <string name="device_dosing_calibration_measure_illustration_description">Menisküsün en alt noktasının göz hizasında okunmasını gösteren dereceli silindir.</string>
    <string name="device_dosing_calibration_verify_illustration_description">Pompanın dereceli silindire 4 mililitre test dozu verdiğini gösteren animasyon.</string>
    <string name="device_dosing_calibration_confirm_illustration_description">Menisküsü 4 mililitre çizgisinde ve kabul aralığında gösteren dereceli silindir.</string>
