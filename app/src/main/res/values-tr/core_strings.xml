    <string name="permission_camera_photo_rationale_title">Fotoğraflar için kamera erişimi</string>
    <string name="permission_camera_photo_rationale_message">Akvaryum veya profil fotoğrafı çekmek için kamera erişimine izin verin. AquaLight kamerayı yalnızca fotoğraf çekimini başlattığınızda kullanır.</string>
    <string name="permission_camera_photo_settings_title">Kamera erişimini etkinleştirin</string>
    <string name="permission_camera_photo_settings_message">Kamera erişimi şu anda engellenmiş. Fotoğraf çekmeye devam etmek için AquaLight ayarlarını açıp Kamera iznini etkinleştirin.</string>
    <string name="permission_camera_qr_rationale_title">QR kurulumu için kamera erişimi</string>
    <string name="permission_camera_qr_rationale_message">AquaLight cihaz kurulum QR kodunu okuyabilsin diye kamera erişimine izin verin. Kamera kareleri yalnızca cihaz kurulumu için işlenir.</string>
    <string name="permission_camera_qr_settings_title">QR kamera erişimini etkinleştirin</string>
    <string name="permission_camera_qr_settings_message">Kamera erişimi şu anda engellenmiş. Cihaz QR kodunu taramak için AquaLight ayarlarını açıp Kamera iznini etkinleştirin.</string>
    <string name="permission_ble_scan_rationale_title">Yakındaki cihazlara erişim</string>
    <string name="permission_ble_scan_rationale_message">AquaLight kurulum sırasında uyumlu cihazları bulabilsin diye yakındaki cihazlara erişime izin verin.</string>
    <string name="permission_ble_scan_settings_title">Yakındaki cihazlara erişimi etkinleştirin</string>
    <string name="permission_ble_scan_settings_message">Yakındaki cihazlara erişim şu anda engellenmiş. Cihazları taramak için AquaLight ayarlarını açıp gerekli izni etkinleştirin.</string>
    <string name="permission_ble_connect_rationale_title">Bluetooth bağlantı erişimi</string>
    <string name="permission_ble_connect_rationale_message">AquaLight seçili cihazı güvenli biçimde yapılandırabilsin diye Bluetooth bağlantı erişimine izin verin.</string>
    <string name="permission_ble_connect_settings_title">Bluetooth bağlantı erişimini etkinleştirin</string>
    <string name="permission_ble_connect_settings_message">Bluetooth bağlantı erişimi şu anda engellenmiş. Kuruluma devam etmek için AquaLight ayarlarını açıp gerekli izni etkinleştirin.</string>
    <string name="permission_ble_provisioning_rationale_title">Yakındaki cihazlara erişim</string>
    <string name="permission_ble_provisioning_rationale_message">AquaLight cihazınızı bulup güvenli biçimde yapılandırabilsin diye yakındaki cihazlara erişime izin verin.</string>
    <string name="permission_ble_provisioning_settings_title">Yakındaki cihazlara erişimi etkinleştirin</string>
    <string name="permission_ble_provisioning_settings_message">Cihaz kurulumu için gereken izinler şu anda engellenmiş. AquaLight ayarlarını açıp Yakındaki cihazlar iznini etkinleştirin.</string>
    <string name="permission_wifi_ssid_rationale_title">Geçerli Wi-Fi ağı</string>
    <string name="permission_wifi_ssid_rationale_message">Android, telefonun bağlı olduğu Wi-Fi ağının adını okuyabilmek için konum izni ister. AquaLight bu izni yalnızca cihaz kurulumu sırasında ağ adını doldurmak için kullanır.</string>
    <string name="permission_wifi_ssid_settings_title">Wi-Fi ağı erişimini etkinleştirin</string>
    <string name="permission_wifi_ssid_settings_message">Geçerli Wi-Fi ağının adına erişim engellenmiş. Ağ adını otomatik doldurmak için AquaLight ayarlarını açıp Konum iznini etkinleştirin.</string>
    <string name="permission_notifications_rationale_title">Bildirimlere izin verin</string>
    <string name="permission_notifications_rationale_message">Akvaryum bakım hatırlatıcıları ve önemli cihaz uyarıları almak için bildirimlere izin verin. Bu ayarı daha sonra Uygulama Ayarları bölümünden değiştirebilirsiniz.</string>
    <string name="permission_notifications_settings_title">Bildirimleri etkinleştirin</string>
    <string name="permission_notifications_settings_message">Bildirimler Android tarafından engellenmiş. Bildirim ayarlarını açıp AquaLight bildirimlerine izin verin.</string>
    <string name="permission_precise_reminders_rationale_title">Zamanında bakım hatırlatıcıları</string>
    <string name="permission_precise_reminders_rationale_message">Uygulama kapalıyken bile bakım bildirimlerinin seçtiğiniz saatte gelebilmesi için AquaLight uygulamasının alarm ve hatırlatıcı planlamasına izin verin.</string>
    <string name="permission_precise_reminders_settings_title">Alarm ve hatırlatıcılara izin verin</string>
    <string name="permission_precise_reminders_settings_message">Android şu anda yalnızca yaklaşık hatırlatma zamanlamasına izin veriyor. Alarm ve hatırlatıcılar ayarını açıp AquaLight uygulamasının seçilen saatte bildirim göndermesine izin verin.</string>
    <string name="settings_notifications_subtitle_precise_reminders_blocked">Zamanında bakım bildirimleri için Alarm ve hatırlatıcılar erişimi gereklidir.</string>

