<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/aqua_card_surface" />
            <stroke
                android:width="@dimen/aqua_size_2"
                android:color="@color/aqua_card_accent" />
            <corners android:radius="@dimen/aqua_size_18" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/aqua_card_surface_pressed" />
            <stroke
                android:width="@dimen/aqua_size_1"
                android:color="@color/aqua_card_outline" />
            <corners android:radius="@dimen/aqua_size_18" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="@color/aqua_card_surface" />
            <stroke
                android:width="@dimen/aqua_size_1"
                android:color="@color/aqua_card_outline" />
            <corners android:radius="@dimen/aqua_size_18" />
        </shape>
    </item>
</selector>
