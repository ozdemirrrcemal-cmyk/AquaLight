<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SELECTED -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/light_accent_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/light_stroke_active" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- PRESSED -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/light_surface_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/light_accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- DEFAULT -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/light_bg_deep" />
            <stroke
                android:width="1dp"
                android:color="@color/light_stroke_soft" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</selector>