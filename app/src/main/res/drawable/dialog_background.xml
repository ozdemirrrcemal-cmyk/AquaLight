<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 🔹 Yarı saydam arka plan -->
    <solid android:color="@color/colorSurfaceTransparent" />

    <!-- 🔹 Köşeler -->
    <corners android:radius="24dp" />

    <!-- 🔹 İnce kenarlık -->
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />

    <padding
        android:left="20dp"
        android:top="16dp"
        android:right="20dp"
        android:bottom="20dp" />
</shape>