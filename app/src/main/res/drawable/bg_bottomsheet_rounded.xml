<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <solid android:color="@color/aqua_bottom_sheet_sheet_border" />
            <corners
                android:topLeftRadius="32dp"
                android:topRightRadius="32dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="0dp">
        <shape>
            <solid android:color="@color/aqua_bottom_sheet_surface" />
            <corners
                android:topLeftRadius="31dp"
                android:topRightRadius="31dp" />
        </shape>
    </item>

</layer-list>
