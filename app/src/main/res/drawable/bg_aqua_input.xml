<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/aqua_input_background" />
            <corners android:radius="@dimen/aqua_radius_value_16" />
            <stroke
                android:width="@dimen/aqua_size_value_1_5"
                android:color="@color/aqua_input_stroke_focused" />
            <padding
                android:left="0dp"
                android:top="0dp"
                android:right="0dp"
                android:bottom="0dp" />
        </shape>
    </item>

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/aqua_input_background" />
            <corners android:radius="@dimen/aqua_radius_value_16" />
            <stroke
                android:width="@dimen/aqua_size_value_1"
                android:color="@color/aqua_input_stroke_disabled" />
            <padding
                android:left="0dp"
                android:top="0dp"
                android:right="0dp"
                android:bottom="0dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/aqua_input_background" />
            <corners android:radius="@dimen/aqua_radius_value_16" />
            <stroke
                android:width="@dimen/aqua_size_value_1"
                android:color="@color/aqua_input_stroke_unfocused" />
            <padding
                android:left="0dp"
                android:top="0dp"
                android:right="0dp"
                android:bottom="0dp" />
        </shape>
    </item>

</selector>
