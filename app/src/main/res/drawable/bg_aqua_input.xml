<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/aqua_input_background" />
            <corners android:radius="@dimen/aqua_size_16" />
            <stroke
                android:width="@dimen/aqua_size_1_5"
                android:color="@color/aqua_input_stroke_focused" />
            <padding
                android:left="@dimen/aqua_size_0"
                android:top="@dimen/aqua_size_0"
                android:right="@dimen/aqua_size_0"
                android:bottom="@dimen/aqua_size_0" />
        </shape>
    </item>

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/aqua_input_background" />
            <corners android:radius="@dimen/aqua_size_16" />
            <stroke
                android:width="@dimen/aqua_size_1"
                android:color="@color/aqua_input_stroke_disabled" />
            <padding
                android:left="@dimen/aqua_size_0"
                android:top="@dimen/aqua_size_0"
                android:right="@dimen/aqua_size_0"
                android:bottom="@dimen/aqua_size_0" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/aqua_input_background" />
            <corners android:radius="@dimen/aqua_size_16" />
            <stroke
                android:width="@dimen/aqua_size_1"
                android:color="@color/aqua_input_stroke_unfocused" />
            <padding
                android:left="@dimen/aqua_size_0"
                android:top="@dimen/aqua_size_0"
                android:right="@dimen/aqua_size_0"
                android:bottom="@dimen/aqua_size_0" />
        </shape>
    </item>

</selector>
