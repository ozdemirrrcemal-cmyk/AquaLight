<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Arka plan (şeffaf bırakıyoruz) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- Altta ince çizgi (divider) -->
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="@dimen/aqua_size_value_1" />
            <!-- Divider rengi: istersen değiştir -->
            <solid android:color="@color/aqua_palette_3348556b" />
        </shape>
    </item>

</layer-list>