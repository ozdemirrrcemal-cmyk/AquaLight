<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Degrade dairesel arka plan -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/aqua_palette_hex_1e3a8a"
                android:centerColor="@color/aqua_palette_hex_0a192f"
                android:endColor="@color/aqua_palette_hex_112240" />
            <stroke
                android:width="@dimen/aqua_size_2"
                android:color="@color/aqua_palette_hex_33ffffff" />
        </shape>
    </item>

    <!-- Hafif iç parlama -->
    <item android:top="@dimen/aqua_size_2" android:left="@dimen/aqua_size_2" android:right="@dimen/aqua_size_2" android:bottom="@dimen/aqua_size_2">
        <shape android:shape="oval">
            <solid android:color="@color/aqua_palette_hex_10ffffff" />
        </shape>
    </item>
</layer-list>