<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Degrade dairesel arka plan -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/aqua_profile_background_start_color"
                android:centerColor="@color/aqua_profile_background_center_color"
                android:endColor="@color/aqua_profile_background_end_color" />
            <stroke
                android:width="@dimen/aqua_size_2"
                android:color="@color/aqua_profile_background_fill" />
        </shape>
    </item>

    <!-- Hafif iç parlama -->
    <item android:top="@dimen/aqua_size_2" android:left="@dimen/aqua_size_2" android:right="@dimen/aqua_size_2" android:bottom="@dimen/aqua_size_2">
        <shape android:shape="oval">
            <solid android:color="@color/aqua_profile_background_fill_variant_2" />
        </shape>
    </item>
</layer-list>