<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="data_key.bin" />
        <exclude domain="file" path="profile_photos/" />
        <exclude domain="file" path="tank_photos/" />
        <exclude domain="sharedpref" path="device_credentials.xml" />
        <exclude domain="sharedpref" path="account_deletion_recovery.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_file_pref__.xml" />
    </cloud-backup>

    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="data_key.bin" />
        <exclude domain="file" path="profile_photos/" />
        <exclude domain="file" path="tank_photos/" />
        <exclude domain="sharedpref" path="device_credentials.xml" />
        <exclude domain="sharedpref" path="account_deletion_recovery.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_file_pref__.xml" />
    </device-transfer>
</data-extraction-rules>
