<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.Aqua.Light"
        parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/light_text_primary</item>
    </style>

    <style name="TextAppearance.Aqua.Light.PageTitle"
        parent="TextAppearance.Aqua.Light">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/light_text_primary</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
    </style>

    <style name="TextAppearance.Aqua.Light.Subtitle"
        parent="TextAppearance.Aqua.Light">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/light_text_secondary</item>
    </style>

    <style name="TextAppearance.Aqua.Light.HeroValue"
        parent="TextAppearance.Aqua.Light">
        <item name="android:textSize">48sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/light_text_primary</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
    </style>

    <style name="TextAppearance.Aqua.Light.Value"
        parent="TextAppearance.Aqua.Light">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/light_text_primary</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
    </style>
	
	<style name="TextAppearance.Aqua.Light.SectionTitle"
    parent="TextAppearance.Aqua.Light">
    <item name="android:textSize">18sp</item>
    <item name="android:textColor">@color/light_text_primary</item>
    <item name="android:fontFamily">@font/inter_semibold</item>
    <item name="fontFamily">@font/inter_semibold</item>
</style>

</resources>