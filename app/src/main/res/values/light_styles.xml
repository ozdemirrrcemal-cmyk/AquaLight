<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.Aqua.Light.SheetTitle"
        parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/light_text_primary</item>
        <item name="android:textSize">21sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.Aqua.Light.SheetSubtitle"
        parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/light_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Widget.Aqua.Light.Button.Primary"
        parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/light_button_primary</item>
        <item name="android:textColor">@color/light_button_on_primary</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>
    <style name="Widget.Aqua.Light.Button.Secondary"
        parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/light_button_secondary</item>
        <item name="android:textColor">@color/light_button_on_secondary</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>
</resources>
