<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Aqua.Input.Layout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/aqua_color_transparent</item>
        <item name="boxStrokeColor">@color/aqua_input_stroke_color</item>
        <item name="boxStrokeWidth">@dimen/aqua_size_1</item>
        <item name="boxStrokeWidthFocused">@dimen/aqua_size_2</item>
        <item name="boxCornerRadiusTopStart">@dimen/aqua_size_14</item>
        <item name="boxCornerRadiusTopEnd">@dimen/aqua_size_14</item>
        <item name="boxCornerRadiusBottomStart">@dimen/aqua_size_14</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/aqua_size_14</item>
        <item name="hintTextColor">@color/aqua_input_hint_color</item>
        <item name="android:textColorHint">@color/aqua_input_hint_color</item>
        <item name="errorTextColor">@color/aqua_input_error</item>
        <item name="errorIconTint">@color/aqua_input_error</item>
        <item name="errorEnabled">true</item>
    </style>

    <style name="Widget.Aqua.Input.Layout.Multiline" parent="Widget.Aqua.Input.Layout">
        <item name="boxCornerRadiusTopStart">@dimen/aqua_size_14</item>
        <item name="boxCornerRadiusTopEnd">@dimen/aqua_size_14</item>
        <item name="boxCornerRadiusBottomStart">@dimen/aqua_size_14</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/aqua_size_14</item>
    </style>

<style name="Widget.Aqua.Input.Layout.Feedback" parent="Widget.Aqua.Input.Layout">
        <item name="boxCornerRadiusTopStart">@dimen/aqua_size_18</item>
        <item name="boxCornerRadiusTopEnd">@dimen/aqua_size_18</item>
        <item name="boxCornerRadiusBottomStart">@dimen/aqua_size_18</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/aqua_size_18</item>
        <item name="boxStrokeColor">@color/aqua_input_feedback_stroke_color</item>
    </style>

    <style name="Widget.Aqua.Input.Layout.Feedback.Multiline" parent="Widget.Aqua.Input.Layout.Feedback" />

    <style name="Widget.Aqua.Input.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/aqua_input_text_primary</item>
        <item name="android:textColorHint">@color/aqua_input_hint_unfocused</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textSize">@dimen/aqua_text_size_body_xlarge</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.Aqua.Input.EditText.Multiline" parent="Widget.Aqua.Input.EditText">
        <item name="android:gravity">top|start</item>
        <item name="android:minLines">4</item>
        <item name="android:maxLines">8</item>
    </style>

    <style name="Widget.Aqua.Input.PlainEditText" parent="@android:style/Widget.EditText">
        <item name="android:background">@drawable/bg_aqua_input</item>
        <item name="android:textColor">@color/aqua_input_text_primary</item>
        <item name="android:textColorHint">@color/aqua_input_hint_unfocused</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textSize">@dimen/aqua_text_size_body_xlarge</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">@dimen/aqua_size_54</item>
        <item name="android:paddingStart">@dimen/aqua_size_16</item>
        <item name="android:paddingEnd">@dimen/aqua_size_16</item>
        <item name="android:paddingTop">@dimen/aqua_size_12</item>
        <item name="android:paddingBottom">@dimen/aqua_size_12</item>
    </style>

    <style name="Widget.Aqua.Input.PlainEditText.Multiline" parent="Widget.Aqua.Input.PlainEditText">
        <item name="android:gravity">top|start</item>
        <item name="android:minLines">3</item>
        <item name="android:paddingTop">@dimen/aqua_size_14</item>
        <item name="android:paddingBottom">@dimen/aqua_size_14</item>
    </style>

    <style name="Widget.Aqua.Input.PlainEditText.Search" parent="Widget.Aqua.Input.PlainEditText">
        <item name="android:minHeight">@dimen/aqua_size_48</item>
        <item name="android:textSize">@dimen/aqua_text_size_body_large</item>
        <item name="android:paddingStart">@dimen/aqua_size_16</item>
        <item name="android:paddingEnd">@dimen/aqua_size_16</item>
        <item name="android:paddingTop">@dimen/aqua_size_10</item>
        <item name="android:paddingBottom">@dimen/aqua_size_10</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.Aqua.Input.PlainEditText.Compact" parent="Widget.Aqua.Input.PlainEditText">
        <item name="android:minHeight">@dimen/aqua_size_48</item>
        <item name="android:textSize">@dimen/aqua_text_size_body_large</item>
        <item name="android:paddingStart">@dimen/aqua_size_14</item>
        <item name="android:paddingEnd">@dimen/aqua_size_14</item>
        <item name="android:paddingTop">@dimen/aqua_size_10</item>
        <item name="android:paddingBottom">@dimen/aqua_size_10</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.Aqua.Input.PlainEditText.Embedded" parent="Widget.Aqua.Input.PlainEditText">
        <item name="android:background">@color/aqua_color_transparent</item>
        <item name="android:minHeight">@dimen/aqua_size_0</item>
        <item name="android:textSize">@dimen/aqua_text_size_body_xlarge</item>
        <item name="android:paddingStart">@dimen/aqua_size_0</item>
        <item name="android:paddingEnd">@dimen/aqua_size_0</item>
        <item name="android:paddingTop">@dimen/aqua_size_0</item>
        <item name="android:paddingBottom">@dimen/aqua_size_0</item>
        <item name="android:singleLine">true</item>
    </style>


    <!-- Existing one-off outlined input keeps Material defaults while joining the Aqua style contract. -->
    <style name="Widget.Aqua.Input.Layout.Inline" parent="Widget.Material3.TextInputLayout.OutlinedBox" />

</resources>
