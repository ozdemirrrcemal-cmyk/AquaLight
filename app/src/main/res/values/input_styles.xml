<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Aqua.Input.Layout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/aqua_input_background</item>
        <item name="boxStrokeColor">@color/aqua_input_stroke_color</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/aqua_input_hint_color</item>
        <item name="errorTextColor">@color/aqua_input_error</item>
        <item name="errorIconTint">@color/aqua_input_error</item>
        <item name="errorEnabled">true</item>
    </style>

    <style name="Widget.Aqua.Input.Layout.Multiline" parent="Widget.Aqua.Input.Layout">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <style name="Widget.Aqua.Input.Layout.Search" parent="Widget.Aqua.Input.Layout">
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
    </style>

    <style name="Widget.Aqua.Input.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/aqua_input_text_primary</item>
        <item name="android:textColorHint">@color/aqua_input_hint_unfocused</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textSize">16sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Widget.Aqua.Input.EditText.Multiline" parent="Widget.Aqua.Input.EditText">
        <item name="android:gravity">top|start</item>
        <item name="android:minLines">4</item>
        <item name="android:maxLines">8</item>
    </style>

    <!-- Existing auth input styles moved here from styles.xml. -->
<!-- 🔳 TextInputLayout stili -->
<style name="AuthTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
    <!-- Çerçeve (border) -->
    <item name="boxStrokeColor">@color/auth_input_stroke_color</item>
    <item name="boxStrokeWidth">1dp</item>
    <item name="boxStrokeWidthFocused">2dp</item>

    <!-- Kenar yuvarlaklık -->
    <item name="boxCornerRadiusTopStart">12dp</item>
    <item name="boxCornerRadiusTopEnd">12dp</item>
    <item name="boxCornerRadiusBottomStart">12dp</item>
    <item name="boxCornerRadiusBottomEnd">12dp</item>

    <!-- Hint rengi -->
    <item name="hintTextColor">@color/auth_hint_color</item>
    <item name="android:textColorHint">@color/auth_hint_color</item>

    <!-- İç yüzey rengi (şeffaf olsun) -->
    <item name="boxBackgroundColor">@android:color/transparent</item>
</style>

<!-- ✏️ TextInputEditText stili -->
<style name="AuthEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
    <item name="android:textColor">@color/auth_text_color</item>
    <item name="colorControlActivated">@color/auth_focus_color</item> <!-- ✅ Güvenli -->
</style>

</resources>
