<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AquaBottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowBackground">@color/aqua_color_transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:navigationBarColor">@color/aqua_color_transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="enableEdgeToEdge">true</item>
        <item name="bottomSheetStyle">@style/Widget.Aqua.BottomSheet.Modal</item>
    </style>



    <style name="Widget.Aqua.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottomsheet_rounded</item>
        <item name="backgroundTint">@null</item>
        <item name="shapeAppearance">@null</item>
        <item name="shapeAppearanceOverlay">@null</item>
        <item name="paddingBottomSystemWindowInsets">true</item>
    </style>

    <style name="ShapeAppearanceOverlay.Aqua.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/aqua_size_32</item>
        <item name="cornerSizeTopRight">@dimen/aqua_size_32</item>
        <item name="cornerSizeBottomLeft">@dimen/aqua_size_0</item>
        <item name="cornerSizeBottomRight">@dimen/aqua_size_0</item>
    </style>

    <style name="Widget.Aqua.BottomSheet.Root" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_bottomsheet_rounded</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/aqua_size_22</item>
        <item name="android:paddingTop">@dimen/aqua_size_14</item>
        <item name="android:paddingEnd">@dimen/aqua_size_22</item>
        <item name="android:paddingBottom">@dimen/aqua_size_24</item>
    </style>

    <style name="Widget.Aqua.BottomSheet.Handle" parent="">
        <item name="android:layout_width">@dimen/aqua_size_42</item>
        <item name="android:layout_height">@dimen/aqua_size_4</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:background">@drawable/bg_bottomsheet_handle</item>
    </style>

    <style name="Widget.Aqua.BottomSheet.PermissionIconSurface" parent="">
        <item name="android:layout_width">@dimen/aqua_size_64</item>
        <item name="android:layout_height">@dimen/aqua_size_64</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:background">@drawable/bg_permission_icon_surface</item>
    </style>

    <style name="Widget.Aqua.BottomSheet.PermissionIcon" parent="">
        <item name="android:layout_width">@dimen/aqua_size_30</item>
        <item name="android:layout_height">@dimen/aqua_size_30</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Widget.Aqua.BottomSheet.PermissionStatusBadge" parent="">
        <item name="android:layout_width">@dimen/aqua_size_22</item>
        <item name="android:layout_height">@dimen/aqua_size_22</item>
        <item name="android:layout_gravity">end|bottom</item>
        <item name="android:background">@drawable/bg_permission_icon_badge</item>
        <item name="android:padding">@dimen/aqua_size_5</item>
    </style>

    <style name="Widget.Aqua.BottomSheet.PermissionStatusIcon" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="TextAppearance.Aqua.BottomSheet.Title"
        parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/aqua_bottom_sheet_text_primary</item>
        <item name="android:textSize">@dimen/aqua_text_size_section_title</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Aqua.BottomSheet.SectionTitle"
        parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/aqua_bottom_sheet_text_primary</item>
        <item name="android:textSize">@dimen/aqua_text_size_section_title</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Aqua.BottomSheet.Subtitle"
        parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/aqua_bottom_sheet_text_secondary</item>
        <item name="android:textSize">@dimen/aqua_text_size_body</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Aqua.BottomSheet.RowTitle"
        parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/aqua_bottom_sheet_text_primary</item>
        <item name="android:textSize">@dimen/aqua_text_size_body_xlarge</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Aqua.BottomSheet.RowSubtitle"
        parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/aqua_bottom_sheet_text_secondary</item>
        <item name="android:textSize">@dimen/aqua_text_size_body_small</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.Aqua.BottomSheet.Button.Primary"
        parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/aqua_bottom_sheet_primary</item>
        <item name="android:textColor">@color/aqua_bottom_sheet_on_primary</item>
        <item name="cornerRadius">@dimen/aqua_size_18</item>
        <item name="android:minHeight">@dimen/aqua_size_52</item>
        <item name="android:insetTop">@dimen/aqua_size_0</item>
        <item name="android:insetBottom">@dimen/aqua_size_0</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>

    <style name="Widget.Aqua.BottomSheet.Button.Neutral"
        parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/aqua_bottom_sheet_neutral</item>
        <item name="android:textColor">@color/aqua_bottom_sheet_on_neutral</item>
        <item name="cornerRadius">@dimen/aqua_size_18</item>
        <item name="android:minHeight">@dimen/aqua_size_52</item>
        <item name="android:insetTop">@dimen/aqua_size_0</item>
        <item name="android:insetBottom">@dimen/aqua_size_0</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

    <style name="Widget.Aqua.BottomSheet.Button.Danger"
        parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/aqua_bottom_sheet_danger_container</item>
        <item name="android:textColor">@color/aqua_bottom_sheet_danger</item>
        <item name="strokeColor">@color/aqua_bottom_sheet_danger_outline</item>
        <item name="strokeWidth">@dimen/aqua_size_1</item>
        <item name="cornerRadius">@dimen/aqua_size_18</item>
        <item name="android:minHeight">@dimen/aqua_size_52</item>
        <item name="android:insetTop">@dimen/aqua_size_0</item>
        <item name="android:insetBottom">@dimen/aqua_size_0</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>


    <style name="Widget.Aqua.BottomSheet.Button.EditorSave" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">@dimen/aqua_size_0</item>
        <item name="android:insetBottom">@dimen/aqua_size_0</item>
        <item name="android:minWidth">@dimen/aqua_size_0</item>
        <item name="android:minHeight">@dimen/aqua_size_0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/aqua_content_on_dark</item>
        <item name="android:textSize">@dimen/aqua_text_size_body</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/aqua_accent_primary</item>
        <item name="cornerRadius">@dimen/aqua_size_16</item>
    </style>


    <style name="Widget.Aqua.BottomSheet.Button.Text" parent="Widget.Material3.Button.TextButton" />

</resources>