<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Aqua.Card.Device.Update" parent="Widget.Aqua.Card.Device.Section">
        <item name="cardBackgroundColor">@color/aqua_surface_action</item>
        <item name="cardCornerRadius">@dimen/aqua_device_settings_update_card_radius</item>
        <item name="cardElevation">@dimen/aqua_size_0</item>
        <item name="rippleColor">@color/aqua_card_device_ripple</item>
        <item name="strokeColor">@color/aqua_accent_primary</item>
        <item name="strokeWidth">@dimen/aqua_device_settings_update_card_stroke_width</item>
    </style>

    <style name="TextAppearance.Aqua.DeviceSettings.UpdateTitle"
        parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/aqua_content_primary</item>
        <item name="android:textSize">@dimen/aqua_text_size_body</item>
    </style>

    <style name="TextAppearance.Aqua.DeviceSettings.UpdateDescription"
        parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/aqua_content_secondary</item>
        <item name="android:textSize">@dimen/aqua_text_size_caption_plus</item>
    </style>

    <style name="TextAppearance.Aqua.DeviceSettings.UpdateMeta"
        parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/aqua_content_secondary</item>
        <item name="android:textSize">@dimen/aqua_text_size_caption</item>
    </style>

    <style name="TextAppearance.Aqua.DeviceSettings.UpdateAction"
        parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/device_settings_update_check_action_text</item>
        <item name="android:textSize">@dimen/aqua_text_size_caption_plus</item>
    </style>

    <style name="Widget.Aqua.DeviceSettings.UpdateCheckAction"
        parent="Widget.AppCompat.TextView">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">@dimen/aqua_device_settings_update_action_min_height</item>
        <item name="android:paddingStart">@dimen/aqua_device_settings_update_action_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/aqua_device_settings_update_action_padding_horizontal</item>
        <item name="android:textAppearance">@style/TextAppearance.Aqua.DeviceSettings.UpdateAction</item>
    </style>
</resources>
