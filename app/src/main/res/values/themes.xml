<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Renk bağlantıları -->
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="colorOnPrimary">?attr/colorOnPrimary</item>

        <item name="colorSecondary">?attr/colorSecondary</item>
        <item name="colorOnSecondary">?attr/colorOnSecondary</item>

        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="colorSurface">?attr/colorSurface</item>
        <item name="colorOnSurface">?attr/colorOnSurface</item>

        <!-- Bar renkleri -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>

        <!-- Açık veya koyu mod ikonları -->
        <item name="android:windowLightStatusBar">?attr/colorOnSurface</item>
        <item name="android:windowLightNavigationBar">?attr/colorOnSurface</item>

        <!-- ActionBar kapalı -->
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

    </style>

    <!-- Splash metin stilleri -->
    <style name="SplashTitleText">
        <item name="android:textColor">@color/md_theme_dark_onPrimary</item>
        <item name="android:textSize">32sp</item>
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SplashSubtitleText">
        <item name="android:textColor">#AAB6C1</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/raleway_medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:gravity">center</item>
    </style>

</resources>