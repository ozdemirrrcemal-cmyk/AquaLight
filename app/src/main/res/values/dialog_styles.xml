<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowEnterAnimation">@anim/dialog_scale_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_fade_out</item>
    </style>

    <style name="Widget.Aqua.Dialog" parent="" />

    <style name="Widget.Aqua.Dialog.Root" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_aqua_dialog_surface</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/aqua_space_value_24</item>
        <item name="android:paddingTop">@dimen/aqua_space_value_24</item>
        <item name="android:paddingEnd">@dimen/aqua_space_value_24</item>
        <item name="android:paddingBottom">@dimen/aqua_space_value_24</item>
    </style>

    <style name="Widget.Aqua.Dialog.IconSurface" parent="">
        <item name="android:layout_width">@dimen/aqua_size_value_64</item>
        <item name="android:layout_height">@dimen/aqua_size_value_64</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginBottom">@dimen/aqua_space_value_14</item>
        <item name="android:background">@drawable/bg_aqua_dialog_icon_surface</item>
        <item name="android:padding">@dimen/aqua_space_value_14</item>
    </style>

    <style name="TextAppearance.Aqua.Dialog.Title"
        parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/aqua_dialog_text_primary</item>
        <item name="android:textSize">@dimen/aqua_text_size_title_large</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Aqua.Dialog.Message"
        parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/aqua_dialog_text_secondary</item>
        <item name="android:textSize">@dimen/aqua_text_size_body</item>
        <item name="android:lineSpacingExtra">@dimen/aqua_space_value_2</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.Aqua.Dialog.Button" parent="" />

    <style name="Widget.Aqua.Dialog.Button.Primary"
        parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/aqua_dialog_primary</item>
        <item name="android:textColor">@color/aqua_dialog_on_primary</item>
        <item name="cornerRadius">@dimen/aqua_radius_value_22</item>
        <item name="android:minHeight">@dimen/aqua_size_value_52</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>

    <style name="Widget.Aqua.Dialog.Button.Neutral"
        parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/aqua_dialog_neutral</item>
        <item name="android:textColor">@color/aqua_dialog_on_neutral</item>
        <item name="cornerRadius">@dimen/aqua_radius_value_22</item>
        <item name="android:minHeight">@dimen/aqua_size_value_52</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>

    <style name="Widget.Aqua.Dialog.Button.Danger"
        parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/aqua_dialog_danger_container</item>
        <item name="android:textColor">@color/aqua_dialog_danger</item>
        <item name="strokeColor">@color/aqua_dialog_danger_outline</item>
        <item name="strokeWidth">@dimen/aqua_stroke_value_1</item>
        <item name="cornerRadius">@dimen/aqua_radius_value_22</item>
        <item name="android:minHeight">@dimen/aqua_size_value_52</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>

</resources>
