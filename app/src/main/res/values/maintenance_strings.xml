    <!-- Smart care rule messages -->
    <string name="maintenance_smart_rule_initial_setup_check_message">Check that the filter is running, equipment is installed correctly, and water circulation is stable.</string>
    <string name="maintenance_smart_rule_check_light_duration_message">During the early setup phase, keeping the light period around 6 hours can help reduce algae risk.</string>
    <string name="maintenance_smart_rule_co2_check_message">Check CO₂ timing, drop checker color, and livestock behavior.</string>
    <string name="maintenance_smart_rule_early_water_change_message">Active soil can release excess nutrients during the first days. A water change helps reduce algae risk.</string>
    <string name="maintenance_smart_rule_startup_water_change_message">Regular water changes during the first weeks help stabilize the aquarium and reduce excess nutrients.</string>
    <string name="maintenance_smart_rule_plant_adaptation_check_message">Check for melting leaves, weak stems, or newly planted sections that may need adjustment.</string>
    <string name="maintenance_smart_rule_algae_check_message">Check glass, hardscape, and plant leaves for early algae signs.</string>
    <string name="maintenance_smart_rule_review_fertilizer_plan_message">Add your fertilizer product to improve automatic dosing recommendations.</string>
    <string name="maintenance_smart_rule_fertilizer_check_message">Start carefully with reduced dosing and adjust based on plant response and algae signs.</string>
    <string name="maintenance_smart_rule_water_test_before_livestock_message">Before adding livestock, check that the aquarium is stable and no ammonia or nitrite is detected.</string>
    <string name="maintenance_smart_rule_livestock_readiness_check_message">If water parameters are stable, you can start planning suitable cleanup crew or livestock gradually.</string>
    <string name="maintenance_smart_rule_fish_addition_check_message">Add fish only if the tank is stable. Start with a small number and avoid overstocking.</string>
    <string name="maintenance_smart_rule_adjust_light_period_message">If plant growth is stable and algae is under control, you can gradually increase the light period.</string>
    <string name="maintenance_smart_rule_first_trimming_check_message">Check fast-growing plants and trim unhealthy or overgrown sections if needed.</string>
    <string name="maintenance_smart_rule_weekly_water_change_message">Continue weekly water changes while the aquarium matures.</string>
    <string name="maintenance_smart_rule_filter_flow_check_message">Check filter flow and make sure circulation is still strong and stable.</string>
    <string name="maintenance_smart_rule_shrimp_stability_check_message">Shrimp are sensitive to unstable water parameters. Check behavior and avoid sudden changes.</string>
    <string name="maintenance_smart_rule_feeding_review_message">Review feeding amount and remove excess food if needed.</string>
    <string name="maintenance_smart_rule_startup_phase_complete_message">Your aquarium has reached the end of the startup phase. Continue with a regular maintenance routine.</string>
    <string name="maintenance_smart_rule_weekly_water_change_mature_message">Perform a regular water change to keep water quality stable.</string>
    <string name="maintenance_smart_rule_plant_trimming_check_message">Check plant growth and trim overgrown or unhealthy sections if needed.</string>
    <string name="maintenance_smart_rule_filter_maintenance_check_message">Check filter flow and clean mechanical media only if the flow is reduced.</string>
    <string name="maintenance_smart_rule_co2_system_check_message">Check CO₂ timing, bubble rate, drop checker color, and livestock behavior.</string>
    <string name="maintenance_smart_rule_livestock_health_check_message">Check appetite, behavior, breathing, and visible signs of stress.</string>

