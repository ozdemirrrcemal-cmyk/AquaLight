<resources>

    <!-- Filled (temel) -->
    <style name="RedButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">#DB4437</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">15dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="BlackButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@android:color/black</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">15dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Outlined -->
    <style name="WhiteButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/white</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="cornerRadius">15dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:elevation">0dp</item>
    </style>
<!-- 🔹 Bottom nav: aktif indicator -->
<style name="Widget.Aqua.BottomNav.ActiveIndicator" parent="">  
    <!-- Boyut -->
    <item name="android:width">60dp</item>
    <item name="android:height">32dp</item>

    <!-- Arka plan rengi -->
    <item name="android:color">?attr/colorSecondaryContainer</item>

    <!-- Köşeleri yuvarla (pill) -->
    <item name="shapeAppearance">@style/ShapeAppearance.Aqua.BottomNavIndicator</item>
</style>

<!-- 🔹 Bottom nav indicator'ın şekli (oval/pill) -->
<style name="ShapeAppearance.Aqua.BottomNavIndicator"
    parent="@style/ShapeAppearance.Material3.Corner.None">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">16dp</item> <!-- 32dp yüksekliğin yarısı -->
</style>

<style name="TextAppearance.Aqua.BottomNav" parent="TextAppearance.MaterialComponents.Body2">
    <item name="android:textSize">12sp</item>
</style>

<style name="Widget.Aqua.BottomNav"
    parent="Widget.MaterialComponents.BottomNavigationView">

    <!-- 🔹 Toplam yüksekliği aşağı çeken kısım -->
    <item name="android:minHeight">56dp</item>   <!-- 48–56 arası mantıklı -->
    <item name="android:paddingTop">2dp</item>
    <item name="android:paddingBottom">5dp</item>

    <!-- Yazıları da biraz küçültelim -->
    <item name="itemTextAppearanceActive">@style/TextAppearance.Aqua.BottomNav</item>
    <item name="itemTextAppearanceInactive">@style/TextAppearance.Aqua.BottomNav</item>
</style>
<!-- 🔹 Edit profile başlık textAppearance -->
<style name="TextAppearance.Aqua.EditProfileTitle"
    parent="TextAppearance.Material3.TitleLarge">
    <item name="fontFamily">@font/inter_semibold</item>
    <item name="android:fontFamily">@font/inter_semibold</item>
    <item name="android:textColor">@android:color/white</item>
    <item name="android:textSize">20sp</item>
</style>


<!-- 🔹 Step başlık textAppearance -->
<style name="TextAppearance.Aqua.StepTitle"
    parent="TextAppearance.Material3.TitleSmall">
    <item name="fontFamily">@font/inter_regular</item>
    <item name="android:fontFamily">@font/inter_regular</item>
    <item name="android:textColor">@android:color/white</item>
    <item name="android:textSize">18sp</item>
    <item name="android:lineSpacingExtra">2dp</item>
</style>

<!-- 🔹 Primary (mavi) buton – eski inline görünüme uygun -->
<style name="Widget.Aqua.PrimaryButton" parent="Widget.Material3.Button">
    <item name="android:textColor">@android:color/white</item>
    <item name="cornerRadius">12dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:paddingTop">12dp</item>
    <item name="android:paddingBottom">12dp</item>
    <item name="backgroundTint">@color/aqua_button_blue</item>
</style>
<style name="Widget.Aqua.DangerButton" parent="@style/Widget.Aqua.PrimaryButton">
    <item name="backgroundTint">@color/aqua_button_red</item>
</style>

<!-- Feedback üst açıklama -->
<style name="TextAppearance.Aqua.Feedback.SubInfo"
    parent="TextAppearance.Material3.BodyMedium">
    <item name="fontFamily">@font/inter_regular</item>
    <item name="android:fontFamily">@font/inter_regular</item>
    <item name="android:textColor">@color/aqua_card_text_secondary</item>
    <item name="android:textSize">14sp</item>
</style>

<!-- Feedback alt bilgi -->
<style name="TextAppearance.Aqua.Feedback.Footer"
    parent="TextAppearance.Material3.BodySmall">
    <item name="fontFamily">@font/inter_regular</item>
    <item name="android:fontFamily">@font/inter_regular</item>
    <item name="android:textColor">@color/aqua_card_text_secondary</item>
    <item name="android:textSize">13sp</item>
</style>

<!-- Feedback success mesajı -->
<style name="TextAppearance.Aqua.Feedback.Success"
    parent="TextAppearance.Material3.BodyMedium">
    <item name="fontFamily">@font/inter_medium</item>
    <item name="android:fontFamily">@font/inter_medium</item>
    <item name="android:textColor">#64FFDA</item>
    <item name="android:textSize">15sp</item>
</style>

<!-- ⚙️ Ayarlar ekranı RadioButton stili -->
<style name="Widget.Aqua.SettingsRadio"
    parent="Widget.Material3.CompoundButton.RadioButton">

    <!-- Seçili/boş renkler: mevcut tema rengini kullanıyoruz -->
    <item name="android:buttonTint">?attr/colorPrimary</item>

    <!-- Arkaplanı şeffaf tut -->
    <item name="android:background">@android:color/transparent</item>

    <!-- Fazla boşluk olmasın diye min boyutları küçült -->
    <item name="android:minWidth">0dp</item>
    <item name="android:minHeight">0dp</item>
</style>


<style name="TextAppearance.Aqua.Body" parent="TextAppearance.Material3.BodyMedium" />

<style name="TextAppearance.Aqua.BodyBold" parent="TextAppearance.Material3.BodyLarge">
    <item name="android:textStyle">bold</item>
</style>

<style name="TextAppearance.Aqua.Caption" parent="TextAppearance.Material3.LabelMedium" />

  <style name="Aqua" />

<style name="Aqua.DeviceMenuRow" parent="Aqua">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">48dp</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:paddingLeft">12dp</item>
    <item name="android:paddingRight">12dp</item>
    <item name="android:background">?attr/selectableItemBackground</item>
    <!-- 🔹 Lint’in istediği satır -->
    <item name="android:orientation">horizontal</item>
</style>

<style name="ShapeAppearanceOverlay.Aqua.DockedActivityButton" parent="">
  <item name="cornerFamily">rounded</item>
  <item name="cornerSizeTopLeft">29dp</item>
  <item name="cornerSizeBottomLeft">29dp</item>
  <item name="cornerSizeTopRight">0dp</item>
  <item name="cornerSizeBottomRight">0dp</item>
</style>

</resources>