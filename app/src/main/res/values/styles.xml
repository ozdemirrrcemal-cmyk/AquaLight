<resources>

    <!-- Filled (temel) -->
    <style name="RedButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">#DB4437</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">15dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="BlackButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@android:color/black</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">15dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Outlined -->
    <style name="WhiteButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/white</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="cornerRadius">15dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:elevation">0dp</item>
    </style>
	
	<!-- 🎨 AppDialogTheme : Her dialog bu temayı kullanacak -->
   <style name="AppDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
    <!-- Arka plan şekli -->
        <item name="android:background">@null</item>

    <!-- Köşeler -->
    <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Material3.Corner.Medium</item>

    <!-- Yazılar -->
    <item name="android:textColorPrimary">?attr/colorOnSurface</item>
    <item name="android:fontFamily">@font/poppins_medium</item>

    <!-- Animasyonlar -->
    <item name="android:windowEnterAnimation">@anim/dialog_scale_in</item>
    <item name="android:windowExitAnimation">@anim/dialog_fade_out</item>

    <!-- Gölge -->
    <item name="android:elevation">12dp</item>
   </style>

</resources>