<resources>

<!-- 🔹 Bottom nav: aktif indicator -->
<style name="Widget.Aqua.BottomNav.ActiveIndicator" parent="">  
    <!-- Boyut -->
    <item name="android:width">@dimen/aqua_size_60</item>
    <item name="android:height">@dimen/aqua_size_32</item>

    <!-- Arka plan rengi -->
    <item name="android:color">?attr/aquaBottomNavActiveIndicator</item>

    <!-- Köşeleri yuvarla (pill) -->
    <item name="shapeAppearance">@style/ShapeAppearance.Aqua.BottomNavIndicator</item>
</style>

<!-- 🔹 Bottom nav indicator'ın şekli (oval/pill) -->
<style name="ShapeAppearance.Aqua.BottomNavIndicator"
    parent="@style/ShapeAppearance.Material3.Corner.None">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">@dimen/aqua_size_16</item> <!-- Half the indicator height. -->
</style>

<style name="TextAppearance.Aqua.BottomNav" parent="TextAppearance.MaterialComponents.Body2">
    <item name="android:textSize">@dimen/aqua_text_size_caption</item>
</style>

<style name="Widget.Aqua.BottomNav"
    parent="Widget.MaterialComponents.BottomNavigationView">

    <!-- Keep the shared background exact; Material elevation would apply a tonal overlay. -->
    <item name="elevation">@dimen/aqua_size_0</item>

    <!-- 🔹 Toplam yüksekliği aşağı çeken kısım -->
    <item name="android:minHeight">@dimen/aqua_size_56</item>   <!-- 48–56 arası mantıklı -->
    <item name="android:paddingTop">@dimen/aqua_size_2</item>
    <item name="android:paddingBottom">@dimen/aqua_size_5</item>

    <!-- Yazıları da biraz küçültelim -->
    <item name="itemTextAppearanceActive">@style/TextAppearance.Aqua.BottomNav</item>
    <item name="itemTextAppearanceInactive">@style/TextAppearance.Aqua.BottomNav</item>
</style>
<!-- 🔹 Edit profile başlık textAppearance -->
<style name="TextAppearance.Aqua.EditProfileTitle"
    parent="TextAppearance.Material3.TitleLarge">
    <item name="fontFamily">@font/inter_semibold</item>
    <item name="android:fontFamily">@font/inter_semibold</item>
    <item name="android:textColor">@color/aqua_content_on_dark</item>
    <item name="android:textSize">@dimen/aqua_text_size_toolbar_title</item>
</style>


<!-- 🔹 Step başlık textAppearance -->
<!-- 🔹 Primary (mavi) buton – eski inline görünüme uygun -->

<!-- Feedback üst açıklama -->
<style name="TextAppearance.Aqua.Feedback.SubInfo"
    parent="TextAppearance.Material3.BodyMedium">
    <item name="fontFamily">@font/inter_regular</item>
    <item name="android:fontFamily">@font/inter_regular</item>
    <item name="android:textColor">@color/aqua_card_text_secondary</item>
    <item name="android:textSize">@dimen/aqua_text_size_body</item>
</style>

<!-- Feedback alt bilgi -->
<style name="TextAppearance.Aqua.Feedback.Footer"
    parent="TextAppearance.Material3.BodySmall">
    <item name="fontFamily">@font/inter_regular</item>
    <item name="android:fontFamily">@font/inter_regular</item>
    <item name="android:textColor">@color/aqua_card_text_secondary</item>
    <item name="android:textSize">@dimen/aqua_text_size_body_small</item>
</style>

<style name="Widget.Aqua.Auth.LegalLink" parent="Widget.AppCompat.TextView">
    <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    <item name="android:clickable">true</item>
    <item name="android:ellipsize">end</item>
    <item name="android:focusable">true</item>
    <item name="android:fontFamily">@font/inter_regular</item>
    <item name="android:gravity">center</item>
    <item name="android:includeFontPadding">false</item>
    <item name="android:maxLines">1</item>
    <item name="android:minHeight">@dimen/aqua_size_48</item>
    <item name="android:paddingStart">@dimen/aqua_size_8</item>
    <item name="android:paddingEnd">@dimen/aqua_size_8</item>
    <item name="android:textColor">@color/aqua_accent_aqua</item>
    <item name="android:textSize">@dimen/aqua_text_size_body_small</item>
    <item name="autoSizeMaxTextSize">@dimen/aqua_text_size_body_small</item>
    <item name="autoSizeMinTextSize">@dimen/aqua_text_size_caption</item>
    <item name="autoSizeStepGranularity">@dimen/aqua_text_size_autosize_step</item>
    <item name="autoSizeTextType">uniform</item>
</style>

<!-- Feedback success mesajı -->
<!-- ⚙️ Ayarlar ekranı RadioButton stili -->
<style name="Widget.Aqua.SettingsRadio"
    parent="Widget.Material3.CompoundButton.RadioButton">

    <!-- Seçili/boş renkler: mevcut tema rengini kullanıyoruz -->
    <item name="android:buttonTint">?attr/colorPrimary</item>

    <!-- Arkaplanı şeffaf tut -->
    <item name="android:background">@color/aqua_color_transparent</item>

    <!-- Fazla boşluk olmasın diye min boyutları küçült -->
    <item name="android:minWidth">@dimen/aqua_size_0</item>
    <item name="android:minHeight">@dimen/aqua_size_0</item>
</style>



<style name="ShapeAppearanceOverlay.Aqua.DockedActivityButton" parent="">
  <item name="cornerFamily">rounded</item>
  <item name="cornerSizeTopLeft">@dimen/aqua_size_29</item>
  <item name="cornerSizeBottomLeft">@dimen/aqua_size_29</item>
  <item name="cornerSizeTopRight">@dimen/aqua_size_0</item>
  <item name="cornerSizeBottomRight">@dimen/aqua_size_0</item>
</style>

</resources>
