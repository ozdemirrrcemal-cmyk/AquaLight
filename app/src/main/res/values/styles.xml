<resources>

    <!-- Filled (temel) -->
    <style name="RedButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">#DB4437</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">15dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="BlackButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@android:color/black</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">15dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Outlined -->
    <style name="WhiteButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/white</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="cornerRadius">15dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:elevation">0dp</item>
    </style>
	
<!-- 🎨 AppDialogTheme : Her dialog bu temayı kullanacak -->
<style name="AppDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">

    <!-- 🔹 Tamamen şeffaf pencere ve alt katmanı kaldır -->
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:background">@null</item>

    <!-- 🔹 Köşeler -->
    <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Material3.Corner.Medium</item>

    <!-- 🔹 Yazılar -->
    <item name="android:textColorPrimary">?attr/colorOnSurface</item>
    <item name="android:fontFamily">@font/poppins_medium</item>

    <!-- 🔹 Animasyonlar -->
    <item name="android:windowEnterAnimation">@anim/dialog_scale_in</item>
    <item name="android:windowExitAnimation">@anim/dialog_fade_out</item>

    <!-- 🔹 Gölge -->
    <item name="android:elevation">12dp</item>

</style>

<!-- 🔳 TextInputLayout stili -->
<style name="AuthTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
    <!-- Çerçeve (border) -->
    <item name="boxStrokeColor">@color/auth_input_stroke_color</item>
    <item name="boxStrokeWidth">1dp</item>
    <item name="boxStrokeWidthFocused">2dp</item>

    <!-- Kenar yuvarlaklık -->
    <item name="boxCornerRadiusTopStart">12dp</item>
    <item name="boxCornerRadiusTopEnd">12dp</item>
    <item name="boxCornerRadiusBottomStart">12dp</item>
    <item name="boxCornerRadiusBottomEnd">12dp</item>

    <!-- Hint rengi -->
    <item name="hintTextColor">@color/auth_hint_color</item>
    <item name="android:textColorHint">@color/auth_hint_color</item>

    <!-- İç yüzey rengi (şeffaf olsun) -->
    <item name="boxBackgroundColor">@android:color/transparent</item>
</style>

<!-- ✏️ TextInputEditText stili -->
<style name="AuthEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
    <item name="android:textColor">@color/auth_text_color</item>
    <item name="colorControlActivated">@color/auth_focus_color</item> <!-- ✅ Güvenli -->
</style>

<!-- 🔹 Bottom nav: active indicator tamamen kapalı -->
<style name="Widget.Aqua.BottomNav.NoActiveIndicator" parent="">
    <item name="android:width">0dp</item>
    <item name="android:height">0dp</item>
    <item name="android:color">@android:color/transparent</item>
</style>

    <!-- Settings ekranındaki tüm kartlar için ortak stil -->
    <style name="Widget.Aqua.CardStyles"
        parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/settings_card_background</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>
	
	
	<!-- 🔹 Edit profile başlık textAppearance -->
<style name="TextAppearance.Aqua.EditProfileTitle" parent="TextAppearance.Material3.TitleLarge">
    <item name="android:textColor">@android:color/white</item>
    <item name="android:textStyle">bold</item>
</style>

<!-- 🔹 Primary (mavi) buton – eski inline görünüme uygun -->
<style name="Widget.Aqua.PrimaryButton" parent="Widget.Material3.Button">
    <item name="android:textColor">@android:color/white</item>
    <item name="cornerRadius">12dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:paddingTop">12dp</item>
    <item name="android:paddingBottom">12dp</item>
</style>
</resources>