<!-- 🎨 AppDialogTheme : Her dialog bu temayı kullanacak -->
<style name="AppDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">

    <!-- 🔹 Tamamen şeffaf pencere ve alt katmanı kaldır -->
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:background">@null</item>

    <!-- 🔹 Köşeler -->
    <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Material3.Corner.Medium</item>

    <!-- 🔹 Yazılar -->
    <item name="android:textColorPrimary">?attr/colorOnSurface</item>
    <item name="android:fontFamily">@font/poppins_medium</item>

    <!-- 🔹 Animasyonlar -->
    <item name="android:windowEnterAnimation">@anim/dialog_scale_in</item>
    <item name="android:windowExitAnimation">@anim/dialog_fade_out</item>

    <!-- 🔹 Gölge -->
    <item name="android:elevation">12dp</item>

</style>

<!-- 🔳 TextInputLayout stili -->
<style name="AuthTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
    <!-- Çerçeve (border) -->
    <item name="boxStrokeColor">@color/auth_input_stroke_color</item>
    <item name="boxStrokeWidth">1dp</item>
    <item name="boxStrokeWidthFocused">2dp</item>

    <!-- Kenar yuvarlaklık -->
    <item name="boxCornerRadiusTopStart">12dp</item>
    <item name="boxCornerRadiusTopEnd">12dp</item>
    <item name="boxCornerRadiusBottomStart">12dp</item>
    <item name="boxCornerRadiusBottomEnd">12dp</item>

    <!-- Hint rengi -->
    <item name="hintTextColor">@color/auth_hint_color</item>
    <item name="android:textColorHint">@color/auth_hint_color</item>

    <!-- İç yüzey rengi (şeffaf olsun) -->
    <item name="boxBackgroundColor">@android:color/transparent</item>
</style>

<!-- ✏️ TextInputEditText stili -->
<style name="AuthEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
    <item name="android:textColor">@color/auth_text_color</item>
    <item name="colorControlActivated">@color/auth_focus_color</item> <!-- ✅ Güvenli -->
</style>

<!-- 🔹 Bottom nav: aktif indicator -->
<style name="Widget.Aqua.BottomNav.ActiveIndicator" parent="">  
    <!-- Boyut -->
    <item name="android:width">60dp</item>
    <item name="android:height">32dp</item>

    <!-- Arka plan rengi -->
    <item name="android:color">?attr/colorSecondaryContainer</item>

    <!-- Köşeleri yuvarla (pill) -->
    <item name="shapeAppearance">@style/ShapeAppearance.Aqua.BottomNavIndicator</item>
</style>

<!-- 🔹 Bottom nav indicator'ın şekli (oval/pill) -->
<style name="ShapeAppearance.Aqua.BottomNavIndicator"
    parent="@style/ShapeAppearance.Material3.Corner.None">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">16dp</item> <!-- 32dp yüksekliğin yarısı -->
</style>

<style name="TextAppearance.Aqua.BottomNav" parent="TextAppearance.MaterialComponents.Body2">
    <item name="android:textSize">12sp</item>
</style>

<style name="Widget.Aqua.BottomNav"
    parent="Widget.MaterialComponents.BottomNavigationView">

    <!-- 🔹 Toplam yüksekliği aşağı çeken kısım -->
    <item name="android:minHeight">56dp</item>   <!-- 48–56 arası mantıklı -->
    <item name="android:paddingTop">2dp</item>
    <item name="android:paddingBottom">5dp</item>

    <!-- Yazıları da biraz küçültelim -->
    <item name="itemTextAppearanceActive">@style/TextAppearance.Aqua.BottomNav</item>
    <item name="itemTextAppearanceInactive">@style/TextAppearance.Aqua.BottomNav</item>
</style>

    <!-- Settings ekranındaki tüm kartlar için ortak stil -->
