<resources>

    <!-- Doğrudan köşe yarıçapı vermek en sorunsuz yol -->
    <style name="RedButton" parent="Widget.Material3.Button.Filled">
        <item name="backgroundTint">#DB4437</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">15dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="BlackButton" parent="Widget.Material3.Button.Filled">
        <item name="backgroundTint">@android:color/black</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">15dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- ÖNEMLİ: Doğru parent adı -->
    <style name="WhiteButton" parent="Widget.Material3.Button.Outlined">
        <item name="backgroundTint">@android:color/white</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="cornerRadius">15dp</item>
		<item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">17dp</item>
        <item name="android:paddingBottom">17dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="VerifyButton" parent="Widget.Material3.Button.Outlined">
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/raleway_medium</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:elevation">0dp</item>
    </style>

</resources>