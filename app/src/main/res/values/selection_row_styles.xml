<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Aqua.SelectionRow" parent="@android:style/Widget">
        <item name="android:background">@drawable/bg_aqua_selection_row</item>
        <item name="android:minHeight">@dimen/aqua_size_value_56</item>
        <item name="android:paddingStart">@dimen/aqua_space_value_14</item>
        <item name="android:paddingEnd">@dimen/aqua_space_value_12</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Aqua.SelectionRow.Large" parent="Widget.Aqua.SelectionRow">
        <item name="android:minHeight">@dimen/aqua_size_value_72</item>
    </style>

    <style name="Widget.Aqua.SelectionRow.Compact" parent="Widget.Aqua.SelectionRow">
        <item name="android:background">@drawable/bg_aqua_selection_row_compact</item>
        <item name="android:minHeight">@dimen/aqua_size_value_46</item>
        <item name="android:paddingStart">@dimen/aqua_space_value_14</item>
        <item name="android:paddingEnd">@dimen/aqua_space_value_14</item>
    </style>

    <style name="Widget.Aqua.SelectionRow.BottomSheet" parent="Widget.Aqua.SelectionRow.Compact" />

    <style name="Widget.Aqua.SelectionRow.Danger" parent="Widget.Aqua.SelectionRow">
        <item name="android:background">@drawable/bg_aqua_selection_row_danger</item>
    </style>

    <style name="Widget.Aqua.SelectionRow.Control" parent="Widget.Aqua.SelectionRow">
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:minHeight">@dimen/aqua_size_value_52</item>
        <item name="android:paddingStart">@dimen/aqua_space_value_10</item>
        <item name="android:paddingEnd">@dimen/aqua_space_value_10</item>
    </style>

    <style name="Widget.Aqua.SelectionRow.Settings" parent="Widget.Aqua.SelectionRow">
        <item name="android:minHeight">@dimen/aqua_size_value_60</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>


    <style name="Widget.Aqua.SelectionRow.GridOption" parent="Widget.Aqua.SelectionRow.Compact">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/aqua_size_value_64</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">@dimen/aqua_space_value_5</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/aqua_card_text_primary</item>
        <item name="android:textSize">@dimen/aqua_text_size_body</item>
    </style>

</resources>
