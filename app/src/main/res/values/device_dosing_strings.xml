    <string name="device_dosing_calibration_name_title">Identify this dosing channel</string>
    <string name="device_dosing_calibration_name_description">Enter the nutrient or additive used on this channel. AquaLight will show this name in dosing schedules and alerts.</string>
    <string name="device_dosing_calibration_prime_title">Prime the tubing</string>
    <string name="device_dosing_calibration_prime_description">Place the intake tube in the liquid reservoir and the outlet tube in a waste cup. Press and hold; release when liquid flows continuously with no air bubbles.</string>
    <string name="device_dosing_calibration_run_title">Collect the 5-second calibration dose</string>
    <string name="device_dosing_calibration_run_description">Place the outlet tube in a clean, dry, low-volume graduated cylinder. The pump runs for exactly 5 seconds; keep the cylinder still until it stops.</string>
    <string name="device_dosing_calibration_measure_title">Enter the actual volume</string>
    <string name="device_dosing_calibration_measure_description">Place the cylinder on a level surface. At eye level, read the bottom of the meniscus to the nearest 0.05 ml and enter the result.</string>
    <string name="device_dosing_calibration_verify_title">Dispense the 4.00 ml test dose</string>
    <string name="device_dosing_calibration_verify_description">Empty and completely dry the cylinder, then place the outlet tube back inside it. AquaLight will dispense 4.00 ml once using the newly calculated setting.</string>
    <string name="device_dosing_calibration_confirm_title">Check the test dose</string>
    <string name="device_dosing_calibration_confirm_description">Read the cylinder at eye level on a level surface. Save if it shows 3.95–4.05 ml; otherwise recalibrate. The previous calibration remains until you save.</string>
