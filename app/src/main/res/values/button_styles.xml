    </style>
    <style name="Widget.Aqua.Button.Auth.Google" parent="Widget.Aqua.Button">
        <item name="backgroundTint">@color/aqua_button_auth_google_container</item>
        <item name="android:textColor">@color/aqua_button_auth_google_content</item>
        <item name="iconTint">@null</item>
        <item name="strokeColor">@color/aqua_button_auth_google_stroke</item>
        <item name="strokeWidth">@dimen/aqua_button_stroke_width</item>
    </style>
    <style name="Widget.Aqua.Button.InlineAdd" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/aqua_text_size_toolbar_primary_action</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="backgroundTint">@color/aqua_toolbar_primary_action_container</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="cornerRadius">17dp</item>
        <item name="rippleColor">@color/aqua_button_ripple</item>
        <item name="elevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
