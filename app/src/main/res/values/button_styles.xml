    </style>
    <style name="Widget.Aqua.Button.Auth.Primary" parent="Widget.Aqua.Button">
        <item name="backgroundTint">@color/aqua_button_auth_primary_container</item>
        <item name="android:textColor">@color/aqua_button_auth_primary_content</item>
        <item name="iconTint">@color/aqua_button_auth_primary_content</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.Aqua.Button.Auth.Secondary" parent="Widget.Aqua.Button">
        <item name="backgroundTint">@color/aqua_button_auth_secondary_container</item>
        <item name="android:textColor">@color/aqua_button_auth_secondary_content</item>
