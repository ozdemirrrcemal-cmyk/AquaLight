rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /feedback_screenshots/{ownerUid}/{fileName} {
      function isOwner() {
        return request.auth != null && request.auth.uid == ownerUid;
      }

      function isDirectFeedbackJpeg() {
        return fileName.matches('^[^/]+\\.jpg$')
          && request.resource.size > 0
          && request.resource.size <= 3 * 1024 * 1024
          && request.resource.contentType == 'image/jpeg';
      }

      allow read: if isOwner();
      allow create: if isOwner() && isDirectFeedbackJpeg();
      allow update: if false;
      allow delete: if isOwner();
    }

    match /feedback_screenshots/{ownerUid}/{nestedPath=**} {
      function isOwner() {
        return request.auth != null && request.auth.uid == ownerUid;
      }

      // Rules v2 read includes get and list. This recursive owner-only rule permits
      // complete account-deletion enumeration, including orphaned future nested objects.
      // Uploads remain restricted by the direct-file JPEG rule above.
      allow read, delete: if isOwner();
      allow create, update: if false;
    }
  }
}
