rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /feedback_screenshots/{ownerUid}/{objectPath=**} {
      function isOwner() {
        return request.auth != null && request.auth.uid == ownerUid;
      }

      function isDirectFeedbackJpeg() {
        return objectPath.matches('^[^/]+\\.jpg$')
          && request.resource.size > 0
          && request.resource.size <= 3 * 1024 * 1024
          && request.resource.contentType == 'image/jpeg';
      }

      // Owners may enumerate and delete their complete prefix during account deletion,
      // including orphaned or future nested objects. New application uploads remain
      // restricted to immutable, direct JPEG objects under the owner's prefix.
      allow read: if isOwner();
      allow create: if isOwner() && isDirectFeedbackJpeg();
      allow update: if false;
      allow delete: if isOwner();
    }
  }
}
