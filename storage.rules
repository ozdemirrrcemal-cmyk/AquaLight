rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /feedback_screenshots/{ownerUid}/{fileName} {
      function isOwner() {
        return request.auth != null
          && ownerUid.size() > 0
          && ownerUid.size() <= 128
          && request.auth.uid == ownerUid;
      }

      function hasValidFeedbackFileName() {
        return fileName.matches('^[A-Za-z0-9_-]{1,128}\\.jpg$');
      }

      function isFeedbackJpeg() {
        return hasValidFeedbackFileName()
          && request.resource.size > 0
          && request.resource.size <= 3 * 1024 * 1024
          && request.resource.contentType == 'image/jpeg';
      }

      // Feedback screenshots are private owner-scoped objects. New uploads must be JPEG files
      // within the fixed size limit. Existing objects cannot be overwritten from the client.
      allow read: if isOwner();
      allow create: if isOwner() && isFeedbackJpeg();
      allow update: if false;
      allow delete: if isOwner();
    }

    match /{object=**} {
      allow read, write: if false;
    }
  }
}
