rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /feedback_screenshots/{ownerUid}/{documentId}.jpg {
      function isOwner() {
        return request.auth != null && request.auth.uid == ownerUid;
      }

      // Feedback media is private to its immutable path owner. The application stores
      // only Firebase download URLs after a successful owner-authorized upload.
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.size > 0
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
      allow update: if false;
      allow delete: if isOwner();
    }
  }
}
